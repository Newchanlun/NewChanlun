+	resp3, err := cl3.Do(req3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c3.ObserveStreamChunk([]byte(`data: {"type":"response.completed","response":{"id":"resp_dirsync3","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}}` + "\n\n"))
+	_, _ = io.Copy(io.Discard, resp3.Body)
+	_ = resp3.Body.Close()
+	e3.End()
+	c3.Complete(true)
+	c3.HandlerDone(true)
+
+	launchDir3 := filepath.Join(root3, launch3)
+	unsealedBefore3, err := os.ReadFile(filepath.Join(launchDir3, "receipt.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	syncDirFn = func(dir string) error {
+		if dir == launchDir3 {
+			return errors.New("injected launch dir sync error")
+		}
+		return origSync(dir)
+	}
+	if st, digest := SealReviewWithDigest(root3, launch3, session3); st != SealUnavailable || digest != "" {
+		t.Fatalf("SealReviewWithDigest with post-rename dir-sync failure = (%v, %q), want (SealUnavailable, \"\")", st, digest)
+	}
+	// Repeat in-process while dir-sync still fails MUST still return SealUnavailable with empty digest.
+	if st, digest := SealReviewWithDigest(root3, launch3, session3); st != SealUnavailable || digest != "" {
+		t.Fatalf("repeat in-process SealReviewWithDigest while dir-sync fails = (%v, %q), want (SealUnavailable, \"\")", st, digest)
+	}
+	// Wrong session rejects immediately; new BeginReview is blocked.
+	if st, digest := SealReviewWithDigest(root3, launch3, "019d0000-0000-7000-8000-000000000999"); st != SealRejected || digest != "" {
+		t.Fatalf("wrong-session SealReviewWithDigest while unsynced = (%v, %q), want (SealRejected, \"\")", st, digest)
+	}
+	if _, _, err := BeginReview(context.Background(), root3, launch3, session3, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("in-process BeginReview after seal rename err = %v, want ErrUnavailable", err)
+	}
+	// Post-restart while dir-sync STILL fails MUST return SealUnavailable with empty digest (never confirm un-fsynced seal!).
+	sealedBytes3, err := os.ReadFile(filepath.Join(launchDir3, "receipt.json"))
+	if err != nil || !strings.Contains(string(sealedBytes3), `"sealed":true`) {
+		t.Fatalf("expected sealed=true receipt on disk: err=%v raw=%s", err, string(sealedBytes3))
+	}
+	reviewMu.Lock()
+	delete(reviewLedger, root3+"\x00"+launch3)
+	reviewMu.Unlock()
+	if st, digest := SealReviewWithDigest(root3, launch3, session3); st != SealUnavailable || digest != "" {
+		t.Fatalf("post-restart SealReviewWithDigest while dir-sync fails = (%v, %q), want (SealUnavailable, \"\")", st, digest)
+	}
+	// If crash lost the unsynced rename (receipt.json reverts to sealed=false), post-restart returns SealRejected.
+	syncDirFn = origSync
+	if err := os.WriteFile(filepath.Join(launchDir3, "receipt.json"), unsealedBefore3, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if st, digest := SealReviewWithDigest(root3, launch3, session3); st != SealRejected || digest != "" {
+		t.Fatalf("post-restart SealReviewWithDigest after crash lost rename = (%v, %q), want (SealRejected, \"\")", st, digest)
+	}
+	// Once intact sealed=true receipt is on disk AND dir-sync succeeds, idempotent SealReviewWithDigest returns SealOK + exact SHA-256.
+	if err := os.WriteFile(filepath.Join(launchDir3, "receipt.json"), sealedBytes3, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if st, digest := SealReviewWithDigest(root3, launch3, session3); st != SealOK || digest != sha256Hex(string(sealedBytes3)) {
+		t.Fatalf("post-restart SealReviewWithDigest once intact sealed=true + dir-sync succeed = (%v, %q), want (SealOK, %q)", st, digest, sha256Hex(string(sealedBytes3)))
+	}
+}
