+		t.Fatal(err)
+	}
+	client := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		if req.URL.Hostname() == "api.anthropic.com" {
+			return &http.Response{StatusCode: 307, Header: http.Header{"Location": []string{"https://unknown.invalid/private"}}, Body: io.NopCloser(strings.NewReader(""))}, nil
+		}
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+	})})
