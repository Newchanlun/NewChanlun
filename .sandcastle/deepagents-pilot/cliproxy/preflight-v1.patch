+
+func TestReviewReceiptNativeCodexHTTP(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "receipts")
+	t.Setenv("CLIPROXY_PREFLIGHT_RECEIPTS", root)
+	models := make(chan string, 16)
+	upstream := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Host != "chatgpt.com" || (r.URL.Path != "/backend-api/codex/responses" && r.URL.Path != "/backend-api/codex/responses/compact") {
+			t.Errorf("unexpected upstream %s%s", r.Host, r.URL.Path)
+		}
+		var request struct {
+			Model string `json:"model"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
+			t.Errorf("decode upstream request: %v", err)
+		}
+		models <- request.Model
+		if r.URL.Path == "/backend-api/codex/responses/compact" {
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = fmt.Fprintf(w, `{"id":"compact","object":"response.compaction","output":[]}`)
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = fmt.Fprintf(w, `data: {"type":"response.completed","response":{"id":"offline","object":"response","status":"completed","model":%q,"output":[],"usage":{"input_tokens":1,"output_tokens":1}}}`+"\n\n", request.Model)
+	}))
+	defer upstream.Close()
+	roots := x509.NewCertPool()
+	roots.AddCert(upstream.Certificate())
+	transport := &http.Transport{
+		TLSClientConfig: &tls.Config{RootCAs: roots, ServerName: "example.com", MinVersion: tls.VersionTLS12},
+		DialContext: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, network, upstream.Listener.Addr().String())
+		},
+	}
+	defer transport.CloseIdleConnections()
+	server := newTestServer(t)
+	manager := server.handlers.AuthManager
+	manager.SetRoundTripperProvider(preflightTransportProvider{transport})
+	manager.RegisterExecutor(runtimeexecutor.NewCodexAutoExecutor(server.cfg))
+	const id = "review-receipt-codex"
+	credential := &auth.Auth{ID: id, Provider: "codex", Status: auth.StatusActive,
+		Attributes: map[string]string{auth.AttributeAuthKind: auth.AuthKindOAuth},
+		Metadata:   map[string]any{"access_token": "offline-fake", "websockets": true},
+	}
+	if _, err := manager.Register(context.Background(), credential); err != nil {
+		t.Fatal(err)
+	}
+	registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{{ID: "gpt-6.2-sol"}, {ID: "gpt-6.2-astra"}, {ID: "gpt-6.1-sol"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+
+	post := func(path, model, launch, session string) *httptest.ResponseRecorder {
+		body := fmt.Sprintf(`{"model":%q,"stream":true,"input":"offline"}`, model)
+		if path == "/v1/responses/compact" {
+			body = fmt.Sprintf(`{"model":%q,"input":[]}`, model)
+		}
+		req := httptest.NewRequest(http.MethodPost, path, strings.NewReader(body))
+		req.Header.Set("Authorization", "Bearer test-key")
+		req.Header.Set("Content-Type", "application/json")
+		if launch != "" {
+			req.Header.Set(preflightreceipt.ReviewHeader, launch)
+		}
+		if session != "" {
+			req.Header.Set("Session-Id", session)
+		}
+		res := httptest.NewRecorder()
+		server.engine.ServeHTTP(res, req)
+		return res
+	}
+	waitReceipt := func(t *testing.T, launch string, check func(preflightreceipt.ReviewReceipt) bool) ([]byte, preflightreceipt.ReviewReceipt) {
+		t.Helper()
+		deadline := time.Now().Add(2 * time.Second)
+		for time.Now().Before(deadline) {
+			raw, err := os.ReadFile(filepath.Join(root, launch, "receipt.json"))
+			if err == nil {
+				var r preflightreceipt.ReviewReceipt
+				if json.Unmarshal(raw, &r) == nil && check(r) {
+					return raw, r
+				}
+			}
+			time.Sleep(time.Millisecond)
+		}
+		t.Fatalf("review receipt for %s did not reach expected state", launch)
+		return nil, preflightreceipt.ReviewReceipt{}
+	}
+	exportFixture := func(t *testing.T, name, launch string, raw []byte) {
+		t.Helper()
+		if export := os.Getenv("PREFLIGHT_FIXTURES"); export != "" {
+			dir := filepath.Join(export, name, launch)
+			if err := os.MkdirAll(dir, 0700); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(dir, "receipt.json"), raw, 0600); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+
+	for _, tc := range []struct{ model, launch, session, fixture string; compact bool }{
+		{"gpt-6.2-sol", "review-12345678-1234-4234-8234-123456789aa1", "019d0000-0000-7000-8000-000000000aa1", "review-codex-sol", true},
+		{"gpt-6.2-astra", "review-12345678-1234-4234-8234-123456789aa2", "019d0000-0000-7000-8000-000000000aa2", "review-codex-astra", false},
+	} {
+		t.Run(tc.model, func(t *testing.T) {
+			for turn := 1; turn <= 2; turn++ {
+				res := post("/v1/responses", tc.model, tc.launch, tc.session)
+				if res.Code != http.StatusOK {
+					t.Fatalf("turn %d HTTP %d: %s", turn, res.Code, res.Body.String())
+				}
+				if got := <-models; got != tc.model {
+					t.Fatalf("upstream model = %q, want %q", got, tc.model)
+				}
+			}
+			wantCount := 2
+			if tc.compact {
+				res := post("/v1/responses/compact", tc.model, tc.launch, tc.session)
+				if res.Code != http.StatusOK {
+					t.Fatalf("compact HTTP %d: %s", res.Code, res.Body.String())
+				}
+				if got := <-models; got != tc.model {
+					t.Fatalf("compact upstream model = %q, want %q", got, tc.model)
+				}
+				wantCount = 3
+			}
+			raw, r := waitReceipt(t, tc.launch, func(r preflightreceipt.ReviewReceipt) bool {
+				return r.Requests == wantCount && r.Complete && !r.Tainted
+			})
+			wantRoute := "codex:" + tc.model + "@chatgpt.com"
+			if r.Schema != preflightreceipt.ReviewSchema || r.Launch != tc.launch || r.Session != tc.session ||
+				len(r.Routes) != 1 || r.Routes[0] != wantRoute {
+				t.Fatalf("wrong review receipt %+v, want route %q", r, wantRoute)
+			}
+			exportFixture(t, tc.fixture, tc.launch, raw)
+		})
+	}
+
+	t.Run("swapped-model-taints-and-blocks-upstream", func(t *testing.T) {
+		const launch = "review-12345678-1234-4234-8234-123456789aa3"
+		const session = "019d0000-0000-7000-8000-000000000aa3"
+		res1 := post("/v1/responses", "gpt-6.2-sol", launch, session)
+		if res1.Code != http.StatusOK {
+			t.Fatalf("turn 1 HTTP %d: %s", res1.Code, res1.Body.String())
+		}
+		if got := <-models; got != "gpt-6.2-sol" {
+			t.Fatalf("turn 1 model = %q", got)
+		}
+		waitReceipt(t, launch, func(r preflightreceipt.ReviewReceipt) bool { return r.Requests == 1 && r.Complete })
+		res2 := post("/v1/responses", "gpt-6.2-astra", launch, session)
+		if res2.Code < 400 || len(models) != 0 {
+			t.Fatalf("swapped model escaped guard: status=%d extraCalls=%d", res2.Code, len(models))
+		}
+		raw, r := waitReceipt(t, launch, func(r preflightreceipt.ReviewReceipt) bool { return r.Tainted && !r.Complete })
+		if len(r.Routes) != 1 || r.Routes[0] != "other" {
+			t.Fatalf("tainted routes = %+v", r.Routes)
+		}
+		exportFixture(t, "review-codex-tainted", launch, raw)
+	})
+
+	t.Run("unlisted-model-rejected-before-upstream", func(t *testing.T) {
+		const launch = "review-12345678-1234-4234-8234-123456789aa4"
+		const session = "019d0000-0000-7000-8000-000000000aa4"
+		res := post("/v1/responses", "gpt-6.1-sol", launch, session)
+		if res.Code < 400 || len(models) != 0 {
+			t.Fatalf("unlisted review model escaped guard: status=%d calls=%d", res.Code, len(models))
+		}
+		waitReceipt(t, launch, func(r preflightreceipt.ReviewReceipt) bool { return r.Tainted && !r.Complete })
+	})
+
+	t.Run("malformed-header-and-websocket-rejected", func(t *testing.T) {
+		res := post("/v1/responses", "gpt-6.2-sol", "not-a-review-launch", "019d0000-0000-7000-8000-000000000aa5")
+		if res.Code != http.StatusBadRequest || len(models) != 0 {
+			t.Fatalf("malformed review header escaped guard: status=%d calls=%d", res.Code, len(models))
+		}
+	})
+}
