+func TestReviewReceiptFDOnlyReclaimAdvancesCursorPast64SkippedPinnedEntries(t *testing.T) {
+	// Sol P1 #1 + Astra P2 #3 (PR #2280 R52): when disk quota has room and only pinned FD budget
+	// is exhausted, FD-only reclamation MUST:
+	// (1) skip recently-reconfirmed sealedBindings (recordedAt within retention) immediately; AND
+	// (2) advance state.cursor past a 64-entry batch of disk-expired pinned entries that skip at
+	//     reclaim time (e.g. digest mismatch), so a later reclaimable entry at index 64 is reached!
+	root := filepath.Join(t.TempDir(), "fd-cursor-advance")
+	if err := ensurePrivateRoot(root); err != nil {
+		t.Fatal(err)
+	}
+	ancient := time.Now().Add(-48 * time.Hour)
+	cleanRoot := filepath.Clean(root)
+	names := make([]string, 0, 66)
+	var cleanupFDs []*os.File
+	var cleanupKeys []string
+	defer func() {
+		reviewMu.Lock()
+		for _, k := range cleanupKeys {
+			delete(sealedBindings, k)
+		}
+		reviewMu.Unlock()
+		for _, fd := range cleanupFDs {
+			_ = fd.Close()
+		}
+	}()
+
+	lease, err := acquirePrivateRootLease(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lease.Close()
+	var rootDev, rootIno uint64
+	if rf, rerr := lease.dir.Open("."); rerr == nil {
+		if rfi, serr := rf.Stat(); serr == nil {
+			rootDev, rootIno, _ = statDevIno(rfi)
+		}
+		_ = rf.Close()
+	}
+
+	makeBoundAgedDir := func(idx int, recordedAt time.Time, mismatchDigest bool, countBudget bool) (string, string) {
+		launch := fmt.Sprintf("review-fccccccc-2222-4333-8444-%012d", idx)
+		session := fmt.Sprintf("019d0000-0000-7000-8000-%012d", idx)
+		dir := filepath.Join(root, launch)
+		if mkErr := os.Mkdir(dir, 0700); mkErr != nil {
+			t.Fatal(mkErr)
+		}
+		rr := ReviewReceipt{
+			Schema:           ReviewSchema,
+			Launch:           launch,
+			Session:          session,
+			Started:          ancient.UnixNano(),
+			Finished:         ancient.UnixNano(),
+			SealedAt:         ancient.UnixNano(),
+			Complete:         true,
+			Sealed:           true,
+			Requests:         1,
+			Routes:           []string{"codex:gpt-6.2-sol@chatgpt.com"},
+			ResponseIDSHAs:   []string{sha256Hex(fmt.Sprintf("resp_%d", idx))},
+			LastResponseID:   sha256Hex(fmt.Sprintf("resp_%d", idx)),
+			LastOutputSHA256: sha256Hex("VERDICT: PASS"),
+		}
+		rawRec, _ := json.Marshal(rr)
+		shaRec := sha256Hex(string(rawRec))
+		rawMarker, _ := json.Marshal(reviewReservationMarker{Schema: ReviewSchema, Launch: launch, Started: ancient.UnixNano()})
+		if werr := os.WriteFile(filepath.Join(dir, "receipt.json"), rawRec, 0600); werr != nil {
+			t.Fatal(werr)
+		}
+		if werr := os.WriteFile(filepath.Join(dir, "seal.sha256"), []byte(shaRec), 0600); werr != nil {
+			t.Fatal(werr)
+		}
+		if werr := os.WriteFile(filepath.Join(dir, "producer.json"), rawMarker, 0600); werr != nil {
+			t.Fatal(werr)
+		}
+		for _, p := range []string{filepath.Join(dir, "receipt.json"), filepath.Join(dir, "seal.sha256"), filepath.Join(dir, "producer.json"), dir} {
+			_ = os.Chtimes(p, ancient, ancient)
+		}
+		sub, _, oerr := openVerifiedSubdir(lease.dir, launch)
+		if oerr != nil {
+			t.Fatal(oerr)
+		}
+		var fd *os.File
+		var dev, ino uint64
+		var hasID bool
+		var ferr error
+		if countBudget {
+			fd, dev, ino, hasID, ferr = openBudgetedPinnedDirFD(sub)
+		} else {
+			fd, dev, ino, hasID, ferr = openPinnedDirFD(sub)
+		}
+		_ = sub.Close()
+		if ferr != nil {
+			t.Fatal(ferr)
+		}
+		if !countBudget {
+			cleanupFDs = append(cleanupFDs, fd)
+		}
+		boundSHA := shaRec
+		if mismatchDigest {
+			boundSHA = sha256Hex("different-bound-digest")
+		}
+		key := cleanRoot + "\x00" + launch
+		cleanupKeys = append(cleanupKeys, key)
+		reviewMu.Lock()
+		sealedBindings[key] = sealedDirBinding{
+			rootDev:    rootDev,
+			rootIno:    rootIno,
+			dirDev:     dev,
+			dirIno:     ino,
+			hasDirID:   hasID,
+			dirFD:      fd,
+			receiptSHA: boundSHA,
+			recordedAt: recordedAt,
+		}
+		reviewMu.Unlock()
+		return launch, key
+	}
+
+	// Sub-scenario A: 64 disk-expired dirs whose sealedBindings.recordedAt is FRESH + 1 genuinely expired dir at #65.
+	// Pre-filtering fresh recordedAt MUST reach #65 on the VERY FIRST call!
+	freshNames := make([]string, 0, 65)
+	for i := 0; i < 64; i++ {
+		l, _ := makeBoundAgedDir(i+1, time.Now(), false, false)
+		freshNames = append(freshNames, l)
+	}
+	targetA, _ := makeBoundAgedDir(65, ancient, false, true)
+	freshNames = append(freshNames, targetA)
+
+	stateA := &bucketReclaimState{cache: make(map[reclaimCacheKey]reclaimCacheEntry)}
+	dirsA, fdsA := reclaimExpiredBucketEntries(lease.dir, root, freshNames, true, 0, 1, stateA)
+	if dirsA != 1 || fdsA != 1 {
+		t.Fatalf("FD-only reclaim with 64 fresh-recordedAt bindings + 1 expired = (%d, %d), want (1, 1)", dirsA, fdsA)
+	}
+	if _, statErr := os.Lstat(filepath.Join(root, targetA)); !os.IsNotExist(statErr) {
+		t.Fatalf("targetA %s was not reclaimed on call 1: %v", targetA, statErr)
+	}
+
+	// Sub-scenario B: 64 disk-expired dirs whose recordedAt IS aged (so they enter pinnedSet and
+	// consume all 64 inspection slots) yet skip at reclaim due to digest mismatch, followed by
+	// entry #65 which IS genuinely reclaimable! Call 1 MUST advance state.cursor to 64 so Call 2
+	// reaches and reclaims #65 instead of looping on indices 0..63 forever.
+	for i := 0; i < 64; i++ {
+		l, _ := makeBoundAgedDir(100+i, ancient, true, false)
+		names = append(names, l)
+	}
+	targetB, _ := makeBoundAgedDir(200, ancient, false, true)
+	names = append(names, targetB)
+
+	stateB := &bucketReclaimState{cache: make(map[reclaimCacheKey]reclaimCacheEntry)}
+	dirsB1, fdsB1 := reclaimExpiredBucketEntries(lease.dir, root, names, true, 0, 1, stateB)
+	if dirsB1 != 0 || fdsB1 != 0 {
+		t.Fatalf("FD-only reclaim call 1 over 64 mismatched entries = (%d, %d), want (0, 0)", dirsB1, fdsB1)
+	}
+	if stateB.cursor != 64 {
+		t.Fatalf("FD-only reclaim did not advance cursor past first 64 pinned entries: cursor=%d, want 64", stateB.cursor)
+	}
+	dirsB2, fdsB2 := reclaimExpiredBucketEntries(lease.dir, root, names, true, 0, 1, stateB)
+	if dirsB2 != 1 || fdsB2 != 1 {
+		t.Fatalf("FD-only reclaim call 2 starting at cursor 64 = (%d, %d), want (1, 1)", dirsB2, fdsB2)
+	}
+	if _, statErr := os.Lstat(filepath.Join(root, targetB)); !os.IsNotExist(statErr) {
+		t.Fatalf("targetB %s was not reclaimed on call 2: %v", targetB, statErr)
+	}
+}
