+	s2 := "019d0000-0000-7000-8000-666666666802"
+	sseCommentaryStreamed := "data: " + `{"type":"response.created","response":{"id":"resp_c2","status":"in_progress","model":"gpt-6.2-sol"}}` + "\n\n" +
+		"data: " + `{"type":"response.output_item.done","item":{"type":"message","role":"assistant","phase":"commentary","content":[{"type":"output_text","text":"still checking"}]}}` + "\n\n" +
+		"data: " + `{"type":"response.output_item.done","item":{"type":"function_call","name":"exec_command"}}` + "\n\n" +
