+		"data: " + `{"type":"response.completed","response":{"id":"resp_different","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","phase":"final_answer","content":[{"type":"output_text","text":"ok"}]}]}}` + "\n\n"
+	if st, _ := runSSE(t, root, "review-c1111111-2222-4333-8444-555555555501", "019d0000-0000-7000-8000-777777777101", sseCrossFrame); st != SealRejected {
+		t.Fatalf("cross-frame output-only response_id conflict = %v, want SealRejected", st)
