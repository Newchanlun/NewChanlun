+		sealedDigest = sha256Hex(string(data))
+		// Stage producer.json + seal.pending.json + seal.sha256 together inside a dedicated
+		// <root>/.staging/stage-seal-<pid>-<seq>-<16hex>/ directory so every staged artifact is
+		// cryptographically provably producer-owned even on an abrupt crash.
+		sealDirName, sealStageRoot, releaseSealDir, err := createNamedStagingDir(stagingRoot, root, "stage-seal")
