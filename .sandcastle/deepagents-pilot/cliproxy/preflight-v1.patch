+func TestReviewReceiptStrictBodyCloseNeverBlocksOnHangingUpstream(t *testing.T) {
+	// R28 (Astra P2): if an executor stops reading early while upstream holds the stream open without data or EOF,
+	// body.Close() must NOT block on a synchronous probe Read; it must close immediately, run finish(), and reject seal.
+	root := filepath.Join(t.TempDir(), "receipts")
+	launch := "review-eeee1111-2222-4333-8444-555555555949"
+	session := "019d0000-0000-7000-8000-000000000949"
+	ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, e, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	pr, pw := io.Pipe()
+	defer pw.Close()
+	sse := `data: {"type":"response.completed","response":{"id":"resp_hang","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}}` + "\n\n"
+	go func() {
+		_, _ = pw.Write([]byte(sse))
+		// Keep pipe open without closing (stalled upstream after terminal event).
+	}()
+	cl := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: pr}, nil
+	})})
+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	resp, err := cl.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, len(sse))
+	if _, err := io.ReadFull(resp.Body, buf); err != nil {
+		t.Fatal(err)
+	}
+	c.ObserveStreamChunk(buf)
+	closed := make(chan error, 1)
+	go func() { closed <- resp.Body.Close() }()
+	select {
+	case err := <-closed:
+		if err != nil {
+			t.Fatalf("unexpected Close error: %v", err)
+		}
+	case <-time.After(1 * time.Second):
+		t.Fatal("resp.Body.Close() blocked waiting on stalled upstream instead of failing closed immediately")
+	}
+	e.End()
+	c.Complete(true)
+	c.HandlerDone(true)
+	if st := SealReview(root, launch, session); st != SealRejected {
+		t.Fatalf("SealReview accepted early-closed stalled stream without EOF: %v", st)
+	}
+}
