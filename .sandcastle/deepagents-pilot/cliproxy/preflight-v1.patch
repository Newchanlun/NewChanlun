+func TestReviewReceiptReserveDirSyncFailureRollsBackAndRecoversQuota(t *testing.T) {
+	// Sol P2 #2 (PR #2280 R37): when root dir sync fails right after os.Mkdir in reservePrivateDir,
+	// the newly created empty directory MUST be rolled back so quota recovers after the transient fault.
+	oldReviewCap := maxReviewDiskEntries
+	oldPreflightCap := maxPreflightDiskEntries
+	oldSync := syncDirFn
+	maxReviewDiskEntries = 1
+	maxPreflightDiskEntries = 1
+	defer func() {
+		maxReviewDiskEntries = oldReviewCap
+		maxPreflightDiskEntries = oldPreflightCap
+		syncDirFn = oldSync
+	}()
+
+	root := filepath.Join(t.TempDir(), "rollback-quota-receipts")
+	if err := ensurePrivateRoot(root); err != nil {
+		t.Fatal(err)
+	}
+	if err := acquirePrivateRootLock(root); err != nil {
+		t.Fatal(err)
+	}
+
+	failRootSync := true
+	syncDirFn = func(dir string) error {
+		if failRootSync && filepath.Clean(dir) == filepath.Clean(root) {
+			return errors.New("simulated transient root fsync failure")
+		}
+		if oldSync != nil {
+			return oldSync(dir)
+		}
+		return nil
+	}
+
+	lFail := "review-f8888888-2222-4333-8444-555555555501"
+	if _, err := ReserveReview(root, lFail); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("ReserveReview during root sync failure = %v, want ErrUnavailable", err)
+	}
+	if _, statErr := os.Lstat(filepath.Join(root, lFail)); !os.IsNotExist(statErr) {
+		t.Fatalf("newly created empty review dir leaked after root sync failure: %v", statErr)
+	}
+
+	pFail := "preflight-f8888888-2222-4333-8444-555555555501"
+	if err := reservePrivateDir(filepath.Join(root, pFail), false); err == nil {
+		t.Fatalf("reservePrivateDir during root sync failure unexpectedly succeeded")
+	}
+	if _, statErr := os.Lstat(filepath.Join(root, pFail)); !os.IsNotExist(statErr) {
+		t.Fatalf("newly created empty preflight dir leaked after root sync failure: %v", statErr)
+	}
+
+	// Recover transient fault -> quota slot MUST be available for both review and preflight buckets.
+	failRootSync = false
+	lOK := "review-f8888888-2222-4333-8444-555555555502"
+	res, err := ReserveReview(root, lOK)
+	if err != nil {
+		t.Fatalf("ReserveReview after transient root sync recovery failed (quota leaked): %v", err)
+	}
+	res.Release()
+
+	pOK := "preflight-f8888888-2222-4333-8444-555555555502"
+	if err := reservePrivateDir(filepath.Join(root, pOK), false); err != nil {
+		t.Fatalf("reservePrivateDir after transient root sync recovery failed (quota leaked): %v", err)
+	}
+}
