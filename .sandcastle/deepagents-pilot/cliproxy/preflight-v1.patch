+// PreflightEvidenceGuard accepts only an empty, unchanged plugin snapshot.
+// A reload creates a new snapshot, so load/unload during a request also rejects.
+func (h *Host) PreflightEvidenceGuard() func() bool {
+	snapshot := h.Snapshot()
+	return func() bool { return snapshot != nil && len(snapshot.records) == 0 && h.Snapshot() == snapshot }
+}
