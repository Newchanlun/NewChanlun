+func TestReviewReceiptSealReviewDiskTaintedReturnsRejected(t *testing.T) {
+	// Astra P1 #2 (PR #2280 R1): if disk already holds tainted=true while the in-memory entry
+	// still has tainted=false, persistWithStatusLocked flips tainted=true and writes sealed=false;
+	// SealReview MUST return SealRejected (both initially and on retries), never SealOK.
+	root := filepath.Join(t.TempDir(), "receipts")
+	launch := "review-b2222222-2222-4333-8444-555555555501"
+	session := "019d0000-0000-7000-8000-666666666501"
+
+	ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, lease, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sse := "data: " + `{"type":"response.completed","response":{"id":"resp_disk_taint","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}}` + "\n\n"
+	cl := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: 200,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader(sse)),
+			TLS:        verifiedTLSState("chatgpt.com"),
+		}, nil
+	})})
+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	resp, err := cl.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, _ := io.ReadAll(resp.Body)
+	_ = resp.Body.Close()
+	c.ObserveStreamChunk(raw)
+	lease.End()
+	c.Complete(true)
+	c.HandlerDone(true)
+
+	// Externally overwrite receipt.json on disk with tainted=true before SealReview runs.
+	diskPath := filepath.Join(root, launch, "receipt.json")
+	var disk ReviewReceipt
+	origBytes, err := os.ReadFile(diskPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(origBytes, &disk); err != nil {
+		t.Fatal(err)
+	}
+	disk.Tainted = true
+	disk.Complete = false
+	disk.Sealed = false
+	taintedBytes, err := json.Marshal(disk)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(diskPath, taintedBytes, 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	if st := SealReview(root, launch, session); st != SealRejected {
+		t.Fatalf("first SealReview with tainted disk receipt = %v, want SealRejected", st)
+	}
+	if st := SealReview(root, launch, session); st != SealRejected {
+		t.Fatalf("retry SealReview with tainted disk receipt = %v, want SealRejected", st)
+	}
+	after := readReviewReceiptFile(t, root, launch)
+	if !after.Tainted || after.Sealed || after.Complete {
+		t.Fatalf("disk receipt after rejected seal = %+v, want tainted=true sealed=false complete=false", after)
+	}
+}
