+	// 3. Full drain to io.EOF -> SealReview MUST succeed.
+	launchOK := "review-eeee1111-2222-4333-8444-555555555913"
+	sessionOK := "019d0000-0000-7000-8000-000000000913"
+	ctx3, c3, err := BeginReview(context.Background(), root, launchOK, sessionOK, "gpt-6.2-sol")
