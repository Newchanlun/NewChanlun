+			_ = sealStageFD.Close()
+			_ = sealStageRoot.Close()
+			if curSFI, lerr := stagingRoot.Lstat(sealDirName); lerr == nil && curSFI.IsDir() {
+				if cDev, cIno, okC := statDevIno(curSFI); !okC || !hasSSID || (cDev == ssDev && cIno == ssIno) {
+					_ = stagingRoot.Remove(sealDirName)
+				}
+			}
+		}
+		markerBytes, merr := marshalReservationMarker(e.launch, e.started)
+		if merr != nil {
+			cleanupSealStage(false, false)
+			return fail(false, ErrUnavailable)
+		}
+		mf, merr := sealStageRoot.OpenFile("producer.json", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if merr != nil {
+			cleanupSealStage(false, false)
+			return fail(false, merr)
+		}
