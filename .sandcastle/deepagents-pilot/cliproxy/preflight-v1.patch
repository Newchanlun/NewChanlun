+func TestReviewReceiptTLSHandshakeErrorTaintsBeforeRouteAppend(t *testing.T) {
+	wrongSrv, wrongPool := makeHostTLSServer(t, "wrong.example.test")
+	rightSrv, rightPool := makeHostTLSServer(t, "chatgpt.com")
+	combinedPool := wrongPool.Clone()
+	for _, raw := range rightSrv.TLS.Certificates[0].Certificate {
+		c, err := x509.ParseCertificate(raw)
+		if err != nil {
+			t.Fatal(err)
+		}
+		combinedPool.AddCert(c)
+	}
+	_ = rightPool
+
+	// Formal review: first attempt fails real Go TLS hostname verification (resp == nil),
+	// retry hits valid chatgpt.com. Launch MUST be tainted and never record trusted route.
+	root := filepath.Join(t.TempDir(), "receipts")
+	launch := "review-ffff1111-2222-4333-8444-555555555552"
+	session := "019d0000-0000-7000-8000-000000000402"
+	ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, e, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	attempt := 0
+	realTr := &http.Transport{
+		TLSClientConfig: &tls.Config{RootCAs: combinedPool},
+		DialContext: func(dialCtx context.Context, network, _ string) (net.Conn, error) {
+			attempt++
+			target := wrongSrv.Listener.Addr().String()
+			if attempt > 1 {
+				target = rightSrv.Listener.Addr().String()
+			}
+			return (&net.Dialer{}).DialContext(dialCtx, network, target)
+		},
+	}
+	defer realTr.CloseIdleConnections()
+	client := httptransport.Decorate(ctx, &http.Client{Transport: realTr})
+	req1, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	if _, err := client.Do(req1); err == nil {
+		t.Fatalf("expected TLS hostname error from standard http.Transport")
+	}
+	// Retry against valid server must NOT produce a clean receipt.
+	req2, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	if _, err := client.Do(req2); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("retry after TLS handshake failure err = %v, want ErrUnavailable", err)
+	}
+	e.End()
+	c.Complete(true)
+	c.HandlerDone(true)
+	if r := readReviewReceiptFile(t, root, launch); !r.Tainted || r.Complete || r.Sealed {
+		t.Fatalf("TLS handshake error did not taint launch: %+v", r)
+	}
+
+	// Preflight: TLS handshake error rejects collector so subsequent retry cannot produce a valid receipt.
+	pCtx, pc := beginTest(t)
+	pCtx, pe, err := pc.Start(pCtx, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	attempt = 0
+	pClient := httptransport.Decorate(pCtx, &http.Client{Transport: realTr})
+	pReq1, _ := http.NewRequestWithContext(pCtx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	if _, err := pClient.Do(pReq1); err == nil {
+		t.Fatalf("expected preflight TLS hostname error")
+	}
+	pReq2, _ := http.NewRequestWithContext(pCtx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	if _, err := pClient.Do(pReq2); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("preflight retry after TLS failure err = %v, want ErrUnavailable", err)
+	}
+	pe.End()
+	pc.Complete(true)
+	pc.HandlerDone(true)
+	if _, statErr := os.Stat(filepath.Join(pc.directory, "receipt.json")); !os.IsNotExist(statErr) {
+		t.Fatalf("preflight wrote receipt despite TLS handshake error: %v", statErr)
+	}
+}
