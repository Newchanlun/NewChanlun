+		Schema:           ReviewSchema,
+		Launch:           e.launch,
+		Session:          e.session,
+		Started:          e.started,
+		Finished:         finished,
+		SealedAt:         sealedAt,
+		Complete:         complete,
+		Sealed:           sealed,
+		Tainted:          e.tainted,
+		Requests:         e.requests,
+		Routes:           routes,
