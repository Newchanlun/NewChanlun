+		})})
+		req2, _ := http.NewRequestWithContext(ctx2, http.MethodPost, "https://api.anthropic.com/v1/messages", strings.NewReader("{}"))
+		resp2, err := cl2.Do(req2)
+		if err != nil {
+			t.Errorf("req2 err: %v", err)
+			return
+		}
+		_, _ = io.Copy(io.Discard, resp2.Body)
+		_ = resp2.Body.Close()
+		e2.End()
+		close(req2Finished)
+	}()
+
+	wg.Wait()
+	c.Complete(true)
+	c.HandlerDone(true)
+
+	raw, err := os.ReadFile(filepath.Join(root, token, "receipt.json"))
+	if err != nil {
+		t.Fatalf("read receipt.json: %v", err)
+	}
+	var got Receipt
+	if err := json.Unmarshal(raw, &got); err != nil {
+		t.Fatalf("unmarshal receipt.json: %v", err)
+	}
+	want := []string{"kimi@api.kimi.com", "claude@api.anthropic.com"}
+	if len(got.Routes) != len(want) || got.Routes[0] != want[0] || got.Routes[1] != want[1] {
+		t.Fatalf("receipt.Routes = %v, want request-initiation order %v", got.Routes, want)
+	}
+}
