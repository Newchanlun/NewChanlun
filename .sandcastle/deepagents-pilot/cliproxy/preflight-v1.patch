+func TestReviewReceiptSingleWriterRootLockBlocksSecondInstance(t *testing.T) {
+	// Sol P1 #3 (PR #2280 R5): an exclusive non-blocking flock on <root>/.writer.lock prevents a
+	// second same-UID proxy instance from reserving launches or confirming SealOK on a shared root.
+	root := filepath.Join(t.TempDir(), "shared-root")
+	if err := os.Mkdir(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	lockPath := filepath.Join(root, ".writer.lock")
+	peerFile, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(lockPath, 0600); err != nil {
+		_ = peerFile.Close()
+		t.Fatal(err)
+	}
+	// Hold exclusive BSD flock on an independent open file description (simulates another proxy process).
+	if err := syscall.Flock(int(peerFile.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		_ = peerFile.Close()
+		t.Fatal(err)
+	}
+	closed := false
+	t.Cleanup(func() {
+		if !closed {
+			_ = peerFile.Close()
+		}
+	})
+
+	launch := "review-b9999999-2222-4333-8444-555555555501"
+	session := "019d0000-0000-7000-8000-666666666901"
+	if _, err := ReserveReview(root, launch); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("ReserveReview while peer holds root flock = %v, want ErrUnavailable", err)
+	}
+	if _, _, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("BeginReview while peer holds root flock = %v, want ErrUnavailable", err)
+	}
+	if st, digest := SealReviewWithDigest(root, launch, session); st != SealUnavailable || digest != "" {
+		t.Fatalf("SealReviewWithDigest while peer holds root flock = (%v, %q), want (SealUnavailable, \"\")", st, digest)
+	}
+
+	// Peer owns an unsealed receipt.json on disk; second instance calling TaintReview without holding
+	// .writer.lock MUST NOT unlink or mutate the peer's receipt.json (Astra P1 #3).
+	peerDir := filepath.Join(root, launch)
+	if err := os.Mkdir(peerDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(peerDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	peerReceiptPath := filepath.Join(peerDir, "receipt.json")
+	peerContent := []byte(`{"schema":"cliproxy-review-v1","launch":"` + launch + `","session":"` + session + `","complete":false,"sealed":false,"tainted":false,"requests":0,"routes":["other"],"response_id_sha256s":[]}`)
+	if err := os.WriteFile(peerReceiptPath, peerContent, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(peerReceiptPath, 0600); err != nil {
+		t.Fatal(err)
+	}
+	TaintReview(root, launch)
+	gotAfterTaint, err := os.ReadFile(peerReceiptPath)
+	if err != nil || !bytes.Equal(gotAfterTaint, peerContent) {
+		t.Fatalf("TaintReview without root lock mutated/removed peer receipt: err=%v got=%q", err, string(gotAfterTaint))
+	}
+	// Clear this test process's ledger entry and peer placeholder before releasing the peer flock.
+	reviewMu.Lock()
+	delete(reviewLedger, root+"\x00"+launch)
+	reviewMu.Unlock()
+	_ = os.RemoveAll(peerDir)
+
+	// Once peer exits (releases flock), this instance can acquire ownership and reserve normally.
+	_ = peerFile.Close()
+	closed = true
+	res, err := ReserveReview(root, launch)
+	if err != nil {
+		t.Fatalf("ReserveReview after peer released root flock = %v, want nil", err)
+	}
+	res.Release()
+}
