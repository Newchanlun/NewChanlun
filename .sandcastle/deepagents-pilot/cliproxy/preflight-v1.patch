+		errMS := mf.Sync()
+		errMC := mf.Close()
+		if errMW != nil || errMS != nil || errMC != nil {
+			cleanupSealStage(false, false)
+			return fail(false, ErrUnavailable)
+		}
+		pf, perr := sealStageRoot.OpenFile("seal.pending.json", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if perr != nil {
+			cleanupSealStage(false, false)
+			return fail(false, perr)
+		}
