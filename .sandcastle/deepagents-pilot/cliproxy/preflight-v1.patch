+func TestReviewReceiptMultiTurnStrictEnforcementAndStickyTaint(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "receipts")
+	launch := "review-11111111-2222-4333-8444-555555555555"
+	session := "019d0000-0000-7000-8000-000000000001"
+	var upstreamCalls int
+
+	runTurn := func(model, path, wireModel string, useZstd bool) error {
+		ctx, c, err := BeginReview(context.Background(), root, launch, session)
+		if err != nil {
+			return err
+		}
+		ctx, e, err := c.Start(ctx, "codex", model)
+		if err != nil {
+			c.HandlerDone(false)
+			return err
+		}
+		raw := []byte(`{"model":"` + wireModel + `","stream":true}`)
+		if useZstd {
+			raw = compressZstd(t, string(raw))
+		}
+		client := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+			upstreamCalls++
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+		})})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com"+path, bytes.NewReader(raw))
+		if useZstd {
+			req.Header.Set("Content-Encoding", "zstd")
+		}
+		resp, err := client.Do(req)
+		if err != nil {
+			e.End()
+			c.Complete(false)
+			c.HandlerDone(false)
+			return err
+		}
+		_ = resp.Body.Close()
+		e.End()
+		c.Complete(true)
+		c.HandlerDone(true)
+		return nil
+	}
+
+	if err := runTurn("gpt-6.2-sol", "/backend-api/codex/responses", "gpt-6.2-sol", false); err != nil {
+		t.Fatal(err)
+	}
+	if err := runTurn("gpt-6.2-sol", "/backend-api/codex/responses/compact", "gpt-6.2-sol", true); err != nil {
+		t.Fatal(err)
+	}
+	r := readReviewReceiptFile(t, root, launch)
+	if r.Schema != ReviewSchema || r.Launch != launch || r.Session != session || !r.Complete || r.Tainted || r.Requests != 2 || len(r.Routes) != 1 || r.Routes[0] != "codex:gpt-6.2-sol@chatgpt.com" {
+		t.Fatalf("bad multi-turn review receipt: %+v", r)
+	}
+	if upstreamCalls != 2 {
+		t.Fatalf("upstreamCalls = %d, want 2", upstreamCalls)
+	}
+
+	// Simulate proxy restart (empty in-memory ledger): disk receipt must be restored and continue counting cleanly.
+	reviewMu.Lock()
+	delete(reviewLedger, root+"\x00"+launch)
+	reviewMu.Unlock()
+	if err := runTurn("gpt-6.2-sol", "/backend-api/codex/responses", "gpt-6.2-sol", true); err != nil {
+		t.Fatalf("post-restart continuation failed: %v", err)
+	}
+	if r = readReviewReceiptFile(t, root, launch); r.Requests != 3 || !r.Complete || r.Tainted {
+		t.Fatalf("bad post-restart review receipt: %+v", r)
+	}
+
+	// Switching model on a subsequent turn must abort BEFORE upstream and permanently taint the launch receipt.
+	if err := runTurn("gpt-6.2-astra", "/backend-api/codex/responses", "gpt-6.2-astra", false); err == nil {
+		t.Fatal("model switch under same review launch succeeded")
+	}
+	if upstreamCalls != 3 {
+		t.Fatalf("swapped model reached upstream: calls=%d, want 3", upstreamCalls)
+	}
+	r = readReviewReceiptFile(t, root, launch)
+	if !r.Tainted || r.Complete || len(r.Routes) != 1 || r.Routes[0] != "other" {
+		t.Fatalf("expected tainted receipt after model switch: %+v", r)
+	}
+
+	// Even after another simulated proxy restart, tainted launch on disk must never become clean again.
+	reviewMu.Lock()
+	delete(reviewLedger, root+"\x00"+launch)
+	reviewMu.Unlock()
+	if err := runTurn("gpt-6.2-sol", "/backend-api/codex/responses", "gpt-6.2-sol", false); err == nil {
+		t.Fatal("tainted launch resurrected after restart")
+	}
+	if r = readReviewReceiptFile(t, root, launch); !r.Tainted || r.Complete {
+		t.Fatalf("tainted state lost after restart: %+v", r)
+	}
+
+	// Wire body mismatch must abort BEFORE upstream and taint a fresh launch.
+	launch2 := "review-22222222-2222-4333-8444-555555555555"
+	ctx2, c2, err := BeginReview(context.Background(), root, launch2, session)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx2, e2, err := c2.Start(ctx2, "codex", "gpt-6.2-astra")
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := upstreamCalls
+	client2 := httptransport.Decorate(ctx2, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		upstreamCalls++
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+	})})
+	req2, _ := http.NewRequestWithContext(ctx2, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	if _, err := client2.Do(req2); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("wire mismatch err = %v, want ErrUnavailable", err)
+	}
+	e2.End()
+	c2.Complete(false)
+	c2.HandlerDone(false)
+	if upstreamCalls != before {
+		t.Fatalf("wire mismatch reached upstream")
+	}
+	if r2 := readReviewReceiptFile(t, root, launch2); !r2.Tainted || r2.Complete {
+		t.Fatalf("wire mismatch did not taint launch: %+v", r2)
+	}
+}
