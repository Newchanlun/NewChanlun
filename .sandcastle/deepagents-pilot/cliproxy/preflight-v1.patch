+
+func TestPreflightRoundTripperForReturnsSealedReusableTransport(t *testing.T) {
+	t.Parallel()
+
+	provider := newDefaultRoundTripperProvider()
+	rt1 := provider.PreflightRoundTripperFor(&coreauth.Auth{ProxyURL: "direct"})
+	rt2 := provider.PreflightRoundTripperFor(&coreauth.Auth{ProxyURL: "direct"})
+	if rt1 == nil || rt1 != rt2 {
