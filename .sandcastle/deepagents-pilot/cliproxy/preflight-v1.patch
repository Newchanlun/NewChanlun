+func TestReviewReceiptOutputHashRequiresExplicitOutputTextType(t *testing.T) {
+	// Astra P1 #3 (PR #2280 R3): content parts with missing, null, or empty type must NOT be
+	// included in last_output_sha256 on either response.completed or response.output_item.done.
+	root := filepath.Join(t.TempDir(), "receipts")
