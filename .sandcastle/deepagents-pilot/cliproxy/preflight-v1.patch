+
+			// Turn 1: clean upstream completion to EOF.
+			ctx1, c1, err := preflightreceipt.BeginReview(context.Background(), root, tc.launch, tc.session, "gpt-6.2-sol")
+			if err != nil {
+				t.Fatalf("turn 1 BeginReview: %v", err)
