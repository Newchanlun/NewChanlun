+func TestEnsureStagingDirEEXISTAndConcurrentBucketsNeverDeleteSharedStaging(t *testing.T) {
+	// Astra P2 #3 (PR #2280 R51): concurrent creation of shared .staging across preflight & review
+	// buckets must serialize under rootInitMu and an EEXIST caller MUST NEVER delete .staging on
+	// sync failure.
+	root := filepath.Join(t.TempDir(), "staging-concurrent")
+	if err := ensurePrivateRoot(root); err != nil {
+		t.Fatal(err)
+	}
+	lease, err := acquirePrivateRootLease(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lease.Close()
+
+	// Inject a failure on the first syncPinnedDir(root) call while racing two ensureStagingDir calls:
+	// the second caller MUST block on rootInitMu until the first finishes its rollback (or opens the
+	// already-synced .staging), and if .staging already existed on disk, a sync failure must not delete it.
+	origSync := syncDirFn
+	var syncCalls atomic.Int32
+	syncDirFn = func(dir string) error {
+		if filepath.Clean(dir) == filepath.Clean(root) {
+			if syncCalls.Add(1) == 1 {
+				return errors.New("injected first root sync fail")
+			}
+		}
+		if origSync != nil {
+			return origSync(dir)
+		}
+		return nil
+	}
+	defer func() { syncDirFn = origSync }()
+
+	errs := make(chan error, 2)
+	roots := make(chan *os.Root, 2)
+	var wg sync.WaitGroup
+	for range 2 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			sr, serr := ensureStagingDir(lease.dir, root)
+			errs <- serr
+			roots <- sr
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	close(roots)
+
+	succeeded := 0
+	for sr := range roots {
+		if sr != nil {
+			succeeded++
+			_ = sr.Close()
+		}
+	}
+	if succeeded != 1 {
+		t.Fatalf("expected exactly 1 caller to succeed after serialized rollback + retry, got %d", succeeded)
+	}
+	// Verify .staging still exists and is intact.
+	if fi, serr := os.Lstat(filepath.Join(root, ".staging")); serr != nil || !fi.IsDir() {
+		t.Fatalf(".staging missing after concurrent ensureStagingDir: fi=%v err=%v", fi, serr)
+	}
+}
