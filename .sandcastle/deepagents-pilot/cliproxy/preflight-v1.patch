+func TestCodexSSEScannerSingleLeadingBOMStrippedAndSecondPreserved(t *testing.T) {
+	// Sol P2 #1 (PR #2280 R51): WHATWG EventSource strips at most one leading UTF-8 BOM at
+	// stream offset 0 (even when split across chunks), preserves a second or mid-stream BOM
+	// so downstream strict framing rejects it, and never drops truncated invalid 0xEF at EOF.
+	t.Run("contiguous single BOM", func(t *testing.T) {
+		got := scanCodexSSE(t, "\xef\xbb\xbfevent: response.completed\ndata: {\"type\":\"response.completed\"}\n\n")
+		want := []string{"event: response.completed", `data: {"type":"response.completed"}`, ""}
+		if fmt.Sprintf("%q", got) != fmt.Sprintf("%q", want) {
+			t.Fatalf("lines = %q, want %q", got, want)
+		}
+	})
+
+	t.Run("chunk-split single BOM", func(t *testing.T) {
+		reader := &codexSSEChunkReader{chunks: []string{"\xef", "\xbb\xbfdata: {\"type\":\"response.completed\"}\n\n"}}
+		sc := NewCodexSSEScanner(context.Background(), reader, 64*1024)
+		var got []string
+		for sc.Scan() {
+			got = append(got, string(sc.Bytes()))
+		}
+		if err := sc.Err(); err != nil {
+			t.Fatalf("scan error: %v", err)
+		}
+		want := []string{`data: {"type":"response.completed"}`, ""}
+		if fmt.Sprintf("%q", got) != fmt.Sprintf("%q", want) {
+			t.Fatalf("lines = %q, want %q", got, want)
+		}
+	})
+
+	t.Run("BOM-only stream yields zero lines", func(t *testing.T) {
+		got := scanCodexSSE(t, "\xef\xbb\xbf")
+		if len(got) != 0 {
+			t.Fatalf("lines = %q, want empty", got)
+		}
+	})
+
+	t.Run("double leading BOM preserves second BOM", func(t *testing.T) {
+		got := scanCodexSSE(t, "\xef\xbb\xbf\xef\xbb\xbfdata: {\"a\":1}\n\n")
+		want := []string{"\xef\xbb\xbfdata: {\"a\":1}", ""}
+		if fmt.Sprintf("%q", got) != fmt.Sprintf("%q", want) {
+			t.Fatalf("lines = %q, want %q", got, want)
+		}
+	})
+
+	t.Run("mid-stream BOM on later line preserved", func(t *testing.T) {
+		got := scanCodexSSE(t, "data: {\"a\":1}\n\n\xef\xbb\xbfdata: {\"b\":2}\n\n")
+		want := []string{`data: {"a":1}`, "", "\xef\xbb\xbfdata: {\"b\":2}", ""}
+		if fmt.Sprintf("%q", got) != fmt.Sprintf("%q", want) {
+			t.Fatalf("lines = %q, want %q", got, want)
+		}
+	})
+
+	t.Run("truncated invalid 0xEF at EOF preserved", func(t *testing.T) {
+		got := scanCodexSSE(t, "\xef")
+		want := []string{"\xef"}
+		if fmt.Sprintf("%q", got) != fmt.Sprintf("%q", want) {
+			t.Fatalf("lines = %q, want %q", got, want)
+		}
+	})
+}
