+			sse2:           "data: " + `{"type":"response.created","response":{"id":"resp_fm_t3","status":"in_progress","model":"gpt-6.2-sol"}}` + "\n\n" + "data: " + `{"type":"response.failed","response":{"id":"resp_fm_t3","status":"failed","model":"gpt-6.2-sol","error":{"code":"server_error","message":"transient"}}}` + "\n\n",
