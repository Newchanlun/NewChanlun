+			}
+			rt1 := preflightCodexTestRT{tlsState: tlsState, bodyFn: func() io.ReadCloser {
+				return io.NopCloser(strings.NewReader(sse1))
+			}}
+			ctx1 = context.WithValue(ctx1, "cliproxy.roundtripper", http.RoundTripper(rt1))
+			stream1, err := exec.ExecuteStream(ctx1, auth, req, opts)
+			if err != nil {
+				t.Fatalf("turn 1 ExecuteStream: %v", err)
+			}
+			for chunk := range stream1.Chunks {
+				if chunk.Err != nil {
+					t.Fatalf("turn 1 chunk err: %v", chunk.Err)
+				}
+				c1.ObserveStreamChunk(chunk.Payload)
+			}
+			lease1.End()
+			c1.Complete(true)
+			c1.HandlerDone(true)
+
+			// Turn 2: emits response.completed then encounters scan/close error before clean EOF.
+			ctx2, c2, err := preflightreceipt.BeginReview(context.Background(), root, tc.launch, tc.session, "gpt-6.2-sol")
+			if err != nil {
+				t.Fatalf("turn 2 BeginReview: %v", err)
+			}
+			ctx2, lease2, err := c2.Start(ctx2, "codex", "gpt-6.2-sol")
+			if err != nil {
+				t.Fatalf("turn 2 Start: %v", err)
+			}
+			rt2 := preflightCodexTestRT{tlsState: tlsState, bodyFn: func() io.ReadCloser {
+				return &preflightCodexErrReader{data: sse2, readErr: tc.readErr, closeErr: tc.closeErr}
+			}}
+			ctx2 = context.WithValue(ctx2, "cliproxy.roundtripper", http.RoundTripper(rt2))
+			stream2, err := exec.ExecuteStream(ctx2, auth, req, opts)
+			if err != nil {
