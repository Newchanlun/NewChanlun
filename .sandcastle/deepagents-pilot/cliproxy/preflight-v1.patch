+	sseMixedValid := "data: " + `{"type":"response.completed","response":{"id":"resp_mixed_ok","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"refusal","refusal":"ignored"},{"type":"output_text","text":"real-verdict"}]}]}}` + "\n\n"
