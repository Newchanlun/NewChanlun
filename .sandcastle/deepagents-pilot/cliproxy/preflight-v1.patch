+package middleware
+
+import (
+	"context"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/preflightreceipt"
+)
+
+func PreflightReceipt() gin.HandlerFunc {
+	root := os.Getenv("CLIPROXY_PREFLIGHT_RECEIPTS")
+	return func(c *gin.Context) {
+		session := c.GetHeader("Session-Id")
+		if root == "" || !strings.HasPrefix(session, "preflight-") {
+			c.Next()
+			return
+		}
+		if c.Request.Method != http.MethodPost || c.Request.URL.Path != "/v1/responses" || c.GetHeader("Upgrade") != "" {
+			c.AbortWithStatus(http.StatusBadRequest)
+			return
+		}
+		ctx, collector, err := preflightreceipt.Begin(c.Request.Context(), root, session)
+		if err != nil {
+			c.AbortWithStatus(http.StatusServiceUnavailable)
+			return
+		}
+		ctx, cancel := context.WithDeadline(ctx, time.Now().Add(preflightreceipt.Lifetime))
+		defer cancel()
+		c.Request = c.Request.WithContext(ctx)
+		finished := false
+		defer func() { collector.HandlerDone(finished && c.Writer.Status() == http.StatusOK) }()
+		c.Next()
+		finished = true
+	}
+}
