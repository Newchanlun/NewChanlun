+	}
+
+	// 80. Astra P1 #2 (PR #2280 R32): output_text content part missing "text" or with "text": null
+	//     MUST taint even when another valid output_text part exists in the same final message.
+	sseMissingPartText := "data: " + `{"type":"response.completed","response":{"id":"resp_mpt","status":"completed","model":"gpt-6.2-sol","output":[{"id":"msg_mpt","type":"message","role":"assistant","status":"completed","content":[{"type":"output_text"},{"type":"output_text","text":"VERDICT: PASS"}]}]}}` + "\n\n"
+	if st := runSSE(t, "review-d1111111-2222-4333-8444-5555555555bc", "019d0000-0000-7000-8000-8888888881bc", sseMissingPartText); st != SealRejected {
