+		"data: " + `{"type":"response.output_item.done","item":{"type":"message","role":"assistant","content":[{"text":"missing"},{"type":"","text":"emptytype"}]}}` + "\n\n" +
+		"data: " + `{"type":"response.completed","response":{"id":"resp_notype2","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n"
+	r2 := runSSE(t, "review-b7777777-2222-4333-8444-555555555502", "019d0000-0000-7000-8000-666666666702", sseItemNoType)
