+	if err != nil {
+		return fail(false, err)
+	}
+	stagingRoot, err := ensureStagingDir(rootHandle, root)
+	if err != nil {
+		return fail(false, err)
+	}
+	defer stagingRoot.Close()
+	stagingDirFD, _, _, _, err := openPinnedDirFD(stagingRoot)
+	if err != nil {
+		return fail(false, ErrUnavailable)
+	}
+	defer stagingDirFD.Close()
+	launchDirFD, lFDDev, lFDIno, hasLFDID, err := openPinnedDirFD(launchRoot)
+	if err != nil {
+		return fail(false, ErrUnavailable)
