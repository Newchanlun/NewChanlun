+func (t *strictStreamTracker) recordInitialText(canonKey string, contentIdx int64, initText string) bool {
+	if canonKey != "" {
+		if parts := t.contentPartByItem[canonKey]; parts != nil {
+			if prevTag, exists := parts[contentIdx]; exists && strings.HasPrefix(prevTag, "text:") {
+				return false
+			}
+		}
+	}
+	if !t.recordPendingTextPart(canonKey, contentIdx) {
+		return false
+	}
+	if canonKey == "" {
+		return true
+	}
+	if initText == "" {
+		if prefixes := t.textPrefixByItem[canonKey]; prefixes != nil {
+			if pref, exists := prefixes[contentIdx]; exists && pref.byteLen > 0 {
+				return false
+			}
+		}
+		if hashes := t.textDeltaHashByItem[canonKey]; hashes != nil {
+			if st := hashes[contentIdx]; st != nil && hex.EncodeToString(st.h.Sum(nil)) != sha256Hex("") {
+				return false
+			}
+		}
+		return true
+	}
+	if !t.recordTextPrefix(canonKey, contentIdx, initText) {
+		return false
+	}
+	hashes := t.textDeltaHashByItem[canonKey]
+	if hashes == nil {
+		if len(t.textDeltaHashByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.textDeltaHashByItem == nil {
+			t.textDeltaHashByItem = make(map[string]map[int64]*textDeltaState)
+		}
+		hashes = make(map[int64]*textDeltaState)
+		t.textDeltaHashByItem[canonKey] = hashes
+	}
+	initSHA := sha256Hex(initText)
+	if st := hashes[contentIdx]; st != nil {
+		if !st.hasDelta && st.hasSeed {
+			return st.seedSHA == initSHA
+		}
+		return hex.EncodeToString(st.h.Sum(nil)) == initSHA
+	}
+	if len(hashes) >= maxTrackedContentParts {
+		return false
+	}
+	h := sha256.New()
+	_, _ = h.Write([]byte(initText))
+	hashes[contentIdx] = &textDeltaState{h: h, hasSeed: true, seedSHA: initSHA}
+	return true
+}
