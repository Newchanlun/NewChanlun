@@ -0,0 +1,256 @@
+// Package preflightreceipt produces bounded, body-independent admission evidence.
+// It is enabled only for explicit preflight sessions, never for ordinary traffic.
+package preflightreceipt
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+)
+
+const Schema = "cliproxy-preflight-v1"
+const MaxAttempts = 64
+const Lifetime = 50 * time.Second
+
+var ErrUnavailable = errors.New("preflight evidence unavailable")
+var sessionPattern = regexp.MustCompile(`^preflight-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+
+type contextKey struct{}
+
+type Receipt struct {
+	Schema   string   `json:"schema"`
+	Session  string   `json:"session"`
+	Started  int64    `json:"started_ns"`
+	Finished int64    `json:"finished_ns"`
+	Complete bool     `json:"complete"`
+	Routes   []string `json:"routes"`
+}
+
+type Collector struct {
+	mu                                          sync.Mutex
+	receipt                                     Receipt
+	directory                                   string
+	deadline                                    time.Time
+	invalid, sealed, handlerDone, lifecycleDone bool
+	reserved                                    bool
+	executions, active, bodies                  int
+}
+
+type Execution struct {
+	c        *Collector
+	provider string
+	ended    bool
+	attempts int
+}
+
+func From(ctx context.Context) *Collector {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(contextKey{}).(*Collector)
+	return c
+}
+
+func Inherit(ctx, source context.Context) context.Context {
+	if c := From(source); c != nil {
+		return context.WithValue(ctx, contextKey{}, c)
+	}
+	return ctx
+}
+
+// Begin binds the inbound nonce. Disk reservation waits for authenticated execution.
+// The directory must be private to the proxy, outside the credential/state volume.
+func Begin(ctx context.Context, root, session string) (context.Context, *Collector, error) {
+	if !sessionPattern.MatchString(session) || !filepath.IsAbs(root) {
+		return ctx, nil, ErrUnavailable
+	}
+	directory := filepath.Join(root, session)
+	now := time.Now()
+	c := &Collector{directory: directory, deadline: now.Add(Lifetime), receipt: Receipt{Schema: Schema, Session: session, Started: now.UnixNano()}}
+	return context.WithValue(ctx, contextKey{}, c), c, nil
+}
+
+func (c *Collector) Reject() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.invalid = true
+}
+
+func (c *Collector) HandlerDone(success bool) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.handlerDone = true
+	if !success {
+		c.invalid = true
+	}
+	c.publishLocked()
+}
+
+func (c *Collector) Complete(success bool) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	// Multiple lifecycle owners under one inbound request are not covered.
+	if c.lifecycleDone || !success {
+		c.invalid = true
+	}
+	c.lifecycleDone = true
+	c.publishLocked()
+}
+
+// Start is called by the auth execution guard, not by an asynchronous usage sink.
+func (c *Collector) Start(ctx context.Context, provider string) (context.Context, *Execution, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.invalid || c.sealed || c.handlerDone || c.lifecycleDone || time.Now().After(c.deadline) {
+		c.invalid = true
+		return ctx, nil, ErrUnavailable
+	}
+	if !c.reserved {
+		root := filepath.Dir(c.directory)
+		if err := os.MkdirAll(root, 0700); err != nil {
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		info, err := os.Lstat(root)
+		if err != nil || !info.IsDir() || info.Mode().Perm()&0077 != 0 {
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if err = os.Mkdir(c.directory, 0700); err != nil {
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		c.reserved = true
+	}
+	c.active++
+	c.executions++
+	e := &Execution{c: c, provider: provider}
+	ctx = httptransport.WithDecorator(ctx, func(next http.RoundTripper) http.RoundTripper { return &transport{next: next, execution: e} })
+	return ctx, e, nil
+}
+
+func (e *Execution) End() {
+	c := e.c
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if e.ended {
+		c.invalid = true
+		return
+	}
+	e.ended = true
+	c.active--
+	if e.attempts == 0 {
+		c.invalid = true
+	}
+	c.publishLocked()
+}
+
+// Only enums enter the collector. URL paths, bodies and auth identifiers never do.
+func route(provider string, req *http.Request) string {
+	if req.URL == nil || req.URL.Scheme != "https" || req.URL.User != nil || (req.URL.Port() != "" && req.URL.Port() != "443") {
+		return "other"
+	}
+	host := strings.ToLower(req.URL.Hostname())
+	if req.Host != "" && !strings.EqualFold(req.Host, req.URL.Host) {
+		return "other"
+	}
+	value := provider + "@" + host
+	switch value {
+	case "kimi@api.kimi.com", "kimi-ai@api.kimi.ai", "claude@api.anthropic.com", "antigravity@daily-cloudcode-pa.googleapis.com":
+		return value
+	default:
+		return "other"
+	}
+}
+
+type transport struct {
+	next      http.RoundTripper
+	execution *Execution
+}
+
+func (t *transport) RoundTrip(req *http.Request) (*http.Response, error) {
+	e, c := t.execution, t.execution.c
+	c.mu.Lock()
+	if c.invalid || c.sealed || e.ended || time.Now().After(c.deadline) || len(c.receipt.Routes) >= MaxAttempts {
+		c.invalid = true
+		c.mu.Unlock()
+		return nil, ErrUnavailable
+	}
+	e.attempts++
+	c.bodies++
+	c.receipt.Routes = append(c.receipt.Routes, route(e.provider, req))
+	c.mu.Unlock()
+	resp, err := t.next.RoundTrip(req)
+	finish := func() { c.mu.Lock(); defer c.mu.Unlock(); c.bodies--; c.publishLocked() }
+	if err != nil || resp == nil || resp.Body == nil {
+		finish()
+	} else {
+		resp.Body = &body{ReadCloser: resp.Body, finish: finish, reject: c.Reject}
+	}
+	return resp, err
+}
+
+type body struct {
+	io.ReadCloser
+	once   sync.Once
+	finish func()
+	reject func()
+}
+
+func (b *body) Close() error {
+	err := b.ReadCloser.Close()
+	if err != nil {
+		b.reject()
+	}
+	b.once.Do(b.finish)
+	return err
+}
+
+func (c *Collector) publishLocked() {
+	if c.invalid || c.sealed || !c.handlerDone || !c.lifecycleDone || c.active != 0 || c.bodies != 0 || c.executions == 0 || len(c.receipt.Routes) == 0 {
+		return
+	}
+	if time.Now().After(c.deadline) {
+		c.invalid = true
+		return
+	}
+	c.sealed = true
+	c.receipt.Complete = true
+	c.receipt.Finished = time.Now().UnixNano()
+	data, err := json.Marshal(c.receipt)
+	if err != nil {
+		return
+	}
+	// Same-directory exclusive temporary file and rename: readers see all or nothing.
+	tmp := filepath.Join(c.directory, "pending")
+	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return
+	}
+	_, errWrite := f.Write(data)
+	errSync := f.Sync()
+	errClose := f.Close()
+	if errWrite != nil || errSync != nil || errClose != nil {
+		return
+	}
+	_ = os.Rename(tmp, filepath.Join(c.directory, "receipt.json"))
+}
