+func TestReviewReceiptDiskQuotaIsolatesPreflightAndReclaimsExpired(t *testing.T) {
+	// Sol P2 #2 (PR #2280 R32):
+	// 1. Legacy preflight-* directories MUST NOT consume the formal review-* disk quota.
+	// 2. Expired preflight-* and expired review-* directories MUST be reclaimed boundedly when a bucket is full.
+	oldReviewCap := maxReviewDiskEntries
+	oldPreflightCap := maxPreflightDiskEntries
+	oldPreflightRet := preflightDiskRetention
+	oldReviewRet := reviewDiskRetention
+	maxReviewDiskEntries = 1
+	maxPreflightDiskEntries = 2
+	preflightDiskRetention = 30 * time.Minute
+	reviewDiskRetention = 24 * time.Hour
+	defer func() {
+		maxReviewDiskEntries = oldReviewCap
+		maxPreflightDiskEntries = oldPreflightCap
+		preflightDiskRetention = oldPreflightRet
+		reviewDiskRetention = oldReviewRet
+	}()
+
+	root := filepath.Join(t.TempDir(), "isolated-quota-receipts")
+	if err := ensurePrivateRoot(root); err != nil {
+		t.Fatal(err)
+	}
+
+	// Fill preflight bucket (2/2).
+	p1 := filepath.Join(root, "preflight-11111111-2222-4333-8444-555555555501")
+	p2 := filepath.Join(root, "preflight-11111111-2222-4333-8444-555555555502")
+	if err := reservePrivateDir(p1, false); err != nil {
+		t.Fatalf("reserve p1: %v", err)
+	}
+	if err := reservePrivateDir(p2, false); err != nil {
+		t.Fatalf("reserve p2: %v", err)
+	}
+	// Formal review launch MUST still succeed despite preflight bucket being full.
+	r1Launch := "review-e7777777-2222-4333-8444-555555555501"
+	res1, err := ReserveReview(root, r1Launch)
+	if err != nil {
+		t.Fatalf("ReserveReview blocked by full preflight bucket: %v", err)
+	}
+	res1.Release()
+
+	// Fresh 3rd preflight fails while p1 & p2 are recent.
+	p3 := filepath.Join(root, "preflight-11111111-2222-4333-8444-555555555503")
+	if err := reservePrivateDir(p3, false); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("reserve p3 with recent preflights = %v, want ErrUnavailable", err)
+	}
+	// Age p1 (with verified producer receipt.json) past preflightDiskRetention -> p3 MUST reclaim p1 and succeed.
+	oldTime := time.Now().Add(-2 * time.Hour)
+	p1RecPath := filepath.Join(p1, "receipt.json")
+	p1Data, err := json.Marshal(Receipt{
+		Schema:   Schema,
+		Session:  "preflight-11111111-2222-4333-8444-555555555501",
+		Started:  oldTime.UnixNano(),
+		Finished: oldTime.UnixNano(),
+		Complete: true,
+		Routes:   []string{"codex:gpt-6.2-sol@chatgpt.com"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p1RecPath, p1Data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(p1RecPath, oldTime, oldTime); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(p1, oldTime, oldTime); err != nil {
+		t.Fatal(err)
+	}
+	if err := reservePrivateDir(p3, false); err != nil {
+		t.Fatalf("reserve p3 after p1 expired: %v", err)
+	}
+	if _, statErr := os.Stat(p1); !os.IsNotExist(statErr) {
+		t.Fatalf("expired p1 was not reclaimed: %v", statErr)
+	}
+
+	// Age r1 past reviewDiskRetention (both dir, receipt.json, and ledger touched) -> r2 MUST reclaim r1 and succeed.
+	r1Dir := filepath.Join(root, r1Launch)
+	r1RecPath := filepath.Join(r1Dir, "receipt.json")
+	ancient := time.Now().Add(-48 * time.Hour)
+	if raw, err := os.ReadFile(r1RecPath); err == nil {
+		var rec ReviewReceipt
+		if json.Unmarshal(raw, &rec) == nil {
+			rec.Started = ancient.UnixNano()
+			rec.Finished = ancient.UnixNano()
+			if data, merr := json.Marshal(rec); merr == nil {
+				_ = os.WriteFile(r1RecPath, data, 0600)
+			}
+		}
+	}
+	_ = os.Chtimes(r1RecPath, ancient, ancient)
+	_ = os.Chtimes(r1Dir, ancient, ancient)
+	key1 := filepath.Clean(root) + "\x00" + r1Launch
+	reviewMu.Lock()
+	if ent := reviewLedger[key1]; ent != nil {
+		ent.touched = ancient
+	}
+	reviewMu.Unlock()
+
+	r2Launch := "review-e7777777-2222-4333-8444-555555555502"
+	res2, err := ReserveReview(root, r2Launch)
+	if err != nil {
+		t.Fatalf("ReserveReview r2 after r1 expired past 24h: %v", err)
+	}
+	res2.Release()
+	if _, statErr := os.Stat(r1Dir); !os.IsNotExist(statErr) {
+		t.Fatalf("expired r1 was not reclaimed: %v", statErr)
+	}
+
+	// Sol P1 #1 + Astra P1 #1 (PR #2280 R33): reclamation MUST NEVER delete unrelated directories or
+	// receipt-named directories containing unknown files or foreign receipt.json schemas.
+	maxPreflightDiskEntries = 2
+	foreignDir := filepath.Join(root, "unrelated-private-dir")
+	if err := os.Mkdir(foreignDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	foreignFile := filepath.Join(foreignDir, "user-note.txt")
+	if err := os.WriteFile(foreignFile, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	_ = os.Chtimes(foreignFile, ancient, ancient)
+	_ = os.Chtimes(foreignDir, ancient, ancient)
+
+	dirtyPreflight := filepath.Join(root, "preflight-11111111-2222-4333-8444-555555555509")
+	if err := os.Mkdir(dirtyPreflight, 0700); err != nil {
+		t.Fatal(err)
+	}
+	dirtyExtra := filepath.Join(dirtyPreflight, "extra.txt")
+	if err := os.WriteFile(dirtyExtra, []byte("keep-extra"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	_ = os.Chtimes(dirtyExtra, ancient, ancient)
+	_ = os.Chtimes(dirtyPreflight, ancient, ancient)
+
+	// Remove p2 and p3 so only foreignDir and dirtyPreflight occupy the 2-entry preflight cap.
+	_ = os.Remove(p2)
+	_ = os.Remove(p3)
+	p4 := filepath.Join(root, "preflight-11111111-2222-4333-8444-555555555504")
+	if err := reservePrivateDir(p4, false); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("reserve p4 when bucket holds only unrelated/dirty dirs = %v, want ErrUnavailable", err)
+	}
+	if _, err := os.Stat(foreignFile); err != nil {
+		t.Fatalf("reclaimer deleted unrelated directory/file: %v", err)
+	}
+	if _, err := os.Stat(dirtyExtra); err != nil {
+		t.Fatalf("reclaimer deleted receipt-named directory containing unknown file: %v", err)
+	}
+
+	// Sol P1 #1 + Astra P1 #2 (PR #2280 R34):
+	// 1. A review-UUID dir containing ONLY an invalid seal.sha256 (no verified receipt.json) MUST NOT be deleted.
+	// 2. A review-UUID dir with a foreign receipt.json MUST fail closed WITHOUT overwriting or deleting the foreign file.
+	r2Dir := filepath.Join(root, r2Launch)
+	_ = os.Remove(filepath.Join(r2Dir, "receipt.json"))
+	_ = os.Remove(r2Dir)
+	reviewMu.Lock()
+	delete(reviewLedger, filepath.Clean(root)+"\x00"+r2Launch)
+	reviewMu.Unlock()
+
+	sealOnlyLaunch := "review-e7777777-2222-4333-8444-555555555598"
+	sealOnlyDir := filepath.Join(root, sealOnlyLaunch)
+	if err := os.Mkdir(sealOnlyDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	sealOnlyFile := filepath.Join(sealOnlyDir, "seal.sha256")
+	if err := os.WriteFile(sealOnlyFile, []byte("not-a-producer-seal"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	_ = os.Chtimes(sealOnlyFile, ancient, ancient)
+	_ = os.Chtimes(sealOnlyDir, ancient, ancient)
+	maxReviewDiskEntries = 1
+	if _, err := ReserveReview(root, "review-e7777777-2222-4333-8444-555555555599"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("ReserveReview over seal-only foreign dir = %v, want ErrUnavailable", err)
+	}
+	if raw, err := os.ReadFile(sealOnlyFile); err != nil || string(raw) != "not-a-producer-seal" {
+		t.Fatalf("reclaimer modified/deleted seal-only dir without receipt.json: raw=%q err=%v", string(raw), err)
+	}
+
+	foreignLaunch := "review-e7777777-2222-4333-8444-555555555597"
+	foreignReviewDir := filepath.Join(root, foreignLaunch)
+	if err := os.Mkdir(foreignReviewDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	foreignRecPath := filepath.Join(foreignReviewDir, "receipt.json")
+	foreignBytes := `{"schema":"other-app-v1","important":"keep-untouched"}`
+	if err := os.WriteFile(foreignRecPath, []byte(foreignBytes), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ReserveReview(root, foreignLaunch); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("ReserveReview on foreign receipt.json = %v, want ErrUnavailable", err)
+	}
+	if raw, err := os.ReadFile(foreignRecPath); err != nil || string(raw) != foreignBytes {
+		t.Fatalf("foreign receipt.json was overwritten/deleted: raw=%q err=%v", string(raw), err)
+	}
+}
