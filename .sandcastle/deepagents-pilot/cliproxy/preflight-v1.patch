+package auth
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"errors"
+	"fmt"
+	"io"
+	"math/big"
+	"net/http"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/preflightreceipt"
+)
+
+func testVerifiedTLS(t *testing.T, host string) *tls.ConnectionState {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: host},
+		DNSNames:     []string{host},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &tls.ConnectionState{
+		HandshakeComplete: true,
+		ServerName:        host,
+		VerifiedChains:    [][]*x509.Certificate{{leaf}},
+	}
+}
+
+type streamTestRT struct {
+	tlsState *tls.ConnectionState
+}
+
+func (rt streamTestRT) RoundTrip(req *http.Request) (*http.Response, error) {
+	return &http.Response{
+		StatusCode: http.StatusServiceUnavailable,
+		Header:     make(http.Header),
+		Body:       io.NopCloser(strings.NewReader("")),
+		TLS:        rt.tlsState,
+	}, nil
+}
+
+func TestPreflightReceiptStreamEndsLeaseBeforeEOF(t *testing.T) {
+	// Verify wrapPreflightStream releases the execution lease BEFORE closing out on normal EOF,
+	// so an immediate serial retry on the same strict Codex Collector never fails with active > 0.
+	root := filepath.Join(t.TempDir(), "receipts")
+	tlsState := testVerifiedTLS(t, "chatgpt.com")
+	for i := 0; i < 60; i++ {
+		launch := fmt.Sprintf("review-88881111-2222-4333-8444-%012d", i)
+		session := fmt.Sprintf("019d0000-0000-7000-8000-%012d", i)
+		ctx, c, err := preflightreceipt.BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		execCtx1, lease1, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		// Perform one TLS-verified attempt so lease1.End() keeps the Collector valid for serial retry.
+		cl := httptransport.Decorate(execCtx1, &http.Client{Transport: streamTestRT{tlsState: tlsState}})
+		req, _ := http.NewRequestWithContext(execCtx1, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses",
+			strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		resp, err := cl.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+
+		// Upstream closes stream immediately without emitting any chunks.
+		orig := make(chan executor.StreamChunk)
+		close(orig)
+		out := wrapPreflightStream(execCtx1, lease1, orig)
+		for range out {
+		}
+		// Immediately upon observing EOF on out, a serial retry on the same Collector MUST succeed.
+		_, lease2, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatalf("iteration %d: serial retry immediately after stream EOF failed (lease still active?): %v", i, err)
+		}
+		lease2.End()
+		c.Complete(false)
+		c.HandlerDone(false)
+	}
+}
+
+func waitSealReview(t *testing.T, root, launch, session string) preflightreceipt.SealStatus {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		st := preflightreceipt.SealReview(root, launch, session)
+		if st != preflightreceipt.SealInFlight || time.Now().After(deadline) {
+			return st
+		}
+		time.Sleep(2 * time.Millisecond)
+	}
+}
+
+func TestPreflightReceiptStrictCodexStreamCancelRejectsDespiteCleanStreamDelivery(t *testing.T) {
+	// Formal review launches (StrictCodex) must observe upstream EOF; if ctx is canceled before
+	// original closes, wrapPreflightStream MUST reject the collector even when WaitStreamDelivery
+	// reports deliveryErr == nil (which only applies to non-strict preflight streams).
+	root := filepath.Join(t.TempDir(), "receipts")
+	tlsState := testVerifiedTLS(t, "chatgpt.com")
+	launch := "review-88881111-2222-4333-8444-999999999901"
+	session := "019d0000-0000-7000-8000-999999999901"
+
+	deliveryCtx, finishDelivery := coreusage.WithStreamDelivery(context.Background())
+	reqCtx, cancel := context.WithCancel(deliveryCtx)
+	defer cancel()
+
+	ctx, c, err := preflightreceipt.BeginReview(reqCtx, root, launch, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	execCtx, lease, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl := httptransport.Decorate(execCtx, &http.Client{Transport: streamTestRT{tlsState: tlsState}})
+	req, _ := http.NewRequestWithContext(execCtx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses",
+		strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	resp, err := cl.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	orig := make(chan executor.StreamChunk, 1)
+	orig <- executor.StreamChunk{
+		Payload: []byte(`data: {"type":"response.completed","response":{"id":"resp_early_cancel","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"pass"}]}]}}` + "\n\n"),
+	}
+	out := wrapPreflightStream(execCtx, lease, orig)
+	if _, ok := <-out; !ok {
+		t.Fatalf("expected first chunk before cancel")
+	}
+	// Acknowledge clean downstream delivery and cancel ctx BEFORE upstream closes orig.
+	finishDelivery(nil)
+	cancel()
+	close(orig)
+	for range out {
+	}
+	_ = resp.Body.Close()
+	c.Complete(true)
+	c.HandlerDone(true)
+
+	// Because the stream was canceled before upstream EOF, Collector must have been rejected
+	// and never recorded a sealable request.
+	if st := waitSealReview(t, root, launch, session); st != preflightreceipt.SealRejected {
+		t.Fatalf("SealReview after early stream cancel = %v, want SealRejected", st)
+	}
+}
+
+func TestPreflightReceiptStrictCodexCancelHoldsLeaseUntilProducerTaints(t *testing.T) {
+	// Sol P1 #1 & Astra P1 #1 (PR #2280 R3): when ctx cancels on Turn 2 after upstream resp.Body
+	// already closed but before the producer delivers its buffered terminal chunk, wrapPreflightStream
+	// MUST hold lease.End() until the producer finishes Taint() and closes original, so concurrent
+	// SealReview can NEVER observe inFlight == 0 and seal Turn 1 ahead of producer taint.
+	root := filepath.Join(t.TempDir(), "receipts")
+	tlsState := testVerifiedTLS(t, "chatgpt.com")
+	launch := "review-88881111-2222-4333-8444-999999999921"
+	session := "019d0000-0000-7000-8000-999999999921"
+	sse1 := `data: {"type":"response.completed","response":{"id":"resp_t1_race","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"step1"}]}]}}` + "\n\n"
+
+	// Turn 1: clean completion.
+	ctx1, c1, err := preflightreceipt.BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	execCtx1, lease1, err := c1.Start(ctx1, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl1 := httptransport.Decorate(execCtx1, &http.Client{Transport: status200StreamTestRT{tlsState: tlsState, body: sse1}})
+	req1, _ := http.NewRequestWithContext(execCtx1, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses",
+		strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	resp1, err := cl1.Do(req1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw1, err := io.ReadAll(resp1.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := resp1.Body.Close(); err != nil {
+		t.Fatal(err)
+	}
+	c1.ObserveStreamChunk(raw1)
+	lease1.End()
+	c1.Complete(true)
+	c1.HandlerDone(true)
+
+	// Turn 2: upstream body reaches EOF and closes (c2.bodies == 0), then producer goroutine blocks
+	// trying to send buffered terminal while ctx cancels, and takes 40ms to finish Taint() + close(orig).
+	reqCtx2, cancel2 := context.WithCancel(context.Background())
+	defer cancel2()
+	ctx2, c2, err := preflightreceipt.BeginReview(reqCtx2, root, launch, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	execCtx2, lease2, err := c2.Start(ctx2, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl2 := httptransport.Decorate(execCtx2, &http.Client{Transport: status200StreamTestRT{tlsState: tlsState, body: sse1}})
+	req2, _ := http.NewRequestWithContext(execCtx2, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses",
+		strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	resp2, err := cl2.Do(req2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.ReadAll(resp2.Body); err != nil {
+		t.Fatal(err)
+	}
+	if err := resp2.Body.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	orig := make(chan executor.StreamChunk)
+	producerDone := make(chan struct{})
+	go func() {
+		defer close(producerDone)
+		defer close(orig)
+		<-execCtx2.Done()
+		time.Sleep(40 * time.Millisecond)
+		c2.Taint()
+	}()
+
+	out := wrapPreflightStream(execCtx2, lease2, orig)
+	cancel2()
+	for range out {
+	}
+	c2.Complete(false)
+	c2.HandlerDone(false)
+
+	// Immediately race SealReview while producer goroutine has NOT yet run c2.Taint()!
+	sawInFlight := false
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		st := preflightreceipt.SealReview(root, launch, session)
+		if st == preflightreceipt.SealOK {
+			t.Fatalf("SealReview raced ahead of producer Taint() and sealed Turn 1!")
+		}
+		if st == preflightreceipt.SealInFlight {
+			sawInFlight = true
+			if time.Now().After(deadline) {
+				t.Fatalf("SealReview stuck in SealInFlight after producer exit")
+			}
+			time.Sleep(2 * time.Millisecond)
+			continue
+		}
+		if st != preflightreceipt.SealRejected {
+			t.Fatalf("SealReview = %v, want SealRejected", st)
+		}
+		break
+	}
+	<-producerDone
+	if !sawInFlight {
+		t.Fatalf("expected concurrent SealReview to observe SealInFlight while producer Taint() was pending")
+	}
+}
+
+type status200StreamTestRT struct {
+	tlsState *tls.ConnectionState
+	body     string
+}
+
+func (rt status200StreamTestRT) RoundTrip(req *http.Request) (*http.Response, error) {
+	return &http.Response{
+		StatusCode: http.StatusOK,
+		Header:     make(http.Header),
+		Body:       io.NopCloser(strings.NewReader(rt.body)),
+		TLS:        rt.tlsState,
+	}, nil
+}
+
+func TestPreflightReceiptStrictCodexPostEOFClientCancelPreservesReceipt(t *testing.T) {
+	// Sol P1 + Astra P1 (R22): OpenAIResponsesAPIHandler cancels the execution context with
+	// finishDelivery(nil) immediately upon receiving response.completed (ChunkDone). When
+	// CodexExecutor has already drained and closed the upstream HTTP body at true io.EOF
+	// (UpstreamEOF() == true) before emitting response.completed, that post-EOF cancel MUST
+	// preserve the receipt. Conversely, a failed deliveryError or a trailing error chunk on
+	// original MUST still reject/taint.
+	root := filepath.Join(t.TempDir(), "receipts")
+	tlsState := testVerifiedTLS(t, "chatgpt.com")
+	sse := `data: {"type":"response.completed","response":{"id":"resp_post_eof","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"pass"}]}]}}` + "\n\n"
+
+	runCase := func(t *testing.T, launch, session string, deliveryErr error, trailingChunk string, trailingErr error, closeOrigBeforeCancel bool) preflightreceipt.SealStatus {
+		t.Helper()
+		deliveryCtx, finishDelivery := coreusage.WithStreamDelivery(context.Background())
+		reqCtx, cancel := context.WithCancel(deliveryCtx)
+		defer cancel()
+
+		ctx, c, err := preflightreceipt.BeginReview(reqCtx, root, launch, session, "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		execCtx, lease, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		cl := httptransport.Decorate(execCtx, &http.Client{Transport: status200StreamTestRT{tlsState: tlsState, body: sse}})
+		req, _ := http.NewRequestWithContext(execCtx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses",
+			strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		resp, err := cl.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		// Simulate CodexExecutor draining upstream to true io.EOF and closing resp.Body BEFORE emitting response.completed.
+		if _, err := io.ReadAll(resp.Body); err != nil {
+			t.Fatal(err)
+		}
+		if err := resp.Body.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if !c.UpstreamEOF() {
+			t.Fatalf("expected UpstreamEOF() == true after clean EOF body close")
+		}
+
+		orig := make(chan executor.StreamChunk, 2)
+		orig <- executor.StreamChunk{Payload: []byte(sse)}
+		if trailingErr != nil {
+			orig <- executor.StreamChunk{Err: trailingErr}
+		} else if trailingChunk != "" {
+			orig <- executor.StreamChunk{Payload: []byte(trailingChunk)}
+		}
+		if closeOrigBeforeCancel {
+			close(orig)
+		}
+		out := wrapPreflightStream(execCtx, lease, orig)
+		if _, ok := <-out; !ok {
+			t.Fatalf("expected response.completed chunk")
+		}
+		// Simulate ChunkDone() cancelling cliCtx immediately upon receiving response.completed.
+		finishDelivery(deliveryErr)
+		cancel()
+		if !closeOrigBeforeCancel {
+			close(orig)
+		}
+		for range out {
+		}
+		c.Complete(deliveryErr == nil)
+		c.HandlerDone(true)
+		return waitSealReview(t, root, launch, session)
+	}
+
+	// 1. Clean ChunkDone() cancel while orig closes right after -> MUST seal cleanly.
+	if st := runCase(t, "review-88881111-2222-4333-8444-999999999911", "019d0000-0000-7000-8000-999999999911", nil, "", nil, false); st != preflightreceipt.SealOK {
+		t.Fatalf("post-EOF ChunkDone cancel (orig closes after cancel) = %v, want SealOK", st)
+	}
+	// 2. Clean ChunkDone() cancel when orig already closed -> MUST seal cleanly.
+	if st := runCase(t, "review-88881111-2222-4333-8444-999999999912", "019d0000-0000-7000-8000-999999999912", nil, "", nil, true); st != preflightreceipt.SealOK {
+		t.Fatalf("post-EOF ChunkDone cancel (orig already closed) = %v, want SealOK", st)
+	}
+	// 3. Downstream write/cancel failure (deliveryErr != nil) -> MUST reject.
+	if st := runCase(t, "review-88881111-2222-4333-8444-999999999913", "019d0000-0000-7000-8000-999999999913", context.Canceled, "", nil, false); st != preflightreceipt.SealRejected {
+		t.Fatalf("post-EOF failed delivery cancel = %v, want SealRejected", st)
+	}
+	// 4. Trailing error frame queued on original -> drain observes and taints -> MUST reject.
+	if st := runCase(t, "review-88881111-2222-4333-8444-999999999914", "019d0000-0000-7000-8000-999999999914", nil, `data: {"type":"error"}`+"\n\n", nil, false); st != preflightreceipt.SealRejected {
+		t.Fatalf("post-EOF trailing error chunk = %v, want SealRejected", st)
+	}
+	// 5. Astra P1 #2 (PR #2280 R15): trailing StreamChunk.Err queued on original -> drain MUST taint & reject.
+	if st := runCase(t, "review-88881111-2222-4333-8444-999999999915", "019d0000-0000-7000-8000-999999999915", nil, "", errors.New("trailing upstream stream error"), false); st != preflightreceipt.SealRejected {
+		t.Fatalf("post-EOF trailing StreamChunk.Err = %v, want SealRejected", st)
+	}
+}
+
+func TestPreflightReceiptBootstrapStreamErrAllowsSerialRetry(t *testing.T) {
+	// Sol P2 #1 (PR #2280 R18): a pre-payload StreamChunk{Err} (bootstrap failure before any
+	// payload bytes are emitted) MUST block sealing if unretried, yet MUST release the lease
+	// cleanly and leave the Collector reusable for an immediate serial retry (without waiting for
+	// async discardStreamChunks).
+	root := filepath.Join(t.TempDir(), "receipts")
+	tlsState := testVerifiedTLS(t, "chatgpt.com")
+	sseOK := `data: {"type":"response.completed","response":{"id":"resp_retry_ok","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"VERDICT: PASS"}]}]}}` + "\n\n"
+
+	// 1. Unretried pre-payload bootstrap StreamChunk.Err MUST NOT seal.
+	lFail := "review-88881111-2222-4333-8444-999999999931"
+	sFail := "019d0000-0000-7000-8000-999999999931"
+	ctxF, cF, err := preflightreceipt.BeginReview(context.Background(), root, lFail, sFail, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	execCtxF, leaseF, err := cF.Start(ctxF, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	clF := httptransport.Decorate(execCtxF, &http.Client{Transport: streamTestRT{tlsState: tlsState}})
+	reqF, _ := http.NewRequestWithContext(execCtxF, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	respF, err := clF.Do(reqF)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = io.Copy(io.Discard, respF.Body)
+	_ = respF.Body.Close()
+
+	origF := make(chan executor.StreamChunk, 1)
+	origF <- executor.StreamChunk{Err: errors.New("retryable 502")}
+	close(origF)
+	outF := wrapPreflightStream(execCtxF, leaseF, origF)
+	chunkF, ok := <-outF
+	if !ok || chunkF.Err == nil {
+		t.Fatalf("expected bootstrap error chunk, got ok=%v chunk=%+v", ok, chunkF)
+	}
+	for range outF {
+	}
+	cF.Complete(true)
+	cF.HandlerDone(true)
+	if st := waitSealReview(t, root, lFail, sFail); st != preflightreceipt.SealRejected {
+		t.Fatalf("unretried bootstrap StreamChunk.Err seal = %v, want SealRejected", st)
+	}
+
+	// 2. Immediate serial retry right after reading bootstrap error chunk (simulating readStreamBootstrap)
+	//    MUST succeed on Attempt 2 and seal cleanly.
+	lRetry := "review-88881111-2222-4333-8444-999999999932"
+	sRetry := "019d0000-0000-7000-8000-999999999932"
+	ctxR, cR, err := preflightreceipt.BeginReview(context.Background(), root, lRetry, sRetry, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	execCtx1, lease1, err := cR.Start(ctxR, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl1 := httptransport.Decorate(execCtx1, &http.Client{Transport: streamTestRT{tlsState: tlsState}})
+	req1, _ := http.NewRequestWithContext(execCtx1, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	resp1, err := cl1.Do(req1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = io.Copy(io.Discard, resp1.Body)
+	_ = resp1.Body.Close()
+
+	orig1 := make(chan executor.StreamChunk, 1)
+	orig1 <- executor.StreamChunk{Err: errors.New("retryable 502")}
+	close(orig1)
+	out1 := wrapPreflightStream(execCtx1, lease1, orig1)
+	// Read ONLY the first error chunk (exactly like readStreamBootstrap) without waiting for out1 EOF.
+	chunk1, ok := <-out1
+	if !ok || chunk1.Err == nil {
+		t.Fatalf("expected bootstrap error chunk on attempt 1, got ok=%v chunk=%+v", ok, chunk1)
+	}
+	discardStreamChunks(out1)
+
+	// Immediately start Attempt 2 on the same Collector.
+	execCtx2, lease2, err := cR.Start(ctxR, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatalf("serial retry immediately after bootstrap StreamChunk.Err failed: %v", err)
+	}
+	cl2 := httptransport.Decorate(execCtx2, &http.Client{Transport: status200StreamTestRT{tlsState: tlsState, body: sseOK}})
+	req2, _ := http.NewRequestWithContext(execCtx2, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	resp2, err := cl2.Do(req2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw2, err := io.ReadAll(resp2.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := resp2.Body.Close(); err != nil {
+		t.Fatal(err)
+	}
+	orig2 := make(chan executor.StreamChunk, 1)
+	orig2 <- executor.StreamChunk{Payload: raw2}
+	close(orig2)
+	out2 := wrapPreflightStream(execCtx2, lease2, orig2)
+	for range out2 {
+	}
+	cR.Complete(true)
+	cR.HandlerDone(true)
+	if st := waitSealReview(t, root, lRetry, sRetry); st != preflightreceipt.SealOK {
+		t.Fatalf("serial retry after bootstrap StreamChunk.Err seal = %v, want SealOK", st)
+	}
+}
diff --git a/sdk/cliproxy/auth/preflight_transport.go b/sdk/cliproxy/auth/preflight_transport.go
new file mode 100644
index 0000000..36692d6
--- /dev/null
+++ b/sdk/cliproxy/auth/preflight_transport.go
@@ -0,0 +1,154 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/preflightreceipt"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
+	"golang.org/x/net/proxy"
+)
+
+// controlledPreflightTransport seals a proxy-owned *http.Transport behind an unexported
+// http.RoundTripper wrapper so callers outside package auth can never type-assert *http.Transport,
+// mutate TLSClientConfig, set DialTLS/DialTLSContext, or call RegisterProtocol("https", ...).
+// Go's net/http may still lazily initialize tr.TLSClientConfig for HTTP/2 on the first request;
+// trusting the sealed wrapper avoids both false rejection on reuse and data races against
+// onceSetNextProtoDefaults().
+type controlledPreflightTransport struct {
+	tr *http.Transport
+}
+
+func (c *controlledPreflightTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	return c.tr.RoundTrip(req)
+}
+
+var (
+	controlledTransportMu      sync.RWMutex
+	controlledTransportByProxy = make(map[string]*controlledPreflightTransport)
+	controlledTransportPtrs    = make(map[*controlledPreflightTransport]struct{})
+)
+
+func newFreshStandardTransport() *http.Transport {
+	// Constructed directly without cloning http.DefaultTransport so an external
+	// RegisterProtocol("https", ...) or TLSClientConfig mutation on DefaultTransport
+	// can never affect formal review or preflight TLS verification.
+	dialer := &net.Dialer{
+		Timeout:   30 * time.Second,
+		KeepAlive: 30 * time.Second,
+	}
+	return &http.Transport{
+		Proxy:                 http.ProxyFromEnvironment,
+		DialContext:           dialer.DialContext,
+		ForceAttemptHTTP2:     true,
+		MaxIdleConns:          100,
+		IdleConnTimeout:       90 * time.Second,
+		TLSHandshakeTimeout:   10 * time.Second,
+		ExpectContinueTimeout: 1 * time.Second,
+	}
+}
+
+// ControlledTransportForProxy returns a sealed proxy-owned http.RoundTripper bound strictly to
+// OS system trust roots (no DialTLS/DialTLSContext, no RegisterProtocol, never exposing *http.Transport).
+// Unsupported schemes such as https:// proxy (which require DialTLSContext) fail closed.
+func ControlledTransportForProxy(raw string) (http.RoundTripper, error) {
+	trimmed := strings.TrimSpace(raw)
+	controlledTransportMu.RLock()
+	if existing := controlledTransportByProxy[trimmed]; existing != nil {
+		controlledTransportMu.RUnlock()
+		return existing, nil
+	}
+	controlledTransportMu.RUnlock()
+
+	setting, errParse := proxyutil.Parse(trimmed)
+	if errParse != nil {
+		return nil, preflightreceipt.ErrUnavailable
+	}
+	tr := newFreshStandardTransport()
+	switch setting.Mode {
+	case proxyutil.ModeInherit:
+		// Keeps ProxyFromEnvironment with clean OS trust roots.
+	case proxyutil.ModeDirect:
+		tr.Proxy = nil
+	case proxyutil.ModeProxy:
+		switch setting.URL.Scheme {
+		case "http":
+			tr.Proxy = http.ProxyURL(setting.URL)
+		case "socks5", "socks5h":
+			var proxyAuth *proxy.Auth
+			if setting.URL.User != nil {
+				username := setting.URL.User.Username()
+				password, _ := setting.URL.User.Password()
+				proxyAuth = &proxy.Auth{User: username, Password: password}
+			}
+			forwardDialer := &net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}
+			dialer, errSOCKS5 := proxy.SOCKS5("tcp", setting.URL.Host, proxyAuth, forwardDialer)
+			if errSOCKS5 != nil {
+				return nil, preflightreceipt.ErrUnavailable
+			}
+			ctxDialer, ok := dialer.(proxy.ContextDialer)
+			if !ok {
+				return nil, preflightreceipt.ErrUnavailable
+			}
+			tr.Proxy = nil
+			tr.DialContext = func(ctx context.Context, network, addr string) (net.Conn, error) {
+				dialCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
+				defer cancel()
+				return ctxDialer.DialContext(dialCtx, network, addr)
+			}
+		default:
+			return nil, preflightreceipt.ErrUnavailable
+		}
+	default:
+		return nil, preflightreceipt.ErrUnavailable
+	}
+
+	wrapped := &controlledPreflightTransport{tr: tr}
+	controlledTransportMu.Lock()
+	if existing := controlledTransportByProxy[trimmed]; existing != nil {
+		controlledTransportMu.Unlock()
+		return existing, nil
+	}
+	controlledTransportByProxy[trimmed] = wrapped
+	controlledTransportPtrs[wrapped] = struct{}{}
+	controlledTransportMu.Unlock()
+	return wrapped, nil
+}
+
+func isControlledPreflightTransport(rt any) bool {
+	c, ok := rt.(*controlledPreflightTransport)
+	if !ok || c == nil || c.tr == nil {
+		return false
+	}
+	controlledTransportMu.RLock()
+	_, owned := controlledTransportPtrs[c]
+	controlledTransportMu.RUnlock()
+	return owned
+}
+
+type failClosedRoundTripper struct {
+	err error
+}
+
+func (f failClosedRoundTripper) RoundTrip(*http.Request) (*http.Response, error) {
+	if f.err != nil {
+		return nil, f.err
+	}
+	return nil, errors.New("preflight transport unavailable")
+}
+
+// NewPreflightTransportError returns a RoundTripper that fails closed without network I/O.
+func NewPreflightTransportError(err error) http.RoundTripper {
+	return failClosedRoundTripper{err: err}
+}
+
+// IsTestPreflightTransport reports whether rt is an offline test transport registered
+// exclusively in `-tags preflight_test_roots` builds. Production builds always return false.
+func IsTestPreflightTransport(rt any) bool {
+	return isAllowedTestTransport(rt)
+}
