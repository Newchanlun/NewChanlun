+				req.Header.Set("Upgrade", tc.upgrade)
+			}
+			res := httptest.NewRecorder()
+			unauthServer.engine.ServeHTTP(res, req)
+			if res.Code != http.StatusUnauthorized {
+				t.Fatalf("unauthenticated %s %s status = %d, want 401", tc.method, tc.path, res.Code)
+			}
+		}
