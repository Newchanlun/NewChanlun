+
+func hasDotDotSegment(path string) bool {
+	for _, part := range strings.Split(path, string(filepath.Separator)) {
+		if part == ".." {
+			return true
+		}
+	}
+	return false
+}
+
+func cleanPrivateRoot(root string) (string, bool) {
+	if root == "" || !filepath.IsAbs(root) || hasDotDotSegment(root) {
+		return "", false
+	}
+	cleaned := filepath.Clean(root)
+	if cleaned == "" || !filepath.IsAbs(cleaned) || cleaned == string(filepath.Separator) {
+		return "", false
+	}
+	return cleaned, true
+}
+
+func isAllowedOSSymlink(path string) bool {
+	if runtime.GOOS != "darwin" {
+		return false
+	}
+	var want string
+	switch path {
+	case "/var":
+		want = "private/var"
+	case "/tmp":
+		want = "private/tmp"
+	case "/etc":
+		want = "private/etc"
+	default:
+		return false
+	}
+	target, err := os.Readlink(path)
+	if err != nil {
+		return false
+	}
+	return target == want || target == "/"+want
+}
+
+// pathHasDisallowedSymlink walks every existing path prefix from / down to path and rejects
+// any symlink component (except macOS's fixed OS-level /var, /tmp, /etc -> private/* links)
+// so a symlinked ancestor directory can never redirect receipt reads, writes, or reclamation.
+func pathHasDisallowedSymlink(path string) bool {
+	if path == "" || !filepath.IsAbs(path) || hasDotDotSegment(path) {
+		return true
+	}
+	cleaned := filepath.Clean(path)
+	if cleaned == "" || !filepath.IsAbs(cleaned) {
+		return true
+	}
+	if cleaned == string(filepath.Separator) {
+		return false
+	}
+	parts := strings.Split(strings.TrimPrefix(cleaned, string(filepath.Separator)), string(filepath.Separator))
+	cur := ""
+	for _, part := range parts {
+		if part == "" {
+			continue
+		}
+		cur += string(filepath.Separator) + part
+		fi, err := os.Lstat(cur)
+		if err != nil {
+			if errors.Is(err, os.ErrNotExist) {
+				return false
+			}
+			return true
+		}
+		if fi.Mode()&os.ModeSymlink != 0 {
+			if !isAllowedOSSymlink(cur) {
+				return true
+			}
+			tfi, statErr := os.Stat(cur)
+			if statErr != nil || !tfi.IsDir() {
+				return true
+			}
+			continue
+		}
+		if !fi.IsDir() && cur != cleaned {
+			return true
+		}
+	}
+	return false
+}
+
+// Begin binds the inbound nonce. Disk reservation waits for authenticated execution.
+// The directory must be private to the proxy, outside the credential/state volume.
+func Begin(ctx context.Context, root, session string) (context.Context, *Collector, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !sessionPattern.MatchString(session) || pathHasDisallowedSymlink(cleanRoot) {
+		return ctx, nil, ErrUnavailable
+	}
+	directory := filepath.Join(cleanRoot, session)
+	now := time.Now()
+	c := &Collector{directory: directory, deadline: now.Add(Lifetime), receipt: Receipt{Schema: Schema, Session: session, Started: now.UnixNano()}}
+	return context.WithValue(ctx, contextKey{}, c), c, nil
+}
+
+func sha256Hex(s string) string {
+	sum := sha256.Sum256([]byte(s))
+	return hex.EncodeToString(sum[:])
+}
+
+func isSHA256Hex(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
+			return false
+		}
+	}
+	return true
+}
+
+func isOptionalSHA256Hex(s string) bool {
+	return s == "" || isSHA256Hex(s)
+}
+
+type responseOutputContentPart struct {
+	Type string `json:"type"`
+	Text string `json:"text"`
+}
+
+type responseOutputItem struct {
+	ID               string                      `json:"id"`
+	Type             string                      `json:"type"`
+	Role             string                      `json:"role"`
+	Phase            string                      `json:"phase"`
+	Status           string                      `json:"status"`
+	CallID           string                      `json:"call_id"`
+	Name             string                      `json:"name"`
+	ServerLabel      string                      `json:"server_label"`
+	ArgsSHA          string                      `json:"-"`
+	ArgsStr          string                      `json:"-"`
+	ArgsIsStr        bool                        `json:"-"`
+	InputSHA         string                      `json:"-"`
+	InputStr         string                      `json:"-"`
+	InputIsStr       bool                        `json:"-"`
+	CodeSHA          string                      `json:"-"`
+	CodeStr          string                      `json:"-"`
+	CodeIsStr        bool                        `json:"-"`
+	CanonicalItemSHA string                      `json:"-"`
+	Content          []responseOutputContentPart `json:"content"`
