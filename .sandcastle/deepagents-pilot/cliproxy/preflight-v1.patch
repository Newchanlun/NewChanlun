+func doneItemStatusCompatible(doneStatus, nextStatus string) bool {
+	if doneStatus == nextStatus {
+		return true
+	}
+	return (doneStatus == "" && nextStatus == "completed") || (doneStatus == "completed" && nextStatus == "")
+}
+
+func doneItemMatchesOutputItem(doneRec doneItemSummary, item responseOutputItem) bool {
+	if doneRec.itemType != item.Type || doneRec.itemRole != item.Role || doneRec.itemPhase != item.Phase ||
+		!doneItemStatusCompatible(doneRec.itemStatus, item.Status) ||
+		doneRec.callID != item.CallID || doneRec.name != item.Name || doneRec.serverLabel != item.ServerLabel ||
+		doneRec.argsSHA != item.ArgsSHA || doneRec.inputSHA != item.InputSHA || doneRec.codeSHA != item.CodeSHA ||
+		(doneRec.canonicalItemSHA != "" && item.CanonicalItemSHA != "" && doneRec.canonicalItemSHA != item.CanonicalItemSHA) ||
+		doneRec.isFinal != isFinalAssistantOutputItem(item) {
+		return false
+	}
+	if doneRec.isAssistantMsg {
+		if item.Type != "message" || item.Role != "assistant" {
+			return false
+		}
+		itemText := extractSingleAssistantText(item)
+		itemSHA := ""
+		if itemText != "" {
+			itemSHA = sha256Hex(itemText)
+		}
+		if itemSHA != doneRec.outputTextSHA {
+			return false
+		}
+	}
+	return true
+}
