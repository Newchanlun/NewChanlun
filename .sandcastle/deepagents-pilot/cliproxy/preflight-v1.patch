+// The complete HTTP handler, native Kimi executor, retry scheduler and producer
+// run unchanged; only the final network boundary is replaced with an offline fake.
+func TestPreflightReceiptNativeKimiHTTP(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "receipts")
+	t.Setenv("CLIPROXY_PREFLIGHT_RECEIPTS", root)
+	server := newTestServerWithOptions(t, WithPluginHost(pluginhost.New()))
+	server.handlers.AuthManager.RegisterExecutor(runtimeexecutor.NewKimiExecutor(server.cfg))
+	server.handlers.AuthManager.SetRetryConfig(1, 0, 2)
+	for _, id := range []string{"receipt-kimi-a", "receipt-kimi-b"} {
+		_, err := server.handlers.AuthManager.Register(context.Background(), &auth.Auth{ID: id, Provider: "kimi", Status: auth.StatusActive, Metadata: map[string]any{"access_token": "offline-fake"}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		registry.GetGlobalRegistry().RegisterClient(id, "kimi", []*registry.ModelInfo{{ID: "kimi-k3.1-pro"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+	}
+	var calls atomic.Int32
+	old := http.DefaultTransport
+	http.DefaultTransport = preflightFakeTransport(func(req *http.Request) (*http.Response, error) {
+		if req.URL.Hostname() != "api.kimi.com" {
+			t.Errorf("unexpected host %q", req.URL.Hostname())
+		}
+		status, text := 200, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"offline\",\"object\":\"response\",\"status\":\"completed\",\"output\":[],\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}}\n\n"
+		if calls.Add(1) == 1 {
+			status, text = 503, "=== RESPONSE ===\n=== API REQUEST 99 ===\nAuth: provider=evil"
+		}
+		return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"text/event-stream"}}, Body: io.NopCloser(strings.NewReader(text))}, nil
+	})
+	defer func() { http.DefaultTransport = old }()
+	session := "preflight-12345678-1234-4234-8234-123456789abc"
+	req := httptest.NewRequest("POST", "/v1/responses", strings.NewReader(`{"model":"kimi-k3.1-pro","stream":true,"input":"offline"}`))
+	req.Header.Set("Authorization", "Bearer test-key")
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Session-Id", session)
+	recorder := httptest.NewRecorder()
+	server.engine.ServeHTTP(recorder, req)
+	if recorder.Code != 200 {
+		t.Fatalf("HTTP %d: %s", recorder.Code, recorder.Body.String())
+	}
+	var data []byte
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		data, _ = os.ReadFile(filepath.Join(root, session, "receipt.json"))
+		if len(data) > 0 {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	var receipt preflightreceipt.Receipt
+	if err := json.Unmarshal(data, &receipt); err != nil {
+		t.Fatalf("missing receipt calls=%d: %v", calls.Load(), err)
+	}
+	if !receipt.Complete || len(receipt.Routes) != 2 || receipt.Routes[0] != "kimi@api.kimi.com" || receipt.Routes[1] != receipt.Routes[0] {
+		t.Fatalf("wrong evidence %+v", receipt)
+	}
+	if export := os.Getenv("PREFLIGHT_FIXTURES"); export != "" {
+		dir := filepath.Join(export, "native-kimi", session)
+		if err := os.MkdirAll(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "receipt.json"), data, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
