+// syncDirFn is nil in production so pinned directory syncs never re-open paths by name;
+// unit tests may assign it temporarily to observe or inject directory fsync failures.
+var syncDirFn func(string) error
+
+func syncPathDir(dir string) error {
+	if syncDirFn != nil {
+		return syncDirFn(dir)
+	}
+	return defaultSyncDir(dir)
+}
+
+func defaultSyncDir(dir string) error {
+	f, err := os.OpenFile(dir, os.O_RDONLY|syscall.O_DIRECTORY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return err
+	}
+	fi, statErr := f.Stat()
+	if statErr != nil || !fi.IsDir() {
+		_ = f.Close()
+		return ErrUnavailable
+	}
+	syncErr := f.Sync()
+	closeErr := f.Close()
+	if syncErr != nil {
+		return syncErr
+	}
+	return closeErr
+}
+
+func statDevIno(info os.FileInfo) (uint64, uint64, bool) {
+	if st, ok := info.Sys().(*syscall.Stat_t); ok {
+		return uint64(st.Dev), uint64(st.Ino), true
+	}
+	return 0, 0, false
+}
+
+// acquirePrivateRootLease enforces single-writer ownership over a dedicated private receipt root
+// across same-UID proxy processes via a non-blocking exclusive flock DIRECTLY on the verified root
+// directory inode (cannot be bypassed by lock-file rotation), returning a ref-counted lease holding
+// the locked root directory fd, the descriptor-pinned *os.Root, and the verified parent directory fd.
+// Even if root is rotated or pruned from the cache while operations are in flight, neither the flock
+// nor the directory descriptors are closed until the last active lease calls Close().
+func acquirePrivateRootLease(root string) (*lockedRootLease, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || pathHasDisallowedSymlink(cleanRoot) {
+		return nil, ErrUnavailable
+	}
+	root = cleanRoot
+	if err := ensurePrivateRoot(root); err != nil {
+		return nil, ErrUnavailable
+	}
+	candRoot, rDev, rIno, err := openVerifiedPrivateRoot(root)
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+
+	var toClose []*heldRootLock
+	releaseRetired := func(h *heldRootLock) {
+		h.refs--
+		if h.refs == 0 {
+			toClose = append(toClose, h)
+		}
+	}
+	closeRetired := func() {
+		for _, h := range toClose {
+			_ = h.file.Close()
+			if h.dir != nil {
+				_ = h.dir.Close()
+			}
+			if h.parentFD != nil {
+				_ = h.parentFD.Close()
+			}
+		}
+	}
+
+	rootLockMu.Lock()
+	if held := rootLocks[root]; held != nil {
+		if held.file != nil && held.dir != nil && held.parentFD != nil && held.rootDev == rDev && held.rootIno == rIno && verifyRootStillBound(held, root) == nil {
+			held.refs++
+			lease := &lockedRootLease{lock: held, dir: held.dir}
+			rootLockMu.Unlock()
+			_ = candRoot.Close()
+			return lease, nil
+		}
+		delete(rootLocks, root)
+		releaseRetired(held)
+	}
+
+	// Best-effort prune of stale locks whose temp directories have already been removed.
+	if len(rootLocks) >= 32 {
+		for k, v := range rootLocks {
+			if _, statErr := os.Lstat(k); statErr != nil {
+				delete(rootLocks, k)
+				releaseRetired(v)
+			}
+		}
+	}
+
+	parentFD, pDev, pIno, err := openVerifiedRootParent(root, rDev, rIno)
+	if err != nil {
+		rootLockMu.Unlock()
+		closeRetired()
+		_ = candRoot.Close()
+		return nil, ErrUnavailable
+	}
+	rootFD, rfDev, rfIno, hasRFID, err := openPinnedDirFD(candRoot)
+	if err != nil || (hasRFID && (rfDev != rDev || rfIno != rIno)) {
+		rootLockMu.Unlock()
+		closeRetired()
+		if rootFD != nil {
+			_ = rootFD.Close()
+		}
+		_ = parentFD.Close()
+		_ = candRoot.Close()
+		return nil, ErrUnavailable
+	}
+	if err := syscall.Flock(int(rootFD.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		rootLockMu.Unlock()
+		closeRetired()
+		_ = rootFD.Close()
+		_ = parentFD.Close()
+		_ = candRoot.Close()
+		return nil, ErrUnavailable
+	}
+	if err := syncPinnedDir(candRoot, root); err != nil {
+		rootLockMu.Unlock()
+		closeRetired()
+		_ = rootFD.Close()
+		_ = parentFD.Close()
+		_ = candRoot.Close()
+		return nil, ErrUnavailable
+	}
+	held := &heldRootLock{
+		file:      rootFD,
+		dir:       candRoot,
+		parentFD:  parentFD,
+		dev:       rDev,
+		ino:       rIno,
+		rootDev:   rDev,
+		rootIno:   rIno,
+		parentDev: pDev,
+		parentIno: pIno,
+		refs:      2, // 1 for rootLocks cache + 1 for returned lease
+	}
+	if err := verifyRootStillBound(held, root); err != nil {
+		rootLockMu.Unlock()
+		closeRetired()
+		_ = rootFD.Close()
+		_ = parentFD.Close()
+		_ = candRoot.Close()
+		return nil, ErrUnavailable
+	}
+	rootLocks[root] = held
+	lease := &lockedRootLease{lock: held, dir: candRoot}
+	rootLockMu.Unlock()
+	closeRetired()
+	// Newly acquired exclusive root-directory flock guarantees no other proxy process owns root;
+	// safely sweep content-verified crash-orphaned producer staging artifacts not active in this process.
+	sweepOrphanStagingInRoot(candRoot, root, true)
+	return lease, nil
+}
+
+func acquirePrivateRootLock(root string) error {
+	lease, err := acquirePrivateRootLease(root)
+	if err != nil {
+		return err
+	}
+	lease.Close()
+	return nil
+}
+
+func ensurePrivateRoot(root string) error {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || pathHasDisallowedSymlink(cleanRoot) {
+		return ErrUnavailable
+	}
+	root = cleanRoot
+	parentOfRoot := filepath.Dir(root)
+	if parentOfRoot == "" || parentOfRoot == root {
+		return ErrUnavailable
+	}
+	// Require the immediate parent directory of <receipt-root> to ALREADY exist as a real directory
+	// (allowing fixed OS symlinks such as /tmp -> private/tmp on macOS via isAllowedOSSymlink, while
+	// rejecting arbitrary symlinks and missing multi-level ancestors). Serialize creation + parent fsync.
+	rootInitMu.Lock()
+	defer rootInitMu.Unlock()
+	pfi, perr := os.Lstat(parentOfRoot)
+	if perr != nil {
+		return ErrUnavailable
+	}
+	if pfi.Mode()&os.ModeSymlink != 0 {
+		if !isAllowedOSSymlink(parentOfRoot) {
+			return ErrUnavailable
+		}
+		pfi, perr = os.Stat(parentOfRoot)
+		if perr != nil {
+			return ErrUnavailable
+		}
+	}
+	if !pfi.IsDir() {
+		return ErrUnavailable
+	}
+	if _, err := os.Lstat(root); err == nil {
+		if _, err := checkPrivateDir(root, false); err != nil {
+			return ErrUnavailable
+		}
+		if err := syncPathDir(parentOfRoot); err != nil {
+			return ErrUnavailable
+		}
+		return nil
+	} else if !os.IsNotExist(err) {
+		return ErrUnavailable
+	}
+	mkdirErr := os.Mkdir(root, 0700)
+	createdRoot := mkdirErr == nil
+	if mkdirErr != nil && !os.IsExist(mkdirErr) {
+		return mkdirErr
+	}
+	var createdDev, createdIno uint64
+	var hasCreatedID bool
+	if createdRoot {
+		if cfi, serr := os.Lstat(root); serr == nil && cfi.IsDir() && cfi.Mode()&os.ModeSymlink == 0 {
+			createdDev, createdIno, hasCreatedID = statDevIno(cfi)
+		}
+	}
+	if err := syncPathDir(parentOfRoot); err != nil {
+		// Roll back ONLY if THIS call created root AND its (dev, ino) still matches.
+		if createdRoot && hasCreatedID {
+			if pRoot, pOpenErr := os.OpenRoot(parentOfRoot); pOpenErr == nil {
+				removeVerifiedEmptySubdir(pRoot, filepath.Base(root), createdDev, createdIno, true)
+				_ = pRoot.Close()
+			}
+		}
+		return err
+	}
+	if _, err := checkPrivateDir(root, false); err != nil {
+		return ErrUnavailable
+	}
+	return nil
+}
