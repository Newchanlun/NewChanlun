+		if r.Host != "chatgpt.com" || r.URL.Path != "/backend-api/codex/responses" {
+			t.Errorf("unexpected upstream %s%s", r.Host, r.URL.Path)
+		}
+		var request struct {
+			Model string `json:"model"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
+			t.Errorf("decode upstream request: %v", err)
+		}
+		models <- request.Model
+		n := seq.Add(1)
+		respID := fmt.Sprintf("resp_%s_%d", request.Model, n)
+		respModel := request.Model
+		if override, _ := responseModelOverride.Load().(string); override != "" {
+			respModel = override
+		}
+		output := []map[string]any{}
+		if toolOnlyMode.Load() {
+			output = append(output, map[string]any{"type": "function_call", "name": "shell"})
+		} else {
+			outText := fmt.Sprintf(`{"status":"completed","summary":"VERDICT: PASS","model":%q,"turn":%d}`, request.Model, n)
+			output = append(output, map[string]any{
+				"type": "message", "role": "assistant", "status": "completed",
+				"content": []map[string]any{{"type": "output_text", "text": outText}},
+			})
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		ev, _ := json.Marshal(map[string]any{
+			"type": "response.completed",
+			"response": map[string]any{
+				"id":     respID,
+				"object": "response",
+				"status": "completed",
+				"model":  respModel,
+				"output": output,
+				"usage":  map[string]any{"input_tokens": 1, "output_tokens": 1},
+			},
+		})
+		_, _ = fmt.Fprintf(w, "data: %s\n\n", ev)
+	}))
+	defer upstream.Close()
+	defer transport.CloseIdleConnections()
+	server := newTestServer(t)
+	manager := server.handlers.AuthManager
+	manager.SetRoundTripperProvider(preflightTransportProvider{transport})
+	manager.RegisterExecutor(runtimeexecutor.NewCodexAutoExecutor(server.cfg))
+	const id = "review-receipt-codex"
+	credential := &auth.Auth{ID: id, Provider: "codex", Status: auth.StatusActive,
+		Attributes: map[string]string{auth.AttributeAuthKind: auth.AuthKindOAuth},
+		Metadata:   map[string]any{"access_token": "offline-fake", "websockets": true},
