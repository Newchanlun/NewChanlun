+	if _, _, err := BeginReview(context.Background(), newRoot, "review-b8888888-2222-4333-8444-555555555505", "019d0000-0000-7000-8000-666666666805", "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
