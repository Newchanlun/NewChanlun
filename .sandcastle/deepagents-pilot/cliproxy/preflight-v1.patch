+
+const maxStagingCreateRetries = 8
+
+var (
+	stagingFilePattern  = regexp.MustCompile(`^(?:pending|pending-marker)-[0-9]+-[0-9]+-[0-9a-f]{16}$`)
+	stagingDirPattern   = regexp.MustCompile(`^stage-dir-[0-9]+-[0-9]+-[0-9a-f]{16}$`)
+	stageSealDirPattern = regexp.MustCompile(`^stage-seal-[0-9]+-[0-9]+-[0-9a-f]{16}$`)
+	reclaimDirPattern   = regexp.MustCompile(`^reclaim-[0-9]+-[0-9]+-[0-9a-f]{16,32}$`)
+	stagingOrphanAge    = 5 * time.Minute
+
+	activeStagingMu sync.Mutex
+	activeStaging   = make(map[string]int)
+)
+
+func stagingEntryKey(root, name string) string {
+	return root + "\x00" + name
+}
+
+func trackStagingEntry(root, name string) {
+	activeStagingMu.Lock()
+	activeStaging[stagingEntryKey(root, name)]++
+	activeStagingMu.Unlock()
+}
+
+func untrackStagingEntry(root, name string) {
+	k := stagingEntryKey(root, name)
+	activeStagingMu.Lock()
+	if n := activeStaging[k]; n <= 1 {
+		delete(activeStaging, k)
+	} else {
+		activeStaging[k] = n - 1
+	}
+	activeStagingMu.Unlock()
+}
+
+func isStagingEntryActive(root, name string) bool {
+	activeStagingMu.Lock()
+	active := activeStaging[stagingEntryKey(root, name)] > 0
+	activeStagingMu.Unlock()
+	return active
+}
+
+func randomStagingToken() (string, error) {
+	var buf [8]byte
+	if _, err := rand.Read(buf[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(buf[:]), nil
+}
+
+func randomQuarantineToken() (string, error) {
+	var buf [16]byte
+	if _, err := rand.Read(buf[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(buf[:]), nil
+}
+
+func createStagingFileWithGen(stagingRoot *os.Root, root string, gen func() (string, error)) (string, *os.File, func(), error) {
+	if stagingRoot == nil || gen == nil {
+		return "", nil, nil, ErrUnavailable
+	}
+	for i := 0; i < maxStagingCreateRetries; i++ {
+		name, err := gen()
+		if err != nil || !isSingleBaseName(name) {
+			return "", nil, nil, ErrUnavailable
+		}
+		trackStagingEntry(root, name)
+		f, oerr := stagingRoot.OpenFile(name, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if oerr == nil {
+			var once sync.Once
+			release := func() {
+				once.Do(func() { untrackStagingEntry(root, name) })
+			}
+			return name, f, release, nil
+		}
+		untrackStagingEntry(root, name)
+		if os.IsExist(oerr) {
+			continue
+		}
+		return "", nil, nil, oerr
+	}
+	return "", nil, nil, ErrUnavailable
+}
+
+func createStagingFile(stagingRoot *os.Root, root, prefix string) (string, *os.File, func(), error) {
+	return createStagingFileWithGen(stagingRoot, root, func() (string, error) {
+		tok, err := randomStagingToken()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%s-%d-%d-%s", prefix, os.Getpid(), tmpSeq.Add(1), tok), nil
+	})
+}
+
+func createNamedStagingDir(stagingRoot *os.Root, root, prefix string) (string, *os.Root, func(), error) {
+	if stagingRoot == nil || !isSingleBaseName(prefix) {
+		return "", nil, nil, ErrUnavailable
+	}
+	for i := 0; i < maxStagingCreateRetries; i++ {
+		tok, err := randomStagingToken()
+		if err != nil {
+			return "", nil, nil, ErrUnavailable
+		}
+		name := fmt.Sprintf("%s-%d-%d-%s", prefix, os.Getpid(), tmpSeq.Add(1), tok)
+		trackStagingEntry(root, name)
+		if mkErr := stagingRoot.Mkdir(name, 0700); mkErr != nil {
+			untrackStagingEntry(root, name)
+			if os.IsExist(mkErr) {
+				continue
+			}
+			return "", nil, nil, mkErr
+		}
+		subRoot, _, oerr := openVerifiedSubdir(stagingRoot, name)
+		if oerr != nil {
+			_ = stagingRoot.Remove(name)
+			untrackStagingEntry(root, name)
+			return "", nil, nil, ErrUnavailable
+		}
+		var once sync.Once
+		release := func() {
+			once.Do(func() { untrackStagingEntry(root, name) })
+		}
+		return name, subRoot, release, nil
+	}
+	return "", nil, nil, ErrUnavailable
+}
+
+func createStagingDir(stagingRoot *os.Root, root string) (string, *os.Root, func(), error) {
+	return createNamedStagingDir(stagingRoot, root, "stage-dir")
+}
+
+type verifiedLeafChild struct {
+	name   string
+	dev    uint64
+	ino    uint64
+	hasID  bool
+	sha256 string
+}
+
+func readPrivateRegularFileInSubdir(subRoot *os.Root, childName string, maxBytes int64) ([]byte, uint64, uint64, bool, bool) {
+	if subRoot == nil || !isSingleBaseName(childName) || maxBytes <= 0 {
+		return nil, 0, 0, false, false
+	}
+	cfi, cerr := subRoot.Lstat(childName)
+	if cerr != nil || !cfi.Mode().IsRegular() || cfi.Mode()&os.ModeSymlink != 0 || cfi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(cfi) || cfi.Size() <= 0 || cfi.Size() > maxBytes {
+		return nil, 0, 0, false, false
+	}
+	f, oerr := subRoot.OpenFile(childName, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if oerr != nil {
+		return nil, 0, 0, false, false
+	}
+	fStat, serr := f.Stat()
+	if serr != nil || !fStat.Mode().IsRegular() || fStat.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fStat) || fStat.Size() <= 0 || fStat.Size() > maxBytes {
+		_ = f.Close()
+		return nil, 0, 0, false, false
+	}
+	raw, rerr := io.ReadAll(io.LimitReader(f, maxBytes+1))
+	_ = f.Close()
+	if rerr != nil || len(raw) == 0 || int64(len(raw)) > maxBytes {
+		return nil, 0, 0, false, false
+	}
+	dev, ino, hasID := statDevIno(fStat)
+	return raw, dev, ino, hasID, true
+}
+
+// removeVerifiedFileInSubdir holds the target file descriptor open across stat/content SHA-256
+// verification, re-checks Lstat identity, and unlinks via descriptor-pinned unix.Unlinkat before
+// closing the fd. Under the dedicated single-writer 0700 receipt-root contract (root-inode flock),
+// this prevents inode-number reuse during verification and refuses to unlink pre-existing or
+// previously swapped files (POSIX unlinkat is inherently name-based, so concurrent adversarial
+// same-UID mutations inside the dedicated private root remain outside POSIX process isolation).
+func removeVerifiedFileInSubdir(subRoot *os.Root, childName string, dev, ino uint64, hasID bool, expectSHA string, maxBytes int64) bool {
+	if subRoot == nil || !isSingleBaseName(childName) || !hasID || expectSHA == "" || maxBytes <= 0 {
+		return false
+	}
+	subDirFD, _, _, _, err := openPinnedDirFD(subRoot)
+	if err != nil {
+		return false
+	}
+	defer subDirFD.Close()
+	f, oerr := subRoot.OpenFile(childName, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if oerr != nil {
+		return false
+	}
+	defer f.Close()
+	fStat, serr := f.Stat()
+	if serr != nil || !fStat.Mode().IsRegular() || fStat.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fStat) || fStat.Size() <= 0 || fStat.Size() > maxBytes {
+		return false
+	}
+	curDev, curIno, curHasID := statDevIno(fStat)
+	if !curHasID || curDev != dev || curIno != ino {
+		return false
+	}
+	raw, rerr := io.ReadAll(io.LimitReader(f, maxBytes+1))
+	if rerr != nil || len(raw) == 0 || int64(len(raw)) > maxBytes || sha256Hex(string(raw)) != expectSHA {
+		return false
+	}
+	lfi, lerr := subRoot.Lstat(childName)
+	if lerr != nil || !lfi.Mode().IsRegular() || lfi.Mode()&os.ModeSymlink != 0 {
+		return false
+	}
+	if lDev, lIno, okL := statDevIno(lfi); !okL || lDev != dev || lIno != ino {
+		return false
+	}
+	unlinkErr := unix.Unlinkat(int(subDirFD.Fd()), childName, 0)
+	runtime.KeepAlive(subDirFD)
+	return unlinkErr == nil
+}
+
+func verifyStagingRegularFile(stagingRoot *os.Root, name string) (verifiedLeafChild, bool) {
+	if strings.HasPrefix(name, "pending-marker-") {
+		raw, dev, ino, hasID, ok := readPrivateRegularFileInSubdir(stagingRoot, name, 4096)
+		if !ok {
+			return verifiedLeafChild{}, false
+		}
+		var rm reviewReservationMarker
+		if decodeExactReceiptJSON(raw, reviewMarkerJSONKeys, &rm) == nil && rm.Schema == ReviewSchema && ValidReviewLaunch(rm.Launch) && rm.Started > 0 {
+			return verifiedLeafChild{name: name, dev: dev, ino: ino, hasID: hasID, sha256: sha256Hex(string(raw))}, true
+		}
+		var pm preflightReservationMarker
+		if decodeExactReceiptJSON(raw, preflightMarkerJSONKeys, &pm) == nil && pm.Schema == Schema && ValidPreflightSession(pm.Session) && pm.Started > 0 {
+			return verifiedLeafChild{name: name, dev: dev, ino: ino, hasID: hasID, sha256: sha256Hex(string(raw))}, true
+		}
+		return verifiedLeafChild{}, false
+	}
+	if strings.HasPrefix(name, "pending-") {
+		raw, dev, ino, hasID, ok := readPrivateRegularFileInSubdir(stagingRoot, name, maxReviewReceiptBytes)
+		if !ok {
+			return verifiedLeafChild{}, false
+		}
+		var rr ReviewReceipt
+		if decodeExactReceiptJSON(raw, reviewReceiptJSONKeys, &rr) == nil && ValidReviewLaunch(rr.Launch) && isValidProducerReviewReceipt(rr, rr.Launch) {
+			return verifiedLeafChild{name: name, dev: dev, ino: ino, hasID: hasID, sha256: sha256Hex(string(raw))}, true
+		}
+		var pr Receipt
+		if decodeExactReceiptJSON(raw, preflightReceiptJSONKeys, &pr) == nil && ValidPreflightSession(pr.Session) && isValidProducerPreflightReceipt(pr, pr.Session) {
+			return verifiedLeafChild{name: name, dev: dev, ino: ino, hasID: hasID, sha256: sha256Hex(string(raw))}, true
+		}
+		return verifiedLeafChild{}, false
+	}
+	return verifiedLeafChild{}, false
+}
+
+func readVerifiedStagingMarkerFile(subRoot *os.Root) (verifiedLeafChild, string, bool) {
+	raw, dev, ino, hasID, ok := readPrivateRegularFileInSubdir(subRoot, "producer.json", 4096)
+	if !ok {
+		return verifiedLeafChild{}, "", false
+	}
+	var rm reviewReservationMarker
+	if decodeExactReceiptJSON(raw, reviewMarkerJSONKeys, &rm) == nil && rm.Schema == ReviewSchema && ValidReviewLaunch(rm.Launch) && rm.Started > 0 {
+		return verifiedLeafChild{name: "producer.json", dev: dev, ino: ino, hasID: hasID, sha256: sha256Hex(string(raw))}, rm.Launch, true
+	}
+	var pm preflightReservationMarker
+	if decodeExactReceiptJSON(raw, preflightMarkerJSONKeys, &pm) == nil && pm.Schema == Schema && ValidPreflightSession(pm.Session) && pm.Started > 0 {
+		return verifiedLeafChild{name: "producer.json", dev: dev, ino: ino, hasID: hasID, sha256: sha256Hex(string(raw))}, pm.Session, true
+	}
+	return verifiedLeafChild{}, "", false
+}
+
+func removeVerifiedChildrenInSafeOrder(subRoot *os.Root, verified map[string]verifiedLeafChild) bool {
+	if subRoot == nil {
+		return false
+	}
+	order := []string{"seal.sha256", "seal.pending.json", "receipt.json", "producer.json"}
+	for _, cname := range order {
+		ch, ok := verified[cname]
+		if !ok {
+			continue
+		}
+		maxB := int64(maxReviewReceiptBytes)
+		if cname == "producer.json" {
+			maxB = 4096
+		} else if cname == "seal.sha256" {
+			maxB = 64
+		}
+		if !removeVerifiedFileInSubdir(subRoot, ch.name, ch.dev, ch.ino, ch.hasID, ch.sha256, maxB) {
+			return false
+		}
+	}
+	rem, err := readDirFromRoot(subRoot)
+	return err == nil && len(rem) == 0
+}
+
+func reviewSealPendingMatchesReceipt(reviewDisk, sealPendingDisk ReviewReceipt) bool {
+	return !reviewDisk.Sealed &&
+		reviewDisk.Complete &&
+		!reviewDisk.Tainted &&
+		sealPendingDisk.Schema == reviewDisk.Schema &&
+		sealPendingDisk.Launch == reviewDisk.Launch &&
+		sealPendingDisk.Session == reviewDisk.Session &&
+		sealPendingDisk.Started == reviewDisk.Started &&
+		sealPendingDisk.Finished == reviewDisk.Finished &&
+		sealPendingDisk.Complete == reviewDisk.Complete &&
+		sealPendingDisk.Tainted == reviewDisk.Tainted &&
+		sealPendingDisk.Requests == reviewDisk.Requests &&
+		slices.Equal(sealPendingDisk.Routes, reviewDisk.Routes) &&
+		slices.Equal(sealPendingDisk.ResponseIDSHAs, reviewDisk.ResponseIDSHAs) &&
+		sealPendingDisk.LastResponseID == reviewDisk.LastResponseID &&
+		sealPendingDisk.LastOutputSHA256 == reviewDisk.LastOutputSHA256 &&
+		sealPendingDisk.Sealed &&
+		sealPendingDisk.SealedAt >= reviewDisk.Finished
+}
+
+func cleanOrphanStageSealDir(rootHandle, stagingRoot *os.Root, name string, subRoot *os.Root, subDev, subIno uint64, hasSubID bool) bool {
+	children, err := readDirFromRoot(subRoot)
+	if err != nil {
+		return false
+	}
+	if len(children) == 0 {
+		return false
+	}
+	verified := make(map[string]verifiedLeafChild, len(children))
+	var markerLaunch string
+	var pendingLaunch string
+	var pendingSHA string
+	var sealDigest string
+	hasMarker := false
+	hasSeal := false
+	for _, child := range children {
+		cname := child.Name()
+		switch cname {
+		case "producer.json":
+			ch, owner, ok := readVerifiedStagingMarkerFile(subRoot)
+			if !ok || !ValidReviewLaunch(owner) {
+				return false
+			}
+			markerLaunch = owner
+			hasMarker = true
+			verified[cname] = ch
+		case "seal.pending.json":
+			raw, dev, ino, hasID, ok := readPrivateRegularFileInSubdir(subRoot, cname, maxReviewReceiptBytes)
+			if !ok {
+				return false
+			}
+			var rr ReviewReceipt
+			if decodeExactReceiptJSON(raw, reviewReceiptJSONKeys, &rr) != nil || !ValidReviewLaunch(rr.Launch) || !isValidProducerReviewReceipt(rr, rr.Launch) || !rr.Sealed {
+				return false
+			}
+			pendingLaunch = rr.Launch
+			pendingSHA = sha256Hex(string(raw))
+			verified[cname] = verifiedLeafChild{name: cname, dev: dev, ino: ino, hasID: hasID, sha256: pendingSHA}
+		case "seal.sha256":
+			d, dev, ino, hasID, ok := readVerifiedSealDigestWithIdentityFromRoot(subRoot)
+			if !ok {
+				return false
+			}
+			sealDigest = d
+			hasSeal = true
+			verified[cname] = verifiedLeafChild{name: cname, dev: dev, ino: ino, hasID: hasID, sha256: sha256Hex(d)}
+		default:
+			return false
+		}
+	}
+	// Cross-check launch ownership independently of ReadDir(-1) enumeration order.
+	if !hasMarker || markerLaunch == "" {
+		return false
+	}
+	if pendingLaunch != "" && pendingLaunch != markerLaunch {
+		return false
+	}
+	launch := markerLaunch
+	if hasSeal {
+		var matched bool
+		if pendingSHA != "" {
+			// When seal.pending.json is still present in stage-seal-*, seal.sha256 MUST match it directly;
+			// contradicting staged files are preserved untouched rather than explained away via <launch>.
+			matched = (sealDigest == pendingSHA)
+		} else if rootHandle != nil {
+			if lSub, _, lerr := openVerifiedSubdir(rootHandle, launch); lerr == nil {
+				for _, target := range []string{"seal.pending.json", "receipt.json"} {
+					if raw, _, _, _, ok := readPrivateRegularFileInSubdir(lSub, target, maxReviewReceiptBytes); ok && sha256Hex(string(raw)) == sealDigest {
+						matched = true
+						break
+					}
+				}
+				_ = lSub.Close()
+			}
+		}
+		if !matched {
+			return false
+		}
+	}
+	if !removeVerifiedChildrenInSafeOrder(subRoot, verified) {
+		return false
+	}
+	_ = subRoot.Close()
+	curFI, curErr := stagingRoot.Lstat(name)
+	if curErr != nil || !curFI.IsDir() || curFI.Mode()&os.ModeSymlink != 0 || curFI.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(curFI) {
+		return false
+	}
+	if curDev, curIno, okCur := statDevIno(curFI); okCur && hasSubID && (curDev != subDev || curIno != subIno) {
+		return false
+	}
+	return stagingRoot.Remove(name) == nil
+}
+
+func cleanOrphanReclaimDir(stagingRoot *os.Root, name string, subRoot *os.Root, subDev, subIno uint64, hasSubID bool) bool {
+	children, err := readDirFromRoot(subRoot)
+	if err != nil || len(children) == 0 {
+		// Never delete an empty directory with zero verified producer evidence.
+		return false
+	}
+	if len(children) > 0 {
+		verified := make(map[string]verifiedLeafChild, len(children))
+		var (
+			hasMarker, hasReceipt, hasPending, hasSeal bool
+			markerOwner, receiptOwner, pendingOwner    string
+			markerIsReview, receiptIsReview            bool
+			reviewDisk, pendingDisk                    ReviewReceipt
+			receiptSHA, pendingSHA, sealDigest         string
+		)
+		for _, child := range children {
+			cname := child.Name()
+			switch cname {
+			case "producer.json":
+				ch, owner, ok := readVerifiedStagingMarkerFile(subRoot)
+				if !ok || owner == "" {
+					return false
+				}
+				hasMarker = true
+				markerOwner = owner
+				markerIsReview = ValidReviewLaunch(owner)
+				verified[cname] = ch
+			case "receipt.json":
+				raw, dev, ino, hasID, ok := readPrivateRegularFileInSubdir(subRoot, cname, maxReviewReceiptBytes)
+				if !ok {
+					return false
+				}
+				var rr ReviewReceipt
+				var pr Receipt
+				okRR := decodeExactReceiptJSON(raw, reviewReceiptJSONKeys, &rr) == nil && ValidReviewLaunch(rr.Launch) && isValidProducerReviewReceipt(rr, rr.Launch)
+				okPR := !okRR && decodeExactReceiptJSON(raw, preflightReceiptJSONKeys, &pr) == nil && ValidPreflightSession(pr.Session) && isValidProducerPreflightReceipt(pr, pr.Session)
+				if !okRR && !okPR {
+					return false
+				}
+				hasReceipt = true
+				if okRR {
+					receiptIsReview = true
+					receiptOwner = rr.Launch
+					reviewDisk = rr
+				} else {
+					receiptIsReview = false
+					receiptOwner = pr.Session
+				}
+				receiptSHA = sha256Hex(string(raw))
+				verified[cname] = verifiedLeafChild{name: cname, dev: dev, ino: ino, hasID: hasID, sha256: receiptSHA}
+			case "seal.pending.json":
+				raw, dev, ino, hasID, ok := readPrivateRegularFileInSubdir(subRoot, cname, maxReviewReceiptBytes)
+				if !ok {
+					return false
+				}
+				var rr ReviewReceipt
+				if decodeExactReceiptJSON(raw, reviewReceiptJSONKeys, &rr) != nil || !ValidReviewLaunch(rr.Launch) || !isValidProducerReviewReceipt(rr, rr.Launch) || !rr.Sealed {
+					return false
+				}
+				hasPending = true
+				pendingOwner = rr.Launch
+				pendingDisk = rr
+				pendingSHA = sha256Hex(string(raw))
+				verified[cname] = verifiedLeafChild{name: cname, dev: dev, ino: ino, hasID: hasID, sha256: pendingSHA}
+			case "seal.sha256":
+				d, dev, ino, hasID, ok := readVerifiedSealDigestWithIdentityFromRoot(subRoot)
+				if !ok {
+					return false
+				}
+				sealDigest = d
+				hasSeal = true
+				verified[cname] = verifiedLeafChild{name: cname, dev: dev, ino: ino, hasID: hasID, sha256: sha256Hex(d)}
+			default:
+				return false
+			}
+		}
+		// Enforce order-independent owner/bucket agreement and full cross-file seal consistency
+		// matching inspectProducerReceiptSubdir + safe deletion order (seal.sha256 -> seal.pending.json -> receipt.json -> producer.json).
+		var commonOwner string
+		var isReview bool
+		haveOwner := false
+		bindOwner := func(owner string, rev bool) bool {
+			if owner == "" {
+				return false
+			}
+			if !haveOwner {
+				commonOwner = owner
+				isReview = rev
+				haveOwner = true
+				return true
+			}
+			return commonOwner == owner && isReview == rev
+		}
+		if hasMarker && !bindOwner(markerOwner, markerIsReview) {
+			return false
+		}
+		if hasReceipt && !bindOwner(receiptOwner, receiptIsReview) {
+			return false
+		}
+		if hasPending && !bindOwner(pendingOwner, true) {
+			return false
+		}
+		if !haveOwner {
+			return false
+		}
+		if !isReview && (hasPending || hasSeal) {
+			return false
+		}
+		if hasPending && (!hasMarker || !hasReceipt || !reviewSealPendingMatchesReceipt(reviewDisk, pendingDisk)) {
+			return false
+		}
+		if hasSeal {
+			if hasPending {
+				if sealDigest != pendingSHA {
+					return false
+				}
+			} else if hasReceipt {
+				if !reviewDisk.Sealed || sealDigest != receiptSHA {
+					return false
+				}
+			} else {
+				// seal.sha256 is always removed FIRST in removeVerifiedChildrenInSafeOrder;
+				// a standalone seal.sha256 without its receipt/pending file is never valid.
+				return false
+			}
+		}
+		if !removeVerifiedChildrenInSafeOrder(subRoot, verified) {
+			return false
+		}
+	}
+	_ = subRoot.Close()
+	curFI, curErr := stagingRoot.Lstat(name)
+	if curErr != nil || !curFI.IsDir() || curFI.Mode()&os.ModeSymlink != 0 || curFI.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(curFI) {
+		return false
+	}
+	if curDev, curIno, okCur := statDevIno(curFI); okCur && hasSubID && (curDev != subDev || curIno != subIno) {
+		return false
+	}
+	return stagingRoot.Remove(name) == nil
+}
+
+func sweepOrphanStagingDir(rootHandle, stagingRoot *os.Root, root string, forceAllInactive bool) int {
+	if stagingRoot == nil {
+		return 0
+	}
+	entries, err := readDirFromRoot(stagingRoot)
+	if err != nil {
+		return 0
+	}
+	now := time.Now()
+	removed := 0
+	for _, ent := range entries {
+		name := ent.Name()
+		if isStagingEntryActive(root, name) {
+			continue
+		}
+		if stagingFilePattern.MatchString(name) {
+			fi, lerr := stagingRoot.Lstat(name)
+			if lerr != nil || !fi.Mode().IsRegular() || fi.Mode()&os.ModeSymlink != 0 || fi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fi) {
+				continue
+			}
+			if !forceAllInactive && now.Sub(fi.ModTime()) < stagingOrphanAge {
+				continue
+			}
+			ch, ok := verifyStagingRegularFile(stagingRoot, name)
+			if !ok {
+				continue
+			}
+			maxB := int64(maxReviewReceiptBytes)
+			if strings.HasPrefix(name, "pending-marker-") {
+				maxB = 4096
+			}
+			if removeVerifiedFileInSubdir(stagingRoot, ch.name, ch.dev, ch.ino, ch.hasID, ch.sha256, maxB) {
+				removed++
+			}
+			continue
+		}
+		if stagingDirPattern.MatchString(name) {
+			fi, lerr := stagingRoot.Lstat(name)
+			if lerr != nil || !fi.IsDir() || fi.Mode()&os.ModeSymlink != 0 || fi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fi) {
+				continue
+			}
+			if !forceAllInactive && now.Sub(fi.ModTime()) < stagingOrphanAge {
+				continue
+			}
+			subRoot, subFI, oerr := openVerifiedSubdir(stagingRoot, name)
+			if oerr != nil {
+				continue
+			}
+			subDev, subIno, hasSubID := statDevIno(subFI)
+			children, cerr := readDirFromRoot(subRoot)
+			if cerr != nil || len(children) != 1 || children[0].Name() != "producer.json" {
+				_ = subRoot.Close()
+				continue
+			}
+			ch, _, ok := readVerifiedStagingMarkerFile(subRoot)
+			if !ok {
+				_ = subRoot.Close()
+				continue
+			}
+			if !removeVerifiedFileInSubdir(subRoot, ch.name, ch.dev, ch.ino, ch.hasID, ch.sha256, 4096) {
+				_ = subRoot.Close()
+				continue
+			}
+			rem, rerr := readDirFromRoot(subRoot)
+			_ = subRoot.Close()
+			if rerr == nil && len(rem) == 0 {
+				curFI, curErr := stagingRoot.Lstat(name)
+				if curErr == nil && curFI.IsDir() && curFI.Mode()&os.ModeSymlink == 0 && curFI.Mode().Perm()&0077 == 0 && ownedByCurrentUser(curFI) {
+					if curDev, curIno, okCur := statDevIno(curFI); !okCur || !hasSubID || (curDev == subDev && curIno == subIno) {
+						if stagingRoot.Remove(name) == nil {
+							removed++
+						}
+					}
+				}
+			}
+			continue
+		}
+		if stageSealDirPattern.MatchString(name) {
+			fi, lerr := stagingRoot.Lstat(name)
+			if lerr != nil || !fi.IsDir() || fi.Mode()&os.ModeSymlink != 0 || fi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fi) {
+				continue
+			}
+			if !forceAllInactive && now.Sub(fi.ModTime()) < stagingOrphanAge {
+				continue
+			}
+			subRoot, subFI, oerr := openVerifiedSubdir(stagingRoot, name)
+			if oerr != nil {
+				continue
+			}
+			subDev, subIno, hasSubID := statDevIno(subFI)
+			if cleanOrphanStageSealDir(rootHandle, stagingRoot, name, subRoot, subDev, subIno, hasSubID) {
+				removed++
+			} else {
+				_ = subRoot.Close()
+			}
+			continue
+		}
+		if reclaimDirPattern.MatchString(name) {
+			fi, lerr := stagingRoot.Lstat(name)
+			if lerr != nil || !fi.IsDir() || fi.Mode()&os.ModeSymlink != 0 || fi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fi) {
+				continue
+			}
+			if !forceAllInactive && now.Sub(fi.ModTime()) < stagingOrphanAge {
+				continue
+			}
+			subRoot, subFI, oerr := openVerifiedSubdir(stagingRoot, name)
+			if oerr != nil {
+				continue
+			}
+			subDev, subIno, hasSubID := statDevIno(subFI)
+			if cleanOrphanReclaimDir(stagingRoot, name, subRoot, subDev, subIno, hasSubID) {
+				removed++
+			} else {
+				_ = subRoot.Close()
+			}
+		}
+	}
+	if removed > 0 {
+		_ = syncPinnedDir(stagingRoot, filepath.Join(root, ".staging"))
+	}
+	return removed
+}
+
+func sweepOrphanStagingInRoot(rootHandle *os.Root, root string, forceAllInactive bool) int {
+	if rootHandle == nil {
+		return 0
+	}
+	stagingRoot, _, err := openVerifiedSubdir(rootHandle, ".staging")
+	if err != nil {
+		return 0
+	}
+	defer stagingRoot.Close()
+	return sweepOrphanStagingDir(rootHandle, stagingRoot, root, forceAllInactive)
+}
+
+func ensureStagingDir(rootHandle *os.Root, root string) (*os.Root, error) {
+	if rootHandle == nil {
+		return nil, ErrUnavailable
+	}
+	// Serialize shared .staging creation, parent fsync, and rollback across concurrent quota buckets
+	// (preflight vs review) so a racing EEXIST caller never removes a .staging created by another
+	// caller, and no caller can open .staging before its creation has synced cleanly.
+	rootInitMu.Lock()
+	defer rootInitMu.Unlock()
+	if _, err := rootHandle.Lstat(".staging"); errors.Is(err, os.ErrNotExist) {
+		mkErr := rootHandle.Mkdir(".staging", 0700)
+		createdStaging := mkErr == nil
+		if mkErr != nil && !os.IsExist(mkErr) {
+			return nil, ErrUnavailable
+		}
+		var createdDev, createdIno uint64
+		var hasCreatedID bool
+		if createdStaging {
+			if cfi, serr := rootHandle.Lstat(".staging"); serr == nil && cfi.IsDir() && cfi.Mode()&os.ModeSymlink == 0 {
+				createdDev, createdIno, hasCreatedID = statDevIno(cfi)
+			}
+		}
+		if syncErr := syncPinnedDir(rootHandle, root); syncErr != nil {
+			if createdStaging && hasCreatedID {
+				removeVerifiedEmptySubdir(rootHandle, ".staging", createdDev, createdIno, true)
+			}
+			return nil, syncErr
+		}
+	} else if err != nil {
+		return nil, ErrUnavailable
+	}
+	staging, _, err := openVerifiedSubdir(rootHandle, ".staging")
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	return staging, nil
+}
+
+func removeVerifiedMarkerInSubdir(subRoot *os.Root, dev, ino uint64, hasID bool, sha string) {
+	if subRoot == nil || !hasID || sha == "" {
+		return
+	}
+	mf, merr := subRoot.OpenFile("producer.json", os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if merr != nil {
+		return
+	}
+	mfi, serr := mf.Stat()
+	if serr == nil && mfi.Mode().IsRegular() && mfi.Mode().Perm()&0077 == 0 && ownedByCurrentUser(mfi) && mfi.Size() > 0 && mfi.Size() <= 4096 {
+		if mDev, mIno, okM := statDevIno(mfi); okM && mDev == dev && mIno == ino {
+			mRaw, rerr := io.ReadAll(io.LimitReader(mf, 4097))
+			if rerr == nil && sha256Hex(string(mRaw)) == sha {
+				_ = mf.Close()
+				_ = subRoot.Remove("producer.json")
+				return
+			}
+		}
+	}
+	_ = mf.Close()
+}
+
+func removeVerifiedEmptySubdir(rootHandle *os.Root, name string, expectDev, expectIno uint64, hasID bool) {
+	if rootHandle == nil || name == "" {
+		return
+	}
+	curFI, err := rootHandle.Lstat(name)
+	if err != nil || !curFI.IsDir() || curFI.Mode()&os.ModeSymlink != 0 || curFI.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(curFI) {
+		return
+	}
+	if curDev, curIno, okCur := statDevIno(curFI); okCur && hasID && (curDev != expectDev || curIno != expectIno) {
+		return
+	}
+	_ = rootHandle.Remove(name)
+}
+
+func isProducerOwnedReceiptFile(childName string, reviewBucket bool) bool {
+	if reviewBucket {
+		return childName == "receipt.json" || childName == "seal.sha256" || childName == "seal.pending.json" || childName == "producer.json"
+	}
+	return childName == "receipt.json" || childName == "producer.json"
+}
+
+func readDirFromRoot(r *os.Root) ([]os.DirEntry, error) {
+	f, err := r.Open(".")
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	return f.ReadDir(-1)
+}
+
+func inspectProducerReceiptSubdir(rootHandle *os.Root, name string, reviewBucket bool) (*os.Root, uint64, uint64, time.Time, map[string]verifiedLeafChild, bool) {
+	if rootHandle == nil || !isProducerBucketDirName(name, reviewBucket) {
+		return nil, 0, 0, time.Time{}, nil, false
+	}
+	subRoot, fi, err := openVerifiedSubdir(rootHandle, name)
+	if err != nil {
+		return nil, 0, 0, time.Time{}, nil, false
+	}
+	subDev, subIno, _ := statDevIno(fi)
+	lastMod := fi.ModTime()
+	children, err := readDirFromRoot(subRoot)
+	if err != nil {
+		_ = subRoot.Close()
+		return nil, 0, 0, time.Time{}, nil, false
+	}
+	verified := make(map[string]verifiedLeafChild, len(children))
+	hasReceipt := false
+	hasProducerMarker := false
+	hasSealFile := false
+	hasSealPending := false
+	var receiptRaw []byte
+	var sealPendingRaw []byte
+	var reviewDisk ReviewReceipt
+	var sealPendingDisk ReviewReceipt
+	var reviewSealed bool
+	for _, child := range children {
+		childName := child.Name()
+		if !isProducerOwnedReceiptFile(childName, reviewBucket) {
+			_ = subRoot.Close()
+			return nil, 0, 0, time.Time{}, nil, false
+		}
+		cfi, cerr := subRoot.Lstat(childName)
+		if cerr != nil || !cfi.Mode().IsRegular() || cfi.Mode()&os.ModeSymlink != 0 || cfi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(cfi) {
+			_ = subRoot.Close()
+			return nil, 0, 0, time.Time{}, nil, false
+		}
+		if cfi.ModTime().After(lastMod) {
+			lastMod = cfi.ModTime()
+		}
+		if childName == "receipt.json" {
+			raw, fDev, fIno, fHasID, ok := readPrivateRegularFileInSubdir(subRoot, childName, maxReviewReceiptBytes)
+			if !ok {
+				_ = subRoot.Close()
+				return nil, 0, 0, time.Time{}, nil, false
+			}
+			if reviewBucket {
+				var disk ReviewReceipt
+				if decodeExactReceiptJSON(raw, reviewReceiptJSONKeys, &disk) != nil || !isValidProducerReviewReceipt(disk, name) {
+					_ = subRoot.Close()
+					return nil, 0, 0, time.Time{}, nil, false
+				}
+				reviewDisk = disk
+				reviewSealed = disk.Sealed
+				for _, ns := range []int64{disk.Started, disk.Finished, disk.SealedAt} {
+					if ns > 0 {
+						if t := time.Unix(0, ns); t.After(lastMod) {
+							lastMod = t
+						}
+					}
+				}
+			} else {
+				var disk Receipt
+				if decodeExactReceiptJSON(raw, preflightReceiptJSONKeys, &disk) != nil || !isValidProducerPreflightReceipt(disk, name) {
+					_ = subRoot.Close()
+					return nil, 0, 0, time.Time{}, nil, false
+				}
+				for _, ns := range []int64{disk.Started, disk.Finished} {
+					if ns > 0 {
+						if t := time.Unix(0, ns); t.After(lastMod) {
+							lastMod = t
+						}
+					}
+				}
+			}
+			hasReceipt = true
+			receiptRaw = raw
+			verified[childName] = verifiedLeafChild{name: childName, dev: fDev, ino: fIno, hasID: fHasID, sha256: sha256Hex(string(raw))}
+		} else if childName == "seal.pending.json" {
+			if !reviewBucket {
+				_ = subRoot.Close()
+				return nil, 0, 0, time.Time{}, nil, false
+			}
+			raw, fDev, fIno, fHasID, ok := readPrivateRegularFileInSubdir(subRoot, childName, maxReviewReceiptBytes)
+			if !ok {
+				_ = subRoot.Close()
+				return nil, 0, 0, time.Time{}, nil, false
+			}
+			var pendingDisk ReviewReceipt
+			if decodeExactReceiptJSON(raw, reviewReceiptJSONKeys, &pendingDisk) != nil || !isValidProducerReviewReceipt(pendingDisk, name) || !pendingDisk.Sealed {
+				_ = subRoot.Close()
+				return nil, 0, 0, time.Time{}, nil, false
+			}
+			for _, ns := range []int64{pendingDisk.Started, pendingDisk.Finished, pendingDisk.SealedAt} {
+				if ns > 0 {
+					if t := time.Unix(0, ns); t.After(lastMod) {
+						lastMod = t
+					}
+				}
+			}
+			sealPendingDisk = pendingDisk
+			sealPendingRaw = raw
+			hasSealPending = true
+			verified[childName] = verifiedLeafChild{name: childName, dev: fDev, ino: fIno, hasID: fHasID, sha256: sha256Hex(string(raw))}
+		} else if childName == "producer.json" {
+			raw, fDev, fIno, fHasID, ok := readPrivateRegularFileInSubdir(subRoot, childName, 4096)
+			if !ok {
+				_ = subRoot.Close()
+				return nil, 0, 0, time.Time{}, nil, false
+			}
+			if reviewBucket {
+				var marker reviewReservationMarker
+				if decodeExactReceiptJSON(raw, reviewMarkerJSONKeys, &marker) != nil || marker.Schema != ReviewSchema || marker.Launch != name || marker.Started <= 0 {
+					_ = subRoot.Close()
+					return nil, 0, 0, time.Time{}, nil, false
+				}
+				if t := time.Unix(0, marker.Started); t.After(lastMod) {
+					lastMod = t
+				}
+			} else {
+				var marker preflightReservationMarker
+				if decodeExactReceiptJSON(raw, preflightMarkerJSONKeys, &marker) != nil || marker.Schema != Schema || marker.Session != name || marker.Started <= 0 {
+					_ = subRoot.Close()
+					return nil, 0, 0, time.Time{}, nil, false
+				}
+				if t := time.Unix(0, marker.Started); t.After(lastMod) {
+					lastMod = t
+				}
+			}
+			hasProducerMarker = true
+			verified[childName] = verifiedLeafChild{name: childName, dev: fDev, ino: fIno, hasID: fHasID, sha256: sha256Hex(string(raw))}
+		} else if childName == "seal.sha256" {
+			hasSealFile = true
+		}
+	}
+	if !hasReceipt && !hasProducerMarker {
+		_ = subRoot.Close()
+		return nil, 0, 0, time.Time{}, nil, false
+	}
+	if reviewBucket {
+		if reviewSealed {
+			if !hasSealFile || hasSealPending {
+				_ = subRoot.Close()
+				return nil, 0, 0, time.Time{}, nil, false
+			}
+			savedDigest, sDev, sIno, sHasID, okSeal := readVerifiedSealDigestWithIdentityFromRoot(subRoot)
+			if !okSeal || savedDigest != sha256Hex(string(receiptRaw)) {
+				_ = subRoot.Close()
+				return nil, 0, 0, time.Time{}, nil, false
+			}
+			verified["seal.sha256"] = verifiedLeafChild{name: "seal.sha256", dev: sDev, ino: sIno, hasID: sHasID, sha256: sha256Hex(savedDigest)}
+		} else if hasSealPending || hasSealFile {
+			// An interrupted seal is recognized ONLY when producer.json, a matching unsealed complete
+			// receipt.json, AND the exact staged seal.pending.json are present; when seal.sha256 is
+			// also present, its 64-byte digest MUST cryptographically match sha256(seal.pending.json).
+			if !hasProducerMarker || !hasReceipt || !hasSealPending || !reviewSealPendingMatchesReceipt(reviewDisk, sealPendingDisk) {
+				_ = subRoot.Close()
+				return nil, 0, 0, time.Time{}, nil, false
+			}
+			if hasSealFile {
+				savedDigest, sDev, sIno, sHasID, okSeal := readVerifiedSealDigestWithIdentityFromRoot(subRoot)
+				if !okSeal || savedDigest != sha256Hex(string(sealPendingRaw)) {
+					_ = subRoot.Close()
+					return nil, 0, 0, time.Time{}, nil, false
+				}
+				verified["seal.sha256"] = verifiedLeafChild{name: "seal.sha256", dev: sDev, ino: sIno, hasID: sHasID, sha256: sha256Hex(savedDigest)}
+			}
+		}
+	} else if hasSealFile || hasSealPending {
+		_ = subRoot.Close()
+		return nil, 0, 0, time.Time{}, nil, false
+	}
+	return subRoot, subDev, subIno, lastMod, verified, true
+}
+
+func inspectProducerReceiptDir(dir, name string, reviewBucket bool) (time.Time, bool) {
+	rootHandle, _, _, err := openVerifiedPrivateRoot(filepath.Dir(dir))
+	if err != nil {
+		return time.Time{}, false
+	}
+	defer rootHandle.Close()
+	subRoot, _, _, lastMod, _, ok := inspectProducerReceiptSubdir(rootHandle, name, reviewBucket)
+	if !ok {
+		return time.Time{}, false
+	}
+	_ = subRoot.Close()
+	return lastMod, true
+}
+
+func countRootBucketEntries(rootHandle *os.Root, reviewBucket bool) (int, []string, error) {
+	entries, err := readDirFromRoot(rootHandle)
+	if err != nil {
+		return 0, nil, err
+	}
+	names := make([]string, 0, len(entries))
+	for _, ent := range entries {
+		name := ent.Name()
+		if name == ".writer.lock" || name == ".staging" {
+			continue
+		}
+		if isReviewBucketName(name) != reviewBucket {
+			continue
+		}
+		names = append(names, name)
+	}
+	return len(names), names, nil
+}
+
+// removeVerifiedLeafSubdir atomically quarantines a verified, expired bucket directory out of
+// <root> into <root>/.staging/reclaim-<random> via descriptor-pinned renameatNoReplace BEFORE
+// deleting any child file, immediately confirms the quarantined directory matches the exact
+// inspected (subDev, subIno) before syncing or claiming quota, and then removes the verified
+// children in safe order via removeVerifiedFileInSubdir.
+func removeVerifiedLeafSubdir(rootHandle *os.Root, root, name string, reviewBucket bool, expectDev, expectIno uint64, checkExpectedID bool, retention time.Duration, checkRetention bool, expectedReceiptSHA string) bool {
+	subRoot, subDev, subIno, lastMod, verified, ok := inspectProducerReceiptSubdir(rootHandle, name, reviewBucket)
+	if !ok {
+		return false
+	}
+	if checkExpectedID && (subDev != expectDev || subIno != expectIno) {
+		_ = subRoot.Close()
+		return false
+	}
+	if expectedReceiptSHA != "" {
+		recCh, okRec := verified["receipt.json"]
+		if !okRec || recCh.sha256 != expectedReceiptSHA {
+			_ = subRoot.Close()
+			return false
+		}
+	}
+	if checkRetention && time.Now().Sub(lastMod) < retention {
+		_ = subRoot.Close()
+		return false
+	}
+	stagingRoot, err := ensureStagingDir(rootHandle, root)
+	if err != nil {
+		_ = subRoot.Close()
+		return false
+	}
+	defer stagingRoot.Close()
+	rootDirFD, _, _, _, err := openPinnedDirFD(rootHandle)
+	if err != nil {
+		_ = subRoot.Close()
+		return false
+	}
+	defer rootDirFD.Close()
+	stagingDirFD, _, _, _, err := openPinnedDirFD(stagingRoot)
+	if err != nil {
+		_ = subRoot.Close()
+		return false
+	}
+	defer stagingDirFD.Close()
+
+	// Re-confirm <root>/<name> still refers to the exact verified directory inode right before quarantine.
+	curFI, err := rootHandle.Lstat(name)
+	if err != nil || !curFI.IsDir() || curFI.Mode()&os.ModeSymlink != 0 || curFI.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(curFI) {
+		_ = subRoot.Close()
+		return false
+	}
+	if curDev, curIno, hasID := statDevIno(curFI); hasID && (curDev != subDev || curIno != subIno) {
+		_ = subRoot.Close()
+		return false
+	}
+
+	var reclaimName string
+	var releaseReclaim func()
+	moved := false
+	for i := 0; i < maxStagingCreateRetries; i++ {
+		tok, terr := randomQuarantineToken()
+		if terr != nil {
+			break
+		}
+		cand := fmt.Sprintf("reclaim-%d-%d-%s", os.Getpid(), tmpSeq.Add(1), tok)
+		trackStagingEntry(root, cand)
+		renErr := renameatNoReplacePinned(rootDirFD, name, stagingDirFD, cand)
+		if renErr == nil {
+			reclaimName = cand
+			releaseReclaim = func() { untrackStagingEntry(root, cand) }
+			moved = true
+			break
+		}
+		untrackStagingEntry(root, cand)
+		if os.IsExist(renErr) || errors.Is(renErr, syscall.ENOTEMPTY) {
+			continue
+		}
+		break
+	}
+	if !moved {
+		_ = subRoot.Close()
+		return false
+	}
+	defer releaseReclaim()
+
+	// Immediately confirm the directory that landed at .staging/<reclaimName> IS the exact inspected
+	// (subDev, subIno) BEFORE syncing, deleting any child, or counting the slot as reclaimed.
+	qFI, qErr := stagingRoot.Lstat(reclaimName)
+	if qErr != nil || !qFI.IsDir() || qFI.Mode()&os.ModeSymlink != 0 || qFI.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(qFI) {
+		_ = renameatNoReplacePinned(stagingDirFD, reclaimName, rootDirFD, name)
+		_ = subRoot.Close()
+		return false
+	}
+	if qDev, qIno, okQ := statDevIno(qFI); !okQ || qDev != subDev || qIno != subIno {
+		_ = renameatNoReplacePinned(stagingDirFD, reclaimName, rootDirFD, name)
+		_ = subRoot.Close()
+		return false
+	}
+	_ = syncPinnedDir(rootHandle, root)
+
+	// Delete ONLY the exact files verified during inspection (checked again while held open before unlinkat).
+	allClean := removeVerifiedChildrenInSafeOrder(subRoot, verified)
+	_ = subRoot.Close()
+	if allClean {
+		qFI2, qErr2 := stagingRoot.Lstat(reclaimName)
+		if qErr2 == nil && qFI2.IsDir() && qFI2.Mode()&os.ModeSymlink == 0 && qFI2.Mode().Perm()&0077 == 0 && ownedByCurrentUser(qFI2) {
+			if qDev, qIno, okQ := statDevIno(qFI2); !okQ || (qDev == subDev && qIno == subIno) {
+				if stagingRoot.Remove(reclaimName) == nil {
+					_ = syncPinnedDir(stagingRoot, filepath.Join(root, ".staging"))
+				}
+			}
+		}
+	}
+	return true
+}
+
+func reclaimExpiredBucketEntries(rootHandle *os.Root, root string, names []string, reviewBucket bool, needDirs, needFDs int, state *bucketReclaimState) (int, int) {
+	if (needDirs <= 0 && needFDs <= 0) || rootHandle == nil || len(names) == 0 {
+		return 0, 0
+	}
+	sweepOrphanStagingInRoot(rootHandle, root, false)
+	now := time.Now()
+	retention := preflightDiskRetention
+	if reviewBucket {
+		retention = reviewDiskRetention
+	}
+	var rootDev, rootIno uint64
+	if rf, rerr := rootHandle.Open("."); rerr == nil {
+		if rfi, serr := rf.Stat(); serr == nil {
+			rootDev, rootIno, _ = statDevIno(rfi)
+		}
+		_ = rf.Close()
+	}
+	if state != nil && len(state.cache) > maxReclaimCacheEntries {
+		state.cache = make(map[reclaimCacheKey]reclaimCacheEntry)
+	}
+	var pinnedSet map[string]struct{}
+	if reviewBucket && needFDs > 0 && reviewMu.TryLock() {
+		prefix := root + "\x00"
+		pinnedSet = make(map[string]struct{})
+		for k, b := range sealedBindings {
+			if b.dirFD != nil && strings.HasPrefix(k, prefix) && now.Sub(b.recordedAt) >= retention &&
+				pendingReviewLaunches[k] == nil && activeSealingKeys[k] == 0 && !reclaimingKeys[k] {
+				if ent := reviewLedger[k]; ent == nil || (ent.inFlight == 0 && !ent.sealing && now.Sub(ent.touched) >= retention) {
+					pinnedSet[strings.TrimPrefix(k, prefix)] = struct{}{}
+				}
+			}
+		}
+		for k, ent := range reviewLedger {
+			if ent != nil && ent.inFlight == 0 && !ent.sealing && strings.HasPrefix(k, prefix) && now.Sub(ent.touched) >= retention &&
+				pendingReviewLaunches[k] == nil && activeSealingKeys[k] == 0 && !reclaimingKeys[k] {
+				if b, ok := sealedBindings[k]; ok && now.Sub(b.recordedAt) < retention {
+					continue
+				}
+				pinnedSet[strings.TrimPrefix(k, prefix)] = struct{}{}
+			}
+		}
+		reviewMu.Unlock()
+	}
+	startIdx := 0
+	if state != nil && len(names) > 0 {
+		startIdx = state.cursor % len(names)
+	}
+	candidates := make([]expiredDiskCandidate, 0)
+	inspected := 0
+	visited := 0
+	inspectName := func(name string) bool {
+		// Fast Lstat pre-filter before any directory open or JSON parse:
+		// inspectProducerReceiptSubdir sets lastMod >= dir.ModTime(), so a directory whose
+		// ModTime is still within retention can never be eligible yet.
+		lfi, lerr := rootHandle.Lstat(name)
+		if lerr != nil || !lfi.IsDir() || lfi.Mode()&os.ModeSymlink != 0 || lfi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(lfi) {
+			return true
+		}
+		if now.Sub(lfi.ModTime()) < retention {
+			return true
+		}
+		lDev, lIno, _ := statDevIno(lfi)
+		mtimeNS := lfi.ModTime().UnixNano()
+		ck := reclaimCacheKey{rootDev: rootDev, rootIno: rootIno, name: name}
+		if state != nil {
+			if ce, hit := state.cache[ck]; hit && ce.dev == lDev && ce.ino == lIno && ce.mtimeNS == mtimeNS && now.Before(ce.skipUntil) {
+				return true
+			}
+		}
+		if inspected >= maxReclaimInspectPerCall {
+			return false
+		}
+		inspected++
+		subRoot, subDev, subIno, lastMod, verified, ok := inspectProducerReceiptSubdir(rootHandle, name, reviewBucket)
+		if !ok {
+			if state != nil {
+				state.cache[ck] = reclaimCacheEntry{dev: lDev, ino: lIno, mtimeNS: mtimeNS, skipUntil: now.Add(reclaimNegativeCooldown)}
+			}
+			return true
+		}
+		_ = subRoot.Close()
+		if now.Sub(lastMod) < retention {
+			if state != nil {
+				state.cache[ck] = reclaimCacheEntry{dev: lDev, ino: lIno, mtimeNS: mtimeNS, skipUntil: lastMod.Add(retention)}
+			}
+			return true
+		}
+		if state != nil {
+			delete(state.cache, ck)
+		}
+		candidates = append(candidates, expiredDiskCandidate{
+			name:       name,
+			dir:        filepath.Join(root, name),
+			ts:         lastMod.UnixNano(),
+			dev:        subDev,
+			ino:        subIno,
+			hasID:      subDev != 0 || subIno != 0,
+			receiptSHA: verified["receipt.json"].sha256,
+		})
+		return true
+	}
+	pinnedVisited := 0
+	if pinnedSet != nil {
+		// Prioritize entries that hold in-process pinned FDs so expired non-FD disk directories
+		// never crowd out FD reclamation within maxReclaimInspectPerCall, and track visited
+		// progress so state.cursor always advances past skipped batches on FD-only scans.
+		for i := 0; i < len(names); i++ {
+			idx := (startIdx + i) % len(names)
+			name := names[idx]
+			pinnedVisited++
+			if _, ok := pinnedSet[name]; !ok {
+				continue
+			}
+			if !inspectName(name) {
+				pinnedVisited--
+				break
+			}
+		}
+	}
+	if (needDirs > 0 || pinnedSet == nil) && inspected < maxReclaimInspectPerCall {
+		for i := 0; i < len(names); i++ {
+			idx := (startIdx + i) % len(names)
+			name := names[idx]
+			visited++
+			if pinnedSet != nil {
+				if _, already := pinnedSet[name]; already {
+					continue
+				}
+			}
+			if !inspectName(name) {
+				visited--
+				break
+			}
+		}
+		if state != nil && len(names) > 0 {
+			state.cursor = (startIdx + visited) % len(names)
+		}
+	} else if state != nil && len(names) > 0 && pinnedVisited > 0 {
+		state.cursor = (startIdx + pinnedVisited) % len(names)
+	}
+	if len(candidates) == 0 {
+		return 0, 0
+	}
+	// Selection-sort oldest-first (bounded by maxReclaimInspectPerCall).
+	for i := 0; i < len(candidates); i++ {
+		minIdx := i
+		for j := i + 1; j < len(candidates); j++ {
+			if candidates[j].ts < candidates[minIdx].ts {
+				minIdx = j
+			}
+		}
+		if minIdx != i {
+			candidates[i], candidates[minIdx] = candidates[minIdx], candidates[i]
+		}
+	}
+	reclaimedDirs := 0
+	releasedFDs := 0
+	for _, cand := range candidates {
+		if reclaimedDirs >= needDirs && releasedFDs >= needFDs {
+			break
+		}
+		var (
+			key                string
+			expectedEntry      *reviewEntry
+			hadBinding         bool
+			expectedBind       sealedDirBinding
+			expectedReceiptSHA string
+		)
+		if reviewBucket {
+			key = root + "\x00" + cand.name
+			// Use TryLock to prevent any lock-order cycle when called from persistWithStatusInRootLocked (holding another entry's mu).
+			// Reserve exclusive reclamation state for key so concurrent SealReviewWithDigest and admission paths
+			// are strictly mutually exclusive with quarantine; never delete ledger or sealed binding before quarantine succeeds.
+			if !reviewMu.TryLock() {
+				continue
+			}
+			if pendingReviewLaunches[key] != nil || activeSealingKeys[key] > 0 || reclaimingKeys[key] {
+				reviewMu.Unlock()
+				continue
+			}
+			if ent := reviewLedger[key]; ent != nil {
+				if ent.inFlight > 0 || ent.sealing || now.Sub(ent.touched) < retention {
+					reviewMu.Unlock()
+					continue
+				}
+				expectedEntry = ent
+			}
+			if b, ok := sealedBindings[key]; ok {
+				if now.Sub(b.recordedAt) < retention || b.rootDev != rootDev || b.rootIno != rootIno ||
+					(b.hasDirID && (!cand.hasID || b.dirDev != cand.dev || b.dirIno != cand.ino)) ||
+					b.receiptSHA == "" || cand.receiptSHA != b.receiptSHA {
+					reviewMu.Unlock()
+					continue
+				}
+				hadBinding = true
+				expectedBind = b
+				expectedReceiptSHA = b.receiptSHA
+			}
+			reclaimingKeys[key] = true
+			reviewMu.Unlock()
+		}
+		removed := removeVerifiedLeafSubdir(rootHandle, root, cand.name, reviewBucket, cand.dev, cand.ino, cand.hasID, retention, true, expectedReceiptSHA)
+		closedFDs := 0
+		if reviewBucket {
+			k := key
+			expEnt := expectedEntry
+			hadBind := hadBinding
+			expBind := expectedBind
+			cDev, cIno, cHasID := cand.dev, cand.ino, cand.hasID
+			rDev, rIno := rootDev, rootIno
+			finishReclaim := func() (fd1, fd2 *os.File) {
+				if removed && pendingReviewLaunches[k] == nil {
+					if ent := reviewLedger[k]; ent != nil && ent == expEnt && ent.inFlight == 0 && !ent.sealing {
+						delete(reviewLedger, k)
+						ent.mu.Lock()
+						fd1 = ent.boundDirFD
+						ent.boundDirFD = nil
+						ent.mu.Unlock()
+					}
+					if hadBind {
+						if cur, ok := sealedBindings[k]; ok && cur == expBind {
+							fd2 = cur.dirFD
+							delete(sealedBindings, k)
+						}
+					} else if cur, ok := sealedBindings[k]; ok {
+						if cur.rootDev == rDev && cur.rootIno == rIno && (!cur.hasDirID || !cHasID || (cur.dirDev == cDev && cur.dirIno == cIno)) {
+							fd2 = cur.dirFD
+							delete(sealedBindings, k)
+						}
+					}
+				}
+				delete(reclaimingKeys, k)
+				return fd1, fd2
+			}
+			if reviewMu.TryLock() {
+				fd1, fd2 := finishReclaim()
+				reviewMu.Unlock()
+				if fd1 != nil {
+					closeBudgetedPinnedDirFD(fd1)
+					closedFDs++
+				}
+				if fd2 != nil && fd2 != fd1 {
+					closeBudgetedPinnedDirFD(fd2)
+					closedFDs++
+				}
+			} else {
+				go func() {
+					reviewMu.Lock()
+					fd1, fd2 := finishReclaim()
+					reviewMu.Unlock()
+					closeBudgetedPinnedDirFD(fd1)
+					if fd2 != fd1 {
+						closeBudgetedPinnedDirFD(fd2)
+					}
+				}()
+			}
+		}
+		if removed {
+			reclaimedDirs++
+			releasedFDs += closedFDs
+		}
+	}
+	return reclaimedDirs, releasedFDs
+}
+
+func marshalReservationMarker(name string, started int64) ([]byte, error) {
+	if started <= 0 {
+		started = time.Now().UnixNano()
+	}
+	if ValidReviewLaunch(name) {
+		return json.Marshal(reviewReservationMarker{
+			Schema:  ReviewSchema,
+			Launch:  name,
+			Started: started,
+		})
+	}
+	if ValidPreflightSession(name) {
+		return json.Marshal(preflightReservationMarker{
+			Schema:  Schema,
+			Session: name,
+			Started: started,
+		})
+	}
+	return nil, ErrUnavailable
+}
+
+func reservePrivateDir(directory string, allowExisting bool) error {
+	directory = filepath.Clean(directory)
+	root, ok := cleanPrivateRoot(filepath.Dir(directory))
+	if !ok {
+		return ErrUnavailable
+	}
+	rootLease, err := acquirePrivateRootLease(root)
+	if err != nil {
+		return err
+	}
+	defer rootLease.Close()
+	subRoot, _, _, _, _, _, _, err := reserveStagedSubdirWithMarker(rootLease.dir, root, filepath.Base(directory), allowExisting, time.Now().UnixNano())
+	if err != nil {
+		return err
+	}
+	_ = subRoot.Close()
+	return nil
+}
+
+// reserveStagedSubdirWithMarker prepares a complete private 0700 directory containing an
+// atomically written, synced producer.json inside <root>/.staging/, then publishes that
+// directory into <root>/<name> via a non-overwriting descriptor-pinned renameat. A crash
+// at any point before publication leaves zero empty or half-marked directories under <root>.
+func reserveStagedSubdirWithMarker(rootHandle *os.Root, root, name string, allowExisting bool, started int64) (*os.Root, os.FileInfo, bool, uint64, uint64, bool, string, error) {
+	if rootHandle == nil || !isSingleBaseName(name) {
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	markerData, err := marshalReservationMarker(name, started)
+	if err != nil {
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	reviewBucket := isReviewBucketName(name)
+	capLimit := maxPreflightDiskEntries
+	if reviewBucket {
+		capLimit = maxReviewDiskEntries
+	}
+	bState := bucketStateFor(reviewBucket)
+	bState.mu.Lock()
+	_, statErr := rootHandle.Lstat(name)
+	if statErr == nil {
+		bState.mu.Unlock()
+		if !allowExisting {
+			return nil, nil, false, 0, 0, false, "", os.ErrExist
+		}
+		subRoot, subFI, checkErr := openVerifiedSubdir(rootHandle, name)
+		if checkErr != nil {
+			return nil, nil, false, 0, 0, false, "", ErrUnavailable
+		}
+		if err := syncPinnedDir(rootHandle, root); err != nil {
+			_ = subRoot.Close()
+			return nil, nil, false, 0, 0, false, "", err
+		}
+		return subRoot, subFI, false, 0, 0, false, "", nil
+	}
+	if !os.IsNotExist(statErr) {
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	existingCount, names, countErr := countRootBucketEntries(rootHandle, reviewBucket)
+	if countErr != nil {
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	fdNeed := 0
+	if reviewBucket {
+		fdBudget := int64(effectivePinnedDirFDBudget())
+		if fdBudget <= 0 {
+			bState.mu.Unlock()
+			return nil, nil, false, 0, 0, false, "", ErrUnavailable
+		}
+		if cur := pinnedDirFDs.Load(); cur >= fdBudget {
+			fdNeed = int(cur-fdBudget) + 1
+		}
+	}
+	diskNeed := 0
+	if existingCount >= capLimit {
+		diskNeed = existingCount - capLimit + 1
+	}
+	if diskNeed > 0 || fdNeed > 0 {
+		reclaimedDirs, _ := reclaimExpiredBucketEntries(rootHandle, root, names, reviewBucket, diskNeed, fdNeed, bState)
+		existingCount -= reclaimedDirs
+		if existingCount >= capLimit {
+			bState.mu.Unlock()
+			return nil, nil, false, 0, 0, false, "", ErrUnavailable
+		}
+		if reviewBucket && pinnedDirFDs.Load() >= int64(effectivePinnedDirFDBudget()) {
+			bState.mu.Unlock()
+			return nil, nil, false, 0, 0, false, "", ErrUnavailable
+		}
+	}
+	stagingRoot, err := ensureStagingDir(rootHandle, root)
+	if err != nil {
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", err
+	}
+	defer stagingRoot.Close()
+	rootDirFD, _, _, _, err := openPinnedDirFD(rootHandle)
+	if err != nil {
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	defer rootDirFD.Close()
+	stagingDirFD, _, _, _, err := openPinnedDirFD(stagingRoot)
+	if err != nil {
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	defer stagingDirFD.Close()
+
+	stageDirName, stageSubRoot, releaseStageDir, err := createStagingDir(stagingRoot, root)
+	if err != nil {
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	defer releaseStageDir()
+	stageSubFD, subDev, subIno, hasSubID, err := openPinnedDirFD(stageSubRoot)
+	if err != nil {
+		_ = stageSubRoot.Close()
+		_ = stagingRoot.Remove(stageDirName)
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	subFI, statSubErr := stageSubFD.Stat()
+	if statSubErr != nil {
+		_ = stageSubFD.Close()
+		_ = stageSubRoot.Close()
+		_ = stagingRoot.Remove(stageDirName)
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+
+	markerTmp, mf, releaseMarkerTmp, err := createStagingFile(stagingRoot, root, "pending-marker")
+	if err != nil {
+		_ = stageSubFD.Close()
+		_ = stageSubRoot.Close()
+		_ = stagingRoot.Remove(stageDirName)
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	mfi, mStatErr := mf.Stat()
+	_, errW := mf.Write(markerData)
+	errS := mf.Sync()
+	errC := mf.Close()
+	if mStatErr != nil || errW != nil || errS != nil || errC != nil {
+		_ = stagingRoot.Remove(markerTmp)
+		releaseMarkerTmp()
+		_ = stageSubFD.Close()
+		_ = stageSubRoot.Close()
+		_ = stagingRoot.Remove(stageDirName)
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	mDev, mIno, hasMID := statDevIno(mfi)
+	mSHA := sha256Hex(string(markerData))
+	if renErr := renameatPinned(stagingDirFD, markerTmp, stageSubFD, "producer.json"); renErr != nil {
+		_ = stagingRoot.Remove(markerTmp)
+		releaseMarkerTmp()
+		_ = stageSubFD.Close()
+		_ = stageSubRoot.Close()
+		_ = stagingRoot.Remove(stageDirName)
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", ErrUnavailable
+	}
+	releaseMarkerTmp()
+	_ = stageSubFD.Close()
+	if err := syncPinnedDir(stageSubRoot, filepath.Join(root, ".staging", stageDirName)); err != nil {
+		removeVerifiedMarkerInSubdir(stageSubRoot, mDev, mIno, hasMID, mSHA)
+		_ = stageSubRoot.Close()
+		_ = stagingRoot.Remove(stageDirName)
+		bState.mu.Unlock()
+		return nil, nil, false, 0, 0, false, "", err
+	}
+	pubErr := renameatNoReplacePinned(stagingDirFD, stageDirName, rootDirFD, name)
+	bState.mu.Unlock()
+	if pubErr != nil {
+		removeVerifiedMarkerInSubdir(stageSubRoot, mDev, mIno, hasMID, mSHA)
+		_ = stageSubRoot.Close()
+		_ = stagingRoot.Remove(stageDirName)
+		if allowExisting && (os.IsExist(pubErr) || errors.Is(pubErr, syscall.ENOTEMPTY)) {
+			subRoot, existFI, checkErr := openVerifiedSubdir(rootHandle, name)
+			if checkErr != nil {
+				return nil, nil, false, 0, 0, false, "", ErrUnavailable
+			}
+			if err := syncPinnedDir(rootHandle, root); err != nil {
+				_ = subRoot.Close()
+				return nil, nil, false, 0, 0, false, "", err
+			}
+			return subRoot, existFI, false, 0, 0, false, "", nil
+		}
+		if os.IsExist(pubErr) || errors.Is(pubErr, syscall.ENOTEMPTY) {
+			return nil, nil, false, 0, 0, false, "", os.ErrExist
+		}
+		return nil, nil, false, 0, 0, false, "", pubErr
+	}
+	if err := syncPinnedDir(rootHandle, root); err != nil {
+		removeVerifiedMarkerInSubdir(stageSubRoot, mDev, mIno, hasMID, mSHA)
+		_ = stageSubRoot.Close()
+		removeVerifiedEmptySubdir(rootHandle, name, subDev, subIno, hasSubID)
+		return nil, nil, false, 0, 0, false, "", err
+	}
+	return stageSubRoot, subFI, true, mDev, mIno, hasMID, mSHA, nil
+}
+
+// Start is called by the auth execution guard, not by an asynchronous usage sink.
+func (c *Collector) Start(ctx context.Context, provider, model string) (context.Context, *Execution, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.invalid || c.sealed || c.handlerDone || c.lifecycleDone || time.Now().After(c.deadline) {
+		c.invalid = true
+		return ctx, nil, ErrUnavailable
+	}
+	if c.strictCodex && c.active > 0 {
+		c.invalid = true
+		return ctx, nil, ErrUnavailable
+	}
+	if c.review != nil {
+		expected := "codex:" + model + "@chatgpt.com"
+		c.review.mu.Lock()
+		if c.review.sealed {
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if c.review.tainted {
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if provider != "codex" || c.expectedModel == "" || model != c.expectedModel || (model != "gpt-6.2-sol" && model != "gpt-6.2-astra") {
+			c.review.taintAndPersistLocked()
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if c.review.route != expected {
+			c.review.taintAndPersistLocked()
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if !c.review.reserved {
+			rootDir := filepath.Dir(c.directory)
+			rootLease, lerr := acquirePrivateRootLease(rootDir)
+			if lerr != nil {
+				c.review.mu.Unlock()
+				c.invalid = true
+				return ctx, nil, ErrUnavailable
+			}
+			subRoot, _, _, _, _, _, _, rerr := reserveStagedSubdirWithMarker(rootLease.dir, rootDir, c.review.launch, true, c.review.started)
+			rootLease.Close()
+			if rerr != nil {
+				c.review.mu.Unlock()
+				c.invalid = true
+				return ctx, nil, ErrUnavailable
+			}
+			_ = subRoot.Close()
+			c.review.reserved = true
+		}
+		c.review.mu.Unlock()
+		c.reserved = true
+	} else if !c.reserved {
+		rootDir := filepath.Dir(c.directory)
+		rootLease, err := acquirePrivateRootLease(rootDir)
+		if err != nil {
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		subRoot, subFI, _, mDev, mIno, hasMID, mSHA, err := reserveStagedSubdirWithMarker(rootLease.dir, rootDir, c.receipt.Session, false, c.receipt.Started)
+		rootLease.Close()
+		if err != nil {
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		subDev, subIno, hasSubID := statDevIno(subFI)
+		_ = subRoot.Close()
+		c.dirDev, c.dirIno, c.hasDirID = subDev, subIno, hasSubID
+		c.markerDev, c.markerIno, c.hasMarkerID, c.markerSHA256 = mDev, mIno, hasMID, mSHA
+		c.reserved = true
+	}
+	c.active++
+	c.executions++
+	c.attemptFailed = false
+	c.upstreamEOF = false
+	c.had2xxBody = false
+	c.lastAttemptRequiredProducer = false
+	c.lastAttemptProducerVerified = false
+	c.resetAttemptStreamStateLocked()
+	e := &Execution{c: c, provider: provider, model: model}
+	ctx = httptransport.WithDecorator(ctx, func(next http.RoundTripper) http.RoundTripper { return &transport{next: next, execution: e} })
+	return ctx, e, nil
+}
+
+func (e *Execution) End() {
+	c := e.c
+	c.mu.Lock()
+	if e.ended {
+		c.invalid = true
+		c.mu.Unlock()
+		return
+	}
+	e.ended = true
+	unterminatedPostComplete := false
+	if c.strictCodex && (len(c.sseDataLines) > 0 || c.sseHasEvent || c.sseBOMLen > 0) {
+		// Trailing SSE data, event header, or truncated UTF-8 BOM without closure is an invalid/incomplete event.
+		c.invalid = true
+		if c.sseBOMLen > 0 {
+			c.modelMismatch = true
+		}
+		if c.observedCompleted {
+			unterminatedPostComplete = true
+		}
+	}
+	producerMismatch := false
+	if c.strictCodex && (c.producerRequired || c.producerObserved) {
+		if c.producer.sawCompleted && c.consumer.sawCompleted &&
+			c.producer.responseID != "" && c.producer.responseID == c.consumer.responseID &&
+			c.producer.completedOutputSHA == c.consumer.completedOutputSHA &&
+			c.producer.completedOutputSHA == c.lastOutputSHA {
+			c.lastAttemptProducerVerified = true
+		} else {
+			c.lastAttemptProducerVerified = false
+			if c.observedCompleted {
+				c.modelMismatch = true
+				c.invalid = true
+				producerMismatch = true
+			}
+		}
+	}
+	truncatedStream := false
+	if c.strictCodex && c.had2xxBody &&
+		!c.observedCompleted && !c.producer.sawFailure && !c.consumer.sawFailure {
+		c.modelMismatch = true
+		c.invalid = true
+		truncatedStream = true
+	}
+	c.resetAttemptStreamStateLocked()
+	if e.attempts == 0 {
+		c.invalid = true
+	}
+	if unterminatedPostComplete || producerMismatch || truncatedStream {
+		// Hold c.active (keeping entry.inFlight > 0) until c.Taint() finishes persisting taint
+		// so concurrent HandlerDone() + SealReview can never race ahead and seal a prior clean turn.
+		c.mu.Unlock()
+		c.Taint()
+		c.mu.Lock()
+		c.active--
+		c.maybeReleaseReviewLocked()
+		c.mu.Unlock()
+		return
+	}
+	c.active--
+	c.publishLocked()
+	c.mu.Unlock()
+}
+
+type restoredBody struct {
+	io.Reader
+	io.Closer
+}
+
+func parseTopLevelJSONModel(raw []byte) string {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return ""
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok || delim != '{' {
+		return ""
+	}
+	found := ""
+	seenModel := false
+	for dec.More() {
+		keyTok, err := dec.Token()
+		if err != nil {
+			return ""
+		}
+		key, ok := keyTok.(string)
+		if !ok {
+			return ""
+		}
+		if key == "model" {
+			if seenModel {
+				return ""
+			}
+			seenModel = true
+			var value string
+			if err := dec.Decode(&value); err != nil {
+				return ""
+			}
+			found = value
+		} else {
+			var skip json.RawMessage
+			if err := dec.Decode(&skip); err != nil {
+				return ""
+			}
+		}
+	}
+	endTok, err := dec.Token()
+	if err != nil {
+		return ""
+	}
+	if endDelim, ok := endTok.(json.Delim); !ok || endDelim != '}' {
+		return ""
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return ""
+	}
+	return found
+}
+
+func parseTopLevelJSONReviewRequest(raw []byte) (string, bool) {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return "", false
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok || delim != '{' {
+		return "", false
+	}
+	foundModel := ""
+	seenModel := false
+	seenStream := false
+	streamTrue := false
+	for dec.More() {
+		keyTok, err := dec.Token()
+		if err != nil {
+			return "", false
+		}
+		key, ok := keyTok.(string)
+		if !ok {
+			return "", false
+		}
+		switch key {
+		case "model":
+			if seenModel {
+				return "", false
+			}
+			seenModel = true
+			var value string
+			if err := dec.Decode(&value); err != nil {
+				return "", false
+			}
+			foundModel = value
+		case "stream":
+			if seenStream {
+				return "", false
+			}
+			seenStream = true
+			var flag bool
+			if err := dec.Decode(&flag); err != nil {
+				return "", false
+			}
+			streamTrue = flag
+		default:
+			var skip json.RawMessage
+			if err := dec.Decode(&skip); err != nil {
+				return "", false
+			}
+		}
+	}
+	endTok, err := dec.Token()
+	if err != nil {
+		return "", false
+	}
+	if endDelim, ok := endTok.(json.Delim); !ok || endDelim != '}' {
+		return "", false
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return "", false
+	}
+	return foundModel, seenModel && seenStream && streamTrue
+}
+
+func decodeCodexWireBody(raw []byte, encoding string) ([]byte, bool) {
+	switch strings.ToLower(strings.TrimSpace(encoding)) {
+	case "", "identity":
+		return raw, true
+	case "zstd":
+		dec, err := zstd.NewReader(bytes.NewReader(raw), zstd.WithDecoderMaxMemory(64<<20))
+		if err != nil {
+			return nil, false
+		}
+		defer dec.Close()
+		out, err := io.ReadAll(io.LimitReader(dec, maxOutboundModelBody+1))
+		if err != nil || len(out) > maxOutboundModelBody {
+			return nil, false
+		}
+		return out, true
+	case "gzip":
+		dec, err := gzip.NewReader(bytes.NewReader(raw))
+		if err != nil {
+			return nil, false
+		}
+		defer dec.Close()
+		out, err := io.ReadAll(io.LimitReader(dec, maxOutboundModelBody+1))
+		if err != nil || len(out) > maxOutboundModelBody {
+			return nil, false
+		}
+		return out, true
+	default:
+		return nil, false
+	}
+}
+
+func isExactCodexResponsesURL(u *url.URL) bool {
+	return u != nil &&
+		u.Opaque == "" &&
+		u.RawPath == "" &&
+		u.Path == "/backend-api/codex/responses" &&
+		u.EscapedPath() == "/backend-api/codex/responses" &&
+		!u.ForceQuery &&
+		u.RawQuery == "" &&
+		u.Fragment == "" &&
+		u.RawFragment == "" &&
+		u.RequestURI() == "/backend-api/codex/responses"
+}
+
+func codexOutboundModel(req *http.Request) string {
+	if req.Method != http.MethodPost || req.Body == nil {
+		return ""
+	}
+	if !isExactCodexResponsesURL(req.URL) {
+		return ""
+	}
+	orig := req.Body
+	raw, err := io.ReadAll(io.LimitReader(orig, maxOutboundModelBody+1))
+	if err != nil {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return ""
+	}
+	if len(raw) > maxOutboundModelBody {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return ""
+	}
+	_ = orig.Close()
+	req.Body = io.NopCloser(bytes.NewReader(raw))
+	decoded, ok := decodeCodexWireBody(raw, req.Header.Get("Content-Encoding"))
+	if !ok {
+		return ""
+	}
+	return parseTopLevelJSONModel(decoded)
+}
+
+// Only enums enter the collector. URL paths, bodies and auth identifiers never do.
+func route(provider, model string, req *http.Request) string {
+	if req.URL == nil || req.URL.Scheme != "https" || req.URL.User != nil || (req.URL.Port() != "" && req.URL.Port() != "443") {
+		return "other"
+	}
+	host := strings.ToLower(req.URL.Hostname())
+	if req.Host != "" && !strings.EqualFold(req.Host, req.URL.Host) {
+		return "other"
+	}
+	if provider == "codex" {
+		if host != "chatgpt.com" || req.Method != http.MethodPost || !isExactCodexResponsesURL(req.URL) || (model != "gpt-6.2-sol" && model != "gpt-6.2-astra") {
+			return "other"
+		}
+		if codexOutboundModel(req) != model {
+			return "other"
+		}
+		return "codex:" + model + "@chatgpt.com"
+	}
+	value := provider + "@" + host
+	switch value {
+	case "kimi@api.kimi.com", "kimi-ai@api.kimi.ai", "claude@api.anthropic.com", "antigravity@daily-cloudcode-pa.googleapis.com":
+		return value
+	default:
+		return "other"
+	}
+}
+
+type transport struct {
+	next      http.RoundTripper
+	execution *Execution
+}
+
+func isTLSVerificationError(err error) bool {
+	if err == nil {
+		return false
+	}
+	var certVerifyErr *tls.CertificateVerificationError
+	var recordHeaderErr tls.RecordHeaderError
+	var hostnameErr x509.HostnameError
+	var unknownAuthErr x509.UnknownAuthorityError
+	var certInvalidErr x509.CertificateInvalidError
+	var systemRootsErr x509.SystemRootsError
+	var constraintErr x509.ConstraintViolationError
+	return errors.As(err, &certVerifyErr) ||
+		errors.As(err, &recordHeaderErr) ||
+		errors.As(err, &hostnameErr) ||
+		errors.As(err, &unknownAuthErr) ||
+		errors.As(err, &certInvalidErr) ||
+		errors.As(err, &systemRootsErr) ||
+		errors.As(err, &constraintErr)
+}
+
+func (t *transport) RoundTrip(req *http.Request) (*http.Response, error) {
+	e, c := t.execution, t.execution.c
+	c.mu.Lock()
+	if c.invalid || c.sealed || e.ended || time.Now().After(c.deadline) || c.attempts >= MaxAttempts {
+		c.invalid = true
+		c.mu.Unlock()
+		return nil, ErrUnavailable
+	}
+	strict := c.strictCodex
+	c.mu.Unlock()
+	observed := route(e.provider, e.model, req)
+	if strict {
+		expected := "codex:" + e.model + "@chatgpt.com"
+		if e.provider != "codex" || (e.model != "gpt-6.2-sol" && e.model != "gpt-6.2-astra") || observed != expected {
+			c.Taint()
+			return nil, ErrUnavailable
+		}
+	}
+	c.mu.Lock()
+	if c.invalid || c.sealed || e.ended || time.Now().After(c.deadline) || c.attempts >= MaxAttempts {
+		c.invalid = true
+		c.mu.Unlock()
+		return nil, ErrUnavailable
+	}
+	c.attempts++
+	e.attempts++
+	c.bodies++
+	c.upstreamEOF = false
+	slot := len(c.receipt.Routes)
+	c.receipt.Routes = append(c.receipt.Routes, "other")
+	c.mu.Unlock()
+	resp, err := t.next.RoundTrip(req)
+	finish := func() { c.mu.Lock(); defer c.mu.Unlock(); c.bodies--; c.publishLocked() }
+	if err != nil {
+		if strict {
+			if observed != "other" && isTLSVerificationError(err) {
+				c.Taint()
+			} else {
+				c.Reject()
+			}
+		} else {
+			c.Reject()
+		}
+		finish()
+		return nil, err
+	}
+	if resp == nil {
+		c.Reject()
+		finish()
+		return nil, nil
+	}
+	if observed != "other" {
+		expectedHost := strings.ToLower(req.URL.Hostname())
+		tlsOK := resp.TLS != nil &&
+			resp.TLS.HandshakeComplete &&
+			len(resp.TLS.VerifiedChains) > 0 &&
+			len(resp.TLS.VerifiedChains[0]) > 0 &&
+			strings.EqualFold(resp.TLS.ServerName, expectedHost) &&
+			resp.TLS.VerifiedChains[0][0].VerifyHostname(expectedHost) == nil
+		if !tlsOK {
+			if resp.Body != nil {
+				_ = resp.Body.Close()
+			}
+			if strict {
+				c.Taint()
+			} else {
+				c.Reject()
+			}
+			finish()
+			return nil, ErrUnavailable
+		}
+	}
+	c.mu.Lock()
+	c.receipt.Routes[slot] = observed
+	if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+		c.had2xxBody = true
+	}
+	c.mu.Unlock()
+	if resp.Body == nil {
+		finish()
+	} else {
+		var markEOF func()
+		if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+			markEOF = c.MarkUpstreamEOF
+		}
+		resp.Body = &body{
+			ReadCloser:           resp.Body,
+			finish:               finish,
+			reject:               c.Reject,
+			taint:                c.Taint,
+			observedCompleted:    c.ObservedCompleted,
+			markEOF:              markEOF,
+			requireEOF:           true,
+			taintOnIncompleteEOF: strict && resp.StatusCode >= 200 && resp.StatusCode < 300,
+		}
+	}
+	return resp, nil
+}
+
+type body struct {
+	io.ReadCloser
+	once                 sync.Once
+	finish               func()
+	reject               func()
+	taint                func()
+	observedCompleted    func() bool
+	markEOF              func()
+	requireEOF           bool
+	taintOnIncompleteEOF bool
+	sawEOF               atomic.Bool
+	readErr              atomic.Bool
+}
+
+func (b *body) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if errors.Is(err, io.EOF) {
+		b.sawEOF.Store(true)
+	} else if err != nil {
+		b.readErr.Store(true)
+	}
+	return n, err
+}
+
+func (b *body) Close() error {
+	// Never block Close() on a synchronous Read against a potentially stalled upstream connection:
+	// strict callers must have already drained Read() to real io.EOF; otherwise fail closed immediately.
+	err := b.ReadCloser.Close()
+	if err != nil || (b.requireEOF && (b.readErr.Load() || !b.sawEOF.Load())) {
+		if b.requireEOF && b.taint != nil && (b.taintOnIncompleteEOF || (b.observedCompleted != nil && b.observedCompleted())) {
+			b.taint()
+		}
+		b.reject()
+	} else if b.requireEOF && b.markEOF != nil {
+		b.markEOF()
+	}
+	b.once.Do(b.finish)
+	return err
+}
+
+type diskReceiptState int
+
+const (
+	diskReceiptSafeToWrite diskReceiptState = iota
+	diskReceiptAlreadyTainted
+	diskReceiptPreserveUntouched
+)
+
+func (e *reviewEntry) inspectDiskReceiptBeforeWriteLocked(launchRoot *os.Root) diskReceiptState {
+	if launchRoot == nil {
+		return diskReceiptPreserveUntouched
+	}
+	if _, sealErr := launchRoot.Lstat("seal.sha256"); !errors.Is(sealErr, os.ErrNotExist) {
+		// An existing seal.sha256 (or unreadable entry) indicates sealed or foreign disk state;
+		// never overwrite or unlink it.
+		return diskReceiptPreserveUntouched
+	}
+	if _, pendErr := launchRoot.Lstat("seal.pending.json"); !errors.Is(pendErr, os.ErrNotExist) {
+		return diskReceiptPreserveUntouched
+	}
+	finfo, err := launchRoot.Lstat("receipt.json")
+	if !e.markerPersisted && e.lastPersistedSHA == "" {
+		if errors.Is(err, os.ErrNotExist) {
+			return diskReceiptSafeToWrite
+		}
+		// A receipt.json already exists even though this entry never wrote or loaded one:
+		// preserve it untouched so a stale or racing writer can never clobber sealed/foreign files.
+		return diskReceiptPreserveUntouched
+	}
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode()&os.ModeSymlink != 0 ||
+		finfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(finfo) ||
+		finfo.Size() <= 0 || finfo.Size() > maxReviewReceiptBytes {
+		return diskReceiptPreserveUntouched
+	}
+	f, err := launchRoot.OpenFile("receipt.json", os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return diskReceiptPreserveUntouched
+	}
+	fStat, statErr := f.Stat()
+	if statErr != nil || !fStat.Mode().IsRegular() || fStat.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fStat) || fStat.Size() <= 0 || fStat.Size() > maxReviewReceiptBytes {
+		_ = f.Close()
+		return diskReceiptPreserveUntouched
+	}
+	raw, readErr := io.ReadAll(io.LimitReader(f, maxReviewReceiptBytes+1))
+	_ = f.Close()
+	if readErr != nil || len(raw) == 0 || int64(len(raw)) > maxReviewReceiptBytes {
+		return diskReceiptPreserveUntouched
+	}
+	if e.lastPersistedSHA == "" || sha256Hex(string(raw)) != e.lastPersistedSHA {
+		return diskReceiptPreserveUntouched
+	}
+	var disk ReviewReceipt
+	if decodeExactReceiptJSON(raw, reviewReceiptJSONKeys, &disk) != nil || !isValidProducerReviewReceipt(disk, e.launch) {
+		return diskReceiptPreserveUntouched
+	}
+	if disk.Sealed {
+		return diskReceiptPreserveUntouched
+	}
+	if e.session != "" && disk.Session != "" && disk.Session != e.session {
+		return diskReceiptPreserveUntouched
+	}
+	if disk.Requests > e.requests {
+		return diskReceiptPreserveUntouched
+	}
+	if disk.Tainted {
+		return diskReceiptAlreadyTainted
+	}
+	return diskReceiptSafeToWrite
+}
+
+func (e *reviewEntry) invalidateDiskReceiptInRootLocked(launchRoot *os.Root) {
+	if e.foreignDisk || launchRoot == nil {
+		return
+	}
+	// Never call os.Truncate on receipt.json: Truncate follows symlinks, whereas Root.Remove
+	// unlinks only the directory entry inside the verified, descriptor-pinned launch directory.
+	// Retain producer.json so a failed taint persistence still leaves the launch directory
+	// non-reusable across restarts and safely reclaimable once past reviewDiskRetention.
+	_ = launchRoot.Remove("receipt.json")
+	_ = launchRoot.Remove("seal.sha256")
+	_ = launchRoot.Remove("seal.pending.json")
+	_ = syncPinnedDir(launchRoot, e.directory)
+}
+
+func (e *reviewEntry) invalidateDiskReceiptLocked() {
+	if e.foreignDisk {
+		return
+	}
+	rootHandle, _, _, err := openVerifiedPrivateRoot(filepath.Dir(e.directory))
+	if err != nil {
+		return
+	}
+	defer rootHandle.Close()
+	launchRoot, _, err := openVerifiedSubdir(rootHandle, filepath.Base(e.directory))
+	if err != nil {
+		return
+	}
+	defer launchRoot.Close()
+	e.invalidateDiskReceiptInRootLocked(launchRoot)
+}
+
+func (e *reviewEntry) persistLocked() error {
+	_, err := e.persistWithStatusLocked()
+	return err
+}
+
+func (e *reviewEntry) persistWithStatusLocked() (bool, error) {
+	if e.foreignDisk {
+		return false, ErrUnavailable
+	}
+	root, ok := cleanPrivateRoot(filepath.Dir(e.directory))
+	if !ok {
+		return false, ErrUnavailable
+	}
+	// Acquire single-writer root-directory flock FIRST and pin all disk mutations to the locked root lease.
+	// Never unlink or modify any file under root unless this process holds exclusive flock on root's inode.
+	rootLease, err := acquirePrivateRootLease(root)
+	if err != nil {
+		return false, ErrUnavailable
+	}
+	defer rootLease.Close()
+	return e.persistWithStatusInRootLocked(rootLease, root, false)
+}
+
+func (e *reviewEntry) persistWithStatusInRootLocked(rootLease *lockedRootLease, root string, syncSealAncestors bool) (bool, error) {
+	if e.foreignDisk || rootLease == nil || rootLease.dir == nil {
+		return false, ErrUnavailable
+	}
+	rootHandle := rootLease.dir
+
+	var launchRoot *os.Root
+	var launchDev, launchIno uint64
+	var hasLaunchID bool
+	invalidateOnFail := false
+	createdDir := false
+	createdMarker := false
+	var markerDev, markerIno uint64
+	var markerHasID bool
+	var markerSHA string
+	fail := func(renamed bool, err error) (bool, error) {
+		if invalidateOnFail && e.tainted && !e.foreignDisk {
+			e.invalidateDiskReceiptInRootLocked(launchRoot)
+		}
+		if createdDir && !renamed && !e.markerPersisted && e.lastPersistedSHA == "" {
+			if createdMarker {
+				removeVerifiedMarkerInSubdir(launchRoot, markerDev, markerIno, markerHasID, markerSHA)
