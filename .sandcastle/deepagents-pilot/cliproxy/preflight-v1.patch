+func isValidReviewResponseIDs(ids []string, count int, last string) bool {
+	if count < 1 || count > maxReviewResponseIDs || len(ids) != count || ids[len(ids)-1] != last {
+		return false
+	}
+	for _, id := range ids {
+		if !isSHA256Hex(id) {
+			return false
+		}
+	}
+	return true
+}
+
+func isValidProducerReviewReceipt(disk ReviewReceipt, launch string) bool {
+	if disk.Schema != ReviewSchema || disk.Launch != launch {
+		return false
+	}
+	if disk.Started <= 0 || disk.Finished < disk.Started {
+		return false
+	}
+	if disk.Requests < 0 || disk.Requests > maxReviewResponseIDs {
+		return false
+	}
+	if disk.Session != "" && !reviewSessionPattern.MatchString(disk.Session) {
+		return false
+	}
+	if len(disk.Routes) != 1 {
+		return false
+	}
+	route := disk.Routes[0]
+	isAllowedRoute := route == "codex:gpt-6.2-sol@chatgpt.com" || route == "codex:gpt-6.2-astra@chatgpt.com"
+	if disk.Sealed {
+		if disk.Tainted || !disk.Complete || !isAllowedRoute || !reviewSessionPattern.MatchString(disk.Session) {
+			return false
+		}
+		if disk.Finished-disk.Started > int64(MaxReviewDuration) || disk.SealedAt < disk.Finished {
+			return false
+		}
+		return isSHA256Hex(disk.LastResponseID) &&
+			isValidReviewResponseIDs(disk.ResponseIDSHAs, disk.Requests, disk.LastResponseID) &&
+			isOptionalSHA256Hex(disk.LastOutputSHA256)
+	}
+	if disk.SealedAt != 0 {
+		return false
+	}
+	if disk.Complete {
+		if disk.Tainted || !isAllowedRoute || !reviewSessionPattern.MatchString(disk.Session) {
+			return false
+		}
+		if disk.Finished-disk.Started > int64(MaxReviewDuration) {
+			return false
+		}
+		return isSHA256Hex(disk.LastResponseID) &&
+			isValidReviewResponseIDs(disk.ResponseIDSHAs, disk.Requests, disk.LastResponseID) &&
+			isOptionalSHA256Hex(disk.LastOutputSHA256)
+	}
+	return route == "other" && len(disk.ResponseIDSHAs) == 0 && disk.LastResponseID == "" && disk.LastOutputSHA256 == ""
+}
+
+func isValidProducerPreflightReceipt(disk Receipt, session string) bool {
+	if disk.Schema != Schema || disk.Session != session {
+		return false
+	}
+	if disk.Started <= 0 || disk.Finished < disk.Started || disk.Finished-disk.Started > int64(Lifetime) || !disk.Complete {
+		return false
+	}
+	if len(disk.Routes) < 1 || len(disk.Routes) > MaxAttempts {
+		return false
+	}
+	for _, r := range disk.Routes {
+		if !isValidProducerPreflightRoute(r) {
+			return false
+		}
+	}
+	return true
+}
+
+func openVerifiedPrivateRoot(root string) (*os.Root, uint64, uint64, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || pathHasDisallowedSymlink(cleanRoot) {
+		return nil, 0, 0, ErrUnavailable
+	}
+	r, err := os.OpenRoot(cleanRoot)
+	if err != nil {
+		return nil, 0, 0, err
+	}
+	df, err := r.Open(".")
+	if err != nil {
+		_ = r.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	fi, err := df.Stat()
+	_ = df.Close()
+	if err != nil || !fi.IsDir() || fi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fi) {
+		_ = r.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	rDev, rIno, hasRootID := statDevIno(fi)
+	if pathHasDisallowedSymlink(cleanRoot) {
+		_ = r.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	lfi, err := os.Lstat(cleanRoot)
+	if err != nil || !lfi.IsDir() || lfi.Mode()&os.ModeSymlink != 0 || lfi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(lfi) {
+		_ = r.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	if lDev, lIno, ok := statDevIno(lfi); ok && hasRootID && (lDev != rDev || lIno != rIno) {
+		_ = r.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	return r, rDev, rIno, nil
+}
+
+func openVerifiedSubdir(rootHandle *os.Root, name string) (*os.Root, os.FileInfo, error) {
+	if rootHandle == nil || name == "" || strings.ContainsRune(name, filepath.Separator) || name == "." || name == ".." {
+		return nil, nil, ErrUnavailable
+	}
+	lfi, err := rootHandle.Lstat(name)
+	if err != nil {
+		return nil, nil, err
+	}
+	if !lfi.IsDir() || lfi.Mode()&os.ModeSymlink != 0 || lfi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(lfi) {
+		return nil, nil, ErrUnavailable
+	}
+	sub, err := rootHandle.OpenRoot(name)
+	if err != nil {
+		return nil, nil, ErrUnavailable
+	}
+	df, err := sub.Open(".")
+	if err != nil {
+		_ = sub.Close()
+		return nil, nil, ErrUnavailable
+	}
+	fi, err := df.Stat()
+	_ = df.Close()
+	if err != nil || !fi.IsDir() || fi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fi) {
+		_ = sub.Close()
+		return nil, nil, ErrUnavailable
+	}
+	lDev, lIno, okL := statDevIno(lfi)
+	sDev, sIno, okS := statDevIno(fi)
+	if okL && okS && (lDev != sDev || lIno != sIno) {
+		_ = sub.Close()
+		return nil, nil, ErrUnavailable
+	}
+	return sub, fi, nil
+}
+
+func isSingleBaseName(name string) bool {
+	return name != "" && name != "." && name != ".." &&
+		!strings.ContainsRune(name, '/') &&
+		!strings.ContainsRune(name, filepath.Separator) &&
+		!strings.ContainsRune(name, 0)
+}
+
+func openPinnedDirFD(r *os.Root) (*os.File, uint64, uint64, bool, error) {
+	if r == nil {
+		return nil, 0, 0, false, ErrUnavailable
+	}
+	f, err := r.Open(".")
+	if err != nil {
+		return nil, 0, 0, false, ErrUnavailable
+	}
+	fi, statErr := f.Stat()
+	if statErr != nil || !fi.IsDir() || fi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fi) {
+		_ = f.Close()
+		return nil, 0, 0, false, ErrUnavailable
+	}
+	dev, ino, hasID := statDevIno(fi)
+	return f, dev, ino, hasID, nil
+}
+
+func renameatPinned(oldDir *os.File, oldName string, newDir *os.File, newName string) error {
+	if oldDir == nil || newDir == nil || !isSingleBaseName(oldName) || !isSingleBaseName(newName) {
+		return ErrUnavailable
+	}
+	err := unix.Renameat(int(oldDir.Fd()), oldName, int(newDir.Fd()), newName)
+	runtime.KeepAlive(oldDir)
+	runtime.KeepAlive(newDir)
+	return err
+}
+
+func renameatNoReplacePinned(oldDir *os.File, oldName string, newDir *os.File, newName string) error {
+	if oldDir == nil || newDir == nil || !isSingleBaseName(oldName) || !isSingleBaseName(newName) {
+		return ErrUnavailable
+	}
+	err := renameatNoReplace(int(oldDir.Fd()), oldName, int(newDir.Fd()), newName)
+	runtime.KeepAlive(oldDir)
+	runtime.KeepAlive(newDir)
+	return err
+}
+
+func linkatPinned(oldDir *os.File, oldName string, newDir *os.File, newName string) error {
+	if oldDir == nil || newDir == nil || !isSingleBaseName(oldName) || !isSingleBaseName(newName) {
+		return ErrUnavailable
+	}
+	err := unix.Linkat(int(oldDir.Fd()), oldName, int(newDir.Fd()), newName, 0)
+	runtime.KeepAlive(oldDir)
+	runtime.KeepAlive(newDir)
+	return err
+}
+
+func syncPinnedDir(r *os.Root, fullPath string) error {
+	if r == nil {
+		return ErrUnavailable
+	}
+	f, err := r.Open(".")
+	if err != nil {
+		return err
+	}
+	fi, statErr := f.Stat()
+	if statErr != nil || !fi.IsDir() || fi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fi) {
+		_ = f.Close()
+		return ErrUnavailable
+	}
+	syncErr := f.Sync()
+	closeErr := f.Close()
+	if syncErr != nil {
+		return syncErr
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	// Production never re-opens fullPath by name (syncDirFn is nil outside tests).
+	if syncDirFn != nil {
+		return syncDirFn(fullPath)
+	}
+	return nil
+}
+
+func checkPrivateDir(path string, allowMissing bool) (bool, error) {
+	if pathHasDisallowedSymlink(path) {
+		return false, ErrUnavailable
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		if allowMissing && os.IsNotExist(err) {
+			return false, nil
+		}
+		return false, ErrUnavailable
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(info) {
+		return false, ErrUnavailable
+	}
+	return true, nil
+}
+
+func loadReviewEntryFromRoot(rootHandle *os.Root, dir, launch, session string, now time.Time) (*reviewEntry, bool, error) {
+	if rootHandle == nil {
+		return nil, true, ErrUnavailable
+	}
+	var rootDev, rootIno uint64
+	var hasRootID bool
+	if rf, rerr := rootHandle.Open("."); rerr == nil {
+		if rfi, serr := rf.Stat(); serr == nil {
+			rootDev, rootIno, hasRootID = statDevIno(rfi)
+		}
+		_ = rf.Close()
+	}
+	subRoot, subFI, err := openVerifiedSubdir(rootHandle, launch)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil, false, nil
+		}
+		return nil, true, ErrUnavailable
+	}
+	defer subRoot.Close()
+	ent, onDisk, loadErr := loadReviewEntryFromSubRoot(subRoot, dir, launch, session, now)
+	if ent != nil && hasRootID {
+		if subDev, subIno, hasSubID := statDevIno(subFI); hasSubID {
+			ent.boundRootDev = rootDev
+			ent.boundRootIno = rootIno
+			ent.boundDirDev = subDev
+			ent.boundDirIno = subIno
+			ent.hasBoundDirID = true
+		}
+	}
+	return ent, onDisk, loadErr
+}
+
+func loadReviewEntryFromDisk(dir, launch, session string, now time.Time) (*reviewEntry, bool, error) {
+	root := filepath.Dir(dir)
+	rootHandle, _, _, err := openVerifiedPrivateRoot(root)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil, false, nil
+		}
+		return nil, true, ErrUnavailable
+	}
+	defer rootHandle.Close()
+	return loadReviewEntryFromRoot(rootHandle, dir, launch, session, now)
+}
+
+func loadReviewEntryFromSubRoot(subRoot *os.Root, dir, launch, session string, now time.Time) (*reviewEntry, bool, error) {
+	finfo, err := subRoot.Lstat("receipt.json")
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode()&os.ModeSymlink != 0 || finfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(finfo) || finfo.Size() <= 0 || finfo.Size() > maxReviewReceiptBytes {
+		return &reviewEntry{
+			directory:        dir,
+			launch:           launch,
+			session:          session,
+			started:          now.UnixNano(),
+			tainted:          true,
+			taintedPersisted: true,
+			foreignDisk:      true,
+			reserved:         true,
+			touched:          now,
+		}, true, nil
+	}
+	f, err := subRoot.OpenFile("receipt.json", os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, true, ErrUnavailable
+	}
+	fStat, statErr := f.Stat()
+	if statErr != nil || !fStat.Mode().IsRegular() || fStat.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fStat) || fStat.Size() <= 0 || fStat.Size() > maxReviewReceiptBytes {
+		_ = f.Close()
+		return nil, true, ErrUnavailable
+	}
+	raw, readErr := io.ReadAll(io.LimitReader(f, maxReviewReceiptBytes+1))
+	_ = f.Close()
+	if readErr != nil || len(raw) == 0 || int64(len(raw)) > maxReviewReceiptBytes {
+		return nil, true, ErrUnavailable
+	}
+	rawSHA := sha256Hex(string(raw))
+	var disk ReviewReceipt
+	decodeErr := decodeExactReceiptJSON(raw, reviewReceiptJSONKeys, &disk)
+	validProducer := decodeErr == nil && isValidProducerReviewReceipt(disk, launch)
+	if !validProducer || !disk.Sealed {
+		// Preserve any foreign/malformed/invalidly-sealed receipt untouched on disk; only allow
+		// crash-recovery tainting of a strictly verified unsealed producer receipt.
+		foreignReceipt := !validProducer || disk.Sealed
+		startedNS := now.UnixNano()
+		if validProducer && disk.Started > 0 {
+			startedNS = disk.Started
+		}
+		return &reviewEntry{
+			directory:        dir,
+			launch:           launch,
+			session:          disk.Session,
+			started:          startedNS,
+			requests:         disk.Requests,
+			tainted:          true,
+			taintedPersisted: (validProducer && disk.Tainted) || foreignReceipt,
+			foreignDisk:      foreignReceipt,
+			reserved:         true,
+			markerPersisted:  true,
+			lastPersistedSHA: rawSHA,
+			touched:          now,
+		}, true, nil
+	}
+	return &reviewEntry{
+		directory:         dir,
+		launch:            launch,
+		session:           disk.Session,
+		route:             disk.Routes[0],
+		started:           disk.Started,
+		finished:          disk.Finished,
+		sealedAt:          disk.SealedAt,
+		requests:          disk.Requests,
+		responseIDSHAs:    append([]string(nil), disk.ResponseIDSHAs...),
+		lastResponseIDSHA: disk.LastResponseID,
+		lastOutputSHA:     disk.LastOutputSHA256,
+		sealed:            true,
+		sealedFlag:        true,
+		sealedReceiptSHA:  rawSHA,
+		lastPersistedSHA:  rawSHA,
+		tainted:           false,
+		reserved:          true,
+		markerPersisted:   true,
+		touched:           now,
+	}, true, nil
+}
+
+func getOrCreateReviewEntry(root, launch, session string, now time.Time, acquire, rejectSealed bool) (*reviewEntry, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok {
+		return nil, ErrUnavailable
+	}
+	root = cleanRoot
+	key := root + "\x00" + launch
+	reviewMu.Lock()
+	defer reviewMu.Unlock()
+	if reclaimingKeys[key] {
+		return nil, ErrUnavailable
+	}
+	if entry := reviewLedger[key]; entry != nil {
+		if rejectSealed && (entry.sealedFlag || entry.sealing) {
+			return nil, errReviewSealed
+		}
+		entry.touched = now
+		if acquire {
+			entry.inFlight++
+		}
+		return entry, nil
+	}
+	if _, sealedBound := sealedBindings[key]; sealedBound {
+		if rejectSealed {
+			return nil, errReviewSealed
+		}
+		return nil, ErrUnavailable
+	}
+	if taintWriteOverflow {
+		return nil, ErrUnavailable
+	}
+	dir := filepath.Join(root, launch)
+	diskEntry, onDisk, err := loadReviewEntryFromDisk(dir, launch, session, now)
+	if err != nil {
+		return nil, err
+	}
+	if rejectSealed && onDisk && diskEntry != nil && diskEntry.sealedFlag {
+		return nil, errReviewSealed
+	}
+	if len(reviewLedger) >= maxReviewLedgerEntries {
+		var oldestKey string
+		var oldestTime time.Time
+		for k, v := range reviewLedger {
+			if v.inFlight > 0 || v.sealing {
+				continue
+			}
+			v.mu.Lock()
+			evictable := !(v.tainted && !v.taintedPersisted) && (v.sealed || v.tainted || (v.started > 0 && now.UnixNano()-v.started > int64(MaxReviewDuration)))
+			v.mu.Unlock()
+			if !evictable {
+				continue
+			}
+			if oldestKey == "" || v.touched.Before(oldestTime) {
+				oldestKey, oldestTime = k, v.touched
+			}
+		}
+		if oldestKey != "" {
+			evicted := reviewLedger[oldestKey]
+			delete(reviewLedger, oldestKey)
+			if evicted != nil {
+				evicted.mu.Lock()
+				evictedFD := evicted.boundDirFD
+				evicted.boundDirFD = nil
+				evicted.mu.Unlock()
+				closeBudgetedPinnedDirFD(evictedFD)
+			}
+		} else {
+			return nil, ErrUnavailable
+		}
+	}
+	entry := diskEntry
+	if !onDisk {
+		startedNS := now.UnixNano()
+		if st := pendingReviewLaunches[key]; st != nil && st.started > 0 && st.started < startedNS {
+			startedNS = st.started
+		}
+		entry = &reviewEntry{
+			directory: dir,
+			launch:    launch,
+			session:   session,
+			started:   startedNS,
+			touched:   now,
+		}
+		if st := pendingReviewLaunches[key]; st != nil && st.failedTurnSeq > 0 {
+			entry.failedTurnSeq = st.failedTurnSeq
+			entry.lastTurnFailed = true
+		}
+	}
+	if acquire {
+		entry.inFlight = 1
+	}
+	reviewLedger[key] = entry
+	return entry, nil
+}
+
+func finishReserveReviewEntry(root, key string, entry *reviewEntry) (*ReviewReservation, error) {
+	entry.mu.Lock()
+	if entry.sealed {
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	if entry.tainted {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	if entry.started > 0 && time.Now().UnixNano()-entry.started > int64(MaxReviewDuration) {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	if !entry.markerPersisted {
+		if lockErr := acquirePrivateRootLock(root); lockErr != nil || entry.persistLocked() != nil {
+			entry.mu.Unlock()
+			reviewMu.Lock()
+			if entry.inFlight > 0 {
+				entry.inFlight--
+			}
+			if entry.inFlight == 0 && !entry.sealing && !entry.sealedFlag && reviewLedger[key] == entry {
+				entry.mu.Lock()
+				canEvict := !entry.markerPersisted && !entry.tainted && !entry.sealed && entry.requests == 0
+				var evictFD *os.File
+				if canEvict {
+					evictFD = entry.boundDirFD
+					entry.boundDirFD = nil
+				}
+				entry.mu.Unlock()
+				if canEvict {
+					delete(reviewLedger, key)
+					closeBudgetedPinnedDirFD(evictFD)
+				}
+			}
+			reviewMu.Unlock()
+			return nil, ErrUnavailable
+		}
+	}
+	entry.mu.Unlock()
+	return &ReviewReservation{entry: entry}, nil
+}
+
+// ReserveExistingReview reserves an in-flight turn ONLY if launch already exists in the
+// in-memory ledger or on disk under root. For brand-new launches it returns (nil, false, nil)
+// without creating root or any launch directory on disk, so rejected pre-admission requests
+// cannot consume disk space or inodes.
+func ReserveExistingReview(root, launch string) (*ReviewReservation, bool, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) {
+		return nil, false, ErrUnavailable
+	}
+	root = cleanRoot
+	key := root + "\x00" + launch
+	now := time.Now()
+	reviewMu.Lock()
+	if reclaimingKeys[key] {
+		reviewMu.Unlock()
+		return nil, true, ErrUnavailable
+	}
+	pendingTainted := pendingReviewLaunches[key] != nil && pendingReviewLaunches[key].tainted
+	var pendingFailedSeq uint64
+	if st := pendingReviewLaunches[key]; st != nil {
+		pendingFailedSeq = st.failedTurnSeq
+	}
+	if entry := reviewLedger[key]; entry != nil {
+		if entry.sealedFlag || entry.sealing {
+			reviewMu.Unlock()
+			return nil, true, ErrUnavailable
+		}
+		entry.touched = now
+		entry.inFlight++
+		reviewMu.Unlock()
+		if pendingTainted {
+			entry.mu.Lock()
+			entry.taintAndPersistLocked()
+			entry.mu.Unlock()
+			releaseReview(entry)
+			return nil, true, ErrUnavailable
+		}
+		if pendingFailedSeq > 0 {
+			entry.mu.Lock()
+			if !entry.sealed && !entry.tainted && pendingFailedSeq > entry.failedTurnSeq {
+				entry.failedTurnSeq = pendingFailedSeq
+				latestPubSeq := uint64(0)
+				if len(entry.publishedTurns) > 0 {
+					latestPubSeq = entry.publishedTurns[len(entry.publishedTurns)-1].seq
+				}
+				entry.lastTurnFailed = entry.failedTurnSeq > latestPubSeq
+				if entry.lastTurnFailed {
+					if err := entry.persistLocked(); err != nil {
+						entry.taintAndPersistLocked()
+					}
+				}
+			}
+			entry.mu.Unlock()
+		}
+		res, err := finishReserveReviewEntry(root, key, entry)
+		return res, true, err
+	}
+	if _, sealedBound := sealedBindings[key]; sealedBound {
+		reviewMu.Unlock()
+		return nil, true, ErrUnavailable
+	}
+	overflowed := taintWriteOverflow
+	reviewMu.Unlock()
+	if overflowed || pendingTainted {
+		return nil, false, ErrUnavailable
+	}
+	rootExists, err := checkPrivateDir(root, true)
+	if err != nil {
+		return nil, false, ErrUnavailable
+	}
+	if !rootExists {
+		return nil, false, nil
+	}
+	dir := filepath.Join(root, launch)
+	if _, statErr := os.Lstat(dir); statErr != nil {
+		if os.IsNotExist(statErr) {
+			return nil, false, nil
+		}
+		return nil, false, ErrUnavailable
+	}
+	res, resErr := ReserveReview(root, launch)
+	return res, true, resErr
+}
+
+// TaintExistingReview taints launch if it already exists in the pending pre-admission wave,
+// in-memory ledger, or on disk under root. Brand-new launches with no active siblings rejected
+// before admission never allocate directories or files on disk. When an in-memory ledger entry
+// is found, inFlight is incremented BEFORE releasing reviewMu so concurrent SealReview cannot
+// race past the taint in the unlock window.
+func TaintExistingReview(root, launch string) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) {
+		return
+	}
+	root = cleanRoot
+	key := root + "\x00" + launch
+	reviewMu.Lock()
+	if reclaimingKeys[key] {
+		reviewMu.Unlock()
+		return
+	}
+	if _, sealedBound := sealedBindings[key]; sealedBound {
+		reviewMu.Unlock()
+		return
+	}
+	if st := pendingReviewLaunches[key]; st != nil {
+		st.tainted = true
+	}
+	if entry := reviewLedger[key]; entry != nil {
+		if entry.sealedFlag || entry.sealing {
+			reviewMu.Unlock()
+			return
+		}
+		entry.inFlight++
+		reviewMu.Unlock()
+		defer releaseReview(entry)
+		entry.mu.Lock()
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		return
+	}
+	reviewMu.Unlock()
+	rootExists, err := checkPrivateDir(root, true)
+	if err != nil || !rootExists {
+		return
+	}
+	if _, statErr := os.Lstat(filepath.Join(root, launch)); statErr != nil {
+		return
+	}
+	TaintReview(root, launch)
+}
+
+// ReserveReview atomically checks that the launch is neither sealed nor sealing nor rejected by
+// an overlapping pending request, persists the initial unsealed reservation marker on disk before
+// admitting the first request, and registers an in-flight request.
+func ReserveReview(root, launch string) (*ReviewReservation, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) {
+		return nil, ErrUnavailable
+	}
+	root = cleanRoot
+	key := root + "\x00" + launch
+	reviewMu.Lock()
+	if reclaimingKeys[key] {
+		reviewMu.Unlock()
+		return nil, ErrUnavailable
+	}
+	pendingTainted := pendingReviewLaunches[key] != nil && pendingReviewLaunches[key].tainted
+	_, sealedBound := sealedBindings[key]
+	reviewMu.Unlock()
+	if sealedBound {
+		return nil, ErrUnavailable
+	}
+	if pendingTainted {
+		TaintExistingReview(root, launch)
+		return nil, ErrUnavailable
+	}
+	if err := acquirePrivateRootLock(root); err != nil {
+		return nil, ErrUnavailable
+	}
+	entry, err := getOrCreateReviewEntry(root, launch, "", time.Now(), true, true)
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	reviewMu.Lock()
+	pendingTainted = pendingReviewLaunches[key] != nil && pendingReviewLaunches[key].tainted
+	reviewMu.Unlock()
+	if pendingTainted {
+		entry.mu.Lock()
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	return finishReserveReviewEntry(root, key, entry)
+}
+
+func acquireReview(entry *reviewEntry) {
+	if entry == nil {
+		return
+	}
+	reviewMu.Lock()
+	entry.inFlight++
+	reviewMu.Unlock()
+}
+
+func releaseReview(entry *reviewEntry) {
+	if entry == nil {
+		return
+	}
+	reviewMu.Lock()
+	if entry.inFlight > 0 {
+		entry.inFlight--
+	}
+	reviewMu.Unlock()
+}
+
+func (e *reviewEntry) taintAndPersistLocked() {
+	if e.sealed {
+		return
+	}
+	e.tainted = true
+	if e.foreignDisk {
+		e.taintedPersisted = true
+		closeBudgetedPinnedDirFD(e.boundDirFD)
+		e.boundDirFD = nil
+		return
+	}
+	if err := e.persistLocked(); err == nil || e.foreignDisk {
+		e.taintedPersisted = true
+		closeBudgetedPinnedDirFD(e.boundDirFD)
+		e.boundDirFD = nil
+	} else {
+		e.taintedPersisted = false
+	}
+}
+
+// ExtractInboundReviewModel reads, decodes (identity/zstd/gzip), and restores req.Body
+// before routing/normalization so the launch is bound to the exact client-requested model.
+func ExtractInboundReviewModel(req *http.Request) (string, bool) {
+	if req == nil || req.Method != http.MethodPost || req.Body == nil {
+		return "", false
+	}
+	orig := req.Body
+	raw, err := io.ReadAll(io.LimitReader(orig, maxOutboundModelBody+1))
+	if err != nil {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return "", false
+	}
+	if len(raw) > maxOutboundModelBody {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return "", false
+	}
+	_ = orig.Close()
+	req.Body = io.NopCloser(bytes.NewReader(raw))
+	decoded, ok := decodeCodexWireBody(raw, req.Header.Get("Content-Encoding"))
+	if !ok {
+		return "", false
+	}
+	model, streamTrue := parseTopLevelJSONReviewRequest(decoded)
+	if model == "" || !streamTrue {
+		return "", false
+	}
+	return model, true
+}
+
+// TaintReview permanently marks an unsealed valid review launch receipt as tainted.
+// Already-sealed terminal receipts are immutable and unaffected.
+// The in-memory ledger stays strictly bounded at maxReviewLedgerEntries; if the ledger is full
+// and taint persistence also fails on disk, taintWriteOverflow latches fail-closed for new sessions and seals.
+// Callers must invoke this only after request authentication.
+func TaintReview(root, launch string) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) {
+		return
+	}
+	root = cleanRoot
+	now := time.Now()
+	entry, err := getOrCreateReviewEntry(root, launch, "", now, true, true)
+	if errors.Is(err, errReviewSealed) {
+		return
+	}
+	if err == nil && entry != nil {
+		defer releaseReview(entry)
+		entry.mu.Lock()
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		return
+	}
+	rootLease, lockErr := acquirePrivateRootLease(root)
+	if lockErr != nil {
+		reviewMu.Lock()
+		taintWriteOverflow = true
+		reviewMu.Unlock()
+		return
+	}
+	defer rootLease.Close()
+	dir := filepath.Join(root, launch)
+	diskEntry, onDisk, loadErr := loadReviewEntryFromRoot(rootLease.dir, dir, launch, "", now)
+	if loadErr != nil {
+		reviewMu.Lock()
+		taintWriteOverflow = true
+		reviewMu.Unlock()
+		return
+	}
+	if onDisk && diskEntry != nil {
+		if (diskEntry.sealed && !diskEntry.tainted) || diskEntry.foreignDisk || diskEntry.taintedPersisted {
+			return
+		}
+		if _, persistErr := diskEntry.persistWithStatusInRootLocked(rootLease, root, false); persistErr != nil && !diskEntry.foreignDisk {
+			reviewMu.Lock()
+			taintWriteOverflow = true
+			reviewMu.Unlock()
+		}
+		return
+	}
+	temp := &reviewEntry{
+		directory: dir,
+		launch:    launch,
+		started:   now.UnixNano(),
+		tainted:   true,
+	}
+	if _, persistErr := temp.persistWithStatusInRootLocked(rootLease, root, false); persistErr != nil && !temp.foreignDisk {
+		reviewMu.Lock()
+		taintWriteOverflow = true
+		reviewMu.Unlock()
+	}
+}
+
+func openVerifiedRootParent(root string, rDev, rIno uint64) (*os.File, uint64, uint64, error) {
+	parent := filepath.Dir(root)
+	base := filepath.Base(root)
+	if parent == "" || parent == root || !isSingleBaseName(base) || pathHasDisallowedSymlink(root) {
+		return nil, 0, 0, ErrUnavailable
+	}
+	pf, err := os.OpenFile(parent, os.O_RDONLY|syscall.O_DIRECTORY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, 0, 0, ErrUnavailable
+	}
+	pfi, statErr := pf.Stat()
+	if statErr != nil || !pfi.IsDir() {
+		_ = pf.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	pDev, pIno, _ := statDevIno(pfi)
+	var childSt unix.Stat_t
+	fstatErr := unix.Fstatat(int(pf.Fd()), base, &childSt, unix.AT_SYMLINK_NOFOLLOW)
+	runtime.KeepAlive(pf)
+	if fstatErr != nil || childSt.Mode&unix.S_IFMT != unix.S_IFDIR || childSt.Mode&0077 != 0 || childSt.Uid != uint32(os.Geteuid()) {
+		_ = pf.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	if uint64(childSt.Dev) != rDev || uint64(childSt.Ino) != rIno {
+		_ = pf.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	if pathHasDisallowedSymlink(root) {
+		_ = pf.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	lfi, lerr := os.Lstat(root)
+	if lerr != nil || !lfi.IsDir() || lfi.Mode()&os.ModeSymlink != 0 || lfi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(lfi) {
+		_ = pf.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	if lDev, lIno, okL := statDevIno(lfi); okL && (lDev != rDev || lIno != rIno) {
+		_ = pf.Close()
+		return nil, 0, 0, ErrUnavailable
+	}
+	return pf, pDev, pIno, nil
+}
+
+func syncPinnedParentFD(parentFD *os.File, parentPath string) error {
+	if parentFD == nil {
+		return ErrUnavailable
+	}
+	fi, statErr := parentFD.Stat()
+	if statErr != nil || !fi.IsDir() {
+		return ErrUnavailable
+	}
+	if err := parentFD.Sync(); err != nil {
+		return err
+	}
+	if syncDirFn != nil {
+		return syncDirFn(parentPath)
+	}
+	return nil
+}
+
+func verifyRootStillBound(lock *heldRootLock, root string) error {
+	if lock == nil || lock.dir == nil || lock.parentFD == nil {
+		return ErrUnavailable
+	}
+	base := filepath.Base(root)
+	parent := filepath.Dir(root)
+	if !isSingleBaseName(base) || parent == "" || parent == root {
+		return ErrUnavailable
+	}
+	// Verify base(root) inside the exact pinned parent directory descriptor is still the locked root inode.
+	var childSt unix.Stat_t
+	fstatErr := unix.Fstatat(int(lock.parentFD.Fd()), base, &childSt, unix.AT_SYMLINK_NOFOLLOW)
+	runtime.KeepAlive(lock.parentFD)
+	if fstatErr != nil || childSt.Mode&unix.S_IFMT != unix.S_IFDIR || childSt.Mode&0077 != 0 || childSt.Uid != uint32(os.Geteuid()) {
+		return ErrUnavailable
+	}
+	if uint64(childSt.Dev) != lock.rootDev || uint64(childSt.Ino) != lock.rootIno {
+		return ErrUnavailable
+	}
+	// Also verify the configured path from / still reaches this exact parent & root (no ancestor rotation).
+	if pathHasDisallowedSymlink(root) {
+		return ErrUnavailable
+	}
+	pfi, perr := os.Stat(parent)
+	if perr != nil || !pfi.IsDir() {
+		return ErrUnavailable
+	}
+	if curPDev, curPIno, okP := statDevIno(pfi); okP && (curPDev != lock.parentDev || curPIno != lock.parentIno) {
+		return ErrUnavailable
+	}
+	rfi, rerr := os.Lstat(root)
+	if rerr != nil || !rfi.IsDir() || rfi.Mode()&os.ModeSymlink != 0 || rfi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(rfi) {
+		return ErrUnavailable
+	}
+	if curRDev, curRIno, okR := statDevIno(rfi); okR && (curRDev != lock.rootDev || curRIno != lock.rootIno) {
+		return ErrUnavailable
+	}
+	return nil
+}
+
+func syncSealAncestorsForSubRoot(rootLease *lockedRootLease, subRoot *os.Root, launch, dir, root string, expectDev, expectIno uint64, hasSubID bool) error {
+	if rootLease == nil || rootLease.dir == nil || rootLease.lock == nil || subRoot == nil {
+		return ErrUnavailable
+	}
+	if err := syncPinnedDir(subRoot, dir); err != nil {
+		return err
+	}
+	if err := syncPinnedDir(rootLease.dir, root); err != nil {
+		return err
+	}
+	parent := filepath.Dir(root)
+	if parent != "" && parent != root {
+		if err := syncPinnedParentFD(rootLease.lock.parentFD, parent); err != nil {
+			return err
+		}
+	}
+	// Confirm configured root and pinned parent STILL resolve to the exact locked root inode,
+	// AND launch inside rootLease.dir STILL resolves to the exact verified & synced subRoot inode.
+	if err := verifyRootStillBound(rootLease.lock, root); err != nil {
+		return err
+	}
+	curFI, err := rootLease.dir.Lstat(launch)
+	if err != nil || !curFI.IsDir() || curFI.Mode()&os.ModeSymlink != 0 || curFI.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(curFI) {
+		return ErrUnavailable
+	}
+	if curDev, curIno, okCur := statDevIno(curFI); okCur && hasSubID && (curDev != expectDev || curIno != expectIno) {
+		return ErrUnavailable
+	}
+	return nil
+}
+
+func readVerifiedSealDigestWithIdentityFromRoot(subRoot *os.Root) (string, uint64, uint64, bool, bool) {
+	if subRoot == nil {
+		return "", 0, 0, false, false
+	}
+	finfo, err := subRoot.Lstat("seal.sha256")
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode()&os.ModeSymlink != 0 || finfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(finfo) || finfo.Size() != 64 {
+		return "", 0, 0, false, false
+	}
+	f, err := subRoot.OpenFile("seal.sha256", os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return "", 0, 0, false, false
+	}
+	fStat, statErr := f.Stat()
+	if statErr != nil || !fStat.Mode().IsRegular() || fStat.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fStat) || fStat.Size() != 64 {
+		_ = f.Close()
+		return "", 0, 0, false, false
+	}
+	raw, readErr := io.ReadAll(io.LimitReader(f, 65))
+	_ = f.Close()
+	if readErr != nil || len(raw) != 64 {
+		return "", 0, 0, false, false
+	}
+	digest := string(raw)
+	if !isSHA256Hex(digest) {
+		return "", 0, 0, false, false
+	}
+	dev, ino, hasID := statDevIno(fStat)
+	return digest, dev, ino, hasID, true
+}
+
+func readVerifiedSealDigestFromRoot(subRoot *os.Root) (string, bool) {
+	digest, _, _, _, ok := readVerifiedSealDigestWithIdentityFromRoot(subRoot)
+	return digest, ok
+}
+
+func readVerifiedSealDigest(dir string) (string, bool) {
+	rootHandle, _, _, err := openVerifiedPrivateRoot(filepath.Dir(dir))
+	if err != nil {
+		return "", false
+	}
+	defer rootHandle.Close()
+	subRoot, _, err := openVerifiedSubdir(rootHandle, filepath.Base(dir))
+	if err != nil {
+		return "", false
+	}
+	defer subRoot.Close()
+	return readVerifiedSealDigestFromRoot(subRoot)
+}
+
+func verifyPinnedDirFDAlive(fd *os.File, expectDev, expectIno uint64) bool {
+	if fd == nil {
+		return false
+	}
+	fi, err := fd.Stat()
+	if err != nil || !fi.IsDir() {
+		return false
+	}
+	dev, ino, hasID := statDevIno(fi)
+	if !hasID || dev != expectDev || ino != expectIno {
+		return false
+	}
+	if st, ok := fi.Sys().(*syscall.Stat_t); ok && st.Nlink == 0 {
+		return false
+	}
+	return true
+}
+
+func sealedBindingMatches(existing, candidate sealedDirBinding) bool {
+	if existing.rootDev != candidate.rootDev || existing.rootIno != candidate.rootIno {
+		return false
+	}
+	if existing.receiptSHA != candidate.receiptSHA {
+		return false
+	}
+	if existing.hasDirID {
+		if !candidate.hasDirID || existing.dirDev != candidate.dirDev || existing.dirIno != candidate.dirIno {
+			return false
+		}
+	}
+	return true
+}
+
+func reserveSealedBindingSlotLocked(key string) (reserved bool, ok bool) {
+	if _, exists := sealedBindings[key]; exists {
+		return false, true
+	}
+	if reservedBindingKeys[key] {
+		return false, false
+	}
+	if len(sealedBindings)+len(reservedBindingKeys) >= effectivePinnedDirFDBudget() {
+		return false, false
+	}
+	reservedBindingKeys[key] = true
+	return true, true
+}
+
+func recordSealedBindingLocked(key string, b sealedDirBinding, now time.Time, hasReservation bool) (bool, *os.File) {
+	if existing, exists := sealedBindings[key]; exists {
+		if hasReservation {
+			delete(reservedBindingKeys, key)
+		}
+		if !sealedBindingMatches(existing, b) {
+			return false, b.dirFD
+		}
+		if existing.dirFD != nil && !verifyPinnedDirFDAlive(existing.dirFD, existing.dirDev, existing.dirIno) {
+			return false, b.dirFD
+		}
+		if !existing.hasDirID && b.hasDirID {
+			existing.dirDev = b.dirDev
+			existing.dirIno = b.dirIno
+			existing.hasDirID = true
+		}
+		var extraFD *os.File
+		if existing.dirFD == nil && b.dirFD != nil {
+			existing.dirFD = b.dirFD
+		} else if b.dirFD != nil && b.dirFD != existing.dirFD {
+			extraFD = b.dirFD
+		}
+		sealedBindings[key] = existing
+		return true, extraFD
+	}
+	// Never evict un-reclaimed sealed bindings based solely on age; bindings are only removed
+	// once reclaimExpiredBucketEntries confirms the exact bound directory has exited <root>.
+	if !hasReservation && len(sealedBindings)+len(reservedBindingKeys) >= effectivePinnedDirFDBudget() {
+		return false, b.dirFD
+	}
+	if hasReservation {
+		delete(reservedBindingKeys, key)
+	}
+	sealedBindings[key] = b
+	return true, nil
+}
+
+func verifySealedDiskReceiptInRoot(rootLease *lockedRootLease, dir, root, launch, session, expectedSHA string, expectDirDev, expectDirIno uint64, checkDirID bool, wantPinFD bool, now time.Time) (SealStatus, string, uint64, uint64, bool, *os.File) {
+	if rootLease == nil || rootLease.dir == nil || rootLease.lock == nil {
+		return SealUnavailable, "", 0, 0, false, nil
+	}
+	rootHandle := rootLease.dir
+	subRoot, subFI, err := openVerifiedSubdir(rootHandle, launch)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return SealRejected, "", 0, 0, false, nil
+		}
+		return SealUnavailable, "", 0, 0, false, nil
+	}
+	defer subRoot.Close()
+	subDev, subIno, hasSubID := statDevIno(subFI)
+	if checkDirID && (!hasSubID || subDev != expectDirDev || subIno != expectDirIno) {
+		return SealUnavailable, "", 0, 0, false, nil
+	}
+	diskEntry, onDisk, err := loadReviewEntryFromSubRoot(subRoot, dir, launch, session, now)
+	if err != nil {
+		return SealUnavailable, "", 0, 0, false, nil
+	}
+	if !onDisk || diskEntry == nil || !diskEntry.sealed || diskEntry.tainted || diskEntry.session != session {
+		return SealRejected, "", 0, 0, false, nil
+	}
+	if !isSHA256Hex(diskEntry.sealedReceiptSHA) {
+		return SealUnavailable, "", 0, 0, false, nil
+	}
+	savedDigest, ok := readVerifiedSealDigestFromRoot(subRoot)
+	if !ok || diskEntry.sealedReceiptSHA != savedDigest {
+		return SealRejected, "", 0, 0, false, nil
+	}
+	if expectedSHA != "" && savedDigest != expectedSHA {
+		return SealRejected, "", 0, 0, false, nil
+	}
+	// Always confirm launch, root, and pinned root-parent fsyncs plus active root/launch inode binding
+	// before returning SealOK (never skip fsync via in-memory flags on repeat SealReview calls).
+	if syncSealAncestorsForSubRoot(rootLease, subRoot, launch, dir, root, subDev, subIno, hasSubID) != nil {
+		return SealUnavailable, "", 0, 0, false, nil
+	}
+	var pinFD *os.File
+	if wantPinFD {
+		pfd, pDev, pIno, hasPID, pinErr := openBudgetedPinnedDirFD(subRoot)
+		if pinErr != nil || (hasPID && hasSubID && (pDev != subDev || pIno != subIno)) {
+			closeBudgetedPinnedDirFD(pfd)
+			return SealUnavailable, "", 0, 0, false, nil
+		}
+		pinFD = pfd
+	}
+	return SealOK, savedDigest, subDev, subIno, hasSubID, pinFD
+}
+
+// SealReview seals a formal review launch once all in-flight requests have completed.
+func SealReview(root, launch, session string) SealStatus {
+	st, _ := SealReviewWithDigest(root, launch, session)
+	return st
+}
+
+// SealReviewWithDigest seals a formal review launch once all in-flight requests have completed,
+// and returns the SHA-256 hex digest of the durably sealed receipt.json ONLY when status is SealOK
+// (after verifying root and receipt.json on disk and completing launch, root, and root-parent
+// directory fsyncs while holding the exclusive root writer lock on the exact same root & launch handles).
+func SealReviewWithDigest(root, launch, session string) (SealStatus, string) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) || !reviewSessionPattern.MatchString(session) {
+		return SealRejected, ""
+	}
+	root = cleanRoot
+	rootExists, err := checkPrivateDir(root, true)
+	if err != nil {
+		return SealUnavailable, ""
+	}
+	if !rootExists {
+		return SealRejected, ""
+	}
+	rootLease, err := acquirePrivateRootLease(root)
+	if err != nil {
+		return SealUnavailable, ""
+	}
+	defer rootLease.Close()
+	key := root + "\x00" + launch
+	now := time.Now()
+	reviewMu.Lock()
+	if reclaimingKeys[key] {
+		reviewMu.Unlock()
+		return SealUnavailable, ""
+	}
+	activeSealingKeys[key]++
+	defer func() {
+		reviewMu.Lock()
+		if activeSealingKeys[key] <= 1 {
+			delete(activeSealingKeys, key)
+		} else {
+			activeSealingKeys[key]--
+		}
+		reviewMu.Unlock()
+	}()
+	if st := pendingReviewLaunches[key]; st != nil && st.count > 0 {
+		reviewMu.Unlock()
+		return SealInFlight, ""
+	}
+	overflowed := taintWriteOverflow
+	entry := reviewLedger[key]
+	if entry != nil {
+		if entry.sealedFlag {
+			var wantPinFD bool
+			if existing, hasBind := sealedBindings[key]; hasBind {
+				if existing.dirFD != nil && !verifyPinnedDirFDAlive(existing.dirFD, existing.dirDev, existing.dirIno) {
+					reviewMu.Unlock()
+					return SealUnavailable, ""
+				}
+				wantPinFD = existing.dirFD == nil
+			} else {
+				wantPinFD = true
+			}
+			reservedSlot, slotOK := reserveSealedBindingSlotLocked(key)
+			if !slotOK {
+				reviewMu.Unlock()
+				return SealUnavailable, ""
+			}
+			reviewMu.Unlock()
+			slotReleased := false
+			releaseSlot := func() {
+				if reservedSlot && !slotReleased {
+					reviewMu.Lock()
+					delete(reservedBindingKeys, key)
+					reviewMu.Unlock()
+					slotReleased = true
+				}
+			}
+			defer releaseSlot()
+
+			entry.mu.Lock()
+			if !entry.sealed || entry.tainted || entry.session != session {
+				entry.mu.Unlock()
+				return SealRejected, ""
+			}
+			if !isSHA256Hex(entry.sealedReceiptSHA) {
+				entry.mu.Unlock()
+				return SealUnavailable, ""
+			}
+			if entry.hasSealedDirID && (rootLease.lock.rootDev != entry.sealedRootDev || rootLease.lock.rootIno != entry.sealedRootIno) {
+				entry.mu.Unlock()
+				return SealUnavailable, ""
+			}
+			st, digest, subDev, subIno, hasSubID, pinFD := verifySealedDiskReceiptInRoot(rootLease, entry.directory, root, launch, session, entry.sealedReceiptSHA, entry.sealedDirDev, entry.sealedDirIno, entry.hasSealedDirID, wantPinFD, now)
+			if st != SealOK {
+				if pinFD != nil {
+					_ = pinFD.Close()
+				}
+				entry.mu.Unlock()
+				return st, ""
+			}
+			entry.sealSynced = true
+			if !entry.hasSealedDirID && hasSubID {
+				entry.sealedRootDev = rootLease.lock.rootDev
+				entry.sealedRootIno = rootLease.lock.rootIno
+				entry.sealedDirDev = subDev
+				entry.sealedDirIno = subIno
+				entry.hasSealedDirID = true
+			}
+			if pinFD == nil && entry.boundDirFD != nil {
+				pinFD = entry.boundDirFD
+				entry.boundDirFD = nil
+			}
+			entry.mu.Unlock()
+			// Always release entry.mu BEFORE acquiring reviewMu (canonical lock order: reviewMu -> entry.mu).
+			reviewMu.Lock()
+			if cur := reviewLedger[key]; cur != nil && cur != entry {
+				if reservedSlot {
+					delete(reservedBindingKeys, key)
+					slotReleased = true
+				}
+				reviewMu.Unlock()
+				if pinFD != nil {
+					_ = pinFD.Close()
+				}
+				return SealUnavailable, ""
+			}
+			recorded, extraFD := recordSealedBindingLocked(key, sealedDirBinding{
+				rootDev:    rootLease.lock.rootDev,
+				rootIno:    rootLease.lock.rootIno,
+				dirDev:     subDev,
+				dirIno:     subIno,
