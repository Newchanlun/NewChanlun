+func TestReviewReceiptMalformedOrTypeMismatchedEventCannotProduceCleanReceipt(t *testing.T) {
+	// Astra P1 (R22): malformed JSON data lines or frames with non-null error + type-mismatched
+	// sibling fields MUST NOT be silently skipped by ObserveStreamChunk; they must invalidate and taint.
+	// Meanwhile, legitimate OpenAI Responses non-message items (e.g. reasoning/function_call without
+	// array content) must continue to pass cleanly.
+	root := filepath.Join(t.TempDir(), "receipts")
+
+	runTurn := func(t *testing.T, launch, session string, chunks []string) (SealStatus, ReviewReceipt) {
+		t.Helper()
+		ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, e, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		cl := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+		})})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+		resp, err := cl.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, ch := range chunks {
+			c.ObserveStreamChunk([]byte(ch))
+		}
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+		e.End()
+		c.Complete(true)
+		c.HandlerDone(true)
+		return SealReview(root, launch, session), readReviewReceiptFile(t, root, launch)
+	}
+
+	// 1. Frame with non-null error AND type-mismatched sibling field (item is string, not object),
+	// followed by a clean response.completed -> MUST taint and reject.
+	st1, r1 := runTurn(t, "review-eeee1111-2222-4333-8444-555555555931", "019d0000-0000-7000-8000-000000000931", []string{
+		`data: {"type":"error","error":{"message":"boom"},"item":"unexpected-string"}` + "\n\n",
+		`data: {"type":"response.completed","response":{"id":"resp_m1","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+	})
+	if st1 != SealRejected || !r1.Tainted {
+		t.Fatalf("error + type-mismatched sibling failed to taint: st=%v r=%+v", st1, r1)
+	}
+
+	// 2. Truncated/corrupt JSON data frame -> MUST taint and reject even if response.completed follows.
+	st2, r2 := runTurn(t, "review-eeee1111-2222-4333-8444-555555555932", "019d0000-0000-7000-8000-000000000932", []string{
+		`data: {"type":"error","message":` + "\n\n",
+		`data: {"type":"response.completed","response":{"id":"resp_m2","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+	})
+	if st2 != SealRejected || !r2.Tainted {
+		t.Fatalf("malformed JSON data line failed to taint: st=%v r=%+v", st2, r2)
+	}
+
+	// 3. Legitimate SSE comments, event headers, [DONE], and non-message items (reasoning/function_call)
+	// with non-array content shapes MUST continue to seal cleanly.
+	st3, r3 := runTurn(t, "review-eeee1111-2222-4333-8444-555555555933", "019d0000-0000-7000-8000-000000000933", []string{
+		": keep-alive\n\nevent: response.created\n" + `data: {"type":"response.created","response":{"id":"resp_m3"}}` + "\n\n",
+		`data: {"type":"response.output_item.done","item":{"type":"reasoning","summary":[],"content":"raw-encrypted"}}` + "\n\n",
+		`data: {"type":"response.output_item.done","item":{"type":"function_call","name":"shell","arguments":"{}"}}` + "\n\n",
+		`data: {"type":"response.completed","response":{"id":"resp_m3","status":"completed","model":"gpt-6.2-sol","output":[{"type":"reasoning","content":"x"},{"type":"message","role":"assistant","content":[{"type":"output_text","text":"verified"}]}]}}` + "\n\n",
+		"data: [DONE]\n\n",
+	})
+	if st3 != SealOK || r3.Tainted || !r3.Complete || r3.LastOutputSHA256 != sha256Hex("verified") {
+		t.Fatalf("legitimate non-message items / SSE framing rejected: st=%v r=%+v", st3, r3)
+	}
+
+	// 4. Sol P2 (R22): data: null or empty/missing type (both before and after valid response.completed) MUST taint.
+	badFrames := []struct {
+		name   string
+		id     string
+		chunks []string
+	}{
