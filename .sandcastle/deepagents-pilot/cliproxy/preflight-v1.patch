+func testLeafCert(host string) *x509.Certificate {
+	testCertMu.Lock()
+	defer testCertMu.Unlock()
+	if cert, ok := testCertCache[host]; ok {
+		return cert
+	}
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		panic(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: host},
+		DNSNames:     []string{host},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		panic(err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		panic(err)
+	}
+	testCertCache[host] = cert
+	return cert
+}
+
+func verifiedTLSState(host string) *tls.ConnectionState {
+	cert := testLeafCert(host)
+	return &tls.ConnectionState{
+		HandshakeComplete: true,
+		ServerName:        host,
+		VerifiedChains:    [][]*x509.Certificate{{cert}},
+	}
+}
+
+type fakeTransport func(*http.Request) (*http.Response, error)
+
+func (f fakeTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	resp, err := f(r)
+	if err == nil && resp != nil && resp.TLS == nil && r.URL != nil && r.URL.Scheme == "https" {
+		resp.TLS = verifiedTLSState(strings.ToLower(r.URL.Hostname()))
+	}
+	return resp, err
+}
