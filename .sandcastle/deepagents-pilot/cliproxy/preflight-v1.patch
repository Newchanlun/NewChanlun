+		t.Run(tc.model, func(t *testing.T) {
+			res := request(tc.model, tc.session)
+			if res.Code != http.StatusOK || !strings.Contains(res.Body.String(), "response.completed") {
+				t.Fatalf("HTTP %d: %s", res.Code, res.Body.String())
