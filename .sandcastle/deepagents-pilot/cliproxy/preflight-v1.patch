+	sse := `data: {"type":"response.completed","response":{"id":"resp_eof","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}}` + "\n\n"
+
+	// 1. Executor closes early leaving unread trailing bytes on resp.Body -> MUST reject and refuse SealReview.
+	launchEarly := "review-eeee1111-2222-4333-8444-555555555911"
+	sessionEarly := "019d0000-0000-7000-8000-000000000911"
+	ctx1, c1, err := BeginReview(context.Background(), root, launchEarly, sessionEarly, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx1, e1, err := c1.Start(ctx1, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl1 := httptransport.Decorate(ctx1, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: 200, Header: make(http.Header),
+			Body: &partialBodyReader{data: []byte(sse + "data: {\"type\":\"error\"}\n\n")},
+		}, nil
+	})})
+	req1, _ := http.NewRequestWithContext(ctx1, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	resp1, err := cl1.Do(req1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, len(sse))
+	if _, err := io.ReadFull(resp1.Body, buf); err != nil {
+		t.Fatal(err)
+	}
+	c1.ObserveStreamChunk(buf)
+	// Close WITHOUT draining the trailing bytes to io.EOF.
+	_ = resp1.Body.Close()
+	e1.End()
+	c1.Complete(true)
+	c1.HandlerDone(true)
+	if st := SealReview(root, launchEarly, sessionEarly); st != SealRejected {
+		t.Fatalf("SealReview accepted early-closed body with unread tail: %v", st)
+	}
+
+	// 2. Upstream returns io.ErrUnexpectedEOF after response.completed -> MUST reject.
+	launchErr := "review-eeee1111-2222-4333-8444-555555555912"
+	sessionErr := "019d0000-0000-7000-8000-000000000912"
