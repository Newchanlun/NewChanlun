+		"data: " + `{"type":"response.in_progress","response":{"id":"resp_ooos","status":"in_progress","model":"gpt-6.2-sol","output":[{"id":"rs_ooos","type":"reasoning","status":"completed"},{"id":"msg_ooos","type":"message","role":"assistant","status":"completed","content":[{"type":"output_text","text":"VERDICT: PASS"}]}]}}` + "\n\n" +
