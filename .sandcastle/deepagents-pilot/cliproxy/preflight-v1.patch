+func TestReviewReceiptPinnedRootHandleSurvivesAncestorSwap(t *testing.T) {
+	// Sol P1 #1 + Astra P1 #1 (PR #2280 R38): once a root handle is pinned via acquirePrivateRootHandle,
+	// reclamation/removal MUST operate through that descriptor-pinned root inode even if an ancestor
+	// directory is renamed and replaced with a decoy directory containing the same launch name.
+	base := t.TempDir()
+	origParent := filepath.Join(base, "parent")
+	origRoot := filepath.Join(origParent, "receipts")
+	if err := os.Mkdir(origParent, 0700); err != nil {
+		t.Fatal(err)
+	}
+	launch := "review-a1111111-2222-4333-8444-555555555501"
+	res, err := ReserveReview(origRoot, launch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Release()
+
+	pinnedLease, err := acquirePrivateRootLease(origRoot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pinnedLease.Close()
+
+	// Rename origParent away and plant a decoy tree at the original path with the exact same launch name.
+	movedParent := filepath.Join(base, "moved-parent")
+	if err := os.Rename(origParent, movedParent); err != nil {
+		t.Fatal(err)
+	}
+	decoyRoot := filepath.Join(origParent, "receipts")
+	decoyLaunchDir := filepath.Join(decoyRoot, launch)
+	if err := os.MkdirAll(decoyLaunchDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	_ = os.Chmod(origParent, 0700)
+	_ = os.Chmod(decoyRoot, 0700)
+	_ = os.Chmod(decoyLaunchDir, 0700)
+	decoySentinel := filepath.Join(decoyLaunchDir, "receipt.json")
+	if err := os.WriteFile(decoySentinel, []byte("DO-NOT-DELETE-DECOY"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	// Removing via pinnedLease.dir MUST remove the moved original launch dir and NEVER touch decoyLaunchDir.
+	if !removeVerifiedLeafSubdir(pinnedLease.dir, origRoot, launch, true, 0, 0, false, 0, false, "") {
+		t.Fatalf("removeVerifiedLeafSubdir on pinned root failed after ancestor rename")
+	}
+	if _, err := os.Lstat(filepath.Join(movedParent, "receipts", launch)); !os.IsNotExist(err) {
+		t.Fatalf("original launch dir was not removed through pinned root: %v", err)
+	}
+	if got, err := os.ReadFile(decoySentinel); err != nil || string(got) != "DO-NOT-DELETE-DECOY" {
+		t.Fatalf("decoy tree at swapped ancestor path was modified: err=%v raw=%q", err, string(got))
+	}
+}
