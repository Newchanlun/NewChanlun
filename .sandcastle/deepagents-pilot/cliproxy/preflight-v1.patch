+func TestReviewReceiptFailureEventContradictoryStatusTaintsLaunch(t *testing.T) {
+	// Astra P1 #1 (PR #2280 R36): failure events (response.failed/incomplete/cancelled/error) carrying
+	// contradictory response.status (e.g. "completed") MUST fail strict validation and taint the launch,
+	// whereas a consistent response.failed (status:"failed") remains retryable.
+	root := filepath.Join(t.TempDir(), "receipts")
+	runTurn := func(t *testing.T, launch, session, evName, frame string, expectStrictOK, forwardConsumer bool) {
+		t.Helper()
+		ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+		if err != nil {
+			t.Fatalf("BeginReview(%s): %v", launch, err)
+		}
+		ctx, e, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatalf("Start(%s): %v", launch, err)
+		}
+		cl := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("")), TLS: verifiedTLSState("chatgpt.com")}, nil
+		})})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		resp, err := cl.Do(req)
+		if err != nil {
+			t.Fatalf("Do(%s): %v", launch, err)
+		}
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+		gotStrictOK := c.ValidateStrictEvent(evName, true, []byte(frame))
+		if gotStrictOK != expectStrictOK {
+			t.Fatalf("ValidateStrictEvent(%s) = %v, want %v", frame, gotStrictOK, expectStrictOK)
+		}
+		if forwardConsumer {
+			c.ObserveStreamChunk([]byte("event: " + evName + "\ndata: " + frame + "\n\n"))
+		}
+		e.End()
+		c.Complete(forwardConsumer && expectStrictOK)
+		c.HandlerDone(forwardConsumer && expectStrictOK)
+	}
+
+	for idx, tc := range []struct {
+		evName string
+		frame  string
+	}{
+		{"response.failed", `{"type":"response.failed","response":{"id":"resp_bad_1","status":"completed","model":"gpt-6.2-sol"}}`},
+		{"response.incomplete", `{"type":"response.incomplete","response":{"id":"resp_bad_2","status":"completed","model":"gpt-6.2-sol"}}`},
+		{"response.cancelled", `{"type":"response.cancelled","response":{"id":"resp_bad_3","status":"in_progress","model":"gpt-6.2-sol"}}`},
+		{"error", `{"type":"error","response":{"id":"resp_bad_4","status":"completed","model":"gpt-6.2-sol"}}`},
+	} {
+		launch := fmt.Sprintf("review-f4444444-2222-4333-8444-55555555550%d", idx)
+		session := fmt.Sprintf("019d0000-0000-7000-8000-99999999980%d", idx)
+		runTurn(t, launch, session, tc.evName, tc.frame, false, false)
+		// Launch MUST be permanently tainted: subsequent BeginReview MUST fail closed.
+		if _, _, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+			t.Fatalf("case %d: BeginReview after contradictory failure event = %v, want ErrUnavailable", idx, err)
+		}
+		if st := SealReview(root, launch, session); st != SealRejected {
+			t.Fatalf("case %d: SealReview after contradictory failure event = %v, want SealRejected", idx, st)
+		}
+	}
+
+	// Control: legitimate response.failed with status:"failed" is retryable and seals cleanly on turn 2.
+	okLaunch := "review-f4444444-2222-4333-8444-555555555509"
+	okSession := "019d0000-0000-7000-8000-999999999809"
+	runTurn(t, okLaunch, okSession, "response.failed", `{"type":"response.failed","response":{"id":"resp_fail_ok","status":"failed","model":"gpt-6.2-sol","error":{"message":"transient"}}}`, true, false)
+	runTurn(t, okLaunch, okSession, "response.completed", `{"type":"response.completed","response":{"id":"resp_retry_ok","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"VERDICT: PASS"}]}]}}`, true, true)
+	if st := SealReview(root, okLaunch, okSession); st != SealOK {
+		t.Fatalf("control retry after consistent response.failed = %v, want SealOK", st)
+	}
+}
