+func TestReviewReceiptObserveStreamChunkSingleBOMAcceptedDoubleAndTruncatedRejected(t *testing.T) {
+	// Sol P2 #1 (PR #2280 R51): Collector.ObserveStreamChunk must also strip at most one leading
+	// UTF-8 BOM (including split across chunks) and reject double BOM or truncated 0xEF at EOF.
+	frame := "event: response.completed\ndata: " + `{"type":"response.completed","response":{"id":"resp_obs_bom","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","phase":"final_answer","content":[{"type":"output_text","text":"VERDICT: PASS"}]}]}}` + "\n\n"
+
+	runCase := func(name, launch, session string, chunks [][]byte) SealStatus {
+		root := filepath.Join(t.TempDir(), name)
+		ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, e, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		cl := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("")), TLS: verifiedTLSState("chatgpt.com")}, nil
+		})})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		resp, err := cl.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+		for _, ch := range chunks {
+			c.ObserveStreamChunk(ch)
+		}
+		e.End()
+		c.Complete(true)
+		c.HandlerDone(true)
+		return SealReview(root, launch, session)
+	}
+
+	if st := runCase("single-bom-split", "review-faaaaaaa-2222-4333-8444-555555555501", "019d0000-0000-7000-8000-fffffffff601",
+		[][]byte{{0xEF}, append([]byte{0xBB, 0xBF}, []byte(frame)...)}); st != SealOK {
+		t.Fatalf("split single BOM SealReview = %v, want SealOK", st)
+	}
+	if st := runCase("double-bom", "review-faaaaaaa-2222-4333-8444-555555555502", "019d0000-0000-7000-8000-fffffffff602",
+		[][]byte{[]byte("\xef\xbb\xbf\xef\xbb\xbf" + frame)}); st != SealRejected {
+		t.Fatalf("double BOM SealReview = %v, want SealRejected", st)
+	}
+	if st := runCase("truncated-bom", "review-faaaaaaa-2222-4333-8444-555555555503", "019d0000-0000-7000-8000-fffffffff603",
+		[][]byte{{0xEF}}); st != SealRejected {
+		t.Fatalf("truncated 0xEF SealReview = %v, want SealRejected", st)
+	}
+}
