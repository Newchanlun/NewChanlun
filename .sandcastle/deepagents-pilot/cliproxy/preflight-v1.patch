+func TestReviewReceiptAtomicSealVsConcurrentBeginRace(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "receipts")
+	for i := 0; i < 40; i++ {
+		launch := fmt.Sprintf("review-dddd1111-2222-4333-8444-%012d", i)
+		session := fmt.Sprintf("019d0000-0000-7000-8000-%012d", i)
+		ctx, c0, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, e0, err := c0.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		cl := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+		})})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+		resp, err := cl.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		c0.ObserveStreamChunk([]byte(`data: {"type":"response.completed","response":{"id":"resp_race","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n"))
+		_ = resp.Body.Close()
+		e0.End()
+		c0.Complete(true)
+		c0.HandlerDone(true)
+
+		start := make(chan struct{})
+		var sealStatus SealStatus
+		var beginErr error
+		var c1 *Collector
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			<-start
+			sealStatus = SealReview(root, launch, session)
+		}()
+		go func() {
+			defer wg.Done()
+			<-start
+			_, c1, beginErr = BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+		}()
+		close(start)
+		wg.Wait()
+
+		// Mutual exclusion invariant: NEVER both SealOK and beginErr == nil.
+		if sealStatus == SealOK && beginErr == nil {
+			t.Fatalf("iteration %d: BOTH SealReview succeeded and BeginReview admitted concurrently!", i)
+		}
+		if beginErr == nil && c1 != nil {
+			c1.Complete(false)
+			c1.HandlerDone(false)
+		}
+	}
+}
