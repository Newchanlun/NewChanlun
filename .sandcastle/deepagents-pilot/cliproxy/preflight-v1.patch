+func TestReserveReview_PersistFailureDoesNotEvictConcurrentPersistedEntry(t *testing.T) {
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	launch := "review-12345678-1234-4234-8234-1234567890ef"
+	session := "019d0000-0000-7000-8000-000000000391"
+	key := root + "\x00" + launch
+	launchDir := filepath.Join(root, launch)
+
+	origSync := syncDirFn
+	defer func() { syncDirFn = origSync }()
+
+	inSync := make(chan struct{})
+	proceedSync := make(chan struct{})
+	var failOnce atomic.Bool
+	failOnce.Store(true)
+	syncDirFn = func(dir string) error {
+		if dir == launchDir && failOnce.CompareAndSwap(true, false) {
+			close(inSync)
+			<-proceedSync
+			return errors.New("injected first persist dir-sync error")
+		}
+		return origSync(dir)
+	}
+
+	req1Err := make(chan error, 1)
+	go func() {
+		_, err := ReserveReview(root, launch)
+		req1Err <- err
+	}()
+	<-inSync
+
+	// Grab the same ledger entry while req1 is inside persistLocked (holding entry.mu, not reviewMu).
+	entry, err := getOrCreateReviewEntry(root, launch, "", time.Now(), true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	reviewMu.Lock()
+	gotInFlight := entry.inFlight
+	reviewMu.Unlock()
+	if gotInFlight != 2 {
+		t.Fatalf("expected req1 + concurrent test inFlight == 2 (proving req1 entered persistLocked), got %d", gotInFlight)
+	}
+
+	// Hold reviewMu while letting req1 finish persistLocked and unlock entry.mu, so req1 blocks right at reviewMu.Lock().
+	reviewMu.Lock()
+	close(proceedSync)
+	// Acquiring entry.mu under reviewMu (global lock order) blocks until req1 has released entry.mu after computing error.
+	entry.mu.Lock()
+	// Simulate concurrent request persisting the entry and recording a completed request on disk.
+	entry.session = session
+	entry.route = "codex:gpt-6.2-sol@chatgpt.com"
+	entry.requests = 1
+	entry.responseIDSHAs = []string{strings.Repeat("a", 64)}
+	entry.lastResponseIDSHA = strings.Repeat("a", 64)
+	entry.lastOutputSHA = strings.Repeat("b", 64)
+	entry.finished = time.Now().UnixNano()
+	if persistErr := entry.persistLocked(); persistErr != nil {
+		entry.mu.Unlock()
+		reviewMu.Unlock()
+		t.Fatalf("concurrent persistLocked err = %v", persistErr)
+	}
+	entry.mu.Unlock()
+	// Release concurrent request's inFlight so req1 will observe entry.inFlight dropping to 0.
+	entry.inFlight--
+	reviewMu.Unlock()
+
+	if err := <-req1Err; !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("req1 ReserveReview err = %v, want ErrUnavailable", err)
+	}
+
+	// Entry MUST NOT have been evicted from reviewLedger when req1 observed inFlight==0.
+	reviewMu.Lock()
+	got := reviewLedger[key]
+	reviewMu.Unlock()
+	if got != entry {
+		t.Fatalf("reviewLedger[%q] was evicted despite concurrent persisted request", key)
+	}
+	if st := SealReview(root, launch, session); st != SealOK {
+		t.Fatalf("SealReview after concurrent persist = %v, want SealOK", st)
+	}
+}
