+			launch:   "review-a3333333-2222-4333-8444-555555555501",
+			session:  "019d0000-0000-7000-8000-555555555521",
+			sse2:     "data: " + `{"type":"response.failed","response":{"id":"resp_fm_t2","status":"failed","model":"gpt-6.2-astra","error":{"code":"server_error","message":"boom"}}}` + "\n\n",
+			wantSeal: preflightreceipt.SealRejected,
+		},
+		{
