+				serverLabel:      doneMeta.serverLabel,
+				argsSHA:          doneArgs.sha,
+				inputSHA:         doneInput.sha,
+				codeSHA:          doneCode.sha,
+				canonicalItemSHA: canonItemSHA,
+				outputIndex:      effIdx,
+				hasOutputIndex:   effHasIdx,
+				seq:              seq,
+				isFinal:          isFinalCandidate,
+				isAssistantMsg:   isAssistantMsg,
+				outputTextSHA:    outTextSHA,
+				doneDigest:       doneDigest,
+			})
+			if seq > t.maxItemSeq {
+				t.maxItemSeq = seq
+			}
+			if effHasIdx && (!t.hasMaxOutputIndex || effIdx > t.maxOutputIndex) {
+				t.maxOutputIndex = effIdx
+				t.hasMaxOutputIndex = true
+			}
+			t.sawStreamedOutputItem = true
+			if !isFinalCandidate {
+				if !t.recordNonFinal(seq, canonKey, effItemID, effIdx, effHasIdx, true) {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+			}
+			t.recomputeLastItemOutput()
+			c.mu.Unlock()
+			return
+		}
+	case "response.completed":
+		outText := extractAssistantOutputText(frame.respItems)
+		completedSHA := ""
+		if outText != "" {
+			completedSHA = sha256Hex(outText)
+		}
+		expected := c.expectedModel
+		otherRespID := c.producer.responseID
+		if !isConsumer {
+			otherRespID = ""
+		}
+		if frame.respStatus != "completed" || hasResponseError(frame.respErr) ||
+			expected == "" || frame.respModel != expected ||
+			frame.respID == "" || strings.TrimSpace(frame.respID) != frame.respID ||
+			(t.responseID != "" && t.responseID != frame.respID) ||
+			(otherRespID != "" && otherRespID != frame.respID) ||
+			!t.verifyCompletedOutput(frame.respItems, completedSHA) {
+			c.mu.Unlock()
+			c.taintStreamAnomaly()
+			return
+		}
+		hasPendingItems := len(t.pendingItems) > 0 || t.pendingUnkeyed > 0
+		finalOutputSHA := ""
+		if len(frame.respItems) > 0 {
+			finalOutputSHA = completedSHA
+		} else if !hasPendingItems && t.lastItemOutputSHA != "" && t.lastItemResponseID != "" && t.lastItemResponseID == frame.respID {
+			finalOutputSHA = t.lastItemOutputSHA
+		}
+		if isConsumer {
+			if c.producer.sawCompleted && (c.producer.responseID != frame.respID || c.producer.completedOutputSHA != finalOutputSHA) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		} else {
+			if c.consumer.sawCompleted && (c.consumer.responseID != frame.respID || c.consumer.completedOutputSHA != finalOutputSHA) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		}
+		t.sawCompleted = true
+		t.responseID = frame.respID
+		t.completedOutputSHA = finalOutputSHA
+		if isConsumer {
+			c.observedCompleted = true
+			c.lastResponseIDSHA = sha256Hex(frame.respID)
+			c.lastOutputSHA = finalOutputSHA
+		}
+		t.resetTracking()
+		c.mu.Unlock()
+		return
+	case "response.done":
+		c.mu.Unlock()
+		c.taintStreamAnomaly()
+		return
+	case "response.failed", "response.incomplete", "response.cancelled", "response.canceled", "error":
+		t.sawFailure = true
+		t.resetTracking()
+		if isConsumer {
+			c.invalid = true
+			alreadyCompleted := c.observedCompleted
+			c.mu.Unlock()
+			if alreadyCompleted {
+				c.Taint()
+			}
+			return
+		}
+		c.mu.Unlock()
+		return
+	default:
+		deltaKind, deltaItemType := classifyDeltaFrame(frame)
+		canonKey, effItemID, effIdx, effHasIdx, okBind := t.bindIdentity(frame.itemID, frame.outputIndex, frame.hasOutputIndex)
+		if !okBind || !t.recordItemKind(canonKey, deltaKind) || !t.recordItemType(canonKey, deltaItemType) {
+			c.mu.Unlock()
+			c.taintStreamAnomaly()
+			return
+		}
+		if canonKey != "" {
+			if _, alreadyDone := t.doneItemKeys[canonKey]; alreadyDone {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			if _, alreadyCompSub := t.completedSubItemKeys[canonKey]; alreadyCompSub {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			if _, alreadyFailed := t.failedItemKeys[canonKey]; alreadyFailed {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		}
+		cIdx := int64(0)
+		if frame.hasContentIndex {
+			cIdx = frame.contentIndex
+		}
+		switch frame.evType {
+		case "response.output_text.delta":
+			if !frame.hasEvDelta || !t.recordTextDelta(canonKey, cIdx, frame.evDelta) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.function_call_arguments.delta", "response.mcp_call_arguments.delta":
+			if !frame.hasEvDelta || !t.recordToolPayloadDelta(canonKey, "arguments", frame.evDelta) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.function_call_arguments.done", "response.mcp_call_arguments.done":
+			if !frame.hasEvArgs ||
+				(frame.evName != "" && !t.recordToolMeta(canonKey, toolItemMeta{name: frame.evName})) ||
+				!t.recordToolPayloadFinal(canonKey, "arguments", toolPayloadField{sha: "str:" + sha256Hex(frame.evArgs), str: frame.evArgs, isStr: true}) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.custom_tool_call_input.delta":
+			if !frame.hasEvDelta || !t.recordToolPayloadDelta(canonKey, "input", frame.evDelta) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.custom_tool_call_input.done":
+			if !frame.hasEvInput ||
+				!t.recordToolPayloadFinal(canonKey, "input", toolPayloadField{sha: "str:" + sha256Hex(frame.evInput), str: frame.evInput, isStr: true}) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.code_interpreter_call_code.delta":
+			if !frame.hasEvDelta || !t.recordToolPayloadDelta(canonKey, "code", frame.evDelta) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.code_interpreter_call_code.done":
+			if !frame.hasEvCode ||
+				!t.recordToolPayloadFinal(canonKey, "code", toolPayloadField{sha: "str:" + sha256Hex(frame.evCode), str: frame.evCode, isStr: true}) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.output_text.done":
+			if !frame.hasEvText || !t.recordContentPart(canonKey, cIdx, "output_text", frame.evText) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.refusal.delta", "response.refusal.done":
+			if !t.recordContentPart(canonKey, cIdx, "refusal", "") {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.audio.delta", "response.audio.done", "response.audio.transcript.delta", "response.audio.transcript.done":
+			if !t.recordContentPart(canonKey, cIdx, "output_audio", "") {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		case "response.content_part.added":
+			if frame.partFields == nil {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			pType, _ := exactOptionalString(frame.partFields, "type")
+			pText, _ := exactOptionalString(frame.partFields, "text")
+			if strings.TrimSpace(pType) == "" {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			if pType == "reasoning_text" || pType == "summary_text" {
+				// Non-assistant reasoning content part already bound to itemKindNonMessage/"reasoning".
+			} else if pType == "output_text" {
+				if !t.recordInitialText(canonKey, cIdx, pText) {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+			} else if pType == "refusal" || pType == "output_audio" || t.itemKindByKey[canonKey] != itemKindNonMessage {
+				if !t.recordContentPart(canonKey, cIdx, pType, "") {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+			}
+		case "response.content_part.done":
+			pType, _ := exactOptionalString(frame.partFields, "type")
+			pText, _ := exactOptionalString(frame.partFields, "text")
+			if frame.partFields == nil || pType == "" {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			if pType == "reasoning_text" || pType == "summary_text" {
+				// Non-assistant reasoning content part already bound to itemKindNonMessage/"reasoning".
+			} else if pType == "output_text" || pType == "refusal" || pType == "output_audio" || t.itemKindByKey[canonKey] != itemKindNonMessage {
+				if !t.recordContentPart(canonKey, cIdx, pType, pText) {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+			}
+		default:
+			if strings.HasSuffix(frame.evType, ".failed") ||
+				strings.HasSuffix(frame.evType, ".cancelled") ||
+				strings.HasSuffix(frame.evType, ".canceled") ||
+				strings.HasSuffix(frame.evType, ".incomplete") {
+				if canonKey == "" {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if _, alreadyCompletedSub := t.completedSubItemKeys[canonKey]; alreadyCompletedSub {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if _, exists := t.failedItemKeys[canonKey]; !exists && len(t.failedItemKeys) >= maxTrackedOutputItems {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if t.failedItemKeys == nil {
+					t.failedItemKeys = make(map[string]struct{})
+				}
+				t.failedItemKeys[canonKey] = struct{}{}
+			} else if strings.HasSuffix(frame.evType, ".completed") && canonKey != "" {
+				if _, failed := t.failedItemKeys[canonKey]; failed {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if _, exists := t.completedSubItemKeys[canonKey]; !exists && len(t.completedSubItemKeys) >= maxTrackedOutputItems {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if t.completedSubItemKeys == nil {
+					t.completedSubItemKeys = make(map[string]struct{})
+				}
+				t.completedSubItemKeys[canonKey] = struct{}{}
+			}
+		}
+		t.sawStreamedOutputItem = true
+		seq, okSeq := t.assignSeq(canonKey)
+		if !okSeq {
+			c.mu.Unlock()
+			c.taintStreamAnomaly()
+			return
+		}
+		if seq > t.maxItemSeq {
+			t.maxItemSeq = seq
+		}
+		if effHasIdx && (!t.hasMaxOutputIndex || effIdx > t.maxOutputIndex) {
+			t.maxOutputIndex = effIdx
+			t.hasMaxOutputIndex = true
+		}
+		if deltaKind == itemKindNonMessage {
+			if !t.recordNonFinal(seq, canonKey, effItemID, effIdx, effHasIdx, false) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+		}
+		alreadyDone := false
+		if canonKey != "" {
+			_, alreadyDone = t.doneItemKeys[canonKey]
+		}
+		if !alreadyDone {
+			if canonKey != "" {
+				if _, exists := t.pendingItems[canonKey]; !exists && len(t.pendingItems) >= maxTrackedOutputItems {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if t.pendingItems == nil {
+					t.pendingItems = make(map[string]struct{})
+				}
+				t.pendingItems[canonKey] = struct{}{}
+			} else {
+				if t.pendingUnkeyed >= maxTrackedOutputItems {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				t.pendingUnkeyed++
+			}
+		}
+		t.recomputeLastItemOutput()
+		c.mu.Unlock()
+		return
+	}
+}
+
+func (c *Collector) dispatchSSEEvent(evName string, hasEvName bool, dataLines [][]byte) {
+	c.mu.Lock()
+	alreadyTainted := c.modelMismatch && c.invalid
+	c.mu.Unlock()
+	if alreadyTainted {
+		return
+	}
+	if hasEvName && len(evName) > maxStrictIdentityBytes {
+		c.taintStreamAnomaly()
+		return
+	}
+	if len(dataLines) == 0 {
+		if hasEvName {
+			c.taintStreamAnomaly()
+		}
+		return
+	}
+	joined := bytes.TrimSpace(bytes.Join(dataLines, []byte{'\n'}))
+	if len(joined) == 0 {
+		if hasEvName {
+			c.taintStreamAnomaly()
+		}
+		return
+	}
+	if bytes.Equal(joined, []byte("[DONE]")) {
+		if hasEvName || !c.ObservedCompleted() {
+			c.taintStreamAnomaly()
+		}
+		return
+	}
+	frame, ok := c.validateStrictFrameIdentity(joined, false, false)
+	if !ok {
+		return
+	}
+	if hasEvName && evName != frame.evType {
+		c.taintStreamAnomaly()
+		return
+	}
+	c.applyStrictFrame(frame, true)
+}
+
+// ObserveStreamChunk frames SSE events on blank-line boundaries, validates explicit event names,
+// joins multi-line data fields per WHATWG SSE, records SHA-256 hashes of the upstream response ID
+// and final assistant output text, and verifies upstream response.model without persisting free text.
+func (c *Collector) ObserveStreamChunk(payload []byte) {
+	if c == nil || !c.strictCodex || payload == nil {
+		return
+	}
+	c.mu.Lock()
+	rawLines := c.splitSSEChunkLinesLocked(payload)
+	c.mu.Unlock()
+	for _, rawLine := range rawLines {
+		if len(rawLine) == 0 {
+			c.mu.Lock()
+			evName := c.sseEventName
+			hasEv := c.sseHasEvent
+			dataLines := c.sseDataLines
+			c.sseEventName = ""
+			c.sseHasEvent = false
+			c.sseDataLines = nil
+			c.sseDataBytes = 0
+			c.mu.Unlock()
+			c.dispatchSSEEvent(evName, hasEv, dataLines)
+			continue
+		}
+		if rawLine[0] == ':' {
+			continue
+		}
+		if bytes.HasPrefix(rawLine, []byte("event:")) {
+			val := string(stripSSEFieldValue(rawLine[6:]))
+			if len(val) > maxStrictIdentityBytes {
+				c.mu.Lock()
+				c.sseEventName = ""
+				c.sseHasEvent = false
+				c.sseDataLines = nil
+				c.sseDataBytes = 0
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				continue
+			}
+			c.mu.Lock()
+			c.sseEventName = val
+			c.sseHasEvent = true
+			c.mu.Unlock()
+			continue
+		}
+		if bytes.HasPrefix(rawLine, []byte("data:")) {
+			val := bytes.Clone(stripSSEFieldValue(rawLine[5:]))
+			overflow := false
+			c.mu.Lock()
+			if len(c.sseDataLines) >= maxSSEEventLines || c.sseDataBytes+len(val)+1 > maxSSEEventBytes {
+				overflow = true
+				c.sseEventName = ""
+				c.sseHasEvent = false
+				c.sseDataLines = nil
+				c.sseDataBytes = 0
+			} else {
+				c.sseDataLines = append(c.sseDataLines, val)
+				c.sseDataBytes += len(val) + 1
+			}
+			c.mu.Unlock()
+			if overflow {
+				c.taintStreamAnomaly()
+			}
+			continue
+		}
+		if bytes.HasPrefix(rawLine, []byte("id:")) || bytes.HasPrefix(rawLine, []byte("retry:")) {
+			continue
+		}
+		// Any unrecognized non-SSE line (such as bare JSON without data:) violates strict SSE framing.
+		c.mu.Lock()
+		c.sseEventName = ""
+		c.sseHasEvent = false
+		c.sseDataLines = nil
+		c.sseDataBytes = 0
+		c.mu.Unlock()
+		c.taintStreamAnomaly()
+	}
+}
+
+func ownedByCurrentUser(info os.FileInfo) bool {
+	if st, ok := info.Sys().(*syscall.Stat_t); ok {
+		return st.Uid == uint32(os.Geteuid())
+	}
+	return true
+}
+
+func checkPrivateDir(path string, allowMissing bool) (bool, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		if allowMissing && os.IsNotExist(err) {
+			return false, nil
+		}
+		return false, ErrUnavailable
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(info) {
+		return false, ErrUnavailable
+	}
+	return true, nil
+}
+
+func loadReviewEntryFromDisk(dir, launch, session string, now time.Time) (*reviewEntry, bool, error) {
+	root := filepath.Dir(dir)
+	rootExists, err := checkPrivateDir(root, true)
+	if err != nil {
+		return nil, true, ErrUnavailable
+	}
+	if !rootExists {
+		return nil, false, nil
+	}
+	dirExists, err := checkPrivateDir(dir, true)
+	if err != nil {
+		return nil, true, ErrUnavailable
+	}
+	if !dirExists {
+		return nil, false, nil
+	}
+	path := filepath.Join(dir, "receipt.json")
+	finfo, err := os.Lstat(path)
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode()&os.ModeSymlink != 0 || finfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(finfo) || finfo.Size() <= 0 || finfo.Size() > maxReviewReceiptBytes {
+		return &reviewEntry{
+			directory:        dir,
+			launch:           launch,
+			session:          session,
+			started:          now.UnixNano(),
+			tainted:          true,
+			taintedPersisted: true,
+			foreignDisk:      true,
+			reserved:         true,
+			touched:          now,
+		}, true, nil
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, true, ErrUnavailable
+	}
+	var disk ReviewReceipt
+	validResponseIDs := func(ids []string, count int, last string) bool {
+		if count < 1 || count > maxReviewResponseIDs || len(ids) != count || ids[len(ids)-1] != last {
+			return false
+		}
+		for _, id := range ids {
+			if !isSHA256Hex(id) {
+				return false
+			}
+		}
+		return true
+	}
+	unmarshalErr := json.Unmarshal(raw, &disk)
+	foreignReceipt := unmarshalErr != nil || disk.Schema != ReviewSchema || disk.Launch != launch
+	if foreignReceipt ||
+		disk.Tainted ||
+		!disk.Complete ||
+		!disk.Sealed ||
+		disk.Requests < 1 ||
+		disk.Started <= 0 ||
+		disk.Finished < disk.Started ||
+		disk.Finished-disk.Started > int64(MaxReviewDuration) ||
+		disk.SealedAt < disk.Finished ||
+		!reviewSessionPattern.MatchString(disk.Session) ||
+		!isSHA256Hex(disk.LastResponseID) ||
+		!validResponseIDs(disk.ResponseIDSHAs, disk.Requests, disk.LastResponseID) ||
+		!isOptionalSHA256Hex(disk.LastOutputSHA256) ||
+		len(disk.Routes) != 1 ||
+		(disk.Routes[0] != "codex:gpt-6.2-sol@chatgpt.com" && disk.Routes[0] != "codex:gpt-6.2-astra@chatgpt.com") {
+		return &reviewEntry{
+			directory:        dir,
+			launch:           launch,
+			session:          disk.Session,
+			started:          now.UnixNano(),
+			tainted:          true,
+			taintedPersisted: disk.Tainted || foreignReceipt,
+			foreignDisk:      foreignReceipt,
+			reserved:         true,
+			markerPersisted:  true,
+			touched:          now,
+		}, true, nil
+	}
+	return &reviewEntry{
+		directory:         dir,
+		launch:            launch,
+		session:           disk.Session,
+		route:             disk.Routes[0],
+		started:           disk.Started,
+		finished:          disk.Finished,
+		sealedAt:          disk.SealedAt,
+		requests:          disk.Requests,
+		responseIDSHAs:    append([]string(nil), disk.ResponseIDSHAs...),
+		lastResponseIDSHA: disk.LastResponseID,
+		lastOutputSHA:     disk.LastOutputSHA256,
+		sealed:            true,
+		sealedFlag:        true,
+		sealedReceiptSHA:  sha256Hex(string(raw)),
+		lastPersistedSHA:  sha256Hex(string(raw)),
+		tainted:           false,
+		reserved:          true,
+		markerPersisted:   true,
+		touched:           now,
+	}, true, nil
+}
+
+func getOrCreateReviewEntry(root, launch, session string, now time.Time, acquire, rejectSealed bool) (*reviewEntry, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok {
+		return nil, ErrUnavailable
+	}
+	root = cleanRoot
+	key := root + "\x00" + launch
+	reviewMu.Lock()
+	defer reviewMu.Unlock()
+	if entry := reviewLedger[key]; entry != nil {
+		if rejectSealed && (entry.sealedFlag || entry.sealing) {
+			return nil, errReviewSealed
+		}
+		entry.touched = now
+		if acquire {
+			entry.inFlight++
+		}
+		return entry, nil
+	}
+	if taintWriteOverflow {
+		return nil, ErrUnavailable
+	}
+	dir := filepath.Join(root, launch)
+	diskEntry, onDisk, err := loadReviewEntryFromDisk(dir, launch, session, now)
+	if err != nil {
+		return nil, err
+	}
+	if rejectSealed && onDisk && diskEntry != nil && diskEntry.sealedFlag {
+		return nil, errReviewSealed
+	}
+	if len(reviewLedger) >= maxReviewLedgerEntries {
+		var oldestKey string
+		var oldestTime time.Time
+		for k, v := range reviewLedger {
+			if v.inFlight > 0 || v.sealing {
+				continue
+			}
+			v.mu.Lock()
+			evictable := !(v.tainted && !v.taintedPersisted) && (v.sealed || v.tainted || (v.started > 0 && now.UnixNano()-v.started > int64(MaxReviewDuration)))
+			v.mu.Unlock()
+			if !evictable {
+				continue
+			}
+			if oldestKey == "" || v.touched.Before(oldestTime) {
+				oldestKey, oldestTime = k, v.touched
+			}
+		}
+		if oldestKey != "" {
+			delete(reviewLedger, oldestKey)
+		} else {
+			return nil, ErrUnavailable
+		}
+	}
+	entry := diskEntry
+	if !onDisk {
+		startedNS := now.UnixNano()
+		if st := pendingReviewLaunches[key]; st != nil && st.started > 0 && st.started < startedNS {
+			startedNS = st.started
+		}
+		entry = &reviewEntry{
+			directory: dir,
+			launch:    launch,
+			session:   session,
+			started:   startedNS,
+			touched:   now,
+		}
+		if st := pendingReviewLaunches[key]; st != nil && st.failedTurnSeq > 0 {
+			entry.failedTurnSeq = st.failedTurnSeq
+			entry.lastTurnFailed = true
+		}
+	}
+	if acquire {
+		entry.inFlight = 1
+	}
+	reviewLedger[key] = entry
+	return entry, nil
+}
+
+func finishReserveReviewEntry(root, key string, entry *reviewEntry) (*ReviewReservation, error) {
+	entry.mu.Lock()
+	if entry.sealed {
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	if entry.tainted {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	if entry.started > 0 && time.Now().UnixNano()-entry.started > int64(MaxReviewDuration) {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	if !entry.markerPersisted {
+		if lockErr := acquirePrivateRootLock(root); lockErr != nil || entry.persistLocked() != nil {
+			entry.mu.Unlock()
+			reviewMu.Lock()
+			if entry.inFlight > 0 {
+				entry.inFlight--
+			}
+			if entry.inFlight == 0 && !entry.sealing && !entry.sealedFlag && reviewLedger[key] == entry {
+				entry.mu.Lock()
+				canEvict := !entry.markerPersisted && !entry.tainted && !entry.sealed && entry.requests == 0
+				entry.mu.Unlock()
+				if canEvict {
+					delete(reviewLedger, key)
+				}
+			}
+			reviewMu.Unlock()
+			return nil, ErrUnavailable
+		}
+	}
+	entry.mu.Unlock()
+	return &ReviewReservation{entry: entry}, nil
+}
+
+// ReserveExistingReview reserves an in-flight turn ONLY if launch already exists in the
+// in-memory ledger or on disk under root. For brand-new launches it returns (nil, false, nil)
+// without creating root or any launch directory on disk, so rejected pre-admission requests
+// cannot consume disk space or inodes.
+func ReserveExistingReview(root, launch string) (*ReviewReservation, bool, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) {
+		return nil, false, ErrUnavailable
+	}
+	root = cleanRoot
+	key := root + "\x00" + launch
+	now := time.Now()
+	reviewMu.Lock()
+	pendingTainted := pendingReviewLaunches[key] != nil && pendingReviewLaunches[key].tainted
+	var pendingFailedSeq uint64
+	if st := pendingReviewLaunches[key]; st != nil {
+		pendingFailedSeq = st.failedTurnSeq
+	}
+	if entry := reviewLedger[key]; entry != nil {
+		if entry.sealedFlag || entry.sealing {
+			reviewMu.Unlock()
+			return nil, true, ErrUnavailable
+		}
+		entry.touched = now
+		entry.inFlight++
+		reviewMu.Unlock()
+		if pendingTainted {
+			entry.mu.Lock()
+			entry.taintAndPersistLocked()
+			entry.mu.Unlock()
+			releaseReview(entry)
+			return nil, true, ErrUnavailable
+		}
+		if pendingFailedSeq > 0 {
+			entry.mu.Lock()
+			if !entry.sealed && !entry.tainted && pendingFailedSeq > entry.failedTurnSeq {
+				entry.failedTurnSeq = pendingFailedSeq
+				latestPubSeq := uint64(0)
+				if len(entry.publishedTurns) > 0 {
+					latestPubSeq = entry.publishedTurns[len(entry.publishedTurns)-1].seq
+				}
+				entry.lastTurnFailed = entry.failedTurnSeq > latestPubSeq
+				if entry.lastTurnFailed {
+					if err := entry.persistLocked(); err != nil {
+						entry.taintAndPersistLocked()
+					}
+				}
+			}
+			entry.mu.Unlock()
+		}
+		res, err := finishReserveReviewEntry(root, key, entry)
+		return res, true, err
+	}
+	overflowed := taintWriteOverflow
+	reviewMu.Unlock()
+	if overflowed || pendingTainted {
+		return nil, false, ErrUnavailable
+	}
+	rootExists, err := checkPrivateDir(root, true)
+	if err != nil {
+		return nil, false, ErrUnavailable
+	}
+	if !rootExists {
+		return nil, false, nil
+	}
+	dir := filepath.Join(root, launch)
+	if _, statErr := os.Lstat(dir); statErr != nil {
+		if os.IsNotExist(statErr) {
+			return nil, false, nil
+		}
+		return nil, false, ErrUnavailable
+	}
+	res, resErr := ReserveReview(root, launch)
+	return res, true, resErr
+}
+
+// TaintExistingReview taints launch if it already exists in the pending pre-admission wave,
+// in-memory ledger, or on disk under root. Brand-new launches with no active siblings rejected
+// before admission never allocate directories or files on disk. When an in-memory ledger entry
+// is found, inFlight is incremented BEFORE releasing reviewMu so concurrent SealReview cannot
+// race past the taint in the unlock window.
+func TaintExistingReview(root, launch string) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) {
+		return
+	}
+	root = cleanRoot
+	key := root + "\x00" + launch
+	reviewMu.Lock()
+	if st := pendingReviewLaunches[key]; st != nil {
+		st.tainted = true
+	}
+	if entry := reviewLedger[key]; entry != nil {
+		if entry.sealedFlag || entry.sealing {
+			reviewMu.Unlock()
+			return
+		}
+		entry.inFlight++
+		reviewMu.Unlock()
+		defer releaseReview(entry)
+		entry.mu.Lock()
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		return
+	}
+	reviewMu.Unlock()
+	rootExists, err := checkPrivateDir(root, true)
+	if err != nil || !rootExists {
+		return
+	}
+	if _, statErr := os.Lstat(filepath.Join(root, launch)); statErr != nil {
+		return
+	}
+	TaintReview(root, launch)
+}
+
+// ReserveReview atomically checks that the launch is neither sealed nor sealing nor rejected by
+// an overlapping pending request, persists the initial unsealed reservation marker on disk before
+// admitting the first request, and registers an in-flight request.
+func ReserveReview(root, launch string) (*ReviewReservation, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) {
+		return nil, ErrUnavailable
+	}
+	root = cleanRoot
+	key := root + "\x00" + launch
+	reviewMu.Lock()
+	pendingTainted := pendingReviewLaunches[key] != nil && pendingReviewLaunches[key].tainted
+	reviewMu.Unlock()
+	if pendingTainted {
+		TaintExistingReview(root, launch)
+		return nil, ErrUnavailable
+	}
+	if err := acquirePrivateRootLock(root); err != nil {
+		return nil, ErrUnavailable
+	}
+	entry, err := getOrCreateReviewEntry(root, launch, "", time.Now(), true, true)
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	reviewMu.Lock()
+	pendingTainted = pendingReviewLaunches[key] != nil && pendingReviewLaunches[key].tainted
+	reviewMu.Unlock()
+	if pendingTainted {
+		entry.mu.Lock()
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	return finishReserveReviewEntry(root, key, entry)
+}
+
+func acquireReview(entry *reviewEntry) {
+	if entry == nil {
+		return
+	}
+	reviewMu.Lock()
+	entry.inFlight++
+	reviewMu.Unlock()
+}
+
+func releaseReview(entry *reviewEntry) {
+	if entry == nil {
+		return
+	}
+	reviewMu.Lock()
+	if entry.inFlight > 0 {
+		entry.inFlight--
+	}
+	reviewMu.Unlock()
+}
+
+func (e *reviewEntry) taintAndPersistLocked() {
+	if e.sealed {
+		return
+	}
+	e.tainted = true
+	if e.foreignDisk {
+		e.taintedPersisted = true
+		return
+	}
+	if err := e.persistLocked(); err == nil {
+		e.taintedPersisted = true
+	} else {
+		e.taintedPersisted = false
+	}
+}
+
+// ExtractInboundReviewModel reads, decodes (identity/zstd/gzip), and restores req.Body
+// before routing/normalization so the launch is bound to the exact client-requested model.
+func ExtractInboundReviewModel(req *http.Request) (string, bool) {
+	if req == nil || req.Method != http.MethodPost || req.Body == nil {
+		return "", false
+	}
+	orig := req.Body
+	raw, err := io.ReadAll(io.LimitReader(orig, maxOutboundModelBody+1))
+	if err != nil {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return "", false
+	}
+	if len(raw) > maxOutboundModelBody {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return "", false
+	}
+	_ = orig.Close()
+	req.Body = io.NopCloser(bytes.NewReader(raw))
+	decoded, ok := decodeCodexWireBody(raw, req.Header.Get("Content-Encoding"))
+	if !ok {
+		return "", false
+	}
+	model, streamTrue := parseTopLevelJSONReviewRequest(decoded)
+	if model == "" || !streamTrue {
+		return "", false
+	}
+	return model, true
+}
+
+// TaintReview permanently marks an unsealed valid review launch receipt as tainted.
+// Already-sealed terminal receipts are immutable and unaffected.
+// The in-memory ledger stays strictly bounded at maxReviewLedgerEntries; if the ledger is full
+// and taint persistence also fails on disk, taintWriteOverflow latches fail-closed for new sessions and seals.
+// Callers must invoke this only after request authentication.
+func TaintReview(root, launch string) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) {
+		return
+	}
+	root = cleanRoot
+	now := time.Now()
+	entry, err := getOrCreateReviewEntry(root, launch, "", now, true, true)
+	if errors.Is(err, errReviewSealed) {
+		return
+	}
+	if err == nil && entry != nil {
+		defer releaseReview(entry)
+		entry.mu.Lock()
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		return
+	}
+	dir := filepath.Join(root, launch)
+	diskEntry, onDisk, loadErr := loadReviewEntryFromDisk(dir, launch, "", now)
+	if loadErr == nil && onDisk && diskEntry != nil && diskEntry.sealed && !diskEntry.tainted {
+		return
+	}
+	temp := &reviewEntry{
+		directory: dir,
+		launch:    launch,
+		started:   now.UnixNano(),
+		tainted:   true,
+	}
+	if persistErr := temp.persistLocked(); persistErr != nil {
+		reviewMu.Lock()
+		taintWriteOverflow = true
+		reviewMu.Unlock()
+	}
+}
+
+func syncReviewAncestors(dir, root string) error {
+	if err := syncDirFn(dir); err != nil {
+		return err
+	}
+	if err := syncDirFn(root); err != nil {
+		return err
+	}
+	parent := filepath.Dir(root)
+	if parent != "" && parent != root {
+		if err := syncDirFn(parent); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func readVerifiedSealDigest(dir string) (string, bool) {
+	path := filepath.Join(dir, "seal.sha256")
+	finfo, err := os.Lstat(path)
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode()&os.ModeSymlink != 0 || finfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(finfo) || finfo.Size() != 64 {
+		return "", false
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil || len(raw) != 64 {
+		return "", false
+	}
+	digest := string(raw)
+	if !isSHA256Hex(digest) {
+		return "", false
+	}
+	return digest, true
+}
+
+func verifySealedDiskReceipt(dir, launch, session, expectedSHA string, now time.Time) (SealStatus, string) {
+	diskEntry, onDisk, err := loadReviewEntryFromDisk(dir, launch, session, now)
+	if err != nil {
+		return SealUnavailable, ""
+	}
+	if !onDisk || diskEntry == nil || !diskEntry.sealed || diskEntry.tainted || diskEntry.session != session {
+		return SealRejected, ""
+	}
+	if !isSHA256Hex(diskEntry.sealedReceiptSHA) {
+		return SealUnavailable, ""
+	}
+	savedDigest, ok := readVerifiedSealDigest(dir)
+	if !ok || diskEntry.sealedReceiptSHA != savedDigest {
+		return SealRejected, ""
+	}
+	if expectedSHA != "" && savedDigest != expectedSHA {
+		return SealRejected, ""
+	}
+	return SealOK, savedDigest
+}
+
+// SealReview seals a formal review launch once all in-flight requests have completed.
+func SealReview(root, launch, session string) SealStatus {
+	st, _ := SealReviewWithDigest(root, launch, session)
+	return st
+}
+
+// SealReviewWithDigest seals a formal review launch once all in-flight requests have completed,
+// and returns the SHA-256 hex digest of the durably sealed receipt.json ONLY when status is SealOK
+// (after verifying root and receipt.json on disk and completing launch, root, and root-parent
+// directory fsyncs while holding the exclusive root writer lock).
+func SealReviewWithDigest(root, launch, session string) (SealStatus, string) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) || !reviewSessionPattern.MatchString(session) {
+		return SealRejected, ""
+	}
+	root = cleanRoot
+	rootExists, err := checkPrivateDir(root, true)
+	if err != nil {
+		return SealUnavailable, ""
+	}
+	if !rootExists {
+		return SealRejected, ""
+	}
+	if err := acquirePrivateRootLock(root); err != nil {
+		return SealUnavailable, ""
+	}
+	key := root + "\x00" + launch
+	now := time.Now()
+	reviewMu.Lock()
+	if st := pendingReviewLaunches[key]; st != nil && st.count > 0 {
+		reviewMu.Unlock()
+		return SealInFlight, ""
+	}
+	overflowed := taintWriteOverflow
+	entry := reviewLedger[key]
+	if entry != nil {
+		if entry.sealedFlag {
+			reviewMu.Unlock()
+			entry.mu.Lock()
+			defer entry.mu.Unlock()
+			if !entry.sealed || entry.tainted || entry.session != session {
+				return SealRejected, ""
+			}
+			if !isSHA256Hex(entry.sealedReceiptSHA) {
+				return SealUnavailable, ""
+			}
+			st, digest := verifySealedDiskReceipt(entry.directory, launch, session, entry.sealedReceiptSHA, now)
+			if st != SealOK {
+				return st, ""
+			}
+			if !entry.sealSynced {
+				if syncReviewAncestors(entry.directory, root) != nil {
+					return SealUnavailable, ""
+				}
+				entry.sealSynced = true
+			}
+			return SealOK, digest
+		}
+		if entry.sealing || entry.inFlight > 0 {
+			reviewMu.Unlock()
+			return SealInFlight, ""
+		}
+		entry.sealing = true
+		entry.touched = now
+		reviewMu.Unlock()
+
+		finishSeal := func(markSealed bool) {
+			reviewMu.Lock()
+			entry.sealing = false
+			if markSealed {
+				entry.sealedFlag = true
+			}
+			reviewMu.Unlock()
+		}
+
+		entry.mu.Lock()
+		if entry.sealed {
+			ok := !entry.tainted && entry.session == session
+			if !ok {
+				entry.mu.Unlock()
+				finishSeal(true)
+				return SealRejected, ""
+			}
+			expectedSHA := entry.sealedReceiptSHA
+			if !isSHA256Hex(expectedSHA) {
+				entry.mu.Unlock()
+				finishSeal(true)
+				return SealUnavailable, ""
+			}
+			st, digest := verifySealedDiskReceipt(entry.directory, launch, session, expectedSHA, now)
+			if st != SealOK {
+				entry.mu.Unlock()
+				finishSeal(true)
+				return st, ""
+			}
+			if !entry.sealSynced {
+				if syncReviewAncestors(entry.directory, root) != nil {
+					entry.mu.Unlock()
+					finishSeal(true)
+					return SealUnavailable, ""
+				}
+				entry.sealSynced = true
+			}
+			entry.mu.Unlock()
+			finishSeal(true)
+			return SealOK, digest
+		}
+		if overflowed {
+			entry.mu.Unlock()
+			finishSeal(false)
+			return SealUnavailable, ""
+		}
+		if entry.tainted || entry.lastTurnFailed || entry.requests < 1 || entry.route == "" || !isSHA256Hex(entry.lastResponseIDSHA) ||
+			len(entry.responseIDSHAs) != entry.requests || entry.responseIDSHAs[len(entry.responseIDSHAs)-1] != entry.lastResponseIDSHA {
+			entry.mu.Unlock()
+			finishSeal(false)
+			return SealRejected, ""
+		}
+		if entry.started <= 0 || entry.finished < entry.started || entry.finished-entry.started > int64(MaxReviewDuration) {
+			entry.taintAndPersistLocked()
+			entry.mu.Unlock()
+			finishSeal(false)
+			return SealRejected, ""
+		}
+		if entry.session != session {
+			entry.taintAndPersistLocked()
+			entry.mu.Unlock()
+			finishSeal(false)
+			return SealRejected, ""
+		}
+		// Single-phase atomic rename + mandatory dir-sync confirmation:
+		// - If write/sync/rename fails BEFORE receipt.json is replaced, disk still holds sealed=false;
+		//   taint & permanently close so repeat and post-restart SealReview return SealRejected.
+		// - Once Rename replaces receipt.json with the verified, clean, quiescent sealed=true payload,
+		//   the launch is permanently sealed against new turns/taints; SealOK + receipt_sha256 are returned
+		//   ONLY after launch, root, and root-parent directory fsyncs succeed.
+		entry.sealed = true
+		entry.sealedAt = now.UnixNano()
+		if entry.sealedAt < entry.finished {
+			entry.sealedAt = entry.finished
+		}
+		renamed, err := entry.persistWithStatusLocked()
+		if entry.tainted || !entry.sealed {
+			entry.sealed = false
+			entry.sealedAt = 0
+			entry.sealedReceiptSHA = ""
+			entry.taintedPersisted = renamed && err == nil
+			entry.mu.Unlock()
+			finishSeal(true)
+			return SealRejected, ""
+		}
+		if !renamed {
+			entry.sealed = false
+			entry.sealedAt = 0
+			entry.sealedReceiptSHA = ""
+			entry.taintAndPersistLocked()
+			entry.mu.Unlock()
+			finishSeal(true)
+			return SealUnavailable, ""
+		}
+		if err != nil || syncReviewAncestors(entry.directory, root) != nil {
+			entry.sealSynced = false
+			entry.mu.Unlock()
+			finishSeal(true)
+			return SealUnavailable, ""
+		}
+		entry.sealSynced = true
+		digest := entry.sealedReceiptSHA
+		entry.mu.Unlock()
+		finishSeal(true)
+		if !isSHA256Hex(digest) {
+			return SealUnavailable, ""
+		}
+		return SealOK, digest
+	}
+	reviewMu.Unlock()
+
+	dir := filepath.Join(root, launch)
+	st, digest := verifySealedDiskReceipt(dir, launch, session, "", now)
+	if st != SealOK {
+		return st, ""
+	}
+	if syncReviewAncestors(dir, root) != nil {
+		return SealUnavailable, ""
+	}
+	return SealOK, digest
+}
+
+// BeginReviewReserved transfers an already-reserved in-flight review launch into a Collector
+// without ever dropping inFlight to zero between middleware admission and collector completion.
+func BeginReviewReserved(ctx context.Context, res *ReviewReservation, session, requestedModel string) (context.Context, *Collector, error) {
+	if res == nil || res.entry == nil {
+		return ctx, nil, ErrUnavailable
+	}
+	if !reviewSessionPattern.MatchString(session) || (requestedModel != "gpt-6.2-sol" && requestedModel != "gpt-6.2-astra") {
+		res.Taint()
+		res.Release()
+		return ctx, nil, ErrUnavailable
+	}
+	turnSeq := res.turnSeq
+	entry, ok := res.transfer()
+	if !ok {
+		return ctx, nil, ErrUnavailable
+	}
+	if turnSeq == 0 {
+		reviewMu.Lock()
+		reviewTurnSeqGen++
+		turnSeq = reviewTurnSeqGen
+		reviewMu.Unlock()
+	}
+	now := time.Now()
+	expectedRoute := "codex:" + requestedModel + "@chatgpt.com"
+	entry.mu.Lock()
+	if entry.sealed {
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return ctx, nil, ErrUnavailable
+	}
+	if entry.tainted {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return ctx, nil, ErrUnavailable
+	}
+	if entry.session == "" {
+		entry.session = session
+	} else if entry.session != session {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return ctx, nil, ErrUnavailable
+	}
+	if entry.route == "" {
+		entry.route = expectedRoute
+	} else if entry.route != expectedRoute {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return ctx, nil, ErrUnavailable
+	}
+	turnDeadline := now.Add(ReviewTurnTimeout)
+	if entry.started > 0 {
+		launchDeadline := time.Unix(0, entry.started).Add(MaxReviewDuration)
+		if !launchDeadline.After(now) {
+			entry.taintAndPersistLocked()
+			entry.mu.Unlock()
+			releaseReview(entry)
+			return ctx, nil, ErrUnavailable
+		}
+		if launchDeadline.Before(turnDeadline) {
+			turnDeadline = launchDeadline
+		}
+	}
+	entry.mu.Unlock()
+
+	c := &Collector{
+		directory:     entry.directory,
+		deadline:      turnDeadline,
+		strictCodex:   true,
+		expectedModel: requestedModel,
+		review:        entry,
+		reviewTurnSeq: turnSeq,
+		receipt:       Receipt{Schema: ReviewSchema, Session: session, Started: now.UnixNano()},
+	}
+	return context.WithValue(ctx, contextKey{}, c), c, nil
+}
+
+// BeginReview binds a formal external-review launch, its Codex session, and its inbound requested model
+// BEFORE routing or model normalization. Every outbound request and upstream response for this launch
+// must match that exact requested model; any violation aborts before upstream and taints the launch.
+func BeginReview(ctx context.Context, root, launch, session, requestedModel string) (context.Context, *Collector, error) {
+	res, err := ReserveReview(root, launch)
+	if err != nil {
+		return ctx, nil, ErrUnavailable
+	}
+	return BeginReviewReserved(ctx, res, session, requestedModel)
+}
+
+func (c *Collector) Reject() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.invalid = true
+}
+
+// Taint permanently invalidates both this collector and, for formal review launches,
+// the launch-level session receipt on disk so a misrouted or policy-violating turn can never pass.
+func (c *Collector) Taint() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	c.invalid = true
+	entry := c.review
+	if entry != nil {
+		acquireReview(entry)
+	}
+	c.mu.Unlock()
+	if entry != nil {
+		defer releaseReview(entry)
+		entry.mu.Lock()
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+	}
+	c.mu.Lock()
+	c.maybeReleaseReviewLocked()
+	c.mu.Unlock()
+}
+
+func (c *Collector) HandlerDone(success bool) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.handlerDone = true
+	if !success {
+		c.invalid = true
+	}
+	c.publishLocked()
+}
+
+func (c *Collector) Complete(success bool) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	// Multiple lifecycle owners under one inbound request are not covered.
+	if c.lifecycleDone || !success {
+		c.invalid = true
+	}
+	c.lifecycleDone = true
+	c.publishLocked()
+}
+
+var syncDirFn = defaultSyncDir
+
+func defaultSyncDir(dir string) error {
+	f, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	syncErr := f.Sync()
+	closeErr := f.Close()
+	if syncErr != nil {
+		return syncErr
+	}
+	return closeErr
+}
+
+func statDevIno(info os.FileInfo) (uint64, uint64, bool) {
+	if st, ok := info.Sys().(*syscall.Stat_t); ok {
+		return uint64(st.Dev), uint64(st.Ino), true
+	}
+	return 0, 0, false
+}
+
+// acquirePrivateRootLock enforces single-writer ownership over a receipt root across same-UID
+// proxy processes via a non-blocking exclusive flock on <root>/.writer.lock. If another process
+// holds the lock, calls fail closed with ErrUnavailable so two instances can never race on launch
+// reservation, in-flight accounting, or SealOK.
+func acquirePrivateRootLock(root string) error {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok {
+		return ErrUnavailable
+	}
+	root = cleanRoot
+	if err := ensurePrivateRoot(root); err != nil {
+		return ErrUnavailable
+	}
+	rootInfo, err := os.Lstat(root)
+	if err != nil || !rootInfo.IsDir() || rootInfo.Mode()&os.ModeSymlink != 0 || rootInfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(rootInfo) {
+		return ErrUnavailable
+	}
+	rDev, rIno, hasRootID := statDevIno(rootInfo)
+	lockPath := filepath.Join(root, ".writer.lock")
+
+	rootLockMu.Lock()
+	defer rootLockMu.Unlock()
+
+	if held := rootLocks[root]; held != nil {
+		if curLockInfo, err := os.Lstat(lockPath); err == nil && curLockInfo.Mode().IsRegular() &&
+			curLockInfo.Mode()&os.ModeSymlink == 0 && curLockInfo.Mode().Perm()&0077 == 0 && ownedByCurrentUser(curLockInfo) {
+			lDev, lIno, hasLockID := statDevIno(curLockInfo)
+			if (!hasRootID || (held.rootDev == rDev && held.rootIno == rIno)) &&
+				(!hasLockID || (held.dev == lDev && held.ino == lIno)) {
+				return nil
+			}
+		}
+		_ = held.file.Close()
+		delete(rootLocks, root)
+	}
+
+	// Best-effort prune of stale locks whose temp directories have already been removed.
+	if len(rootLocks) >= 32 {
+		for k, v := range rootLocks {
+			if _, statErr := os.Lstat(filepath.Join(k, ".writer.lock")); statErr != nil {
+				_ = v.file.Close()
+				delete(rootLocks, k)
+			}
+		}
+	}
+
+	f, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return ErrUnavailable
+	}
+	finfo, err := f.Stat()
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(finfo) {
+		_ = f.Close()
+		return ErrUnavailable
+	}
+	if err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		_ = f.Close()
+		return ErrUnavailable
+	}
+	lDev, lIno, hasLockID := statDevIno(finfo)
+	curRootInfo, err := os.Lstat(root)
+	if err != nil || !curRootInfo.IsDir() || curRootInfo.Mode()&os.ModeSymlink != 0 || curRootInfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(curRootInfo) {
+		_ = f.Close()
+		return ErrUnavailable
+	}
+	if curRDev, curRIno, ok := statDevIno(curRootInfo); ok && hasRootID && (curRDev != rDev || curRIno != rIno) {
+		_ = f.Close()
+		return ErrUnavailable
+	}
+	curLockInfo, err := os.Lstat(lockPath)
+	if err != nil || !curLockInfo.Mode().IsRegular() || curLockInfo.Mode()&os.ModeSymlink != 0 || curLockInfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(curLockInfo) {
+		_ = f.Close()
+		return ErrUnavailable
+	}
+	if curLDev, curLIno, ok := statDevIno(curLockInfo); ok && hasLockID && (curLDev != lDev || curLIno != lIno) {
+		_ = f.Close()
+		return ErrUnavailable
+	}
+	if err := syncDirFn(root); err != nil {
+		_ = f.Close()
+		return ErrUnavailable
+	}
+	rootLocks[root] = &heldRootLock{
+		file:    f,
+		dev:     lDev,
+		ino:     lIno,
+		rootDev: rDev,
+		rootIno: rIno,
+	}
+	return nil
+}
+
+func ensurePrivateRoot(root string) error {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok {
+		return ErrUnavailable
+	}
+	root = cleanRoot
+	parentOfRoot := filepath.Dir(root)
+	if _, err := os.Lstat(root); err == nil {
+		if _, err := checkPrivateDir(root, false); err != nil {
+			return ErrUnavailable
+		}
+		if parentOfRoot != "" && parentOfRoot != root {
+			if err := syncDirFn(parentOfRoot); err != nil {
+				return ErrUnavailable
+			}
+		}
+		return nil
+	} else if !os.IsNotExist(err) {
+		return ErrUnavailable
+	}
+	// Collect missing ancestors up to the deepest existing parent so every newly created
+	// directory entry (including root inside its parent) is durably synced on disk.
+	var toCreate []string
+	cur := root
+	for {
+		_, err := os.Lstat(cur)
+		if err == nil {
+			break
+		}
+		if !os.IsNotExist(err) {
+			return ErrUnavailable
+		}
+		parent := filepath.Dir(cur)
+		if parent == cur {
+			return ErrUnavailable
+		}
+		toCreate = append(toCreate, cur)
+		cur = parent
+	}
+	for i := len(toCreate) - 1; i >= 0; i-- {
+		dir := toCreate[i]
+		if err := os.Mkdir(dir, 0700); err != nil && !os.IsExist(err) {
+			return err
+		}
+		if err := syncDirFn(filepath.Dir(dir)); err != nil {
+			_ = os.Remove(dir)
+			return err
+		}
+	}
+	if _, err := checkPrivateDir(root, false); err != nil {
+		return ErrUnavailable
+	}
+	return nil
+}
+
+type expiredDiskCandidate struct {
+	name string
+	dir  string
+	ts   int64
+}
+
+func isReviewBucketName(name string) bool {
+	return ValidReviewLaunch(name)
+}
+
+func isProducerBucketDirName(name string, reviewBucket bool) bool {
+	if reviewBucket {
+		return ValidReviewLaunch(name)
+	}
+	return ValidPreflightSession(name)
+}
+
+func isProducerOwnedReceiptFile(childName string, reviewBucket bool) bool {
+	if reviewBucket {
+		return childName == "receipt.json" || childName == "seal.sha256"
+	}
+	return childName == "receipt.json"
+}
+
+func inspectProducerReceiptDir(dir, name string, reviewBucket bool) (time.Time, bool) {
+	if !isProducerBucketDirName(name, reviewBucket) {
+		return time.Time{}, false
+	}
+	fi, err := os.Lstat(dir)
+	if err != nil || !fi.IsDir() || fi.Mode()&os.ModeSymlink != 0 || fi.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(fi) {
+		return time.Time{}, false
+	}
+	lastMod := fi.ModTime()
+	children, err := os.ReadDir(dir)
+	if err != nil {
+		return time.Time{}, false
+	}
+	hasReceipt := false
+	hasSealFile := false
+	var receiptRaw []byte
+	var reviewSealed bool
+	for _, child := range children {
+		childName := child.Name()
+		if !isProducerOwnedReceiptFile(childName, reviewBucket) {
+			return time.Time{}, false
+		}
+		p := filepath.Join(dir, childName)
+		cfi, cerr := os.Lstat(p)
+		if cerr != nil || !cfi.Mode().IsRegular() || cfi.Mode()&os.ModeSymlink != 0 || !ownedByCurrentUser(cfi) {
+			return time.Time{}, false
+		}
+		if cfi.ModTime().After(lastMod) {
+			lastMod = cfi.ModTime()
+		}
+		if childName == "receipt.json" {
+			if cfi.Size() <= 0 || cfi.Size() > maxReviewReceiptBytes {
+				return time.Time{}, false
+			}
+			f, oerr := os.OpenFile(p, os.O_RDONLY|syscall.O_NOFOLLOW, 0)
+			if oerr != nil {
+				return time.Time{}, false
+			}
+			raw, rerr := io.ReadAll(io.LimitReader(f, maxReviewReceiptBytes+1))
+			_ = f.Close()
+			if rerr != nil || len(raw) == 0 || int64(len(raw)) > maxReviewReceiptBytes {
+				return time.Time{}, false
+			}
+			if reviewBucket {
+				var disk ReviewReceipt
+				if json.Unmarshal(raw, &disk) != nil || disk.Schema != ReviewSchema || disk.Launch != name {
+					return time.Time{}, false
+				}
+				reviewSealed = disk.Sealed
+				for _, ns := range []int64{disk.Started, disk.Finished, disk.SealedAt} {
+					if ns > 0 {
+						if t := time.Unix(0, ns); t.After(lastMod) {
+							lastMod = t
+						}
+					}
+				}
+			} else {
+				var disk Receipt
+				if json.Unmarshal(raw, &disk) != nil || disk.Schema != Schema || disk.Session != name {
+					return time.Time{}, false
+				}
+				for _, ns := range []int64{disk.Started, disk.Finished} {
+					if ns > 0 {
+						if t := time.Unix(0, ns); t.After(lastMod) {
+							lastMod = t
+						}
+					}
+				}
+			}
+			hasReceipt = true
+			receiptRaw = raw
+		} else if childName == "seal.sha256" {
+			hasSealFile = true
+		}
+	}
+	if !hasReceipt {
+		return time.Time{}, false
+	}
+	if hasSealFile {
+		if !reviewBucket || !reviewSealed {
+			return time.Time{}, false
+		}
+		sp := filepath.Join(dir, "seal.sha256")
+		sf, serr := os.OpenFile(sp, os.O_RDONLY|syscall.O_NOFOLLOW, 0)
+		if serr != nil {
+			return time.Time{}, false
+		}
+		sraw, rerr := io.ReadAll(io.LimitReader(sf, 129))
+		_ = sf.Close()
+		if rerr != nil || strings.TrimSpace(string(sraw)) != sha256Hex(string(receiptRaw)) {
+			return time.Time{}, false
+		}
+	}
+	return lastMod, true
+}
+
+func countRootBucketEntries(root string, reviewBucket bool) (int, []string, error) {
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		return 0, nil, err
+	}
+	names := make([]string, 0, len(entries))
+	for _, ent := range entries {
+		name := ent.Name()
+		if name == ".writer.lock" {
+			continue
+		}
+		if isReviewBucketName(name) != reviewBucket {
+			continue
+		}
+		names = append(names, name)
+	}
+	return len(names), names, nil
+}
+
+func removePrivateLeafDir(dir, name string, reviewBucket bool) bool {
+	if _, ok := inspectProducerReceiptDir(dir, name, reviewBucket); !ok {
+		return false
+	}
+	children, err := os.ReadDir(dir)
+	if err != nil {
+		return false
+	}
+	for _, child := range children {
+		if !isProducerOwnedReceiptFile(child.Name(), reviewBucket) {
+			return false
+		}
+		if err := os.Remove(filepath.Join(dir, child.Name())); err != nil && !os.IsNotExist(err) {
+			return false
+		}
+	}
+	return os.Remove(dir) == nil
+}
+
+func reclaimExpiredBucketEntries(root string, names []string, reviewBucket bool, need int) int {
+	if need <= 0 {
+		return 0
+	}
+	now := time.Now()
+	retention := preflightDiskRetention
+	if reviewBucket {
+		retention = reviewDiskRetention
+	}
+	candidates := make([]expiredDiskCandidate, 0)
+	for _, name := range names {
+		subDir := filepath.Join(root, name)
+		lastMod, ok := inspectProducerReceiptDir(subDir, name, reviewBucket)
+		if !ok {
+			continue
+		}
+		if now.Sub(lastMod) < retention {
+			continue
+		}
+		candidates = append(candidates, expiredDiskCandidate{name: name, dir: subDir, ts: lastMod.UnixNano()})
+	}
+	if len(candidates) == 0 {
+		return 0
+	}
+	// Selection-sort oldest-first (bounded by bucket cap).
+	for i := 0; i < len(candidates); i++ {
+		minIdx := i
+		for j := i + 1; j < len(candidates); j++ {
+			if candidates[j].ts < candidates[minIdx].ts {
+				minIdx = j
+			}
+		}
+		if minIdx != i {
+			candidates[i], candidates[minIdx] = candidates[minIdx], candidates[i]
+		}
+	}
+	reclaimed := 0
+	for _, cand := range candidates {
+		if reclaimed >= need {
+			break
+		}
+		if reviewBucket {
+			key := root + "\x00" + cand.name
+			// Use TryLock to prevent any lock-order cycle when called from persistWithStatusLocked (holding entry.mu).
+			if !reviewMu.TryLock() {
+				continue
+			}
+			if pendingReviewLaunches[key] != nil {
+				reviewMu.Unlock()
+				continue
+			}
+			if ent := reviewLedger[key]; ent != nil {
+				if ent.inFlight > 0 || ent.sealing || now.Sub(ent.touched) < retention {
+					reviewMu.Unlock()
+					continue
+				}
+				delete(reviewLedger, key)
+			}
+			reviewMu.Unlock()
+		}
+		if removePrivateLeafDir(cand.dir, cand.name, reviewBucket) {
+			reclaimed++
+		}
+	}
+	if reclaimed > 0 {
+		_ = syncDirFn(root)
+	}
+	return reclaimed
+}
+
+func reservePrivateDir(directory string, allowExisting bool) error {
+	directory = filepath.Clean(directory)
+	root, ok := cleanPrivateRoot(filepath.Dir(directory))
+	if !ok {
+		return ErrUnavailable
+	}
+	if err := acquirePrivateRootLock(root); err != nil {
+		return err
+	}
+	reviewBucket := isReviewBucketName(filepath.Base(directory))
+	capLimit := maxPreflightDiskEntries
+	if reviewBucket {
+		capLimit = maxReviewDiskEntries
+	}
+	rootQuotaMu.Lock()
+	_, statErr := os.Lstat(directory)
+	if statErr == nil {
+		rootQuotaMu.Unlock()
+		if !allowExisting {
+			return os.ErrExist
+		}
+		if _, checkErr := checkPrivateDir(directory, false); checkErr != nil {
+			return ErrUnavailable
+		}
+		if err := syncDirFn(root); err != nil {
+			return err
+		}
+		return nil
+	}
+	if !os.IsNotExist(statErr) {
+		rootQuotaMu.Unlock()
+		return ErrUnavailable
+	}
+	existingCount, names, countErr := countRootBucketEntries(root, reviewBucket)
+	if countErr != nil {
+		rootQuotaMu.Unlock()
+		return ErrUnavailable
+	}
+	if existingCount >= capLimit {
+		reclaimed := reclaimExpiredBucketEntries(root, names, reviewBucket, existingCount-capLimit+1)
+		existingCount -= reclaimed
+		if existingCount >= capLimit {
+			rootQuotaMu.Unlock()
+			return ErrUnavailable
+		}
+	}
+	err := os.Mkdir(directory, 0700)
+	rootQuotaMu.Unlock()
+	if err != nil {
+		if !allowExisting || !os.IsExist(err) {
+			return err
+		}
+		if _, checkErr := checkPrivateDir(directory, false); checkErr != nil {
+			return ErrUnavailable
+		}
+	}
+	if err := syncDirFn(root); err != nil {
+		return err
+	}
+	return nil
+}
+
+// Start is called by the auth execution guard, not by an asynchronous usage sink.
+func (c *Collector) Start(ctx context.Context, provider, model string) (context.Context, *Execution, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.invalid || c.sealed || c.handlerDone || c.lifecycleDone || time.Now().After(c.deadline) {
+		c.invalid = true
+		return ctx, nil, ErrUnavailable
+	}
+	if c.strictCodex && c.active > 0 {
+		c.invalid = true
+		return ctx, nil, ErrUnavailable
+	}
+	if c.review != nil {
+		expected := "codex:" + model + "@chatgpt.com"
+		c.review.mu.Lock()
+		if c.review.sealed {
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if c.review.tainted {
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if provider != "codex" || c.expectedModel == "" || model != c.expectedModel || (model != "gpt-6.2-sol" && model != "gpt-6.2-astra") {
+			c.review.taintAndPersistLocked()
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if c.review.route != expected {
+			c.review.taintAndPersistLocked()
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if !c.review.reserved {
+			if err := reservePrivateDir(c.directory, true); err != nil {
+				c.review.mu.Unlock()
+				c.invalid = true
+				return ctx, nil, ErrUnavailable
+			}
+			c.review.reserved = true
+		}
+		c.review.mu.Unlock()
+		c.reserved = true
+	} else if !c.reserved {
+		if err := reservePrivateDir(c.directory, false); err != nil {
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		c.reserved = true
+	}
+	c.active++
+	c.executions++
+	c.attemptFailed = false
+	c.upstreamEOF = false
+	c.had2xxBody = false
+	c.lastAttemptRequiredProducer = false
+	c.lastAttemptProducerVerified = false
+	c.resetAttemptStreamStateLocked()
+	e := &Execution{c: c, provider: provider, model: model}
+	ctx = httptransport.WithDecorator(ctx, func(next http.RoundTripper) http.RoundTripper { return &transport{next: next, execution: e} })
+	return ctx, e, nil
+}
+
+func (e *Execution) End() {
+	c := e.c
+	c.mu.Lock()
+	if e.ended {
+		c.invalid = true
+		c.mu.Unlock()
+		return
+	}
+	e.ended = true
+	unterminatedPostComplete := false
+	if c.strictCodex && (len(c.sseDataLines) > 0 || c.sseHasEvent) {
+		// Trailing SSE data or event header without a terminating blank-line delimiter is an incomplete event.
+		c.invalid = true
+		if c.observedCompleted {
+			unterminatedPostComplete = true
+		}
+	}
+	producerMismatch := false
+	if c.strictCodex && (c.producerRequired || c.producerObserved) {
+		if c.producer.sawCompleted && c.consumer.sawCompleted &&
+			c.producer.responseID != "" && c.producer.responseID == c.consumer.responseID &&
+			c.producer.completedOutputSHA == c.consumer.completedOutputSHA &&
+			c.producer.completedOutputSHA == c.lastOutputSHA {
+			c.lastAttemptProducerVerified = true
+		} else {
+			c.lastAttemptProducerVerified = false
+			if c.observedCompleted {
+				c.modelMismatch = true
+				c.invalid = true
+				producerMismatch = true
+			}
+		}
+	}
+	truncatedStream := false
+	if c.strictCodex && c.had2xxBody &&
+		!c.observedCompleted && !c.producer.sawFailure && !c.consumer.sawFailure {
+		c.modelMismatch = true
+		c.invalid = true
+		truncatedStream = true
+	}
+	c.resetAttemptStreamStateLocked()
+	if e.attempts == 0 {
+		c.invalid = true
+	}
+	if unterminatedPostComplete || producerMismatch || truncatedStream {
+		// Hold c.active (keeping entry.inFlight > 0) until c.Taint() finishes persisting taint
+		// so concurrent HandlerDone() + SealReview can never race ahead and seal a prior clean turn.
+		c.mu.Unlock()
+		c.Taint()
+		c.mu.Lock()
+		c.active--
+		c.maybeReleaseReviewLocked()
+		c.mu.Unlock()
+		return
+	}
+	c.active--
+	c.publishLocked()
+	c.mu.Unlock()
+}
+
+type restoredBody struct {
+	io.Reader
+	io.Closer
+}
+
+func parseTopLevelJSONModel(raw []byte) string {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return ""
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok || delim != '{' {
+		return ""
+	}
+	found := ""
+	seenModel := false
+	for dec.More() {
+		keyTok, err := dec.Token()
+		if err != nil {
+			return ""
+		}
+		key, ok := keyTok.(string)
+		if !ok {
+			return ""
+		}
+		if key == "model" {
+			if seenModel {
+				return ""
+			}
+			seenModel = true
+			var value string
+			if err := dec.Decode(&value); err != nil {
+				return ""
+			}
+			found = value
+		} else {
+			var skip json.RawMessage
+			if err := dec.Decode(&skip); err != nil {
+				return ""
+			}
+		}
+	}
+	endTok, err := dec.Token()
+	if err != nil {
+		return ""
+	}
+	if endDelim, ok := endTok.(json.Delim); !ok || endDelim != '}' {
+		return ""
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return ""
+	}
+	return found
+}
+
+func parseTopLevelJSONReviewRequest(raw []byte) (string, bool) {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return "", false
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok || delim != '{' {
+		return "", false
+	}
+	foundModel := ""
+	seenModel := false
+	seenStream := false
+	streamTrue := false
+	for dec.More() {
+		keyTok, err := dec.Token()
+		if err != nil {
+			return "", false
+		}
+		key, ok := keyTok.(string)
+		if !ok {
+			return "", false
+		}
+		switch key {
+		case "model":
+			if seenModel {
+				return "", false
+			}
+			seenModel = true
+			var value string
+			if err := dec.Decode(&value); err != nil {
+				return "", false
+			}
+			foundModel = value
+		case "stream":
+			if seenStream {
+				return "", false
+			}
+			seenStream = true
+			var flag bool
+			if err := dec.Decode(&flag); err != nil {
+				return "", false
+			}
+			streamTrue = flag
+		default:
+			var skip json.RawMessage
+			if err := dec.Decode(&skip); err != nil {
+				return "", false
+			}
+		}
+	}
+	endTok, err := dec.Token()
+	if err != nil {
+		return "", false
+	}
+	if endDelim, ok := endTok.(json.Delim); !ok || endDelim != '}' {
+		return "", false
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return "", false
+	}
+	return foundModel, seenModel && seenStream && streamTrue
+}
+
+func decodeCodexWireBody(raw []byte, encoding string) ([]byte, bool) {
+	switch strings.ToLower(strings.TrimSpace(encoding)) {
+	case "", "identity":
+		return raw, true
+	case "zstd":
+		dec, err := zstd.NewReader(bytes.NewReader(raw), zstd.WithDecoderMaxMemory(64<<20))
+		if err != nil {
+			return nil, false
+		}
+		defer dec.Close()
+		out, err := io.ReadAll(io.LimitReader(dec, maxOutboundModelBody+1))
+		if err != nil || len(out) > maxOutboundModelBody {
+			return nil, false
+		}
+		return out, true
+	case "gzip":
+		dec, err := gzip.NewReader(bytes.NewReader(raw))
+		if err != nil {
+			return nil, false
+		}
+		defer dec.Close()
+		out, err := io.ReadAll(io.LimitReader(dec, maxOutboundModelBody+1))
+		if err != nil || len(out) > maxOutboundModelBody {
+			return nil, false
+		}
+		return out, true
+	default:
+		return nil, false
+	}
+}
+
+func codexOutboundModel(req *http.Request) string {
+	if req.Method != http.MethodPost || req.Body == nil {
+		return ""
+	}
+	if req.URL == nil || req.URL.Path != "/backend-api/codex/responses" {
+		return ""
+	}
+	orig := req.Body
+	raw, err := io.ReadAll(io.LimitReader(orig, maxOutboundModelBody+1))
+	if err != nil {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return ""
+	}
+	if len(raw) > maxOutboundModelBody {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return ""
+	}
+	_ = orig.Close()
+	req.Body = io.NopCloser(bytes.NewReader(raw))
+	decoded, ok := decodeCodexWireBody(raw, req.Header.Get("Content-Encoding"))
+	if !ok {
+		return ""
+	}
+	return parseTopLevelJSONModel(decoded)
+}
+
+// Only enums enter the collector. URL paths, bodies and auth identifiers never do.
+func route(provider, model string, req *http.Request) string {
+	if req.URL == nil || req.URL.Scheme != "https" || req.URL.User != nil || (req.URL.Port() != "" && req.URL.Port() != "443") {
+		return "other"
+	}
+	host := strings.ToLower(req.URL.Hostname())
+	if req.Host != "" && !strings.EqualFold(req.Host, req.URL.Host) {
+		return "other"
+	}
+	if provider == "codex" {
+		if host != "chatgpt.com" || req.Method != http.MethodPost || req.URL.Path != "/backend-api/codex/responses" || req.URL.RawQuery != "" || (model != "gpt-6.2-sol" && model != "gpt-6.2-astra") {
+			return "other"
+		}
+		if codexOutboundModel(req) != model {
+			return "other"
+		}
+		return "codex:" + model + "@chatgpt.com"
+	}
+	value := provider + "@" + host
+	switch value {
+	case "kimi@api.kimi.com", "kimi-ai@api.kimi.ai", "claude@api.anthropic.com", "antigravity@daily-cloudcode-pa.googleapis.com":
+		return value
+	default:
+		return "other"
+	}
+}
+
+type transport struct {
+	next      http.RoundTripper
+	execution *Execution
+}
+
+func isTLSVerificationError(err error) bool {
+	if err == nil {
+		return false
+	}
+	var certVerifyErr *tls.CertificateVerificationError
+	var recordHeaderErr tls.RecordHeaderError
+	var hostnameErr x509.HostnameError
+	var unknownAuthErr x509.UnknownAuthorityError
+	var certInvalidErr x509.CertificateInvalidError
+	var systemRootsErr x509.SystemRootsError
+	var constraintErr x509.ConstraintViolationError
+	return errors.As(err, &certVerifyErr) ||
+		errors.As(err, &recordHeaderErr) ||
+		errors.As(err, &hostnameErr) ||
+		errors.As(err, &unknownAuthErr) ||
+		errors.As(err, &certInvalidErr) ||
+		errors.As(err, &systemRootsErr) ||
+		errors.As(err, &constraintErr)
+}
+
+func (t *transport) RoundTrip(req *http.Request) (*http.Response, error) {
+	e, c := t.execution, t.execution.c
+	c.mu.Lock()
+	if c.invalid || c.sealed || e.ended || time.Now().After(c.deadline) || c.attempts >= MaxAttempts {
+		c.invalid = true
+		c.mu.Unlock()
+		return nil, ErrUnavailable
+	}
+	strict := c.strictCodex
+	c.mu.Unlock()
+	observed := route(e.provider, e.model, req)
+	if strict {
+		expected := "codex:" + e.model + "@chatgpt.com"
+		if e.provider != "codex" || (e.model != "gpt-6.2-sol" && e.model != "gpt-6.2-astra") || observed != expected {
+			c.Taint()
+			return nil, ErrUnavailable
+		}
+	}
+	c.mu.Lock()
+	if c.invalid || c.sealed || e.ended || time.Now().After(c.deadline) || c.attempts >= MaxAttempts {
+		c.invalid = true
+		c.mu.Unlock()
+		return nil, ErrUnavailable
+	}
+	c.attempts++
+	e.attempts++
+	c.bodies++
+	c.upstreamEOF = false
+	slot := len(c.receipt.Routes)
+	c.receipt.Routes = append(c.receipt.Routes, "other")
+	c.mu.Unlock()
+	resp, err := t.next.RoundTrip(req)
+	finish := func() { c.mu.Lock(); defer c.mu.Unlock(); c.bodies--; c.publishLocked() }
+	if err != nil {
+		if strict {
+			if observed != "other" && isTLSVerificationError(err) {
+				c.Taint()
+			} else {
+				c.Reject()
+			}
+		} else {
+			c.Reject()
+		}
+		finish()
+		return nil, err
+	}
+	if resp == nil {
+		c.Reject()
+		finish()
+		return nil, nil
+	}
+	if observed != "other" {
+		expectedHost := strings.ToLower(req.URL.Hostname())
+		tlsOK := resp.TLS != nil &&
+			resp.TLS.HandshakeComplete &&
+			len(resp.TLS.VerifiedChains) > 0 &&
+			len(resp.TLS.VerifiedChains[0]) > 0 &&
+			strings.EqualFold(resp.TLS.ServerName, expectedHost) &&
+			resp.TLS.VerifiedChains[0][0].VerifyHostname(expectedHost) == nil
+		if !tlsOK {
+			if resp.Body != nil {
+				_ = resp.Body.Close()
+			}
+			if strict {
+				c.Taint()
+			} else {
+				c.Reject()
+			}
+			finish()
+			return nil, ErrUnavailable
+		}
+	}
+	c.mu.Lock()
+	c.receipt.Routes[slot] = observed
+	if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+		c.had2xxBody = true
+	}
+	c.mu.Unlock()
+	if resp.Body == nil {
+		finish()
+	} else {
+		var markEOF func()
+		if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+			markEOF = c.MarkUpstreamEOF
+		}
+		resp.Body = &body{
+			ReadCloser:           resp.Body,
+			finish:               finish,
+			reject:               c.Reject,
+			taint:                c.Taint,
+			observedCompleted:    c.ObservedCompleted,
+			markEOF:              markEOF,
+			requireEOF:           true,
+			taintOnIncompleteEOF: strict && resp.StatusCode >= 200 && resp.StatusCode < 300,
+		}
+	}
+	return resp, nil
+}
+
+type body struct {
+	io.ReadCloser
+	once                 sync.Once
+	finish               func()
+	reject               func()
+	taint                func()
+	observedCompleted    func() bool
+	markEOF              func()
+	requireEOF           bool
+	taintOnIncompleteEOF bool
+	sawEOF               atomic.Bool
+	readErr              atomic.Bool
+}
+
+func (b *body) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if errors.Is(err, io.EOF) {
+		b.sawEOF.Store(true)
+	} else if err != nil {
+		b.readErr.Store(true)
+	}
+	return n, err
+}
+
+func (b *body) Close() error {
+	// Never block Close() on a synchronous Read against a potentially stalled upstream connection:
+	// strict callers must have already drained Read() to real io.EOF; otherwise fail closed immediately.
+	err := b.ReadCloser.Close()
+	if err != nil || (b.requireEOF && (b.readErr.Load() || !b.sawEOF.Load())) {
+		if b.requireEOF && b.taint != nil && (b.taintOnIncompleteEOF || (b.observedCompleted != nil && b.observedCompleted())) {
+			b.taint()
+		}
+		b.reject()
+	} else if b.requireEOF && b.markEOF != nil {
+		b.markEOF()
+	}
+	b.once.Do(b.finish)
+	return err
+}
+
+func (e *reviewEntry) diskReceiptUnsafeLocked() bool {
+	path := filepath.Join(e.directory, "receipt.json")
+	finfo, err := os.Lstat(path)
+	if !e.markerPersisted && e.lastPersistedSHA == "" && errors.Is(err, os.ErrNotExist) {
+		// Before initial persistence, absence of receipt.json is expected.
+		return false
+	}
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode()&os.ModeSymlink != 0 ||
+		finfo.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(finfo) ||
+		finfo.Size() <= 0 || finfo.Size() > maxReviewReceiptBytes {
+		return true
+	}
+	f, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return true
+	}
+	raw, err := io.ReadAll(io.LimitReader(f, maxReviewReceiptBytes+1))
+	_ = f.Close()
+	if err != nil || len(raw) == 0 || int64(len(raw)) > maxReviewReceiptBytes {
+		return true
+	}
+	if e.lastPersistedSHA != "" && sha256Hex(string(raw)) != e.lastPersistedSHA {
+		return true
+	}
+	var disk ReviewReceipt
+	if err := json.Unmarshal(raw, &disk); err != nil {
+		return true
+	}
+	if disk.Schema != ReviewSchema || disk.Launch != e.launch || disk.Tainted {
+		return true
+	}
+	if e.session != "" && disk.Session != "" && disk.Session != e.session {
+		return true
+	}
+	if disk.Sealed || disk.Requests > e.requests {
+		return true
+	}
+	return false
+}
+
+func (e *reviewEntry) invalidateDiskReceiptLocked() {
+	if e.foreignDisk {
+		return
+	}
+	if _, err := checkPrivateDir(filepath.Dir(e.directory), false); err != nil {
+		return
+	}
+	if _, err := checkPrivateDir(e.directory, false); err != nil {
+		return
+	}
+	finalPath := filepath.Join(e.directory, "receipt.json")
+	sealDigestPath := filepath.Join(e.directory, "seal.sha256")
+	// Never call os.Truncate on receipt.json: Truncate follows symlinks, whereas os.Remove
+	// unlinks only the directory entry inside the verified private launch directory.
+	_ = os.Remove(finalPath)
+	_ = os.Remove(sealDigestPath)
+	_ = syncDirFn(e.directory)
+}
+
+func (e *reviewEntry) persistLocked() error {
+	_, err := e.persistWithStatusLocked()
+	return err
+}
+
+func (e *reviewEntry) persistWithStatusLocked() (bool, error) {
+	if e.foreignDisk {
+		return false, ErrUnavailable
+	}
+	root, ok := cleanPrivateRoot(filepath.Dir(e.directory))
+	if !ok {
+		return false, ErrUnavailable
+	}
+	// Acquire single-writer root lock FIRST, before any fail-cleanup or disk mutation path.
+	// Never unlink or modify any file under root unless this process owns <root>/.writer.lock.
+	if err := acquirePrivateRootLock(root); err != nil {
+		return false, ErrUnavailable
+	}
+	fail := func(renamed bool, err error) (bool, error) {
+		if e.tainted {
+			e.invalidateDiskReceiptLocked()
+		}
+		return renamed, err
+	}
+	if !e.reserved {
+		if err := reservePrivateDir(e.directory, true); err != nil {
+			return fail(false, err)
+		}
+		e.reserved = true
+	} else {
+		if _, err := checkPrivateDir(e.directory, false); err != nil {
+			return fail(false, ErrUnavailable)
+		}
+	}
+	if !e.tainted && e.diskReceiptUnsafeLocked() {
+		e.tainted = true
+		e.sealed = false
+		e.sealedAt = 0
+	}
+	routes := []string{"other"}
+	respIDs := []string{}
+	complete := false
+	lastResp := ""
+	lastOut := ""
+	if !e.tainted && !e.lastTurnFailed && e.requests > 0 && e.route != "" && isSHA256Hex(e.lastResponseIDSHA) &&
+		len(e.responseIDSHAs) == e.requests && e.responseIDSHAs[len(e.responseIDSHAs)-1] == e.lastResponseIDSHA {
+		routes = []string{e.route}
+		respIDs = append([]string(nil), e.responseIDSHAs...)
+		complete = true
+		lastResp = e.lastResponseIDSHA
+		lastOut = e.lastOutputSHA
+	}
+	finished := e.finished
+	if finished == 0 {
+		finished = time.Now().UnixNano()
+	}
+	sealed := e.sealed && !e.tainted && complete
+	sealedAt := int64(0)
+	if sealed {
+		sealedAt = e.sealedAt
+		if sealedAt < finished {
+			sealedAt = finished
+		}
+	} else {
+		e.sealed = false
+		e.sealedAt = 0
+	}
+	payload := ReviewReceipt{
+		Schema:           ReviewSchema,
+		Launch:           e.launch,
+		Session:          e.session,
+		Started:          e.started,
+		Finished:         finished,
+		SealedAt:         sealedAt,
+		Complete:         complete,
+		Sealed:           sealed,
+		Tainted:          e.tainted,
+		Requests:         e.requests,
+		Routes:           routes,
+		ResponseIDSHAs:   respIDs,
+		LastResponseID:   lastResp,
+		LastOutputSHA256: lastOut,
+	}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return fail(false, err)
+	}
+	seq := tmpSeq.Add(1)
+	sealedDigest := ""
+	if sealed {
+		sealedDigest = sha256Hex(string(data))
+		shaTmp := filepath.Join(e.directory, fmt.Sprintf("pending-sha-%d-%d", os.Getpid(), seq))
+		sf, err := os.OpenFile(shaTmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if err != nil {
+			return fail(false, err)
+		}
+		_, errWriteSHA := sf.WriteString(sealedDigest)
+		errSyncSHA := sf.Sync()
+		errCloseSHA := sf.Close()
+		if errWriteSHA != nil || errSyncSHA != nil || errCloseSHA != nil {
+			_ = os.Remove(shaTmp)
+			return fail(false, ErrUnavailable)
+		}
+		if err := os.Rename(shaTmp, filepath.Join(e.directory, "seal.sha256")); err != nil {
+			_ = os.Remove(shaTmp)
+			return fail(false, err)
+		}
+	}
+	tmp := filepath.Join(e.directory, fmt.Sprintf("pending-%d-%d", os.Getpid(), seq))
+	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		if sealed {
+			_ = os.Remove(filepath.Join(e.directory, "seal.sha256"))
+		}
+		return fail(false, err)
+	}
+	_, errWrite := f.Write(data)
+	errSync := f.Sync()
+	errClose := f.Close()
+	if errWrite != nil || errSync != nil || errClose != nil {
+		_ = os.Remove(tmp)
+		if sealed {
+			_ = os.Remove(filepath.Join(e.directory, "seal.sha256"))
+		}
+		return fail(false, ErrUnavailable)
+	}
+	if err := os.Rename(tmp, filepath.Join(e.directory, "receipt.json")); err != nil {
+		_ = os.Remove(tmp)
+		if sealed {
+			_ = os.Remove(filepath.Join(e.directory, "seal.sha256"))
+		}
+		return fail(false, err)
+	}
+	e.lastPersistedSHA = sha256Hex(string(data))
+	if sealed {
+		e.sealedReceiptSHA = sealedDigest
+	}
+	if err := syncDirFn(e.directory); err != nil {
+		return fail(true, err)
+	}
+	e.markerPersisted = true
+	return true, nil
+}
+
+func (c *Collector) maybeReleaseReviewLocked() {
+	if c.review != nil && !c.reviewReleased && c.handlerDone && c.active == 0 && c.bodies == 0 && (c.sealed || c.lifecycleDone || c.invalid || c.attemptFailed) {
+		if !c.reviewPublished {
+			entry := c.review
+			entry.mu.Lock()
+			if !entry.sealed && !entry.tainted {
+				if c.reviewTurnSeq > entry.failedTurnSeq {
+					entry.failedTurnSeq = c.reviewTurnSeq
+				}
+				latestPubSeq := uint64(0)
+				if len(entry.publishedTurns) > 0 {
+					latestPubSeq = entry.publishedTurns[len(entry.publishedTurns)-1].seq
+				}
+				entry.lastTurnFailed = entry.failedTurnSeq > latestPubSeq
+				if entry.lastTurnFailed {
+					if err := entry.persistLocked(); err != nil {
+						entry.taintAndPersistLocked()
+					}
+				}
+			}
+			entry.mu.Unlock()
+		}
+		c.reviewReleased = true
+		releaseReview(c.review)
+	}
+}
+
+func (c *Collector) publishLocked() {
+	defer c.maybeReleaseReviewLocked()
+	if c.invalid || c.attemptFailed || c.sealed || !c.handlerDone || !c.lifecycleDone || c.active != 0 || c.bodies != 0 || c.executions == 0 || len(c.receipt.Routes) == 0 {
+		return
+	}
+	if time.Now().After(c.deadline) {
+		c.invalid = true
+		return
+	}
+	c.sealed = true
+	if c.review != nil {
+		routes := append([]string(nil), c.receipt.Routes...)
+		observedCompleted := c.observedCompleted
+		modelMismatch := c.modelMismatch
+		if c.strictCodex && c.lastAttemptRequiredProducer && !c.lastAttemptProducerVerified {
+			modelMismatch = true
+		}
+		lastResp := c.lastResponseIDSHA
+		lastOut := c.lastOutputSHA
+		entry := c.review
+		entry.mu.Lock()
+		defer entry.mu.Unlock()
+		if entry.sealed {
+			return
+		}
+		if entry.tainted || modelMismatch {
+			entry.taintAndPersistLocked()
+			return
+		}
+		for _, r := range routes {
+			if r != "codex:gpt-6.2-sol@chatgpt.com" && r != "codex:gpt-6.2-astra@chatgpt.com" {
+				entry.taintAndPersistLocked()
+				return
+			}
+			if entry.route == "" {
+				entry.route = r
+			} else if entry.route != r {
+				entry.taintAndPersistLocked()
+				return
+			}
+		}
+		if !observedCompleted || !isSHA256Hex(lastResp) {
+			return
+		}
+		if len(entry.responseIDSHAs) >= maxReviewResponseIDs {
+			entry.taintAndPersistLocked()
+			return
+		}
+		finished := time.Now().UnixNano()
+		if entry.started <= 0 || finished < entry.started || finished-entry.started > int64(MaxReviewDuration) {
+			entry.taintAndPersistLocked()
+			return
+		}
+		turnRec := reviewPublishedTurn{
+			seq:        c.reviewTurnSeq,
+			responseID: lastResp,
+			outputSHA:  lastOut,
+		}
+		pos := len(entry.publishedTurns)
+		for pos > 0 && entry.publishedTurns[pos-1].seq > turnRec.seq {
+			pos--
+		}
+		entry.publishedTurns = append(entry.publishedTurns, reviewPublishedTurn{})
+		copy(entry.publishedTurns[pos+1:], entry.publishedTurns[pos:])
+		entry.publishedTurns[pos] = turnRec
+		entry.responseIDSHAs = make([]string, len(entry.publishedTurns))
+		for i, pt := range entry.publishedTurns {
+			entry.responseIDSHAs[i] = pt.responseID
+		}
+		latest := entry.publishedTurns[len(entry.publishedTurns)-1]
+		entry.requests = len(entry.publishedTurns)
+		entry.lastResponseIDSHA = latest.responseID
+		entry.lastOutputSHA = latest.outputSHA
+		entry.lastTurnFailed = entry.failedTurnSeq > latest.seq
+		if finished > entry.finished {
+			entry.finished = finished
+		}
+		if err := entry.persistLocked(); err != nil {
+			entry.taintAndPersistLocked()
+			return
+		}
+		c.reviewPublished = true
+		return
+	}
+	c.receipt.Complete = true
+	c.receipt.Finished = time.Now().UnixNano()
+	data, err := json.Marshal(c.receipt)
+	if err != nil {
+		return
+	}
+	// Same-directory exclusive temporary file and rename: readers see all or nothing.
+	tmp := filepath.Join(c.directory, "pending")
+	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return
+	}
+	_, errWrite := f.Write(data)
+	errSync := f.Sync()
+	errClose := f.Close()
+	if errWrite != nil || errSync != nil || errClose != nil {
+		return
+	}
+	if err := os.Rename(tmp, filepath.Join(c.directory, "receipt.json")); err == nil {
+		_ = syncDirFn(c.directory)
+	}
+}
