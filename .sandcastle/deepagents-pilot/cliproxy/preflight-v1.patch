+type notifyOnReadReader struct {
+	r      io.ReadCloser
+	onRead func()
+}
+
+func (n *notifyOnReadReader) Read(p []byte) (int, error) {
+	if n.onRead != nil {
+		n.onRead()
+	}
+	return n.r.Read(p)
+}
+
+func (n *notifyOnReadReader) Close() error {
+	return n.r.Close()
+}
+
+type deadlineRecorder struct {
+	*httptest.ResponseRecorder
+}
+
+func newDeadlineRecorder() *deadlineRecorder {
+	return &deadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+}
+
+func (d *deadlineRecorder) SetReadDeadline(time.Time) error  { return nil }
+func (d *deadlineRecorder) SetWriteDeadline(time.Time) error { return nil }
