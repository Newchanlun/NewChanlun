+	movedOrig := filepath.Join(t.TempDir(), "orig-launch")
+	if err := os.Rename(dir, movedOrig); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "receipt.json"), agedRecRaw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "seal.sha256"), []byte(agedSHA), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if st2, d2 := SealReviewWithDigest(root, launch, session); st2 != SealUnavailable || d2 != "" {
+		t.Fatalf("SealReviewWithDigest on replaced dir after failed reclaim = (%v, %q), want (SealUnavailable, \"\")", st2, d2)
+	}
+
+	// Restore original dir inode and verify successful reclamation removes dir AND revokes sealedBindings[key].
+	_ = os.RemoveAll(dir)
+	if err := os.Rename(movedOrig, dir); err != nil {
+		t.Fatal(err)
+	}
+	_ = os.Chtimes(dir, ancient, ancient)
+	lease2, err := acquirePrivateRootLease(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := reclaimExpiredBucketEntries(lease2.dir, root, []string{launch}, true, 1, 0, &bucketReclaimState{cache: make(map[reclaimCacheKey]reclaimCacheEntry)}); got != 1 {
+		lease2.Close()
+		t.Fatalf("reclaimExpiredBucketEntries on restored expired dir = %d, want 1", got)
+	}
+	lease2.Close()
+	if _, statErr := os.Lstat(dir); !os.IsNotExist(statErr) {
+		t.Fatalf("reclaimed dir still present on disk: %v", statErr)
+	}
+	reviewMu.Lock()
+	_, stillBound := sealedBindings[key]
+	reviewMu.Unlock()
+	if stillBound {
+		t.Fatalf("sealedBindings[%q] was not revoked after confirmed quarantine reclamation", key)
+	}
+}
