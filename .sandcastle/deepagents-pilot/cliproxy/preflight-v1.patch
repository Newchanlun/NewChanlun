+func inferredDeltaItemType(evType string) string {
+	switch {
+	case evType == "response.output_text.delta" ||
+		evType == "response.output_text.done" ||
+		evType == "response.output_text.annotation.added" ||
+		evType == "response.refusal.delta" ||
+		evType == "response.refusal.done" ||
+		evType == "response.audio.delta" ||
+		evType == "response.audio.done" ||
+		evType == "response.audio.transcript.delta" ||
+		evType == "response.audio.transcript.done":
+		return "message"
+	case strings.HasPrefix(evType, "response.function_call_arguments."):
+		return "function_call"
+	case strings.HasPrefix(evType, "response.custom_tool_call_input."):
+		return "custom_tool_call"
+	case strings.HasPrefix(evType, "response.mcp_call_arguments.") || strings.HasPrefix(evType, "response.mcp_call."):
+		return "mcp_call"
+	case strings.HasPrefix(evType, "response.reasoning"):
+		return "reasoning"
+	case strings.HasPrefix(evType, "response.code_interpreter_call"):
+		return "code_interpreter_call"
+	case strings.HasPrefix(evType, "response.file_search_call"):
+		return "file_search_call"
+	case strings.HasPrefix(evType, "response.web_search_call"):
+		return "web_search_call"
+	case strings.HasPrefix(evType, "response.image_generation_call"):
+		return "image_generation_call"
+	default:
+		return ""
+	}
+}
+
+func classifyDeltaEventKind(evType string) strictItemKind {
+	switch evType {
+	case "response.output_text.delta",
+		"response.output_text.done",
+		"response.output_text.annotation.added",
+		"response.refusal.delta",
+		"response.refusal.done",
+		"response.audio.delta",
+		"response.audio.done",
+		"response.audio.transcript.delta",
+		"response.audio.transcript.done":
+		return itemKindMessageAny
+	default:
+		return itemKindNonMessage
+	}
+}
+
+func classifyDeltaFrame(frame parsedStrictFrame) (strictItemKind, string) {
+	if frame.evType == "response.content_part.added" || frame.evType == "response.content_part.done" {
+		if frame.partFields != nil {
+			pType, _ := exactOptionalString(frame.partFields, "type")
+			switch pType {
+			case "output_text", "refusal", "output_audio":
+				return itemKindMessageAny, "message"
+			case "reasoning_text", "summary_text":
+				return itemKindNonMessage, "reasoning"
+			default:
+				return itemKindUnknown, ""
+			}
+		}
+		return itemKindUnknown, ""
+	}
+	return classifyDeltaEventKind(frame.evType), inferredDeltaItemType(frame.evType)
+}
