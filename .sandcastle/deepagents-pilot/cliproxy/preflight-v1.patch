+
+	sse1 := "data: " + `{"type":"response.completed","response":{"id":"resp_turn1","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"turn1"}]}]}}` + "\n\n"
+	sse2 := "data: " + `{"type":"response.completed","response":{"id":"resp_turn2","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"turn2"}]}]}}` + "\n\n"
+
+	for _, tc := range []struct {
+		name     string
+		launch   string
+		session  string
+		readErr  error
+		closeErr error
+	}{
+		{
+			name:    "post-terminal scan error taints prior turn",
+			launch:  "review-a1111111-2222-4333-8444-555555555501",
+			session: "019d0000-0000-7000-8000-555555555501",
+			readErr: errors.New("simulated upstream reset after response.completed"),
+		},
+		{
+			name:     "post-terminal close error taints prior turn",
+			launch:   "review-a1111111-2222-4333-8444-555555555502",
+			session:  "019d0000-0000-7000-8000-555555555502",
+			closeErr: errors.New("simulated upstream close error after response.completed"),
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
