+		})})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		resp, err := cl.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		raw, _ := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		c.ObserveStreamChunk(raw)
+		lease.End()
+		c.Complete(true)
+		c.HandlerDone(true)
+		if st := SealReview(root, launch, session); st != SealOK {
+			t.Fatalf("SealReview = %v, want SealOK", st)
+		}
+		return readReviewReceiptFile(t, root, launch)
