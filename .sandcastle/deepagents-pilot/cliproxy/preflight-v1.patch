+	beforeSeal := readReviewReceiptFile(t, root, launchOK)
+	if !beforeSeal.Complete || beforeSeal.Sealed || beforeSeal.Tainted || beforeSeal.SealedAt != 0 {
+		t.Fatalf("expected unsealed clean receipt before seal: %+v", beforeSeal)
+	}
+	// Backdate entry.started and entry.finished by 3h to verify delayed seal preserves response completion finished_ns
+	// and records the seal wall time separately in sealed_at_ns.
+	reviewMu.Lock()
+	ent := reviewLedger[root+"\x00"+launchOK]
+	reviewMu.Unlock()
+	ent.mu.Lock()
+	ent.started = time.Now().Add(-3*time.Hour - 5*time.Minute).UnixNano()
+	ent.finished = ent.started + int64(5*time.Minute)
+	wantFinished := ent.finished
+	ent.mu.Unlock()
+	if st := SealReview(root, launchOK, sessionOK); st != SealOK {
+		t.Fatalf("SealReview = %v, want SealOK", st)
+	}
+	if r := readReviewReceiptFile(t, root, launchOK); !r.Complete || !r.Sealed || r.Tainted || r.Finished != wantFinished || r.SealedAt < r.Finished {
+		t.Fatalf("delayed seal clobbered finished_ns or missed sealed_at_ns: %+v (want finished=%d)", r, wantFinished)
+	}
+	// Post-seal request must be blocked BEFORE routing/execution without mutating sealed receipt.
+	if _, _, err := BeginReview(context.Background(), root, launchOK, sessionOK, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("post-seal BeginReview err = %v, want ErrUnavailable", err)
+	}
+	TaintReview(root, launchOK)
+	if r := readReviewReceiptFile(t, root, launchOK); !r.Complete || !r.Sealed || r.Tainted {
+		t.Fatalf("sealed receipt was mutated post-seal: %+v", r)
+	}
+	// After proxy restart, sealed receipt stays SealOK and still rejects new turns.
+	reviewMu.Lock()
+	delete(reviewLedger, root+"\x00"+launchOK)
+	reviewMu.Unlock()
+	if st := SealReview(root, launchOK, sessionOK); st != SealOK {
+		t.Fatalf("post-restart SealReview on sealed launch = %v, want SealOK", st)
+	}
+	if _, _, err := BeginReview(context.Background(), root, launchOK, sessionOK, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("post-restart BeginReview on sealed launch err = %v, want ErrUnavailable", err)
+	}
+
+	// Case 2: Taint persistence fails AND even if the prior unsealed receipt survives on disk (e.g. read-only volume),
+	// SealReview refuses in-process AND after proxy restart (even if volume becomes writable again).
+	launch := "review-cccc1111-2222-4333-8444-555555555551"
+	session := "019d0000-0000-7000-8000-000000000301"
+	ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, e, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+	})})
+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	resp, err := client.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.ObserveStreamChunk([]byte(`data: {"type":"response.completed","response":{"id":"resp_clean","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}}` + "\n\n"))
+	_, _ = io.Copy(io.Discard, resp.Body)
+	_ = resp.Body.Close()
+	e.End()
+	c.Complete(true)
+	c.HandlerDone(true)
+	launchDir := filepath.Join(root, launch)
+	savedUnsealed, err := os.ReadFile(filepath.Join(launchDir, "receipt.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Simulate temp-file creation failure during taint persistence, AND re-plant the exact unsealed file
+	// as would happen on a read-only filesystem where persist, Truncate, and Remove all fail.
+	blocker := filepath.Join(launchDir, fmt.Sprintf("pending-%d-%d", os.Getpid(), tmpSeq.Load()+1))
+	if err := os.Mkdir(blocker, 0700); err != nil {
+		t.Fatal(err)
+	}
+	TaintReview(root, launch)
+	if raw, readErr := os.ReadFile(filepath.Join(launchDir, "receipt.json")); readErr == nil && len(raw) > 0 {
+		t.Fatalf("stale clean receipt survived writable failed taint write: %s", raw)
+	}
+	// Restore the surviving unsealed receipt as if the volume had been read-only during taint.
+	if err := os.WriteFile(filepath.Join(launchDir, "receipt.json"), savedUnsealed, 0600); err != nil {
+		t.Fatal(err)
+	}
+	_ = os.Remove(blocker)
+	// In-process: tainted entry stays pinned in RAM -> SealReview MUST reject.
+	if st := SealReview(root, launch, session); st != SealRejected {
+		t.Fatalf("in-process SealReview accepted read-only surviving receipt: %v", st)
+	}
+	// After proxy restart (even with writable disk): surviving unsealed receipt from dead proxy is UNSEALABLE.
+	reviewMu.Lock()
+	delete(reviewLedger, root+"\x00"+launch)
+	reviewMu.Unlock()
+	if st := SealReview(root, launch, session); st != SealRejected {
+		t.Fatalf("post-restart SealReview accepted surviving unsealed receipt: %v", st)
+	}
+	if _, _, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("post-restart BeginReview accepted surviving unsealed receipt: err=%v", err)
+	}
+}
