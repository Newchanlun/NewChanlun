+	s3 := "019d0000-0000-7000-8000-666666666803"
+	sseRefusalFinal := "data: " + `{"type":"response.created","response":{"id":"resp_c3","status":"in_progress","model":"gpt-6.2-sol"}}` + "\n\n" +
+		"data: " + `{"type":"response.output_item.done","item":{"type":"message","role":"assistant","phase":"final_answer","content":[{"type":"output_text","text":"earlier text"}]}}` + "\n\n" +
