+		t.Fatalf("syncPinnedDir blocked on path-based FIFO open")
+	}
+	// defaultSyncDir (used only for parent-of-root) MUST ALSO fail fast on a FIFO via O_DIRECTORY|O_NONBLOCK.
+	doneParent := make(chan error, 1)
+	go func() {
+		doneParent <- defaultSyncDir(fifoPath)
+	}()
+	select {
+	case err := <-doneParent:
+		if err == nil {
+			t.Fatalf("defaultSyncDir unexpectedly succeeded on a FIFO")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatalf("defaultSyncDir blocked on FIFO")
+	}
+}
