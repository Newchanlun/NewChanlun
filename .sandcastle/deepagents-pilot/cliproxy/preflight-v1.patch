 	budgetCheck func(line []byte, heldLines int, heldBytes int) bool
 }
 
+type sseLineSplitter struct {
+	checkedBOM bool
+	pendingCR  bool
+}
+
+// Split implements WHATWG EventSource line splitting: CRLF, standalone CR, and LF,
+// stripping at most one leading UTF-8 BOM (0xEF 0xBB 0xBF) at stream offset 0.
+// When a CR ends the current read buffer before EOF, emit the line immediately and record
+// pendingCR so a following leading LF on the next read is consumed without stalling live streams.
+func (s *sseLineSplitter) Split(data []byte, atEOF bool) (advance int, token []byte, err error) {
+	if len(data) == 0 {
+		return 0, nil, nil
+	}
+	start := 0
+	if !s.checkedBOM {
+		if !atEOF && ((len(data) == 1 && data[0] == 0xEF) || (len(data) == 2 && data[0] == 0xEF && data[1] == 0xBB)) {
+			return 0, nil, nil
+		}
+		s.checkedBOM = true
+		if len(data) >= 3 && data[0] == 0xEF && data[1] == 0xBB && data[2] == 0xBF {
+			start = 3
+			if start == len(data) {
+				return 3, nil, nil
+			}
+		}
+	} else if s.pendingCR {
+		s.pendingCR = false
+		if data[0] == '\n' {
+			start = 1
+			if start == len(data) {
+				return 1, nil, nil
+			}
+		}
+	}
+	for i := start; i < len(data); i++ {
+		if data[i] == '\n' {
+			return i + 1, data[start:i], nil
+		}
+		if data[i] == '\r' {
+			if i+1 < len(data) {
+				if data[i+1] == '\n' {
+					return i + 2, data[start:i], nil
+				}
+				return i + 1, data[start:i], nil
+			}
+			s.pendingCR = true
+			return i + 1, data[start:i], nil
+		}
+	}
+	if atEOF {
+		return len(data), data[start:], nil
+	}
+	if start > 0 {
+		return start, nil, nil
+	}
+	return 0, nil, nil
+}
+
 // NewCodexSSEScanner returns a CodexSSEScanner over r, with assembly on. maxBytes bounds one line,
 // as bufio.Scanner.Buffer does, and also the data lines collected for one event.
 func NewCodexSSEScanner(ctx context.Context, r io.Reader, maxBytes int) *CodexSSEScanner {
 	lines := bufio.NewScanner(r)
+	splitter := &sseLineSplitter{}
+	lines.Split(splitter.Split)
 	lines.Buffer(nil, maxBytes)
 	return &CodexSSEScanner{ctx: ctx, lines: lines, maxBytes: maxBytes}
 }
