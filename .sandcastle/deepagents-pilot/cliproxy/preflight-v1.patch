+	startCh := make(chan struct{})
+	type sealRes struct {
+		launch string
+		st     SealStatus
+		dig    string
+	}
+	outCh := make(chan sealRes, 2)
+	for _, pair := range [][2]string{{l1, s1}, {l2, s2}} {
+		p := pair
+		go func() {
+			<-startCh
+			st, dig := SealReviewWithDigest(root, p[0], p[1])
+			outCh <- sealRes{launch: p[0], st: st, dig: dig}
+		}()
+	}
+	close(startCh)
