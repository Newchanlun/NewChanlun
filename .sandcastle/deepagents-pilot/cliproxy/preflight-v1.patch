+						!t.recordToolPayloadFinal(canonKey, "arguments", itemArgs) ||
+						!t.recordToolPayloadFinal(canonKey, "input", itemInput) ||
+						!t.recordToolPayloadFinal(canonKey, "code", itemCode) {
+						c.mu.Unlock()
+						c.taintStreamAnomaly()
+						return
+					}
+				} else {
+					if !t.recordToolMeta(canonKey, itemMeta) ||
