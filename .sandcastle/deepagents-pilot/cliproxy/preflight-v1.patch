+func TestReviewReceiptExpiredLaunchRejectedAtAdmissionAndCapsTurnDeadline(t *testing.T) {
+	// Astra P2 #4 (PR #2280 R34):
+	// 1. A launch with <30m remaining in its 2h MaxReviewDuration MUST cap collector.Deadline() to the launch limit.
+	// 2. An already-expired (>2h) launch MUST be rejected at admission BEFORE starting upstream inference.
+	root := filepath.Join(t.TempDir(), "deadline-cap-receipts")
+	launchCap := "review-e9999999-2222-4333-8444-555555555501"
+	sessionCap := "019d0000-0000-7000-8000-888888888901"
+
+	res, err := ReserveReview(root, launchCap)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Release()
+
+	// Backdate started to 1h55m ago -> only ~5m left in 2h window (< 30m ReviewTurnTimeout).
+	keyCap := filepath.Clean(root) + "\x00" + launchCap
+	nearExpStart := time.Now().Add(-MaxReviewDuration + 5*time.Minute)
+	reviewMu.Lock()
+	entCap := reviewLedger[keyCap]
+	reviewMu.Unlock()
+	entCap.mu.Lock()
+	entCap.started = nearExpStart.UnixNano()
+	entCap.mu.Unlock()
+
+	res2, existed, err := ReserveExistingReview(root, launchCap)
+	if err != nil || !existed || res2 == nil {
+		t.Fatalf("ReserveExistingReview near-expiry = (%v, %v, %v), want active reservation", res2, existed, err)
+	}
+	_, c2, err := BeginReviewReserved(context.Background(), res2, sessionCap, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatalf("BeginReviewReserved near-expiry: %v", err)
+	}
+	wantMaxDeadline := nearExpStart.Add(MaxReviewDuration)
+	if c2.Deadline().After(wantMaxDeadline.Add(time.Second)) {
+		t.Fatalf("collector.Deadline() = %v exceeded launch 2h limit %v", c2.Deadline(), wantMaxDeadline)
+	}
+	c2.Complete(false)
+	c2.HandlerDone(false)
+
+	// Backdate started past 2h -> admission MUST reject immediately with ErrUnavailable.
+	entCap.mu.Lock()
+	entCap.started = time.Now().Add(-MaxReviewDuration - time.Minute).UnixNano()
+	entCap.mu.Unlock()
+	if resExp, _, expErr := ReserveExistingReview(root, launchCap); !errors.Is(expErr, ErrUnavailable) || resExp != nil {
+		t.Fatalf("ReserveExistingReview expired launch = (%v, %v), want (nil, ErrUnavailable)", resExp, expErr)
+	}
+}
