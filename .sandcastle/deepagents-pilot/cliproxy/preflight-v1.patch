+func TestReviewReceiptReserveConcurrentWriteFailureNeverAdmitsWithoutMarker(t *testing.T) {
+	// Sol P1 (R19): if persistLocked creates the launch dir (entry.reserved=true) and then fails
+	// writing/renaming receipt.json while a concurrent request holds inFlight > 0, the second request
+	// MUST NOT skip marker persistence and MUST also fail closed with ErrUnavailable.
+	root := filepath.Join(t.TempDir(), "receipts")
+	if err := os.MkdirAll(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	launch := "review-eeee1111-2222-4333-8444-555555555903"
+	launchDir := filepath.Join(root, launch)
+	if err := os.Mkdir(launchDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	// Pre-register a clean in-memory entry with inFlight=1 (simulating a concurrent waiter already
+	// attached to the same entry before persistLocked runs), while blocking the next two pending tmp files.
+	now := time.Now()
+	key := root + "\x00" + launch
+	entry := &reviewEntry{directory: launchDir, launch: launch, started: now.UnixNano(), touched: now, inFlight: 1}
+	reviewMu.Lock()
+	reviewLedger[key] = entry
+	reviewMu.Unlock()
+	t.Cleanup(func() {
+		reviewMu.Lock()
+		delete(reviewLedger, key)
+		reviewMu.Unlock()
+	})
+	baseSeq := tmpSeq.Load()
+	b1 := filepath.Join(launchDir, fmt.Sprintf("pending-%d-%d", os.Getpid(), baseSeq+1))
+	b2 := filepath.Join(launchDir, fmt.Sprintf("pending-%d-%d", os.Getpid(), baseSeq+2))
+	if err := os.Mkdir(b1, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(b2, 0700); err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := ReserveReview(root, launch); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("first ReserveReview with blocked receipt write = %v, want ErrUnavailable", err)
+	}
+	entry.mu.Lock()
+	dirReserved := entry.reserved
+	markerOK := entry.markerPersisted
+	entry.mu.Unlock()
+	if !dirReserved || markerOK {
+		t.Fatalf("expected reserved=true, markerPersisted=false after write failure; got reserved=%v marker=%v", dirReserved, markerOK)
+	}
+	// Second concurrent request arrives while entry is still in reviewLedger with reserved=true, markerPersisted=false.
+	if _, err := ReserveReview(root, launch); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("second ReserveReview bypassed missing marker persistence: err=%v", err)
+	}
+	_ = os.Remove(b1)
+	_ = os.Remove(b2)
+	releaseReview(entry)
+}
