 }
+
+// PreflightRoundTripperFor implements coreauth.PreflightRoundTripperProvider.
+// It returns a sealed proxy-owned RoundTripper (never exposing *http.Transport for mutation)
+// and fails closed for unsupported proxy schemes (such as https://).
+func (p *defaultRoundTripperProvider) PreflightRoundTripperFor(auth *coreauth.Auth) http.RoundTripper {
+	if auth == nil {
+		return nil
+	}
+	proxyStr := strings.TrimSpace(auth.ProxyURL)
+	if proxyStr == "" {
+		return nil
+	}
+	controlled, errControlled := coreauth.ControlledTransportForProxy(proxyStr)
+	if errControlled != nil || controlled == nil {
+		return coreauth.NewPreflightTransportError(preflightreceipt.ErrUnavailable)
+	}
+	return controlled
+}
