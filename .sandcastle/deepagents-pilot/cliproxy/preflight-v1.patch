+	// to StreamChunk{Err} and permanently taint the launch so Turn 1 cannot be sealed. Conversely,
+	// a transient failure frame carrying the expected model must fail Turn 2 without tainting Turn 1.
+	tlsState := preflightCodexVerifiedTLS(t, "chatgpt.com")
