+func TestReviewReceiptFailedFollowupTurnCannotSealStaleTurn(t *testing.T) {
+	// Sol P1 #1 (PR #2280 R29): after Turn 1 succeeds, a Turn 2 that fails before publishing
+	// MUST block SealReview from sealing Turn 1's stale output until a subsequent clean Turn 3 succeeds.
+	root := filepath.Join(t.TempDir(), "stale-turn-receipts")
+	launch := "review-e3333333-2222-4333-8444-555555555501"
+	session := "019d0000-0000-7000-8000-888888888601"
+	runCleanTurn := func(respID, text string) {
+		ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, e, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		cl := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("")), TLS: verifiedTLSState("chatgpt.com")}, nil
+		})})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		resp, err := cl.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+		c.ObserveStreamChunk([]byte("data: " + fmt.Sprintf(`{"type":"response.completed","response":{"id":%q,"status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":%q}]}]}}`, respID, text) + "\n\n"))
+		e.End()
+		c.Complete(true)
+		c.HandlerDone(true)
+	}
+
+	runCleanTurn("resp_stale_1", "VERDICT: PASS (turn 1)")
+
+	// Turn 2 fails before upstream execution completes (transient turn failure, not taint).
+	_, c2, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	c2.Reject()
+	c2.Complete(false)
+	c2.HandlerDone(false)
+
+	if st, digest := SealReviewWithDigest(root, launch, session); st != SealRejected || digest != "" {
+		t.Fatalf("SealReviewWithDigest after failed follow-up turn = (%v, %q), want (SealRejected, \"\")", st, digest)
+	}
+	recAfterFail := readReviewReceiptFile(t, root, launch)
+	if recAfterFail.Complete || recAfterFail.LastOutputSHA256 != "" {
+		t.Fatalf("receipt after failed follow-up turn = %+v, want complete=false and empty last_output_sha256", recAfterFail)
+	}
+
+	// Clean Turn 3 retry recovers and seals with Turn 3's output.
+	runCleanTurn("resp_stale_3", "VERDICT: BLOCK (turn 3)")
+	if st, digest := SealReviewWithDigest(root, launch, session); st != SealOK || digest == "" {
+		t.Fatalf("SealReviewWithDigest after clean retry = (%v, %q), want (SealOK, non-empty)", st, digest)
+	}
+	recAfterRetry := readReviewReceiptFile(t, root, launch)
+	if !recAfterRetry.Complete || !recAfterRetry.Sealed || recAfterRetry.LastOutputSHA256 != sha256Hex("VERDICT: BLOCK (turn 3)") {
+		t.Fatalf("receipt after clean retry = %+v, want sealed turn 3 output", recAfterRetry)
+	}
+}
