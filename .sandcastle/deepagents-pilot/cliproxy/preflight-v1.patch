+			},
+		},
+		// 6. R24 (Sol P1 + Astra P1): case-insensitive field collision (error vs Error, Status vs status, Model vs model).
+		{
+			name: "case-collision-top-level-error", id: "a",
+			chunks: []string{
+				`data: {"type":"response.completed","error":{"code":"boom"},"Error":null,"response":{"id":"resp_ma","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
