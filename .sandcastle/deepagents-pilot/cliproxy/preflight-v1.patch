+func TestComputePinnedDirFDBudgetLowNofileHasNoFixedFloor(t *testing.T) {
+	// Astra P2 #2 (PR #2280 R51): low RLIMIT_NOFILE MUST NOT be overridden upward by a fixed floor
+	// of 16; budget must monotonically respect >=75% and >=256 FD reserve, allowing <16 and 0.
+	cases := []struct {
+		nofile uint64
+		want   int
+	}{
+		{0, 0},
+		{16, 0},
+		{32, 0},
+		{64, 0},
+		{256, 0},
+		{260, 4},
+		{270, 14},
+		{300, 44},
+		{512, 128},
+		{1024, 256},
+		{8192, 2048},
+		{100000, 2048},
+		{^uint64(0), 2048},
+	}
+	prev := 0
+	for _, tc := range cases {
+		got := computePinnedDirFDBudget(tc.nofile, 2048)
+		if got != tc.want {
+			t.Fatalf("computePinnedDirFDBudget(%d, 2048) = %d, want %d", tc.nofile, got, tc.want)
+		}
+		if got < prev {
+			t.Fatalf("computePinnedDirFDBudget non-monotonic at %d: %d < %d", tc.nofile, got, prev)
+		}
+		if tc.nofile > 0 && got > 0 {
+			reserved := tc.nofile - uint64(got)
+			if reserved < 256 || uint64(got) > tc.nofile/4 {
+				t.Fatalf("computePinnedDirFDBudget(%d) = %d violates headroom reserve (reserved=%d)", tc.nofile, got, reserved)
+			}
+		}
+		prev = got
+	}
+
+	// Budget == 0 MUST reject new ReserveReview cleanly without creating a directory.
+	oldOverride := pinnedDirFDBudgetOverride
+	pinnedDirFDBudgetOverride = 0
+	defer func() { pinnedDirFDBudgetOverride = oldOverride }()
+	root := filepath.Join(t.TempDir(), "zero-fd-budget")
+	launch := "review-f8888888-2222-4333-8444-555555555501"
+	if res, err := ReserveReview(root, launch); !errors.Is(err, ErrUnavailable) || res != nil {
+		if res != nil {
+			res.Release()
+		}
+		t.Fatalf("ReserveReview with zero FD budget = (%v, %v), want (nil, ErrUnavailable)", res, err)
+	}
+	if _, statErr := os.Lstat(filepath.Join(root, launch)); !os.IsNotExist(statErr) {
+		t.Fatalf("rejected zero-FD-budget ReserveReview left dir on disk: %v", statErr)
+	}
+}
