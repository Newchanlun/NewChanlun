+
+func isCompletedNonMessageItemStatus(status string) bool {
+	return status == "" || status == "completed"
+}
+
+func isTerminalAssistantItemStatus(status string) bool {
+	return status == "" || status == "completed" || status == "incomplete"
+}
+
+func isIrreversibleFailureItemStatus(status string) bool {
+	return status == "failed" || status == "cancelled" || status == "canceled"
+}
+
+func doneItemStatusCompatible(doneStatus, nextStatus string) bool {
+	if doneStatus == nextStatus {
+		return true
+	}
+	return (doneStatus == "" && nextStatus == "completed") || (doneStatus == "completed" && nextStatus == "")
+}
+
+func doneItemMatchesOutputItem(doneRec doneItemSummary, item responseOutputItem) bool {
+	if doneRec.itemType != item.Type || doneRec.itemRole != item.Role || doneRec.itemPhase != item.Phase ||
+		!doneItemStatusCompatible(doneRec.itemStatus, item.Status) ||
+		doneRec.callID != item.CallID || doneRec.name != item.Name || doneRec.serverLabel != item.ServerLabel ||
+		doneRec.argsSHA != item.ArgsSHA || doneRec.inputSHA != item.InputSHA || doneRec.codeSHA != item.CodeSHA ||
+		(doneRec.canonicalItemSHA != "" && item.CanonicalItemSHA != "" && doneRec.canonicalItemSHA != item.CanonicalItemSHA) ||
+		doneRec.isFinal != isFinalAssistantOutputItem(item) {
+		return false
+	}
+	if doneRec.isAssistantMsg {
+		if item.Type != "message" || item.Role != "assistant" {
+			return false
+		}
+		itemText := extractSingleAssistantText(item)
+		itemSHA := ""
+		if itemText != "" {
+			itemSHA = sha256Hex(itemText)
+		}
+		if itemSHA != doneRec.outputTextSHA {
+			return false
+		}
+	}
+	return true
+}
+
+type strictItemKind uint8
+
+const (
+	itemKindUnknown strictItemKind = iota
+	itemKindMessageAny
+	itemKindFinalAssistant
+	itemKindCommentary
+	itemKindNonMessage
+)
+
+func classifyOutputItemKind(itemType, itemRole, itemPhase string, isDone bool) strictItemKind {
+	if itemType == "" {
+		return itemKindUnknown
+	}
+	if itemType == "message" && itemRole == "assistant" {
+		if itemPhase == "final_answer" {
+			return itemKindFinalAssistant
+		}
+		if itemPhase != "" {
+			return itemKindCommentary
+		}
+		if isDone {
+			return itemKindFinalAssistant
+		}
+		return itemKindMessageAny
+	}
+	return itemKindNonMessage
+}
+
+func inferredDeltaItemType(evType string) string {
+	switch {
+	case evType == "response.output_text.delta" ||
+		evType == "response.output_text.done" ||
+		evType == "response.output_text.annotation.added" ||
+		evType == "response.refusal.delta" ||
+		evType == "response.refusal.done" ||
+		evType == "response.audio.delta" ||
+		evType == "response.audio.done" ||
+		evType == "response.audio.transcript.delta" ||
+		evType == "response.audio.transcript.done":
+		return "message"
+	case strings.HasPrefix(evType, "response.function_call_arguments."):
+		return "function_call"
+	case strings.HasPrefix(evType, "response.custom_tool_call_input."):
+		return "custom_tool_call"
+	case strings.HasPrefix(evType, "response.mcp_call_arguments.") || strings.HasPrefix(evType, "response.mcp_call."):
+		return "mcp_call"
+	case strings.HasPrefix(evType, "response.reasoning"):
+		return "reasoning"
+	case strings.HasPrefix(evType, "response.code_interpreter_call"):
+		return "code_interpreter_call"
+	case strings.HasPrefix(evType, "response.file_search_call"):
+		return "file_search_call"
+	case strings.HasPrefix(evType, "response.web_search_call"):
+		return "web_search_call"
+	case strings.HasPrefix(evType, "response.image_generation_call"):
+		return "image_generation_call"
+	default:
+		return ""
+	}
+}
+
+func classifyDeltaEventKind(evType string) strictItemKind {
+	switch evType {
+	case "response.output_text.delta",
+		"response.output_text.done",
+		"response.output_text.annotation.added",
+		"response.refusal.delta",
+		"response.refusal.done",
+		"response.audio.delta",
+		"response.audio.done",
+		"response.audio.transcript.delta",
+		"response.audio.transcript.done":
+		return itemKindMessageAny
+	default:
+		return itemKindNonMessage
+	}
+}
+
+func classifyDeltaFrame(frame parsedStrictFrame) (strictItemKind, string) {
+	if frame.evType == "response.content_part.added" || frame.evType == "response.content_part.done" {
+		if frame.partFields != nil {
+			pType, _ := exactOptionalString(frame.partFields, "type")
+			switch pType {
+			case "output_text", "refusal", "output_audio":
+				return itemKindMessageAny, "message"
+			case "reasoning_text", "summary_text":
+				return itemKindNonMessage, "reasoning"
+			default:
+				return itemKindUnknown, ""
+			}
+		}
+		return itemKindUnknown, ""
+	}
+	return classifyDeltaEventKind(frame.evType), inferredDeltaItemType(frame.evType)
+}
+
+func isAssistantOnlyPartTag(tag string) bool {
+	return tag == "text-pending" ||
+		strings.HasPrefix(tag, "text:") ||
+		tag == contentPartTag("refusal", "") ||
+		tag == contentPartTag("output_audio", "")
+}
+
+func mergeStrictItemKind(prev, next strictItemKind) (strictItemKind, bool) {
+	if next == itemKindUnknown {
+		return prev, true
+	}
+	if prev == itemKindUnknown || prev == next {
+		return next, true
+	}
+	if prev == itemKindMessageAny && (next == itemKindFinalAssistant || next == itemKindCommentary) {
+		return next, true
+	}
+	if next == itemKindMessageAny && (prev == itemKindFinalAssistant || prev == itemKindCommentary) {
+		return prev, true
+	}
+	return itemKindUnknown, false
+}
+
+func isFinalAssistantOutputItem(item responseOutputItem) bool {
+	if item.Type != "message" || item.Role != "assistant" {
+		return false
+	}
+	if item.Phase != "" && item.Phase != "final_answer" {
+		return false
+	}
+	if item.Status != "" && item.Status != "completed" {
+		return false
+	}
+	return true
+}
+
+func (c *Collector) resetOutputTrackingLocked() {
+	c.consumer.resetTracking()
+	c.producer.resetTracking()
+}
+
+func (c *Collector) resetAttemptStreamStateLocked() {
+	c.consumer = strictStreamTracker{}
+	c.producer = strictStreamTracker{}
+	c.producerRequired = false
+	c.producerObserved = false
+	c.sseEventName = ""
+	c.sseHasEvent = false
+	c.ssePendingCR = false
+	c.sseCheckedBOM = false
+	c.sseBOMLen = 0
+	c.sseDataLines = nil
+	c.sseDataBytes = 0
+}
+
+func extractSingleAssistantText(item responseOutputItem) string {
+	var b strings.Builder
+	for _, part := range item.Content {
+		if part.Type == "output_text" {
+			b.WriteString(part.Text)
+		}
+	}
+	return b.String()
+}
+
+func contentPartTag(partType, text string) string {
+	if partType == "output_text" {
+		return "text:" + sha256Hex(text)
+	}
+	return "other:" + sha256Hex(partType)
+}
+
+func extractAssistantOutputText(items []responseOutputItem) string {
+	last := ""
+	for _, item := range items {
+		if item.Type == "message" && item.Role == "assistant" {
+			// Exclude intermediate narration/progress messages (e.g. phase="commentary") and
+			// explicitly non-completed messages; clear last so earlier text never leaks through.
+			if (item.Phase != "" && item.Phase != "final_answer") || (item.Status != "" && item.Status != "completed") {
+				last = ""
+				continue
+			}
+			// Always overwrite last (including clearing to "" when the latest final assistant
+			// message has only a refusal or non-output_text content) so earlier text never leaks through.
+			last = extractSingleAssistantText(item)
+			continue
+		}
+		// Any non-assistant-message item (tool calls, mcp_approval_request, reasoning, etc.)
+		// supersedes earlier unphased assistant preamble text so only a final assistant answer
+		// emitted as the final actionable item may supply last_output_sha256.
+		last = ""
+	}
+	return last
+}
+
+func hasResponseError(raw json.RawMessage) bool {
+	trimmed := trimJSONSpace(raw)
+	return len(trimmed) > 0 && !bytes.Equal(trimmed, []byte("null"))
+}
+
+func (t *strictStreamTracker) verifyCompletedOutput(output []responseOutputItem, completedSHA string) bool {
+	if len(t.pendingItems) > 0 || t.pendingUnkeyed > 0 || len(t.failedItemKeys) > 0 {
+		return false
+	}
+	for _, item := range output {
+		if item.Type == "message" && item.Role == "assistant" {
+			if !isTerminalAssistantItemStatus(item.Status) {
+				return false
+			}
+		} else if !isCompletedNonMessageItemStatus(item.Status) {
+			return false
+		}
+	}
+	if len(output) == 0 || !t.sawStreamedOutputItem {
+		return true
+	}
+	if t.hasMaxOutputIndex && int64(len(output)) <= t.maxOutputIndex {
+		return false
+	}
+	hasPendingItems := len(t.pendingItems) > 0 || t.pendingUnkeyed > 0
+	completedNonFinalCount := 0
+	completedNonFinalIDs := make(map[string]struct{}, len(output))
+	matchedDoneKeys := make(map[string]struct{}, len(t.doneItems))
+	matchedOutputIdx := make([]bool, len(output))
+	for idx, item := range output {
+		pos := int64(idx)
+		if item.ID != "" {
+			if boundIdx, seen := t.itemIndexByID[item.ID]; seen && boundIdx != pos {
+				return false
+			}
+		}
+		boundID, hasBoundID := t.itemIDByIndex[pos]
+		if hasBoundID && item.ID != "" && boundID != item.ID {
+			return false
+		}
+		canonKey := ""
+		if item.ID != "" {
+			canonKey = "id:" + item.ID
+		} else if hasBoundID {
+			canonKey = "id:" + boundID
+		} else {
+			canonKey = "idx:" + strconv.FormatInt(pos, 10)
+		}
+		itemKind := classifyOutputItemKind(item.Type, item.Role, item.Phase, true)
+		if prevKind, exists := t.itemKindByKey[canonKey]; exists {
+			if _, okMerge := mergeStrictItemKind(prevKind, itemKind); !okMerge {
+				return false
+			}
+		}
+		if prevType, exists := t.itemTypeByKey[canonKey]; exists && item.Type != prevType {
+			return false
+		}
+		if recordedParts, hasParts := t.contentPartByItem[canonKey]; hasParts {
+			if item.Type != "message" || item.Role != "assistant" {
+				for _, wantTag := range recordedParts {
+					if isAssistantOnlyPartTag(wantTag) {
+						return false
+					}
+				}
+			} else {
+				for cIdx, wantTag := range recordedParts {
+					if cIdx < 0 || int(cIdx) >= len(item.Content) {
+						return false
+					}
+					part := item.Content[cIdx]
+					if wantTag == "text-pending" {
+						if part.Type != "output_text" {
+							return false
+						}
+					} else if contentPartTag(part.Type, part.Text) != wantTag {
+						return false
+					}
+				}
+			}
+		}
+		if deltaHashes, hasDeltas := t.textDeltaHashByItem[canonKey]; hasDeltas {
+			if item.Type != "message" || item.Role != "assistant" {
+				return false
+			}
+			for cIdx, st := range deltaHashes {
+				if cIdx < 0 || int(cIdx) >= len(item.Content) {
+					return false
+				}
+				part := item.Content[cIdx]
+				if part.Type != "output_text" || ((!st.fromSnapshot || st.hasDelta) && sha256Hex(part.Text) != hex.EncodeToString(st.h.Sum(nil))) {
+					return false
+				}
+			}
+		}
+		if prefixes, hasPrefixes := t.textPrefixByItem[canonKey]; hasPrefixes {
+			if item.Type != "message" || item.Role != "assistant" {
+				return false
+			}
+			for cIdx, pref := range prefixes {
+				if cIdx < 0 || int(cIdx) >= len(item.Content) {
+					return false
+				}
+				part := item.Content[cIdx]
+				if part.Type != "output_text" || len(part.Text) < pref.byteLen || sha256Hex(part.Text[:pref.byteLen]) != pref.sha256 {
+					return false
+				}
+			}
+		}
+		itemMeta := toolItemMeta{callID: item.CallID, name: item.Name, serverLabel: item.ServerLabel}
+		itemArgs := toolPayloadField{sha: item.ArgsSHA, str: item.ArgsStr, isStr: item.ArgsIsStr}
+		itemInput := toolPayloadField{sha: item.InputSHA, str: item.InputStr, isStr: item.InputIsStr}
+		itemCode := toolPayloadField{sha: item.CodeSHA, str: item.CodeStr, isStr: item.CodeIsStr}
+		if item.Type == "message" && item.Role == "assistant" {
+			if t.hasTrackedToolPayload(canonKey) {
+				return false
+			}
+		} else {
+			if !t.checkToolMetaComplete(canonKey, itemMeta) ||
+				!t.checkToolPayloadFinal(canonKey, "arguments", itemArgs) ||
+				!t.checkToolPayloadFinal(canonKey, "input", itemInput) ||
+				!t.checkToolPayloadFinal(canonKey, "code", itemCode) {
+				return false
+			}
+		}
+		if doneRec, exists := t.doneItems[canonKey]; exists {
+			matchedDoneKeys[canonKey] = struct{}{}
+			matchedOutputIdx[idx] = true
+			if !doneItemMatchesOutputItem(doneRec, item) {
+				return false
+			}
+		}
+		if _, mustBeIncomplete := t.incompleteItemKeys[canonKey]; mustBeIncomplete && item.Status != "incomplete" {
+			return false
+		}
+		if !isFinalAssistantOutputItem(item) {
+			completedNonFinalCount++
+			if item.ID != "" {
+				completedNonFinalIDs[item.ID] = struct{}{}
+			}
+		}
+	}
+	if len(matchedDoneKeys) < len(t.doneItems) {
+		return false
+	}
+	if len(t.unkeyedDoneItems) > 0 {
+		scan := 0
+		for _, unkeyedRec := range t.unkeyedDoneItems {
+			found := false
+			for scan < len(output) {
+				if matchedOutputIdx[scan] {
+					scan++
+					continue
+				}
+				if doneItemMatchesOutputItem(unkeyedRec, output[scan]) {
+					matchedOutputIdx[scan] = true
+					scan++
+					found = true
+					break
+				}
+				scan++
+			}
+			if !found {
+				return false
+			}
+		}
+	}
+	if completedNonFinalCount < len(t.streamedNonFinalKeys)+t.streamedNonFinalUnkeyed {
+		return false
+	}
+	for nonFinalID := range t.streamedNonFinalIDs {
+		if _, ok := completedNonFinalIDs[nonFinalID]; !ok {
+			return false
+		}
+	}
+	if completedSHA != "" && (t.lastItemOutputSHA != completedSHA || hasPendingItems) {
+		return false
+	}
+	return true
+}
+
+func (c *Collector) taintStreamAnomaly() {
+	c.mu.Lock()
+	c.modelMismatch = true
+	c.invalid = true
+	c.resetOutputTrackingLocked()
+	c.mu.Unlock()
+	c.Taint()
+}
