+	st1, d1 := SealReviewWithDigest(root, launch, session)
+	if st1 != SealOK || !isSHA256Hex(d1) {
+		t.Fatalf("initial SealReviewWithDigest = (%v, %q), want SealOK", st1, d1)
+	}
+	// Replace <root>/<launch> with a brand-new directory inode holding copied identical files.
+	origDir := filepath.Join(root, launch)
+	recRaw, err := os.ReadFile(filepath.Join(origDir, "receipt.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	shaRaw, err := os.ReadFile(filepath.Join(origDir, "seal.sha256"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	movedDir := filepath.Join(t.TempDir(), "old-launch")
+	if err := os.Rename(origDir, movedDir); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(origDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(origDir, "receipt.json"), recRaw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(origDir, "seal.sha256"), shaRaw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if st2, d2 := SealReviewWithDigest(root, launch, session); st2 != SealUnavailable || d2 != "" {
+		t.Fatalf("repeat SealReviewWithDigest after launch dir replacement = (%v, %q), want (SealUnavailable, \"\")", st2, d2)
+	}
+
+	// Astra P1 #1 (R44): even AFTER reviewLedger evicts the sealed entry (without process restart),
+	// sealedBindings MUST still preserve the original dir inode + digest binding and reject the replaced dir.
+	key := filepath.Clean(root) + "\x00" + launch
+	reviewMu.Lock()
+	delete(reviewLedger, key)
+	reviewMu.Unlock()
+	if st3, d3 := SealReviewWithDigest(root, launch, session); st3 != SealUnavailable || d3 != "" {
+		t.Fatalf("post-eviction SealReviewWithDigest after launch dir replacement = (%v, %q), want (SealUnavailable, \"\")", st3, d3)
+	}
+
+	// Sol P1 #1 (R46) + Sol P2 #2 (R44): restore the genuine original sealed directory, then
+	// simulate a cold restart (both reviewLedger and sealedBindings empty). The first post-restart
+	// SealOK confirms the genuine directory and binds its inode + pinned dirFD in-process so a
+	// subsequent rename-or-delete replacement returns SealUnavailable rather than SealOK.
+	_ = os.RemoveAll(origDir)
+	if err := os.Rename(movedDir, origDir); err != nil {
+		t.Fatal(err)
+	}
+	reviewMu.Lock()
+	delete(reviewLedger, key)
+	if oldBind, ok := sealedBindings[key]; ok {
+		closeBudgetedPinnedDirFD(oldBind.dirFD)
+		delete(sealedBindings, key)
+	}
+	reviewMu.Unlock()
+	if st4, d4 := SealReviewWithDigest(root, launch, session); st4 != SealOK || d4 != d1 {
+		t.Fatalf("cold post-restart SealReviewWithDigest on genuine dir = (%v, %q), want (SealOK, %q)", st4, d4, d1)
+	}
+	// Astra P1 #1 (R48): delete-and-recreate <root>/<launch> (NOT rename aside) so the filesystem
+	// is eligible to recycle inode numbers; pinned dirFD prevents inode reuse and catches unlinked dir.
+	if err := os.RemoveAll(origDir); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(origDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(origDir, "receipt.json"), recRaw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(origDir, "seal.sha256"), shaRaw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if st5, d5 := SealReviewWithDigest(root, launch, session); st5 != SealUnavailable || d5 != "" {
+		t.Fatalf("post-restart repeat SealReviewWithDigest after delete+recreate = (%v, %q), want (SealUnavailable, \"\")", st5, d5)
+	}
+}
