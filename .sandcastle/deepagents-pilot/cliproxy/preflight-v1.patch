+func TestReviewReceiptPreSealDiskCorruptionFailsClosed(t *testing.T) {
+	// Astra P1 #3 (PR #2280 R19): once markerPersisted is true, missing, corrupted, symlinked, or
+	// permissive receipt.json on disk BEFORE first SealReview MUST fail closed (SealRejected) rather
+	// than overwriting disk from memory and returning SealOK.
+	for idx, tc := range []struct {
+		name    string
+		corrupt func(t *testing.T, receiptPath string)
+	}{
+		{
+			name: "corrupt-json",
+			corrupt: func(t *testing.T, receiptPath string) {
+				if err := os.WriteFile(receiptPath, []byte("{corrupt"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			},
+		},
+		{
+			name: "deleted-receipt",
+			corrupt: func(t *testing.T, receiptPath string) {
+				if err := os.Remove(receiptPath); err != nil {
+					t.Fatal(err)
+				}
+			},
+		},
+		{
+			name: "symlink-receipt",
+			corrupt: func(t *testing.T, receiptPath string) {
+				raw, err := os.ReadFile(receiptPath)
+				if err != nil {
+					t.Fatal(err)
+				}
+				alt := filepath.Join(filepath.Dir(receiptPath), "alt.json")
+				if err := os.WriteFile(alt, raw, 0600); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Remove(receiptPath); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Symlink(alt, receiptPath); err != nil {
+					t.Fatal(err)
+				}
+			},
+		},
+		{
+			name: "permissive-mode",
+			corrupt: func(t *testing.T, receiptPath string) {
+				if err := os.Chmod(receiptPath, 0644); err != nil {
+					t.Fatal(err)
+				}
+			},
+		},
+		{
+			name: "rollback-to-valid-earlier-receipt",
