+	t.Run("unlisted-model", func(t *testing.T) {
+		const session = "preflight-12345678-1234-4234-8234-123456789abf"
+		res := request("gpt-6.1-sol", session)
+		if res.Code < 400 || len(models) != 0 {
+			t.Fatalf("out-of-scope model escaped preflight guard: status=%d calls=%d", res.Code, len(models))
+		}
+		requireNoReceipt(t, session)
+	})
+}
