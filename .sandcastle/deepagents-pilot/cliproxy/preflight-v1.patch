+//go:build preflight_test_roots
+
+package auth
+
+import (
+	"net/http"
+	"sync"
+)
+
+var (
+	preflightTestTransportsMu sync.RWMutex
+	preflightTestTransports   = make(map[*http.Transport]int)
+)
+
+// RegisterPreflightTestTransportForTest registers an offline test *http.Transport
+// exclusively in test builds compiled with `-tags preflight_test_roots`.
+// Production builds omit this file entirely.
+func RegisterPreflightTestTransportForTest(tr *http.Transport) func() {
+	if tr == nil {
+		return func() {}
+	}
+	preflightTestTransportsMu.Lock()
+	preflightTestTransports[tr]++
+	preflightTestTransportsMu.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			preflightTestTransportsMu.Lock()
+			if preflightTestTransports[tr] <= 1 {
+				delete(preflightTestTransports, tr)
+			} else {
+				preflightTestTransports[tr]--
+			}
+			preflightTestTransportsMu.Unlock()
+		})
+	}
+}
+
+func isAllowedTestTransport(rt any) bool {
+	tr, ok := rt.(*http.Transport)
+	if !ok || tr == nil {
+		return false
+	}
+	preflightTestTransportsMu.RLock()
+	allowed := preflightTestTransports[tr] > 0
+	preflightTestTransportsMu.RUnlock()
+	if !allowed {
+		return false
+	}
+	if tr.DialTLS != nil || tr.DialTLSContext != nil {
+		return false
+	}
+	if cfg := tr.TLSClientConfig; cfg != nil {
+		if cfg.InsecureSkipVerify || cfg.ServerName != "" || cfg.VerifyPeerCertificate != nil || cfg.VerifyConnection != nil {
+			return false
+		}
+	}
+	return true
+}
