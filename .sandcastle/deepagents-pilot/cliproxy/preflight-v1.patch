+func TestReviewReceiptStrictJSONMetadataCaseAllowedWhileProtocolAliasesRejected(t *testing.T) {
+	// Astra P2 #2 (PR #2280 R1): arbitrary nested user objects (metadata, tool arguments) may
+	// legitimately contain capitalized keys like "ID"/"Model"/"Text" without tainting the review,
+	// whereas protocol evidence objects (event, response, item/output[], content[]) MUST still
+	// reject case-variant schema aliases and case-insensitive duplicates.
+	root := filepath.Join(t.TempDir(), "receipts")
+
+	runSSE := func(t *testing.T, launch, session, sse string) SealStatus {
+		t.Helper()
+		ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, lease, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		cl := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+			return &http.Response{
+				StatusCode: 200,
+				Header:     make(http.Header),
+				Body:       io.NopCloser(strings.NewReader(sse)),
+				TLS:        verifiedTLSState("chatgpt.com"),
+			}, nil
+		})})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		resp, err := cl.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		raw, _ := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		c.ObserveStreamChunk(raw)
+		lease.End()
+		c.Complete(true)
+		c.HandlerDone(true)
+		return SealReview(root, launch, session)
+	}
+
+	// 1. Capitalized keys inside response.metadata and output[].arguments MUST be allowed.
+	validWithMetadata := "data: " + `{"type":"response.completed","response":{"id":"resp_meta_ok","status":"completed","model":"gpt-6.2-sol","metadata":{"ID":"user-1","Model":"custom","Text":"note","a":1,"A":2},"output":[{"type":"function_call","arguments":{"ID":"arg-1","Model":"m","Status":"s"}},{"type":"message","role":"assistant","content":[{"type":"output_text","text":"pass","annotations":[{"Text":"cite","ID":"c1"}]}]}]}}` + "\n\n"
+	if st := runSSE(t, "review-b6666666-2222-4333-8444-555555555501", "019d0000-0000-7000-8000-666666666601", validWithMetadata); st != SealOK {
+		t.Fatalf("valid SSE with capitalized metadata/arguments keys = %v, want SealOK", st)
+	}
+
+	// 2. Mixed-case protocol aliases at event / response / output-item / content-part MUST still taint & reject.
+	for i, badSSE := range []string{
+		"data: " + `{"type":"response.completed","Response":{"id":"resp_bad1","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+		"data: " + `{"type":"response.completed","response":{"id":"resp_bad2","status":"completed","Model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+		"data: " + `{"type":"response.completed","response":{"ID":"resp_bad3","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+		"data: " + `{"type":"response.completed","response":{"id":"resp_bad4","status":"completed","model":"gpt-6.2-sol","output":[{"Type":"message","role":"assistant","content":[]}]}}` + "\n\n",
+		"data: " + `{"type":"response.completed","response":{"id":"resp_bad5","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","Text":"spoof"}]}]}}` + "\n\n",
+	} {
+		launch := fmt.Sprintf("review-b6666666-2222-4333-8444-55555555551%d", i)
+		session := fmt.Sprintf("019d0000-0000-7000-8000-66666666661%d", i)
+		if st := runSSE(t, launch, session, badSSE); st != SealRejected {
+			t.Fatalf("case %d: protocol case-alias SSE = %v, want SealRejected", i, st)
+		}
+	}
+}
