diff --git a/sdk/preflightreceipt/receipt.go b/sdk/preflightreceipt/receipt.go
index e69de29..fb66a80 100644
--- a/sdk/preflightreceipt/receipt.go
+++ b/sdk/preflightreceipt/receipt.go
@@ -0,0 +1,1979 @@
+// Package preflightreceipt produces bounded, body-independent admission evidence.
+// It is enabled only for explicit preflight sessions and formal review launches, never for ordinary traffic.
+package preflightreceipt
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+)
+
+const Schema = "cliproxy-preflight-v1"
+const ReviewSchema = "cliproxy-review-v1"
+const ReviewHeader = "X-NewChanlun-Review-Launch"
+const MaxAttempts = 64
+const Lifetime = 50 * time.Second
+const ReviewTurnLifetime = 30 * time.Minute
+const maxOutboundModelBody = 32 << 20
+const maxReviewResponseIDs = 512
+const maxReviewReceiptBytes = 65536
+
+var maxReviewLedgerEntries = 2048
+
+var ErrUnavailable = errors.New("preflight evidence unavailable")
+var errReviewSealed = errors.New("review receipt sealed or sealing")
+var sessionPattern = regexp.MustCompile(`^preflight-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+var reviewLaunchPattern = regexp.MustCompile(`^review-(?:preflight-)?[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+var reviewSessionPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+
+func ValidReviewLaunch(launch string) bool {
+	return reviewLaunchPattern.MatchString(launch)
+}
+
+type contextKey struct{}
+
+type Receipt struct {
+	Schema   string   `json:"schema"`
+	Session  string   `json:"session"`
+	Started  int64    `json:"started_ns"`
+	Finished int64    `json:"finished_ns"`
+	Complete bool     `json:"complete"`
+	Routes   []string `json:"routes"`
+}
+
+type ReviewReceipt struct {
+	Schema           string   `json:"schema"`
+	Launch           string   `json:"launch"`
+	Session          string   `json:"session"`
+	Started          int64    `json:"started_ns"`
+	Finished         int64    `json:"finished_ns"`
+	SealedAt         int64    `json:"sealed_at_ns"`
+	Complete         bool     `json:"complete"`
+	Sealed           bool     `json:"sealed"`
+	Tainted          bool     `json:"tainted"`
+	Requests         int      `json:"requests"`
+	Routes           []string `json:"routes"`
+	ResponseIDSHAs   []string `json:"response_id_sha256s"`
+	LastResponseID   string   `json:"last_response_id_sha256"`
+	LastOutputSHA256 string   `json:"last_output_sha256"`
+}
+
+type SealStatus int
+
+const (
+	SealOK SealStatus = iota
+	SealInFlight
+	SealRejected
+	SealUnavailable
+)
+
+type reviewEntry struct {
+	mu                sync.Mutex
+	directory         string
+	launch            string
+	session           string
+	route             string
+	started           int64
+	finished          int64
+	sealedAt          int64
+	requests          int
+	responseIDSHAs    []string
+	lastResponseIDSHA string
+	lastOutputSHA     string
+	sealed            bool
+	sealSynced        bool
+	tainted           bool
+	taintedPersisted  bool
+	reserved          bool
+	markerPersisted   bool
+	touched           time.Time
+	inFlight          int
+	sealing           bool
+	sealedFlag        bool
+}
+
+type ReviewReservation struct {
+	entry *reviewEntry
+	once  sync.Once
+}
+
+func (r *ReviewReservation) Release() {
+	if r == nil {
+		return
+	}
+	r.once.Do(func() {
+		releaseReview(r.entry)
+	})
+}
+
+func (r *ReviewReservation) Taint() {
+	if r == nil || r.entry == nil {
+		return
+	}
+	r.entry.mu.Lock()
+	r.entry.taintAndPersistLocked()
+	r.entry.mu.Unlock()
+}
+
+func (r *ReviewReservation) transfer() (*reviewEntry, bool) {
+	if r == nil || r.entry == nil {
+		return nil, false
+	}
+	transferred := false
+	r.once.Do(func() {
+		transferred = true
+	})
+	if !transferred {
+		return nil, false
+	}
+	return r.entry, true
+}
+
+var (
+	reviewMu           sync.Mutex
+	reviewLedger       = make(map[string]*reviewEntry)
+	taintWriteOverflow bool
+	tmpSeq             atomic.Uint64
+)
+
+type Collector struct {
+	mu                                          sync.Mutex
+	receipt                                     Receipt
+	directory                                   string
+	deadline                                    time.Time
+	invalid, sealed, handlerDone, lifecycleDone bool
+	reserved                                    bool
+	strictCodex                                 bool
+	expectedModel                               string
+	review                                      *reviewEntry
+	reviewReleased                              bool
+	observedCompleted                           bool
+	upstreamEOF                                 bool
+	modelMismatch                               bool
+	lastResponseIDSHA                           string
+	lastOutputSHA                               string
+	streamResponseID                            string
+	lastItemResponseID                          string
+	lastItemOutputSHA                           string
+	executions, active, bodies, attempts        int
+}
+
+type Execution struct {
+	c        *Collector
+	provider string
+	model    string
+	ended    bool
+	attempts int
+}
+
+func From(ctx context.Context) *Collector {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(contextKey{}).(*Collector)
+	return c
+}
+
+func Inherit(ctx, source context.Context) context.Context {
+	if c := From(source); c != nil {
+		return context.WithValue(ctx, contextKey{}, c)
+	}
+	return ctx
+}
+
+func (c *Collector) StrictCodex() bool {
+	return c != nil && c.strictCodex
+}
+
+func (c *Collector) MarkUpstreamEOF() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	c.upstreamEOF = true
+	c.mu.Unlock()
+}
+
+func (c *Collector) UpstreamEOF() bool {
+	if c == nil {
+		return false
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.upstreamEOF
+}
+
+func (c *Collector) ObservedCompleted() bool {
+	if c == nil {
+		return false
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.observedCompleted
+}
+
+// Begin binds the inbound nonce. Disk reservation waits for authenticated execution.
+// The directory must be private to the proxy, outside the credential/state volume.
+func Begin(ctx context.Context, root, session string) (context.Context, *Collector, error) {
+	if !sessionPattern.MatchString(session) || !filepath.IsAbs(root) {
+		return ctx, nil, ErrUnavailable
+	}
+	directory := filepath.Join(root, session)
+	now := time.Now()
+	c := &Collector{directory: directory, deadline: now.Add(Lifetime), receipt: Receipt{Schema: Schema, Session: session, Started: now.UnixNano()}}
+	return context.WithValue(ctx, contextKey{}, c), c, nil
+}
+
+func sha256Hex(s string) string {
+	sum := sha256.Sum256([]byte(s))
+	return hex.EncodeToString(sum[:])
+}
+
+func isSHA256Hex(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
+			return false
+		}
+	}
+	return true
+}
+
+func isOptionalSHA256Hex(s string) bool {
+	return s == "" || isSHA256Hex(s)
+}
+
+type responseOutputContentPart struct {
+	Type string `json:"type"`
+	Text string `json:"text"`
+}
+
+type responseOutputItem struct {
+	Type    string                      `json:"type"`
+	Role    string                      `json:"role"`
+	Content []responseOutputContentPart `json:"content"`
+}
+
+func extractAssistantOutputText(items []responseOutputItem) string {
+	last := ""
+	for _, item := range items {
+		if item.Type != "message" || item.Role != "assistant" {
+			continue
+		}
+		var b strings.Builder
+		for _, part := range item.Content {
+			if part.Type == "" || part.Type == "output_text" {
+				b.WriteString(part.Text)
+			}
+		}
+		if b.Len() > 0 {
+			last = b.String()
+		}
+	}
+	return last
+}
+
+func hasResponseError(raw json.RawMessage) bool {
+	trimmed := bytes.TrimSpace(raw)
+	return len(trimmed) > 0 && !bytes.Equal(trimmed, []byte("null"))
+}
+
+func (c *Collector) recordCompletedResponse(respID, respModel, respStatus string, respErr json.RawMessage, output []responseOutputItem) {
+	status := respStatus
+	id := respID
+	model := respModel
+	outText := extractAssistantOutputText(output)
+
+	c.mu.Lock()
+	if status != "completed" || hasResponseError(respErr) || c.observedCompleted {
+		c.modelMismatch = true
+		c.invalid = true
+		c.lastItemOutputSHA = ""
+		c.lastItemResponseID = ""
+		c.mu.Unlock()
+		c.Taint()
+		return
+	}
+	expected := c.expectedModel
+	if expected == "" || model != expected || id == "" || strings.TrimSpace(id) != id || (c.streamResponseID != "" && c.streamResponseID != id) {
+		c.modelMismatch = true
+		c.invalid = true
+		c.lastItemOutputSHA = ""
+		c.lastItemResponseID = ""
+		c.mu.Unlock()
+		c.Taint()
+		return
+	}
+	c.observedCompleted = true
+	c.lastResponseIDSHA = sha256Hex(id)
+	if outText != "" {
+		c.lastOutputSHA = sha256Hex(outText)
+	} else if c.lastItemOutputSHA != "" && c.lastItemResponseID != "" && c.lastItemResponseID == id {
+		c.lastOutputSHA = c.lastItemOutputSHA
+	} else {
+		c.lastOutputSHA = ""
+	}
+	c.lastItemOutputSHA = ""
+	c.lastItemResponseID = ""
+	c.mu.Unlock()
+}
+
+func (c *Collector) taintStreamAnomaly() {
+	c.mu.Lock()
+	c.modelMismatch = true
+	c.invalid = true
+	c.lastItemOutputSHA = ""
+	c.lastItemResponseID = ""
+	c.mu.Unlock()
+	c.Taint()
+}
+
+var errStrictJSONFormat = errors.New("invalid strict JSON SSE frame")
+
+func isSchemaFieldKey(lower string) bool {
+	switch lower {
+	case "type", "response_id", "error", "item", "response", "id", "model", "status", "output", "role", "content", "text":
+		return true
+	default:
+		return false
+	}
+}
+
+func validateStrictJSONValue(dec *json.Decoder, depth int) error {
+	if depth > 128 {
+		return errStrictJSONFormat
+	}
+	tok, err := dec.Token()
+	if err != nil {
+		return err
+	}
+	return validateStrictJSONToken(dec, tok, depth)
+}
+
+func validateStrictJSONToken(dec *json.Decoder, tok json.Token, depth int) error {
+	delim, ok := tok.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := make(map[string]struct{})
+		for dec.More() {
+			keyTok, err := dec.Token()
+			if err != nil {
+				return err
+			}
+			key, ok := keyTok.(string)
+			if !ok {
+				return errStrictJSONFormat
+			}
+			lower := strings.ToLower(key)
+			if _, dup := seen[lower]; dup {
+				return errStrictJSONFormat
+			}
+			if key != lower && isSchemaFieldKey(lower) {
+				return errStrictJSONFormat
+			}
+			seen[lower] = struct{}{}
+			if err := validateStrictJSONValue(dec, depth+1); err != nil {
+				return err
+			}
+		}
+		endTok, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		if endDelim, ok := endTok.(json.Delim); !ok || endDelim != '}' {
+			return errStrictJSONFormat
+		}
+		return nil
+	case '[':
+		for dec.More() {
+			if err := validateStrictJSONValue(dec, depth+1); err != nil {
+				return err
+			}
+		}
+		endTok, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		if endDelim, ok := endTok.(json.Delim); !ok || endDelim != ']' {
+			return errStrictJSONFormat
+		}
+		return nil
+	default:
+		return errStrictJSONFormat
+	}
+}
+
+func validateStrictJSONObject(raw []byte) error {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return err
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok || delim != '{' {
+		return errStrictJSONFormat
+	}
+	if err := validateStrictJSONToken(dec, tok, 0); err != nil {
+		return err
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return errStrictJSONFormat
+	}
+	return nil
+}
+
+func decodeExactJSONObject(raw []byte) (map[string]json.RawMessage, error) {
+	if err := validateStrictJSONObject(raw); err != nil {
+		return nil, err
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &fields); err != nil {
+		return nil, err
+	}
+	return fields, nil
+}
+
+func exactOptionalStringPresent(fields map[string]json.RawMessage, key string) (string, bool, bool) {
+	raw, exists := fields[key]
+	if !exists {
+		return "", false, true
+	}
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
+		return "", true, false
+	}
+	var s string
+	if err := json.Unmarshal(trimmed, &s); err != nil {
+		return "", true, false
+	}
+	return s, true, true
+}
+
+func exactOptionalString(fields map[string]json.RawMessage, key string) (string, bool) {
+	raw, exists := fields[key]
+	if !exists {
+		return "", true
+	}
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
+		return "", true
+	}
+	var s string
+	if err := json.Unmarshal(trimmed, &s); err != nil {
+		return "", false
+	}
+	return s, true
+}
+
+func decodeExactAssistantContentParts(raw json.RawMessage) ([]responseOutputContentPart, bool) {
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
+		return nil, true
+	}
+	var rawParts []json.RawMessage
+	if err := json.Unmarshal(trimmed, &rawParts); err != nil {
+		return nil, false
+	}
+	parts := make([]responseOutputContentPart, 0, len(rawParts))
+	for _, rp := range rawParts {
+		fields, err := decodeExactJSONObject(rp)
+		if err != nil {
+			return nil, false
+		}
+		typ, ok1 := exactOptionalString(fields, "type")
+		txt, ok2 := exactOptionalString(fields, "text")
+		if !ok1 || !ok2 {
+			return nil, false
+		}
+		parts = append(parts, responseOutputContentPart{Type: typ, Text: txt})
+	}
+	return parts, true
+}
+
+func decodeExactResponseOutputItems(raw json.RawMessage) ([]responseOutputItem, bool) {
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
+		return nil, true
+	}
+	var rawItems []json.RawMessage
+	if err := json.Unmarshal(trimmed, &rawItems); err != nil {
+		return nil, false
+	}
+	items := make([]responseOutputItem, 0, len(rawItems))
+	for _, ri := range rawItems {
+		fields, err := decodeExactJSONObject(ri)
+		if err != nil {
+			return nil, false
+		}
+		typ, ok1 := exactOptionalString(fields, "type")
+		role, ok2 := exactOptionalString(fields, "role")
+		if !ok1 || !ok2 {
+			return nil, false
+		}
+		item := responseOutputItem{Type: typ, Role: role}
+		if typ == "message" && role == "assistant" {
+			parts, ok := decodeExactAssistantContentParts(fields["content"])
+			if !ok {
+				return nil, false
+			}
+			item.Content = parts
+		}
+		items = append(items, item)
+	}
+	return items, true
+}
+
+// ObserveStreamChunk records SHA-256 hashes of the upstream response ID and final assistant output text
+// and verifies the upstream response.model matches the bound review model without persisting any free text.
+func (c *Collector) ObserveStreamChunk(payload []byte) {
+	if c == nil || !c.strictCodex || len(payload) == 0 {
+		return
+	}
+	for _, rawLine := range bytes.Split(payload, []byte{'\n'}) {
+		line := bytes.TrimSpace(rawLine)
+		if len(line) == 0 || line[0] == ':' {
+			continue
+		}
+		if bytes.HasPrefix(line, []byte("event:")) || bytes.HasPrefix(line, []byte("id:")) || bytes.HasPrefix(line, []byte("retry:")) {
+			continue
+		}
+		isDataLine := false
+		if bytes.HasPrefix(line, []byte("data:")) {
+			isDataLine = true
+			line = bytes.TrimSpace(line[5:])
+		}
+		if len(line) == 0 || bytes.Equal(line, []byte("[DONE]")) {
+			continue
+		}
+		if !isDataLine && line[0] != '{' {
+			continue
+		}
+		// Reject non-object JSON (e.g. data: null / []), trailing tokens, case-insensitive duplicate keys,
+		// and mixed-case schema field aliases at any depth, and decode solely by exact lowercase map keys
+		// so Go encoding/json's case-insensitive struct matching can never overwrite error/status/model.
+		evFields, err := decodeExactJSONObject(line)
+		if err != nil {
+			c.taintStreamAnomaly()
+			continue
+		}
+		evType, okType := exactOptionalString(evFields, "type")
+		evRespID, hasEvRespID, okRespID := exactOptionalStringPresent(evFields, "response_id")
+		evModel, hasEvModel, okEvModel := exactOptionalStringPresent(evFields, "model")
+		if !okType || !okRespID || !okEvModel || strings.TrimSpace(evType) == "" {
+			c.taintStreamAnomaly()
+			continue
+		}
+		if hasEvRespID && (evRespID == "" || strings.TrimSpace(evRespID) != evRespID) {
+			c.taintStreamAnomaly()
+			continue
+		}
+		if hasEvModel && evModel == "" {
+			c.taintStreamAnomaly()
+			continue
+		}
+		if hasResponseError(evFields["error"]) {
+			c.taintStreamAnomaly()
+			continue
+		}
+		var respID, respModel, respStatus string
+		var hasRespID, hasRespModel bool
+		var respErr, respOutput json.RawMessage
+		if hasResponseError(evFields["response"]) {
+			respFields, err := decodeExactJSONObject(evFields["response"])
+			if err != nil {
+				c.taintStreamAnomaly()
+				continue
+			}
+			var ok1, ok2, ok3 bool
+			respID, hasRespID, ok1 = exactOptionalStringPresent(respFields, "id")
+			respModel, hasRespModel, ok2 = exactOptionalStringPresent(respFields, "model")
+			respStatus, ok3 = exactOptionalString(respFields, "status")
+			if !ok1 || !ok2 || !ok3 {
+				c.taintStreamAnomaly()
+				continue
+			}
+			if hasRespID && (respID == "" || strings.TrimSpace(respID) != respID) {
+				c.taintStreamAnomaly()
+				continue
+			}
+			if hasRespModel && respModel == "" {
+				c.taintStreamAnomaly()
+				continue
+			}
+			respErr = respFields["error"]
+			respOutput = respFields["output"]
+			if hasResponseError(respErr) {
+				c.taintStreamAnomaly()
+				continue
+			}
+		}
+		if hasEvModel && hasRespModel && evModel != respModel {
+			c.taintStreamAnomaly()
+			continue
+		}
+		explicitModel := ""
+		if hasRespModel {
+			explicitModel = respModel
+		} else if hasEvModel {
+			explicitModel = evModel
+		}
+		if explicitModel != "" {
+			c.mu.Lock()
+			mismatch := c.expectedModel == "" || explicitModel != c.expectedModel
+			c.mu.Unlock()
+			if mismatch {
+				c.taintStreamAnomaly()
+				continue
+			}
+		}
+		if hasEvRespID && hasRespID && evRespID != respID {
+			c.taintStreamAnomaly()
+			continue
+		}
+		var itemFields map[string]json.RawMessage
+		var itemRespID string
+		var hasItemRespID bool
+		if hasResponseError(evFields["item"]) {
+			var itemErr error
+			itemFields, itemErr = decodeExactJSONObject(evFields["item"])
+			if itemErr != nil {
+				c.taintStreamAnomaly()
+				continue
+			}
+			var okItemRespID bool
+			itemRespID, hasItemRespID, okItemRespID = exactOptionalStringPresent(itemFields, "response_id")
+			if !okItemRespID || (hasItemRespID && (itemRespID == "" || strings.TrimSpace(itemRespID) != itemRespID)) {
+				c.taintStreamAnomaly()
+				continue
+			}
+		}
+		explicitRespID := ""
+		if hasEvRespID {
+			explicitRespID = evRespID
+		} else if hasRespID {
+			explicitRespID = respID
+		}
+		if hasItemRespID {
+			if explicitRespID != "" && explicitRespID != itemRespID {
+				c.taintStreamAnomaly()
+				continue
+			}
+			explicitRespID = itemRespID
+		}
+		if explicitRespID != "" {
+			conflict := false
+			c.mu.Lock()
+			if c.streamResponseID != "" && c.streamResponseID != explicitRespID {
+				conflict = true
+			} else {
+				c.streamResponseID = explicitRespID
+			}
+			c.mu.Unlock()
+			if conflict {
+				c.taintStreamAnomaly()
+				continue
+			}
+		}
+		switch evType {
+		case "response.created", "response.in_progress":
+			// streamResponseID is already validated and locked above for every frame carrying a response ID.
+		case "response.output_item.done":
+			if itemFields != nil {
+				itemType, ok1 := exactOptionalString(itemFields, "type")
+				itemRole, ok2 := exactOptionalString(itemFields, "role")
+				if !ok1 || !ok2 {
+					c.taintStreamAnomaly()
+					continue
+				}
+				if itemType == "message" && itemRole == "assistant" {
+					parts, ok := decodeExactAssistantContentParts(itemFields["content"])
+					if !ok {
+						c.taintStreamAnomaly()
+						continue
+					}
+					var b strings.Builder
+					for _, part := range parts {
+						if part.Type == "" || part.Type == "output_text" {
+							b.WriteString(part.Text)
+						}
+					}
+					if b.Len() > 0 {
+						h := sha256Hex(b.String())
+						c.mu.Lock()
+						rid := c.streamResponseID
+						if rid != "" {
+							c.lastItemOutputSHA = h
+							c.lastItemResponseID = rid
+						}
+						c.mu.Unlock()
+					}
+				}
+			}
+		case "response.completed":
+			output, ok := decodeExactResponseOutputItems(respOutput)
+			if !ok {
+				c.taintStreamAnomaly()
+				continue
+			}
+			c.recordCompletedResponse(respID, respModel, respStatus, respErr, output)
+		case "response.done":
+			c.taintStreamAnomaly()
+		case "response.failed", "response.incomplete", "error":
+			c.mu.Lock()
+			c.invalid = true
+			c.lastItemOutputSHA = ""
+			c.lastItemResponseID = ""
+			alreadyCompleted := c.observedCompleted
+			c.mu.Unlock()
+			if alreadyCompleted {
+				c.Taint()
+			}
+		}
+	}
+}
+
+func loadReviewEntryFromDisk(dir, launch, session string, now time.Time) (*reviewEntry, bool, error) {
+	info, err := os.Lstat(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, false, nil
+		}
+		return nil, true, ErrUnavailable
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 {
+		return nil, true, ErrUnavailable
+	}
+	path := filepath.Join(dir, "receipt.json")
+	finfo, err := os.Lstat(path)
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode()&os.ModeSymlink != 0 || finfo.Size() <= 0 || finfo.Size() > maxReviewReceiptBytes {
+		return &reviewEntry{
+			directory: dir,
+			launch:    launch,
+			session:   session,
+			started:   now.UnixNano(),
+			tainted:   true,
+			reserved:  true,
+			touched:   now,
+		}, true, nil
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, true, ErrUnavailable
+	}
+	var disk ReviewReceipt
+	validResponseIDs := func(ids []string, count int, last string) bool {
+		if count < 1 || count > maxReviewResponseIDs || len(ids) != count || ids[len(ids)-1] != last {
+			return false
+		}
+		for _, id := range ids {
+			if !isSHA256Hex(id) {
+				return false
+			}
+		}
+		return true
+	}
+	if err := json.Unmarshal(raw, &disk); err != nil ||
+		disk.Schema != ReviewSchema ||
+		disk.Launch != launch ||
+		disk.Tainted ||
+		!disk.Complete ||
+		!disk.Sealed ||
+		disk.Requests < 1 ||
+		!reviewSessionPattern.MatchString(disk.Session) ||
+		!isSHA256Hex(disk.LastResponseID) ||
+		!validResponseIDs(disk.ResponseIDSHAs, disk.Requests, disk.LastResponseID) ||
+		!isOptionalSHA256Hex(disk.LastOutputSHA256) ||
+		len(disk.Routes) != 1 ||
+		(disk.Routes[0] != "codex:gpt-6.2-sol@chatgpt.com" && disk.Routes[0] != "codex:gpt-6.2-astra@chatgpt.com") {
+		return &reviewEntry{
+			directory:        dir,
+			launch:           launch,
+			session:          disk.Session,
+			started:          now.UnixNano(),
+			tainted:          true,
+			taintedPersisted: disk.Tainted,
+			reserved:         true,
+			markerPersisted:  true,
+			touched:          now,
+		}, true, nil
+	}
+	return &reviewEntry{
+		directory:         dir,
+		launch:            launch,
+		session:           disk.Session,
+		route:             disk.Routes[0],
+		started:           disk.Started,
+		finished:          disk.Finished,
+		sealedAt:          disk.SealedAt,
+		requests:          disk.Requests,
+		responseIDSHAs:    append([]string(nil), disk.ResponseIDSHAs...),
+		lastResponseIDSHA: disk.LastResponseID,
+		lastOutputSHA:     disk.LastOutputSHA256,
+		sealed:            true,
+		sealedFlag:        true,
+		tainted:           false,
+		reserved:          true,
+		markerPersisted:   true,
+		touched:           now,
+	}, true, nil
+}
+
+func getOrCreateReviewEntry(root, launch, session string, now time.Time, acquire, rejectSealed bool) (*reviewEntry, error) {
+	key := root + "\x00" + launch
+	reviewMu.Lock()
+	defer reviewMu.Unlock()
+	if entry := reviewLedger[key]; entry != nil {
+		if rejectSealed && (entry.sealedFlag || entry.sealing) {
+			return nil, errReviewSealed
+		}
+		entry.touched = now
+		if acquire {
+			entry.inFlight++
+		}
+		return entry, nil
+	}
+	if taintWriteOverflow {
+		return nil, ErrUnavailable
+	}
+	dir := filepath.Join(root, launch)
+	diskEntry, onDisk, err := loadReviewEntryFromDisk(dir, launch, session, now)
+	if err != nil {
+		return nil, err
+	}
+	if rejectSealed && onDisk && diskEntry != nil && diskEntry.sealedFlag {
+		return nil, errReviewSealed
+	}
+	if len(reviewLedger) >= maxReviewLedgerEntries {
+		var oldestKey string
+		var oldestTime time.Time
+		for k, v := range reviewLedger {
+			if v.inFlight > 0 || v.sealing {
+				continue
+			}
+			v.mu.Lock()
+			evictable := !(v.tainted && !v.taintedPersisted) && (v.sealed || v.tainted || now.Sub(v.touched) > ReviewTurnLifetime)
+			v.mu.Unlock()
+			if !evictable {
+				continue
+			}
+			if oldestKey == "" || v.touched.Before(oldestTime) {
+				oldestKey, oldestTime = k, v.touched
+			}
+		}
+		if oldestKey != "" {
+			delete(reviewLedger, oldestKey)
+		} else {
+			return nil, ErrUnavailable
+		}
+	}
+	entry := diskEntry
+	if !onDisk {
+		entry = &reviewEntry{
+			directory: dir,
+			launch:    launch,
+			session:   session,
+			started:   now.UnixNano(),
+			touched:   now,
+		}
+	}
+	if acquire {
+		entry.inFlight = 1
+	}
+	reviewLedger[key] = entry
+	return entry, nil
+}
+
+// ReserveReview atomically checks that the launch is neither sealed nor sealing, persists the
+// initial unsealed reservation marker on disk before admitting the first request, and registers
+// an in-flight request before reading or parsing the HTTP request body.
+func ReserveReview(root, launch string) (*ReviewReservation, error) {
+	if !reviewLaunchPattern.MatchString(launch) || !filepath.IsAbs(root) {
+		return nil, ErrUnavailable
+	}
+	key := root + "\x00" + launch
+	entry, err := getOrCreateReviewEntry(root, launch, "", time.Now(), true, true)
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	entry.mu.Lock()
+	if entry.sealed {
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	if entry.tainted {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return nil, ErrUnavailable
+	}
+	if !entry.markerPersisted {
+		if persistErr := entry.persistLocked(); persistErr != nil {
+			canEvict := !entry.markerPersisted && !entry.tainted && entry.requests == 0
+			entry.mu.Unlock()
+			reviewMu.Lock()
+			if entry.inFlight > 0 {
+				entry.inFlight--
+			}
+			if canEvict && entry.inFlight == 0 && reviewLedger[key] == entry {
+				delete(reviewLedger, key)
+			}
+			reviewMu.Unlock()
+			return nil, ErrUnavailable
+		}
+	}
+	entry.mu.Unlock()
+	return &ReviewReservation{entry: entry}, nil
+}
+
+func acquireReview(entry *reviewEntry) {
+	if entry == nil {
+		return
+	}
+	reviewMu.Lock()
+	entry.inFlight++
+	reviewMu.Unlock()
+}
+
+func releaseReview(entry *reviewEntry) {
+	if entry == nil {
+		return
+	}
+	reviewMu.Lock()
+	if entry.inFlight > 0 {
+		entry.inFlight--
+	}
+	reviewMu.Unlock()
+}
+
+func (e *reviewEntry) taintAndPersistLocked() {
+	if e.sealed {
+		return
+	}
+	e.tainted = true
+	if err := e.persistLocked(); err == nil {
+		e.taintedPersisted = true
+	} else {
+		e.taintedPersisted = false
+	}
+}
+
+// ExtractInboundReviewModel reads, decodes (identity/zstd/gzip), and restores req.Body
+// before routing/normalization so the launch is bound to the exact client-requested model.
+func ExtractInboundReviewModel(req *http.Request) (string, bool) {
+	if req == nil || req.Method != http.MethodPost || req.Body == nil {
+		return "", false
+	}
+	orig := req.Body
+	raw, err := io.ReadAll(io.LimitReader(orig, maxOutboundModelBody+1))
+	if err != nil {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return "", false
+	}
+	if len(raw) > maxOutboundModelBody {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return "", false
+	}
+	_ = orig.Close()
+	req.Body = io.NopCloser(bytes.NewReader(raw))
+	decoded, ok := decodeCodexWireBody(raw, req.Header.Get("Content-Encoding"))
+	if !ok {
+		return "", false
+	}
+	model, streamTrue := parseTopLevelJSONReviewRequest(decoded)
+	if model == "" || !streamTrue {
+		return "", false
+	}
+	return model, true
+}
+
+// TaintReview permanently marks an unsealed valid review launch receipt as tainted.
+// Already-sealed terminal receipts are immutable and unaffected.
+// The in-memory ledger stays strictly bounded at maxReviewLedgerEntries; if the ledger is full
+// and taint persistence also fails on disk, taintWriteOverflow latches fail-closed for new sessions and seals.
+// Callers must invoke this only after request authentication.
+func TaintReview(root, launch string) {
+	if !reviewLaunchPattern.MatchString(launch) || !filepath.IsAbs(root) {
+		return
+	}
+	now := time.Now()
+	entry, err := getOrCreateReviewEntry(root, launch, "", now, true, true)
+	if errors.Is(err, errReviewSealed) {
+		return
+	}
+	if err == nil && entry != nil {
+		defer releaseReview(entry)
+		entry.mu.Lock()
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		return
+	}
+	dir := filepath.Join(root, launch)
+	diskEntry, onDisk, loadErr := loadReviewEntryFromDisk(dir, launch, "", now)
+	if loadErr == nil && onDisk && diskEntry != nil && diskEntry.sealed && !diskEntry.tainted {
+		return
+	}
+	temp := &reviewEntry{
+		directory: dir,
+		launch:    launch,
+		started:   now.UnixNano(),
+		tainted:   true,
+	}
+	if persistErr := temp.persistLocked(); persistErr != nil {
+		reviewMu.Lock()
+		taintWriteOverflow = true
+		reviewMu.Unlock()
+	}
+}
+
+// SealReview seals a formal review launch once all in-flight requests have completed.
+// Checking inFlight == 0 and entering the sealing barrier happen atomically under reviewMu
+// so no concurrent request can be admitted after SealReview checks quiescence.
+func SealReview(root, launch, session string) SealStatus {
+	if !reviewLaunchPattern.MatchString(launch) || !reviewSessionPattern.MatchString(session) || !filepath.IsAbs(root) {
+		return SealRejected
+	}
+	key := root + "\x00" + launch
+	now := time.Now()
+	reviewMu.Lock()
+	overflowed := taintWriteOverflow
+	entry := reviewLedger[key]
+	if entry != nil {
+		if entry.sealedFlag {
+			reviewMu.Unlock()
+			entry.mu.Lock()
+			defer entry.mu.Unlock()
+			if !entry.sealed || entry.tainted || entry.session != session {
+				return SealRejected
+			}
+			if !entry.sealSynced {
+				if syncDirFn(entry.directory) != nil || syncDirFn(root) != nil {
+					return SealUnavailable
+				}
+				entry.sealSynced = true
+			}
+			return SealOK
+		}
+		if entry.sealing || entry.inFlight > 0 {
+			reviewMu.Unlock()
+			return SealInFlight
+		}
+		entry.sealing = true
+		entry.touched = now
+		reviewMu.Unlock()
+
+		finishSeal := func(markSealed bool) {
+			reviewMu.Lock()
+			entry.sealing = false
+			if markSealed {
+				entry.sealedFlag = true
+			}
+			reviewMu.Unlock()
+		}
+
+		entry.mu.Lock()
+		if entry.sealed {
+			ok := !entry.tainted && entry.session == session
+			if !ok {
+				entry.mu.Unlock()
+				finishSeal(true)
+				return SealRejected
+			}
+			if !entry.sealSynced {
+				if syncDirFn(entry.directory) != nil || syncDirFn(root) != nil {
+					entry.mu.Unlock()
+					finishSeal(true)
+					return SealUnavailable
+				}
+				entry.sealSynced = true
+			}
+			entry.mu.Unlock()
+			finishSeal(true)
+			return SealOK
+		}
+		if overflowed {
+			entry.mu.Unlock()
+			finishSeal(false)
+			return SealUnavailable
+		}
+		if entry.tainted || entry.requests < 1 || entry.route == "" || !isSHA256Hex(entry.lastResponseIDSHA) ||
+			len(entry.responseIDSHAs) != entry.requests || entry.responseIDSHAs[len(entry.responseIDSHAs)-1] != entry.lastResponseIDSHA {
+			entry.mu.Unlock()
+			finishSeal(false)
+			return SealRejected
+		}
+		if entry.session != session {
+			entry.taintAndPersistLocked()
+			entry.mu.Unlock()
+			finishSeal(false)
+			return SealRejected
+		}
+		// Single-phase atomic rename + mandatory dir-sync confirmation:
+		// - If write/sync/rename fails BEFORE receipt.json is replaced, disk still holds sealed=false;
+		//   taint & permanently close so repeat and post-restart SealReview return SealRejected.
+		// - Once Rename replaces receipt.json with the verified, clean, quiescent sealed=true payload,
+		//   the launch is permanently sealed against new turns/taints; SealOK is returned ONLY after
+		//   both launch and root directory fsyncs succeed (retries & post-restart recovery re-verify
+		//   dir fsync idempotently, eliminating split-brain between RAM and read-only disk).
+		entry.sealed = true
+		entry.sealedAt = now.UnixNano()
+		if entry.sealedAt < entry.finished {
+			entry.sealedAt = entry.finished
+		}
+		renamed, err := entry.persistWithStatusLocked()
+		if !renamed {
+			entry.sealed = false
+			entry.sealedAt = 0
+			entry.taintAndPersistLocked()
+			entry.mu.Unlock()
+			finishSeal(true)
+			return SealUnavailable
+		}
+		if err != nil || syncDirFn(root) != nil {
+			entry.sealSynced = false
+			entry.mu.Unlock()
+			finishSeal(true)
+			return SealUnavailable
+		}
+		entry.sealSynced = true
+		entry.mu.Unlock()
+		finishSeal(true)
+		return SealOK
+	}
+	reviewMu.Unlock()
+
+	dir := filepath.Join(root, launch)
+	diskEntry, onDisk, err := loadReviewEntryFromDisk(dir, launch, session, now)
+	if err != nil {
+		return SealUnavailable
+	}
+	if !onDisk || diskEntry == nil || !diskEntry.sealed || diskEntry.tainted || diskEntry.session != session {
+		return SealRejected
+	}
+	if syncDirFn(dir) != nil || syncDirFn(root) != nil {
+		return SealUnavailable
+	}
+	return SealOK
+}
+
+// BeginReviewReserved transfers an already-reserved in-flight review launch into a Collector
+// without ever dropping inFlight to zero between middleware admission and collector completion.
+func BeginReviewReserved(ctx context.Context, res *ReviewReservation, session, requestedModel string) (context.Context, *Collector, error) {
+	if res == nil || res.entry == nil {
+		return ctx, nil, ErrUnavailable
+	}
+	if !reviewSessionPattern.MatchString(session) || (requestedModel != "gpt-6.2-sol" && requestedModel != "gpt-6.2-astra") {
+		res.Taint()
+		res.Release()
+		return ctx, nil, ErrUnavailable
+	}
+	entry, ok := res.transfer()
+	if !ok {
+		return ctx, nil, ErrUnavailable
+	}
+	now := time.Now()
+	expectedRoute := "codex:" + requestedModel + "@chatgpt.com"
+	entry.mu.Lock()
+	if entry.sealed {
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return ctx, nil, ErrUnavailable
+	}
+	if entry.tainted {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return ctx, nil, ErrUnavailable
+	}
+	if entry.session == "" {
+		entry.session = session
+	} else if entry.session != session {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return ctx, nil, ErrUnavailable
+	}
+	if entry.route == "" {
+		entry.route = expectedRoute
+	} else if entry.route != expectedRoute {
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+		releaseReview(entry)
+		return ctx, nil, ErrUnavailable
+	}
+	entry.mu.Unlock()
+
+	c := &Collector{
+		directory:     entry.directory,
+		deadline:      now.Add(ReviewTurnLifetime),
+		strictCodex:   true,
+		expectedModel: requestedModel,
+		review:        entry,
+		receipt:       Receipt{Schema: ReviewSchema, Session: session, Started: now.UnixNano()},
+	}
+	return context.WithValue(ctx, contextKey{}, c), c, nil
+}
+
+// BeginReview binds a formal external-review launch, its Codex session, and its inbound requested model
+// BEFORE routing or model normalization. Every outbound request and upstream response for this launch
+// must match that exact requested model; any violation aborts before upstream and taints the launch.
+func BeginReview(ctx context.Context, root, launch, session, requestedModel string) (context.Context, *Collector, error) {
+	res, err := ReserveReview(root, launch)
+	if err != nil {
+		return ctx, nil, ErrUnavailable
+	}
+	return BeginReviewReserved(ctx, res, session, requestedModel)
+}
+
+func (c *Collector) Reject() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.invalid = true
+}
+
+// Taint permanently invalidates both this collector and, for formal review launches,
+// the launch-level session receipt on disk so a misrouted or policy-violating turn can never pass.
+func (c *Collector) Taint() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	c.invalid = true
+	entry := c.review
+	if entry != nil {
+		acquireReview(entry)
+	}
+	c.mu.Unlock()
+	if entry != nil {
+		defer releaseReview(entry)
+		entry.mu.Lock()
+		entry.taintAndPersistLocked()
+		entry.mu.Unlock()
+	}
+	c.mu.Lock()
+	c.maybeReleaseReviewLocked()
+	c.mu.Unlock()
+}
+
+func (c *Collector) HandlerDone(success bool) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.handlerDone = true
+	if !success {
+		c.invalid = true
+	}
+	c.publishLocked()
+}
+
+func (c *Collector) Complete(success bool) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	// Multiple lifecycle owners under one inbound request are not covered.
+	if c.lifecycleDone || !success {
+		c.invalid = true
+	}
+	c.lifecycleDone = true
+	c.publishLocked()
+}
+
+var syncDirFn = defaultSyncDir
+
+func defaultSyncDir(dir string) error {
+	f, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	syncErr := f.Sync()
+	closeErr := f.Close()
+	if syncErr != nil {
+		return syncErr
+	}
+	return closeErr
+}
+
+func reservePrivateDir(directory string, allowExisting bool) error {
+	root := filepath.Dir(directory)
+	if err := os.MkdirAll(root, 0700); err != nil {
+		return err
+	}
+	info, err := os.Lstat(root)
+	if err != nil || !info.IsDir() || info.Mode().Perm()&0077 != 0 {
+		return ErrUnavailable
+	}
+	err = os.Mkdir(directory, 0700)
+	if err != nil {
+		if !allowExisting || !os.IsExist(err) {
+			return err
+		}
+		dirInfo, statErr := os.Lstat(directory)
+		if statErr != nil || !dirInfo.IsDir() || dirInfo.Mode()&os.ModeSymlink != 0 || dirInfo.Mode().Perm()&0077 != 0 {
+			return ErrUnavailable
+		}
+	}
+	if err := syncDirFn(root); err != nil {
+		return err
+	}
+	return nil
+}
+
+// Start is called by the auth execution guard, not by an asynchronous usage sink.
+func (c *Collector) Start(ctx context.Context, provider, model string) (context.Context, *Execution, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.invalid || c.sealed || c.handlerDone || c.lifecycleDone || time.Now().After(c.deadline) {
+		c.invalid = true
+		return ctx, nil, ErrUnavailable
+	}
+	if c.strictCodex && c.active > 0 {
+		c.invalid = true
+		return ctx, nil, ErrUnavailable
+	}
+	if c.review != nil {
+		expected := "codex:" + model + "@chatgpt.com"
+		c.review.mu.Lock()
+		if c.review.sealed {
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if c.review.tainted {
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if provider != "codex" || c.expectedModel == "" || model != c.expectedModel || (model != "gpt-6.2-sol" && model != "gpt-6.2-astra") {
+			c.review.taintAndPersistLocked()
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if c.review.route != expected {
+			c.review.taintAndPersistLocked()
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if !c.review.reserved {
+			if err := reservePrivateDir(c.directory, true); err != nil {
+				c.review.mu.Unlock()
+				c.invalid = true
+				return ctx, nil, ErrUnavailable
+			}
+			c.review.reserved = true
+		}
+		c.review.mu.Unlock()
+		c.reserved = true
+	} else if !c.reserved {
+		if err := reservePrivateDir(c.directory, false); err != nil {
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		c.reserved = true
+	}
+	c.active++
+	c.executions++
+	c.upstreamEOF = false
+	c.streamResponseID = ""
+	c.lastItemResponseID = ""
+	c.lastItemOutputSHA = ""
+	e := &Execution{c: c, provider: provider, model: model}
+	ctx = httptransport.WithDecorator(ctx, func(next http.RoundTripper) http.RoundTripper { return &transport{next: next, execution: e} })
+	return ctx, e, nil
+}
+
+func (e *Execution) End() {
+	c := e.c
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if e.ended {
+		c.invalid = true
+		return
+	}
+	e.ended = true
+	c.active--
+	c.streamResponseID = ""
+	c.lastItemResponseID = ""
+	c.lastItemOutputSHA = ""
+	if e.attempts == 0 {
+		c.invalid = true
+	}
+	c.publishLocked()
+}
+
+type restoredBody struct {
+	io.Reader
+	io.Closer
+}
+
+func parseTopLevelJSONModel(raw []byte) string {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return ""
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok || delim != '{' {
+		return ""
+	}
+	found := ""
+	seenModel := false
+	for dec.More() {
+		keyTok, err := dec.Token()
+		if err != nil {
+			return ""
+		}
+		key, ok := keyTok.(string)
+		if !ok {
+			return ""
+		}
+		if key == "model" {
+			if seenModel {
+				return ""
+			}
+			seenModel = true
+			var value string
+			if err := dec.Decode(&value); err != nil {
+				return ""
+			}
+			found = value
+		} else {
+			var skip json.RawMessage
+			if err := dec.Decode(&skip); err != nil {
+				return ""
+			}
+		}
+	}
+	endTok, err := dec.Token()
+	if err != nil {
+		return ""
+	}
+	if endDelim, ok := endTok.(json.Delim); !ok || endDelim != '}' {
+		return ""
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return ""
+	}
+	return found
+}
+
+func parseTopLevelJSONReviewRequest(raw []byte) (string, bool) {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return "", false
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok || delim != '{' {
+		return "", false
+	}
+	foundModel := ""
+	seenModel := false
+	seenStream := false
+	streamTrue := false
+	for dec.More() {
+		keyTok, err := dec.Token()
+		if err != nil {
+			return "", false
+		}
+		key, ok := keyTok.(string)
+		if !ok {
+			return "", false
+		}
+		switch key {
+		case "model":
+			if seenModel {
+				return "", false
+			}
+			seenModel = true
+			var value string
+			if err := dec.Decode(&value); err != nil {
+				return "", false
+			}
+			foundModel = value
+		case "stream":
+			if seenStream {
+				return "", false
+			}
+			seenStream = true
+			var flag bool
+			if err := dec.Decode(&flag); err != nil {
+				return "", false
+			}
+			streamTrue = flag
+		default:
+			var skip json.RawMessage
+			if err := dec.Decode(&skip); err != nil {
+				return "", false
+			}
+		}
+	}
+	endTok, err := dec.Token()
+	if err != nil {
+		return "", false
+	}
+	if endDelim, ok := endTok.(json.Delim); !ok || endDelim != '}' {
+		return "", false
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return "", false
+	}
+	return foundModel, seenModel && seenStream && streamTrue
+}
+
+func decodeCodexWireBody(raw []byte, encoding string) ([]byte, bool) {
+	switch strings.ToLower(strings.TrimSpace(encoding)) {
+	case "", "identity":
+		return raw, true
+	case "zstd":
+		dec, err := zstd.NewReader(bytes.NewReader(raw), zstd.WithDecoderMaxMemory(64<<20))
+		if err != nil {
+			return nil, false
+		}
+		defer dec.Close()
+		out, err := io.ReadAll(io.LimitReader(dec, maxOutboundModelBody+1))
+		if err != nil || len(out) > maxOutboundModelBody {
+			return nil, false
+		}
+		return out, true
+	case "gzip":
+		dec, err := gzip.NewReader(bytes.NewReader(raw))
+		if err != nil {
+			return nil, false
+		}
+		defer dec.Close()
+		out, err := io.ReadAll(io.LimitReader(dec, maxOutboundModelBody+1))
+		if err != nil || len(out) > maxOutboundModelBody {
+			return nil, false
+		}
+		return out, true
+	default:
+		return nil, false
+	}
+}
+
+func codexOutboundModel(req *http.Request) string {
+	if req.Method != http.MethodPost || req.Body == nil {
+		return ""
+	}
+	if req.URL == nil || req.URL.Path != "/backend-api/codex/responses" {
+		return ""
+	}
+	orig := req.Body
+	raw, err := io.ReadAll(io.LimitReader(orig, maxOutboundModelBody+1))
+	if err != nil {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return ""
+	}
+	if len(raw) > maxOutboundModelBody {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return ""
+	}
+	_ = orig.Close()
+	req.Body = io.NopCloser(bytes.NewReader(raw))
+	decoded, ok := decodeCodexWireBody(raw, req.Header.Get("Content-Encoding"))
+	if !ok {
+		return ""
+	}
+	return parseTopLevelJSONModel(decoded)
+}
+
+// Only enums enter the collector. URL paths, bodies and auth identifiers never do.
+func route(provider, model string, req *http.Request) string {
+	if req.URL == nil || req.URL.Scheme != "https" || req.URL.User != nil || (req.URL.Port() != "" && req.URL.Port() != "443") {
+		return "other"
+	}
+	host := strings.ToLower(req.URL.Hostname())
+	if req.Host != "" && !strings.EqualFold(req.Host, req.URL.Host) {
+		return "other"
+	}
+	if provider == "codex" {
+		if host != "chatgpt.com" || req.Method != http.MethodPost || req.URL.Path != "/backend-api/codex/responses" || req.URL.RawQuery != "" || (model != "gpt-6.2-sol" && model != "gpt-6.2-astra") {
+			return "other"
+		}
+		if codexOutboundModel(req) != model {
+			return "other"
+		}
+		return "codex:" + model + "@chatgpt.com"
+	}
+	value := provider + "@" + host
+	switch value {
+	case "kimi@api.kimi.com", "kimi-ai@api.kimi.ai", "claude@api.anthropic.com", "antigravity@daily-cloudcode-pa.googleapis.com":
+		return value
+	default:
+		return "other"
+	}
+}
+
+type transport struct {
+	next      http.RoundTripper
+	execution *Execution
+}
+
+func isTLSVerificationError(err error) bool {
+	if err == nil {
+		return false
+	}
+	var certVerifyErr *tls.CertificateVerificationError
+	var recordHeaderErr tls.RecordHeaderError
+	var hostnameErr x509.HostnameError
+	var unknownAuthErr x509.UnknownAuthorityError
+	var certInvalidErr x509.CertificateInvalidError
+	var systemRootsErr x509.SystemRootsError
+	var constraintErr x509.ConstraintViolationError
+	return errors.As(err, &certVerifyErr) ||
+		errors.As(err, &recordHeaderErr) ||
+		errors.As(err, &hostnameErr) ||
+		errors.As(err, &unknownAuthErr) ||
+		errors.As(err, &certInvalidErr) ||
+		errors.As(err, &systemRootsErr) ||
+		errors.As(err, &constraintErr)
+}
+
+func (t *transport) RoundTrip(req *http.Request) (*http.Response, error) {
+	e, c := t.execution, t.execution.c
+	c.mu.Lock()
+	if c.invalid || c.sealed || e.ended || time.Now().After(c.deadline) || c.attempts >= MaxAttempts {
+		c.invalid = true
+		c.mu.Unlock()
+		return nil, ErrUnavailable
+	}
+	strict := c.strictCodex
+	c.mu.Unlock()
+	observed := route(e.provider, e.model, req)
+	if strict {
+		expected := "codex:" + e.model + "@chatgpt.com"
+		if e.provider != "codex" || (e.model != "gpt-6.2-sol" && e.model != "gpt-6.2-astra") || observed != expected {
+			c.Taint()
+			return nil, ErrUnavailable
+		}
+	}
+	c.mu.Lock()
+	if c.invalid || c.sealed || e.ended || time.Now().After(c.deadline) || c.attempts >= MaxAttempts {
+		c.invalid = true
+		c.mu.Unlock()
+		return nil, ErrUnavailable
+	}
+	c.attempts++
+	e.attempts++
+	c.bodies++
+	c.mu.Unlock()
+	resp, err := t.next.RoundTrip(req)
+	finish := func() { c.mu.Lock(); defer c.mu.Unlock(); c.bodies--; c.publishLocked() }
+	if err != nil {
+		c.mu.Lock()
+		c.receipt.Routes = append(c.receipt.Routes, "other")
+		c.mu.Unlock()
+		if strict {
+			if observed != "other" && isTLSVerificationError(err) {
+				c.Taint()
+			} else {
+				c.Reject()
+			}
+		} else {
+			c.Reject()
+		}
+		finish()
+		return nil, err
+	}
+	if resp != nil && observed != "other" {
+		expectedHost := strings.ToLower(req.URL.Hostname())
+		tlsOK := resp.TLS != nil &&
+			resp.TLS.HandshakeComplete &&
+			len(resp.TLS.VerifiedChains) > 0 &&
+			len(resp.TLS.VerifiedChains[0]) > 0 &&
+			strings.EqualFold(resp.TLS.ServerName, expectedHost) &&
+			resp.TLS.VerifiedChains[0][0].VerifyHostname(expectedHost) == nil
+		if !tlsOK {
+			if resp.Body != nil {
+				_ = resp.Body.Close()
+			}
+			if strict {
+				c.Taint()
+			} else {
+				c.Reject()
+			}
+			finish()
+			return nil, ErrUnavailable
+		}
+	}
+	if resp != nil {
+		c.mu.Lock()
+		c.receipt.Routes = append(c.receipt.Routes, observed)
+		c.mu.Unlock()
+	}
+	if resp == nil || resp.Body == nil {
+		finish()
+	} else {
+		resp.Body = &body{
+			ReadCloser: resp.Body,
+			finish:     finish,
+			reject:     c.Reject,
+			markEOF:    c.MarkUpstreamEOF,
+			requireEOF: strict && resp.StatusCode >= 200 && resp.StatusCode < 300,
+		}
+	}
+	return resp, nil
+}
+
+type body struct {
+	io.ReadCloser
+	once       sync.Once
+	finish     func()
+	reject     func()
+	markEOF    func()
+	requireEOF bool
+	sawEOF     atomic.Bool
+	readErr    atomic.Bool
+}
+
+func (b *body) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if errors.Is(err, io.EOF) {
+		b.sawEOF.Store(true)
+	} else if err != nil {
+		b.readErr.Store(true)
+	}
+	return n, err
+}
+
+func (b *body) Close() error {
+	// Never block Close() on a synchronous Read against a potentially stalled upstream connection:
+	// strict callers must have already drained Read() to real io.EOF; otherwise fail closed immediately.
+	err := b.ReadCloser.Close()
+	if err != nil || (b.requireEOF && (b.readErr.Load() || !b.sawEOF.Load())) {
+		b.reject()
+	} else if b.requireEOF && b.markEOF != nil {
+		b.markEOF()
+	}
+	b.once.Do(b.finish)
+	return err
+}
+
+func (e *reviewEntry) diskIsTaintedLocked() bool {
+	path := filepath.Join(e.directory, "receipt.json")
+	finfo, err := os.Lstat(path)
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode()&os.ModeSymlink != 0 || finfo.Size() <= 0 || finfo.Size() > maxReviewReceiptBytes {
+		return false
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return false
+	}
+	var disk ReviewReceipt
+	return json.Unmarshal(raw, &disk) == nil && disk.Tainted
+}
+
+func (e *reviewEntry) invalidateDiskReceiptLocked() {
+	finalPath := filepath.Join(e.directory, "receipt.json")
+	_ = os.Truncate(finalPath, 0)
+	_ = os.Remove(finalPath)
+	_ = syncDirFn(e.directory)
+}
+
+func (e *reviewEntry) persistLocked() error {
+	_, err := e.persistWithStatusLocked()
+	return err
+}
+
+func (e *reviewEntry) persistWithStatusLocked() (bool, error) {
+	fail := func(renamed bool, err error) (bool, error) {
+		if e.tainted {
+			e.invalidateDiskReceiptLocked()
+		}
+		return renamed, err
+	}
+	if !e.reserved {
+		if err := reservePrivateDir(e.directory, true); err != nil {
+			return fail(false, err)
+		}
+		e.reserved = true
+	}
+	if !e.tainted && e.diskIsTaintedLocked() {
+		e.tainted = true
+	}
+	routes := []string{"other"}
+	respIDs := []string{}
+	complete := false
+	lastResp := ""
+	lastOut := ""
+	if !e.tainted && e.requests > 0 && e.route != "" && isSHA256Hex(e.lastResponseIDSHA) &&
+		len(e.responseIDSHAs) == e.requests && e.responseIDSHAs[len(e.responseIDSHAs)-1] == e.lastResponseIDSHA {
+		routes = []string{e.route}
+		respIDs = append([]string(nil), e.responseIDSHAs...)
+		complete = true
+		lastResp = e.lastResponseIDSHA
+		lastOut = e.lastOutputSHA
+	}
+	finished := e.finished
+	if finished == 0 {
+		finished = time.Now().UnixNano()
+	}
+	sealed := e.sealed && !e.tainted && complete
+	sealedAt := int64(0)
+	if sealed {
+		sealedAt = e.sealedAt
+		if sealedAt < finished {
+			sealedAt = finished
+		}
+	}
+	payload := ReviewReceipt{
+		Schema:           ReviewSchema,
+		Launch:           e.launch,
+		Session:          e.session,
+		Started:          e.started,
+		Finished:         finished,
+		SealedAt:         sealedAt,
+		Complete:         complete,
+		Sealed:           sealed,
+		Tainted:          e.tainted,
+		Requests:         e.requests,
+		Routes:           routes,
+		ResponseIDSHAs:   respIDs,
+		LastResponseID:   lastResp,
+		LastOutputSHA256: lastOut,
+	}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return fail(false, err)
+	}
+	tmp := filepath.Join(e.directory, fmt.Sprintf("pending-%d-%d", os.Getpid(), tmpSeq.Add(1)))
+	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return fail(false, err)
+	}
+	_, errWrite := f.Write(data)
+	errSync := f.Sync()
+	errClose := f.Close()
+	if errWrite != nil || errSync != nil || errClose != nil {
+		_ = os.Remove(tmp)
+		return fail(false, ErrUnavailable)
+	}
+	if err := os.Rename(tmp, filepath.Join(e.directory, "receipt.json")); err != nil {
+		_ = os.Remove(tmp)
+		return fail(false, err)
+	}
+	if err := syncDirFn(e.directory); err != nil {
+		return fail(true, err)
+	}
+	e.markerPersisted = true
+	return true, nil
+}
+
+func (c *Collector) maybeReleaseReviewLocked() {
+	if c.review != nil && !c.reviewReleased && c.handlerDone && c.active == 0 && c.bodies == 0 && (c.sealed || c.lifecycleDone || c.invalid) {
+		c.reviewReleased = true
+		releaseReview(c.review)
+	}
+}
+
+func (c *Collector) publishLocked() {
+	defer c.maybeReleaseReviewLocked()
+	if c.invalid || c.sealed || !c.handlerDone || !c.lifecycleDone || c.active != 0 || c.bodies != 0 || c.executions == 0 || len(c.receipt.Routes) == 0 {
+		return
+	}
+	if time.Now().After(c.deadline) {
+		c.invalid = true
+		return
+	}
+	c.sealed = true
+	if c.review != nil {
+		routes := append([]string(nil), c.receipt.Routes...)
+		observedCompleted := c.observedCompleted
+		modelMismatch := c.modelMismatch
+		lastResp := c.lastResponseIDSHA
+		lastOut := c.lastOutputSHA
+		entry := c.review
+		entry.mu.Lock()
+		defer entry.mu.Unlock()
+		if entry.sealed {
+			return
+		}
+		if entry.tainted || modelMismatch {
+			entry.taintAndPersistLocked()
+			return
+		}
+		for _, r := range routes {
+			if r != "codex:gpt-6.2-sol@chatgpt.com" && r != "codex:gpt-6.2-astra@chatgpt.com" {
+				entry.taintAndPersistLocked()
+				return
+			}
+			if entry.route == "" {
+				entry.route = r
+			} else if entry.route != r {
+				entry.taintAndPersistLocked()
+				return
+			}
+		}
+		if !observedCompleted || !isSHA256Hex(lastResp) {
+			return
+		}
+		if len(entry.responseIDSHAs) >= maxReviewResponseIDs {
+			entry.taintAndPersistLocked()
+			return
+		}
+		entry.requests++
+		entry.responseIDSHAs = append(entry.responseIDSHAs, lastResp)
+		entry.lastResponseIDSHA = lastResp
+		entry.lastOutputSHA = lastOut
+		entry.finished = time.Now().UnixNano()
+		if err := entry.persistLocked(); err != nil {
+			entry.taintAndPersistLocked()
+		}
+		return
+	}
+	c.receipt.Complete = true
+	c.receipt.Finished = time.Now().UnixNano()
+	data, err := json.Marshal(c.receipt)
+	if err != nil {
+		return
+	}
+	// Same-directory exclusive temporary file and rename: readers see all or nothing.
+	tmp := filepath.Join(c.directory, "pending")
+	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return
+	}
+	_, errWrite := f.Write(data)
+	errSync := f.Sync()
+	errClose := f.Close()
+	if errWrite != nil || errSync != nil || errClose != nil {
+		return
+	}
+	if err := os.Rename(tmp, filepath.Join(c.directory, "receipt.json")); err == nil {
+		_ = syncDirFn(c.directory)
+	}
+}
