+	if _, err := os.Lstat(receiptPath); !os.IsNotExist(err) {
+		t.Fatalf("expected symlink receipt.json to be unlinked, lstat err = %v", err)
+	}
+	got, err := os.ReadFile(target)
+	if err != nil {
+		t.Fatalf("read symlink target: %v", err)
+	}
+	if string(got) != sentinel {
+		t.Fatalf("symlink target was modified/truncated: got %q, want %q", string(got), sentinel)
+	}
