+func TestReviewReceiptConcurrentEnsurePrivateRootWaitsForAncestorSync(t *testing.T) {
+	// Sol P2 #2 (R46) + Astra P1 #2 (R47): ensurePrivateRoot MUST reject missing multi-level
+	// ancestors (requiring pre-existing immediate parent) AND serialize single-level root creation
+	// with immediate parent fsync so concurrent callers wait for parent sync completion.
+	base := t.TempDir()
+	missingMultiLevel := filepath.Join(base, "lvl1", "lvl2", "receipts")
+	if err := ensurePrivateRoot(missingMultiLevel); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("ensurePrivateRoot on missing multi-level ancestors = %v, want ErrUnavailable", err)
+	}
+	if _, statErr := os.Lstat(filepath.Join(base, "lvl1")); !os.IsNotExist(statErr) {
+		t.Fatalf("ensurePrivateRoot unexpectedly created missing ancestor lvl1: %v", statErr)
+	}
+
+	root := filepath.Join(base, "receipts")
+	origSync := syncDirFn
+	defer func() { syncDirFn = origSync }()
+	enteredBaseSync := make(chan struct{})
+	releaseBaseSync := make(chan struct{})
+	var baseSynced atomic.Bool
+	var once sync.Once
+	syncDirFn = func(dir string) error {
+		if filepath.Clean(dir) == filepath.Clean(base) {
+			once.Do(func() {
+				close(enteredBaseSync)
+				<-releaseBaseSync
+				baseSynced.Store(true)
+			})
+		}
+		if origSync != nil {
+			return origSync(dir)
+		}
+		return nil
+	}
+
+	err1Ch := make(chan error, 1)
+	go func() {
+		err1Ch <- ensurePrivateRoot(root)
+	}()
+	select {
+	case <-enteredBaseSync:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("goroutine 1 never reached parent sync for %s", base)
+	}
+
+	err2Ch := make(chan error, 1)
+	go func() {
+		err2Ch <- ensurePrivateRoot(root)
+	}()
+
+	// Goroutine 2 MUST NOT return while Goroutine 1 is still syncing immediate parent base!
+	select {
+	case err2 := <-err2Ch:
+		close(releaseBaseSync)
+		t.Fatalf("concurrent ensurePrivateRoot returned early (%v) before parent sync completed", err2)
+	case <-time.After(150 * time.Millisecond):
+	}
+
+	close(releaseBaseSync)
+	if err1 := <-err1Ch; err1 != nil {
+		t.Fatalf("goroutine 1 ensurePrivateRoot failed: %v", err1)
+	}
+	if err2 := <-err2Ch; err2 != nil {
+		t.Fatalf("goroutine 2 ensurePrivateRoot failed: %v", err2)
+	}
+	if !baseSynced.Load() {
+		t.Fatalf("expected parent sync completed")
+	}
+}
