+type partialBodyReader struct {
+	data    []byte
+	offset  int
+	errTail error
+}
+
+func (r *partialBodyReader) Read(p []byte) (int, error) {
+	if r.offset < len(r.data) {
+		n := copy(p, r.data[r.offset:])
+		r.offset += n
+		return n, nil
+	}
+	if r.errTail != nil {
+		return 0, r.errTail
+	}
+	return 0, io.EOF
+}
+
+func (r *partialBodyReader) Close() error { return nil }
+
+func TestReviewReceiptStrictBodyMustReachEOF(t *testing.T) {
+	// Sol P1 (R19): strict Codex transport body wrapper MUST reject if the executor closes resp.Body
