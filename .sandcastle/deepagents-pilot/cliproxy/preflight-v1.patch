+func TestReviewReceiptRejectsPluginExecutorBeforeExecution(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "receipts")
+	session := "019d0000-0000-7000-8000-000000000999"
+	host := &handlerDirectExecutorRouteHost{
+		handlerRouterOnlyTestHost: handlerRouterOnlyTestHost{
+			hasRouters: true,
+			route: func(context.Context, pluginapi.ModelRouteRequest) (pluginapi.ModelRouteResponse, bool) {
+				return pluginapi.ModelRouteResponse{
+					Handled:    true,
+					TargetKind: pluginapi.ModelRouteTargetExecutor,
+					Target:     "forbidden-plugin",
+					Reason:     "test",
+				}, true
+			},
+		},
+	}
+	h := NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, nil)
+	h.SetModelRouterHost(host)
+
+	checkTainted := func(t *testing.T, launch string) {
+		t.Helper()
+		raw, err := os.ReadFile(filepath.Join(root, launch, "receipt.json"))
+		if err != nil {
+			t.Fatalf("missing tainted receipt for %s: %v", launch, err)
+		}
+		var r preflightreceipt.ReviewReceipt
+		if err := json.Unmarshal(raw, &r); err != nil {
+			t.Fatal(err)
+		}
+		if !r.Tainted || r.Complete {
+			t.Fatalf("receipt not tainted: %+v", r)
+		}
+	}
+
+	// Non-streaming Execute must fail closed before invoking plugin executor.
+	l1 := "review-99991111-2222-4333-8444-555555555551"
+	ctx1, c1, err := preflightreceipt.BeginReview(context.Background(), root, l1, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _, errMsg := h.ExecuteWithAuthManager(ctx1, "openai-response", "gpt-6.2-sol", []byte(`{"model":"gpt-6.2-sol"}`), "")
+	c1.HandlerDone(false)
+	if errMsg == nil || errMsg.StatusCode != http.StatusServiceUnavailable {
+		t.Fatalf("Execute errMsg = %+v, want 503", errMsg)
+	}
+	if host.lastPluginID != "" {
+		t.Fatalf("plugin executor ran on Execute: %q", host.lastPluginID)
+	}
+	checkTainted(t, l1)
+
+	// Count must fail closed before invoking plugin executor.
+	l2 := "review-99991111-2222-4333-8444-555555555552"
+	ctx2, c2, err := preflightreceipt.BeginReview(context.Background(), root, l2, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _, errMsg = h.ExecuteCountWithAuthManager(ctx2, "openai-response", "gpt-6.2-sol", []byte(`{"model":"gpt-6.2-sol"}`), "")
+	c2.HandlerDone(false)
+	if errMsg == nil || errMsg.StatusCode != http.StatusServiceUnavailable {
+		t.Fatalf("Count errMsg = %+v, want 503", errMsg)
+	}
+	if host.lastPluginID != "" {
+		t.Fatalf("plugin executor ran on Count: %q", host.lastPluginID)
+	}
+	checkTainted(t, l2)
+
+	// Streaming ExecuteStream must fail closed before invoking plugin executor.
+	l3 := "review-99991111-2222-4333-8444-555555555553"
+	ctx3, c3, err := preflightreceipt.BeginReview(context.Background(), root, l3, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _, errChan := h.ExecuteStreamWithAuthManager(ctx3, "openai-response", "gpt-6.2-sol", []byte(`{"model":"gpt-6.2-sol","stream":true}`), "")
+	errMsg = <-errChan
+	c3.HandlerDone(false)
+	if errMsg == nil || errMsg.StatusCode != http.StatusServiceUnavailable {
+		t.Fatalf("Stream errMsg = %+v, want 503", errMsg)
+	}
+	if host.lastPluginID != "" {
+		t.Fatalf("plugin executor ran on Stream: %q", host.lastPluginID)
+	}
+	checkTainted(t, l3)
+}
