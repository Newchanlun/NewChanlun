+func TestRouteRejectsPercentEncodedAndNonCanonicalCodexPaths(t *testing.T) {
+	// Astra P1 #1 (PR #2280 R52): route() and codexOutboundModel() MUST check the wire request
+	// target (EscapedPath / RawPath / Opaque / ForceQuery / RawQuery / RequestURI), not decoded
+	// URL.Path alone, so percent-encoded slashes like /backend-api%2Fcodex/responses or trailing
+	// "?" are NEVER recorded as a trusted codex route.
+	validReq, err := http.NewRequest(http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := route("codex", "gpt-6.2-sol", validReq); got != "codex:gpt-6.2-sol@chatgpt.com" {
+		t.Fatalf("canonical Codex route = %q, want codex:gpt-6.2-sol@chatgpt.com", got)
+	}
+
+	badURLs := []string{
+		"https://chatgpt.com/backend-api%2Fcodex/responses",
+		"https://chatgpt.com/backend-api/codex%2Fresponses",
+		"https://chatgpt.com/backend-api/codex/responses?",
+		"https://chatgpt.com/backend-api/codex/responses?x=1",
+		"https://chatgpt.com/backend-api/codex/responses#frag",
+	}
+	for _, rawURL := range badURLs {
+		req, rerr := http.NewRequest(http.MethodPost, rawURL, strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		if rerr != nil {
+			t.Fatalf("NewRequest(%q): %v", rawURL, rerr)
+		}
+		if got := route("codex", "gpt-6.2-sol", req); got != "other" {
+			t.Fatalf("route(%q) = %q, want other (Path=%q RawPath=%q RequestURI=%q)", rawURL, got, req.URL.Path, req.URL.RawPath, req.URL.RequestURI())
+		}
+	}
+	// Also test opaque URL form.
+	opaqueReq, err := http.NewRequest(http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	opaqueReq.URL.Opaque = "//chatgpt.com/backend-api/codex/responses"
+	if got := route("codex", "gpt-6.2-sol", opaqueReq); got != "other" {
+		t.Fatalf("route(opaque URL) = %q, want other", got)
+	}
+}
