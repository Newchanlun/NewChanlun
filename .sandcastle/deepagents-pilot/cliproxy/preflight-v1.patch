+		ResponseFormat: sdktranslator.FormatOpenAIResponse,
+	}
+	sse1 := "data: " + `{"type":"response.completed","response":{"id":"resp_cancel_t1","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"turn1"}]}]}}` + "\n\n"
+
+	for _, tc := range []struct {
+		name    string
+		launch  string
+		session string
+		sse2    string
+	}{
+		{
+			name:    "cancel drops buffered wrong-model response.completed",
+			launch:  "review-a2222222-2222-4333-8444-555555555501",
+			session: "019d0000-0000-7000-8000-555555555511",
+			sse2:    "data: " + `{"type":"response.completed","response":{"id":"resp_cancel_t2","status":"completed","model":"gpt-6.2-astra","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"spoof"}]}]}}` + "\n\n",
+		},
+		{
+			name:    "cancel drops undelivered wrong-model response.created",
+			launch:  "review-a2222222-2222-4333-8444-555555555502",
+			session: "019d0000-0000-7000-8000-555555555512",
+			sse2:    "data: " + `{"type":"response.created","response":{"id":"resp_cancel_t3","status":"in_progress","model":"gpt-6.2-astra"}}` + "\n\n",
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			root := filepath.Join(t.TempDir(), "receipts")
+
+			// Turn 1: clean completion.
+			ctx1, c1, err := preflightreceipt.BeginReview(context.Background(), root, tc.launch, tc.session, "gpt-6.2-sol")
+			if err != nil {
+				t.Fatalf("turn 1 BeginReview: %v", err)
+			}
+			ctx1, lease1, err := c1.Start(ctx1, "codex", "gpt-6.2-sol")
+			if err != nil {
+				t.Fatalf("turn 1 Start: %v", err)
+			}
+			rt1 := preflightCodexTestRT{tlsState: tlsState, bodyFn: func() io.ReadCloser {
+				return io.NopCloser(strings.NewReader(sse1))
+			}}
+			ctx1 = context.WithValue(ctx1, "cliproxy.roundtripper", http.RoundTripper(rt1))
+			stream1, err := exec.ExecuteStream(ctx1, auth, req, opts)
+			if err != nil {
+				t.Fatalf("turn 1 ExecuteStream: %v", err)
+			}
+			for chunk := range stream1.Chunks {
+				if chunk.Err != nil {
+					t.Fatalf("turn 1 chunk err: %v", chunk.Err)
+				}
+				c1.ObserveStreamChunk(chunk.Payload)
+			}
+			lease1.End()
+			c1.Complete(true)
+			c1.HandlerDone(true)
+
+			// Turn 2: upstream sends wrong-model frame; cancel ctx WITHOUT reading stream2.Chunks
+			// so the executor goroutine must exit via <-ctx.Done() without delivering to wrapPreflightStream.
+			turn2Ctx, cancelTurn2 := context.WithCancel(context.Background())
+			defer cancelTurn2()
+			ctx2, c2, err := preflightreceipt.BeginReview(turn2Ctx, root, tc.launch, tc.session, "gpt-6.2-sol")
+			if err != nil {
+				t.Fatalf("turn 2 BeginReview: %v", err)
+			}
+			ctx2, lease2, err := c2.Start(ctx2, "codex", "gpt-6.2-sol")
+			if err != nil {
