+func TestReviewReceiptRootLeaseKeepsFlockAliveAcrossRotation(t *testing.T) {
+	// Astra P1 #2 (PR #2280 R39): rotating the root directory path while an in-flight operation holds
+	// a lockedRootLease MUST NOT close the old directory's flock until that lease calls Close().
+	base := t.TempDir()
+	root := filepath.Join(base, "receipts")
+	lease1, err := acquirePrivateRootLease(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	moved := filepath.Join(base, "receipts-old")
+	if err := os.Rename(root, moved); err != nil {
+		lease1.Close()
+		t.Fatal(err)
+	}
+	// Acquire a second lease on the fresh root at the original path -> cache evicts old entry,
+	// yet lease1 is still active so moved root directory inode MUST remain exclusively locked.
+	lease2, err := acquirePrivateRootLease(root)
+	if err != nil {
+		lease1.Close()
+		t.Fatal(err)
+	}
+	defer lease2.Close()
+
+	probe, err := os.OpenFile(moved, os.O_RDONLY|syscall.O_DIRECTORY, 0)
+	if err != nil {
+		lease1.Close()
+		t.Fatal(err)
+	}
+	if flockErr := syscall.Flock(int(probe.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); flockErr == nil {
+		_ = probe.Close()
+		lease1.Close()
+		t.Fatalf("old root directory flock was released before active lease1 closed")
+	}
+
+	// Closing lease1 releases the last reference -> another process/fd can now acquire the old lock.
+	lease1.Close()
+	if flockErr := syscall.Flock(int(probe.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); flockErr != nil {
+		_ = probe.Close()
+		t.Fatalf("old root directory flock remained locked after lease1 closed: %v", flockErr)
+	}
+	_ = probe.Close()
+}
