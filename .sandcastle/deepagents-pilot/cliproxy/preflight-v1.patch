+		launch := "review-12345678-1234-4234-8234-123456789afa"
+		session := "019d0000-0000-7000-8000-000000000afa"
+		delayedServer, delayedTransport := newHostTLSServer(t, "chatgpt.com", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
