+		t.Fatal(err)
+	}
+	_, cb, err := BeginReview(context.Background(), root, "review-bbbb1111-2222-4333-8444-555555555552", s2, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	lOverflow := "review-bbbb1111-2222-4333-8444-555555555553"
+	TaintReview(root, lOverflow)
