+		"data: " + `{"type":"response.output_item.done","response_id":"resp_post","item":{"type":"message","role":"assistant","phase":"final_answer","content":[{"type":"refusal","refusal":"denied"}]}}` + "\n\n"
+	if st, _ := runSSE(t, root, "review-c1111111-2222-4333-8444-555555555503", "019d0000-0000-7000-8000-777777777103", ssePostCompletedItem); st != SealRejected {
