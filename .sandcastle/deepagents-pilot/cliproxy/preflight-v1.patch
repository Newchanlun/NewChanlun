+type receiptJSONKind uint8
+
+const (
+	receiptJSONString receiptJSONKind = iota + 1
+	receiptJSONInt64
+	receiptJSONBool
+	receiptJSONStringSlice
+)
+
+var (
+	reviewReceiptJSONKeys = map[string]receiptJSONKind{
+		"schema":                  receiptJSONString,
+		"launch":                  receiptJSONString,
+		"session":                 receiptJSONString,
+		"started_ns":              receiptJSONInt64,
+		"finished_ns":             receiptJSONInt64,
+		"sealed_at_ns":            receiptJSONInt64,
+		"complete":                receiptJSONBool,
+		"sealed":                  receiptJSONBool,
+		"tainted":                 receiptJSONBool,
+		"requests":                receiptJSONInt64,
+		"routes":                  receiptJSONStringSlice,
+		"response_id_sha256s":     receiptJSONStringSlice,
+		"last_response_id_sha256": receiptJSONString,
+		"last_output_sha256":      receiptJSONString,
+	}
+	preflightReceiptJSONKeys = map[string]receiptJSONKind{
+		"schema":      receiptJSONString,
+		"session":     receiptJSONString,
+		"started_ns":  receiptJSONInt64,
+		"finished_ns": receiptJSONInt64,
+		"complete":    receiptJSONBool,
+		"routes":      receiptJSONStringSlice,
+	}
+	preflightMarkerJSONKeys = map[string]receiptJSONKind{
+		"schema":     receiptJSONString,
+		"session":    receiptJSONString,
+		"started_ns": receiptJSONInt64,
+	}
+	reviewMarkerJSONKeys = map[string]receiptJSONKind{
+		"schema":     receiptJSONString,
+		"launch":     receiptJSONString,
+		"started_ns": receiptJSONInt64,
+	}
+)
+
+func validExactReceiptJSONKind(raw []byte, kind receiptJSONKind) bool {
+	trimmed := trimJSONSpace(raw)
+	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
+		return false
+	}
+	switch kind {
+	case receiptJSONString:
+		if trimmed[0] != '"' {
+			return false
+		}
+		var s string
+		return json.Unmarshal(trimmed, &s) == nil
+	case receiptJSONBool:
+		return bytes.Equal(trimmed, []byte("true")) || bytes.Equal(trimmed, []byte("false"))
+	case receiptJSONInt64:
+		s := string(trimmed)
+		start := 0
+		if s[0] == '-' {
+			start = 1
+		}
+		if start >= len(s) {
+			return false
+		}
+		for i := start; i < len(s); i++ {
+			if s[i] < '0' || s[i] > '9' {
+				return false
+			}
+		}
+		_, err := strconv.ParseInt(s, 10, 64)
+		return err == nil
+	case receiptJSONStringSlice:
+		if trimmed[0] != '[' {
+			return false
+		}
+		var elems []json.RawMessage
+		if err := json.Unmarshal(trimmed, &elems); err != nil {
+			return false
+		}
+		for _, elem := range elems {
+			if !validExactReceiptJSONKind(elem, receiptJSONString) {
+				return false
+			}
+		}
+		return true
+	default:
+		return false
+	}
+}
+
+func decodeExactReceiptJSON(raw []byte, requiredKeys map[string]receiptJSONKind, dst any) error {
+	if !utf8.Valid(raw) {
+		return errors.New("invalid UTF-8 in receipt JSON")
+	}
+	if !hasNoUnpairedJSONSurrogates(raw) {
+		return errors.New("unpaired UTF-16 surrogate in receipt JSON")
+	}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return err
+	}
+	if delim, ok := tok.(json.Delim); !ok || delim != '{' {
+		return errors.New("expected JSON object")
+	}
+	seen := make(map[string]struct{}, len(requiredKeys))
+	for dec.More() {
+		keyTok, kerr := dec.Token()
+		if kerr != nil {
+			return kerr
+		}
+		key, ok := keyTok.(string)
+		if !ok {
+			return errors.New("expected string key")
+		}
+		wantKind, allowed := requiredKeys[key]
+		if !allowed {
+			return errors.New("unexpected field")
+		}
+		if _, dup := seen[key]; dup {
+			return errors.New("duplicate field")
+		}
+		seen[key] = struct{}{}
+		var val json.RawMessage
+		if verr := dec.Decode(&val); verr != nil {
+			return verr
+		}
+		if !validExactReceiptJSONKind(val, wantKind) {
+			return errors.New("invalid field JSON type")
+		}
+	}
+	endTok, err := dec.Token()
+	if err != nil {
+		return err
+	}
+	if delim, ok := endTok.(json.Delim); !ok || delim != '}' {
+		return errors.New("expected closing brace")
+	}
+	if _, trailingErr := dec.Token(); trailingErr != io.EOF {
+		return errors.New("trailing JSON data")
+	}
+	if len(seen) != len(requiredKeys) {
+		return errors.New("missing required fields")
+	}
+	dec2 := json.NewDecoder(bytes.NewReader(raw))
+	dec2.DisallowUnknownFields()
+	if err := dec2.Decode(dst); err != nil {
+		return err
+	}
+	var extra any
+	if err := dec2.Decode(&extra); err != io.EOF {
+		return errors.New("trailing JSON value")
+	}
+	return nil
+}
