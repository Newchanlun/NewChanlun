+type preflightUnsupportedExecutor struct {
+	auth.ProviderExecutor
+	calls atomic.Int32
+}
+
+func (e *preflightUnsupportedExecutor) Identifier() string { return "kimi" }
+func (e *preflightUnsupportedExecutor) ExecuteStream(context.Context, *auth.Auth, coreexecutor.Request, coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	e.calls.Add(1)
+	ch := make(chan coreexecutor.StreamChunk, 1)
+	ch <- coreexecutor.StreamChunk{Payload: []byte("data: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[]}}\n\n")}
+	close(ch)
+	return &coreexecutor.StreamResult{Chunks: ch}, nil
+}
