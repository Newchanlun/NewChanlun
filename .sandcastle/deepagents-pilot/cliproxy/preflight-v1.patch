+package auth
+
+import (
+	"context"
+	"net/http"
+	"reflect"
+
+	execution "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/preflightreceipt"
+)
+
+// This fixed-revision allowlist is deliberately by concrete implementation, not
+// Identifier(): a plugin can advertise the same provider without this coverage.
+func preflightStart(ctx context.Context, executor ProviderExecutor, auth *Auth) (context.Context, *preflightreceipt.Execution, error) {
+	c := preflightreceipt.From(ctx)
+	if c == nil {
+		return ctx, nil, nil
+	}
+	typ := reflect.TypeOf(executor)
+	supported := false
+	if typ != nil && typ.Kind() == reflect.Pointer {
+		typ = typ.Elem()
+		if typ.PkgPath() == "github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor" {
+			switch typ.Name() {
+			case "KimiExecutor", "ClaudeExecutor", "AntigravityExecutor":
+				supported = true
+			}
+		}
+	}
+	// An injected transport may forward elsewhere; it has no coverage contract.
+	rt := ctx.Value("cliproxy.roundtripper")
+	_, standardTransport := rt.(*http.Transport)
+	if !supported || auth == nil || (rt != nil && !standardTransport) {
+		c.Reject()
+		return ctx, nil, preflightreceipt.ErrUnavailable
+	}
+	return c.Start(ctx, auth.Provider)
+}
+
+func preflightExecute(executor ProviderExecutor, ctx context.Context, auth *Auth, req execution.Request, opts execution.Options) (execution.Response, error) {
+	ctx, lease, err := preflightStart(ctx, executor, auth)
+	if err != nil {
+		return execution.Response{}, err
+	}
+	if lease != nil {
+		defer lease.End()
+	}
+	return executor.Execute(ctx, auth, req, opts)
+}
+
+func preflightCount(executor ProviderExecutor, ctx context.Context, auth *Auth, req execution.Request, opts execution.Options) (execution.Response, error) {
+	if c := preflightreceipt.From(ctx); c != nil {
+		c.Reject()
+		return execution.Response{}, preflightreceipt.ErrUnavailable
+	}
+	return executor.CountTokens(ctx, auth, req, opts)
+}
+
+func preflightStream(executor ProviderExecutor, ctx context.Context, auth *Auth, req execution.Request, opts execution.Options) (*execution.StreamResult, error) {
+	ctx, lease, err := preflightStart(ctx, executor, auth)
+	if err != nil {
+		return nil, err
+	}
+	result, err := executor.ExecuteStream(ctx, auth, req, opts)
+	if lease == nil {
+		return result, err
+	}
+	if err != nil || result == nil || result.Chunks == nil {
+		lease.End()
+		return result, err
+	}
+	out := make(chan execution.StreamChunk)
+	original := result.Chunks
+	copyResult := *result
+	copyResult.Chunks = out
+	go func() {
+		defer close(out)
+		defer lease.End()
+		for {
+			select {
+			case <-ctx.Done():
+				preflightreceipt.From(ctx).Reject()
+				return
+			case chunk, ok := <-original:
+				if !ok {
+					return
+				}
+				select {
+				case out <- chunk:
+				case <-ctx.Done():
+					preflightreceipt.From(ctx).Reject()
+					return
+				}
+			}
+		}
+	}()
+	return &copyResult, nil
+}
