--- a/internal/api/middleware/preflight_receipt.go
+++ b/internal/api/middleware/preflight_receipt.go
@@ -0,0 +1,211 @@
+package middleware
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"os"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/preflightreceipt"
+)
+
+func PreflightReceipt() gin.HandlerFunc {
+	root := os.Getenv("CLIPROXY_PREFLIGHT_RECEIPTS")
+	return func(c *gin.Context) {
+		session := c.GetHeader("Session-Id")
+		launch := c.GetHeader(preflightreceipt.ReviewHeader)
+		isPreflight := preflightreceipt.ValidPreflightSession(session)
+		hasReviewHeader := launch != ""
+		if !isPreflight && !hasReviewHeader {
+			c.Next()
+			return
+		}
+		if root == "" {
+			if hasReviewHeader {
+				c.AbortWithStatus(http.StatusServiceUnavailable)
+				return
+			}
+			c.Next()
+			return
+		}
+		if hasReviewHeader && c.Request.Method == http.MethodPost && c.Request.URL.Path == "/v1/review-receipts/seal" && c.GetHeader("Upgrade") == "" {
+			c.Next()
+			return
+		}
+		var (
+			ctx       context.Context
+			collector *preflightreceipt.Collector
+			err       error
+		)
+		if hasReviewHeader {
+			abortClose := func(status int) {
+				rc := http.NewResponseController(c.Writer)
+				_ = rc.SetReadDeadline(time.Now())
+				_ = rc.SetWriteDeadline(time.Now().Add(5 * time.Second))
+				c.Header("Connection", "close")
+				c.AbortWithStatus(status)
+			}
+			if !preflightreceipt.ValidReviewLaunch(launch) {
+				abortClose(http.StatusBadRequest)
+				return
+			}
+			if isPreflight || c.Request.Method != http.MethodPost || c.Request.URL.Path != "/v1/responses" || c.GetHeader("Upgrade") != "" || !preflightreceipt.ValidReviewSession(session) {
+				preflightreceipt.TaintExistingReview(root, launch)
+				abortClose(http.StatusBadRequest)
+				return
+			}
+			turnDeadline := time.Now().Add(preflightreceipt.ReviewTurnTimeout)
+			turnCtx, turnCancel := context.WithDeadline(c.Request.Context(), turnDeadline)
+			defer turnCancel()
+			c.Request = c.Request.WithContext(turnCtx)
+
+			bodyDeadline := time.Now().Add(preflightreceipt.ReviewBodyReadTimeout)
+			if bodyDeadline.After(turnDeadline) {
+				bodyDeadline = turnDeadline
+			}
+			pending, pendErr := preflightreceipt.BeginPendingReview(root, launch)
+			if pendErr != nil {
+				abortClose(http.StatusServiceUnavailable)
+				return
+			}
+			defer pending.Release()
+
+			res, existed, resErr := preflightreceipt.ReserveExistingReview(root, launch)
+			if resErr != nil {
+				abortClose(http.StatusServiceUnavailable)
+				return
+			}
+			if existed {
+				defer res.Release()
+				if launchDeadline := res.Deadline(); !launchDeadline.IsZero() {
+					if !launchDeadline.After(time.Now()) {
+						abortClose(http.StatusServiceUnavailable)
+						return
+					}
+					if launchDeadline.Before(turnDeadline) {
+						turnDeadline = launchDeadline
+						turnCancel()
+						turnCtx, turnCancel = context.WithDeadline(c.Request.Context(), turnDeadline)
+						c.Request = c.Request.WithContext(turnCtx)
+						if bodyDeadline.After(turnDeadline) {
+							bodyDeadline = turnDeadline
+						}
+					}
+				}
+			}
+			taintFailure := func() {
+				if existed {
+					res.Taint()
+				} else {
+					preflightreceipt.TaintExistingReview(root, launch)
+				}
+			}
+			rc := http.NewResponseController(c.Writer)
+			if err := rc.SetReadDeadline(bodyDeadline); err != nil {
+				// Without ResponseWriter deadline enforcement, reading an untrusted review body
+				// cannot be bounded without leaking a blocked reader goroutine or blocking Close().
+				taintFailure()
+				c.Header("Connection", "close")
+				c.AbortWithStatus(http.StatusServiceUnavailable)
+				return
+			}
+			if err := rc.SetWriteDeadline(turnDeadline); err != nil {
+				// Without ResponseWriter write-deadline enforcement, a stalled client could block
+				// downstream streaming Write/Flush past ReviewTurnTimeout and keep res in-flight.
+				_ = rc.SetReadDeadline(time.Time{})
+				taintFailure()
+				c.Header("Connection", "close")
+				c.AbortWithStatus(http.StatusServiceUnavailable)
+				return
+			}
+			requestedModel, ok := preflightreceipt.ExtractInboundReviewModel(c.Request)
+			if !ok || !preflightreceipt.AllowedReviewModel(requestedModel) {
+				taintFailure()
+				c.Header("Connection", "close")
+				if !ok && (errors.Is(turnCtx.Err(), context.DeadlineExceeded) || time.Now().After(bodyDeadline)) {
+					c.AbortWithStatus(http.StatusRequestTimeout)
+				} else {
+					c.AbortWithStatus(http.StatusBadRequest)
+				}
+				return
+			}
+			_ = rc.SetReadDeadline(time.Time{})
+			if !existed {
+				res, resErr = preflightreceipt.ReserveReview(root, launch)
+				if resErr != nil {
+					preflightreceipt.TaintExistingReview(root, launch)
+					abortClose(http.StatusServiceUnavailable)
+					return
+				}
+				defer res.Release()
+			}
+			res.SetTurnSeq(pending.TurnSeq())
+			pending.Release()
+			ctx, collector, err = preflightreceipt.BeginReviewReserved(turnCtx, res, session, requestedModel)
+			if err != nil {
+				abortClose(http.StatusServiceUnavailable)
+				return
+			}
+			if colDeadline := collector.Deadline(); !colDeadline.IsZero() && colDeadline.Before(turnDeadline) {
+				turnDeadline = colDeadline
+				var subCancel context.CancelFunc
+				ctx, subCancel = context.WithDeadline(ctx, turnDeadline)
+				defer subCancel()
+				if err := rc.SetWriteDeadline(turnDeadline); err != nil {
+					collector.Taint()
+					collector.HandlerDone(false)
+					abortClose(http.StatusServiceUnavailable)
+					return
+				}
+			}
+		} else {
+			if c.Request.Method != http.MethodPost || c.Request.URL.Path != "/v1/responses" || c.GetHeader("Upgrade") != "" {
+				c.AbortWithStatus(http.StatusBadRequest)
+				return
+			}
+			ctx, collector, err = preflightreceipt.Begin(c.Request.Context(), root, session)
+			if err != nil {
+				c.AbortWithStatus(http.StatusServiceUnavailable)
+				return
+			}
+			var cancel context.CancelFunc
+			ctx, cancel = context.WithDeadline(ctx, time.Now().Add(preflightreceipt.Lifetime))
+			defer cancel()
+		}
+		c.Request = c.Request.WithContext(ctx)
+		finished := false
+		defer func() { collector.HandlerDone(finished && c.Writer.Status() == http.StatusOK) }()
+		c.Next()
+		finished = true
+	}
+}
+
+func SealReviewReceiptHandler() gin.HandlerFunc {
+	root := os.Getenv("CLIPROXY_PREFLIGHT_RECEIPTS")
+	return func(c *gin.Context) {
+		if root == "" {
+			c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"status": "unavailable"})
+			return
+		}
+		launch := c.GetHeader(preflightreceipt.ReviewHeader)
+		session := c.GetHeader("Session-Id")
+		status, receiptSHA := preflightreceipt.SealReviewWithDigest(root, launch, session)
+		switch status {
+		case preflightreceipt.SealOK:
+			c.JSON(http.StatusOK, gin.H{
+				"status":         "sealed",
+				"launch":         launch,
+				"session":        session,
+				"receipt_sha256": receiptSHA,
+			})
+		case preflightreceipt.SealInFlight:
+			c.AbortWithStatusJSON(http.StatusConflict, gin.H{"status": "in_flight"})
+		case preflightreceipt.SealUnavailable:
+			c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"status": "unavailable"})
+		default:
+			c.AbortWithStatusJSON(http.StatusConflict, gin.H{"status": "rejected"})
+		}
+	}
+}
