+func TestReviewReceiptEvictionNeverSplitsActiveLaunch(t *testing.T) {
+	reviewMu.Lock()
+	oldCap := maxReviewLedgerEntries
+	oldLedger := reviewLedger
+	maxReviewLedgerEntries = 2
+	reviewLedger = make(map[string]*reviewEntry)
+	reviewMu.Unlock()
+	t.Cleanup(func() {
+		reviewMu.Lock()
+		maxReviewLedgerEntries = oldCap
+		reviewLedger = oldLedger
+		reviewMu.Unlock()
+	})
+
+	root := filepath.Join(t.TempDir(), "receipts")
+	l1 := "review-aaaa1111-2222-4333-8444-555555555551"
+	l2 := "review-aaaa1111-2222-4333-8444-555555555552"
+	l3 := "review-aaaa1111-2222-4333-8444-555555555553"
+	s1 := "019d0000-0000-7000-8000-000000000101"
+	s2 := "019d0000-0000-7000-8000-000000000102"
+	s3 := "019d0000-0000-7000-8000-000000000103"
+
+	// l1 starts and stays in-flight.
+	ctx1, c1, err := BeginReview(context.Background(), root, l1, s1, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx1, e1, err := c1.Start(ctx1, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	client1 := httptransport.Decorate(ctx1, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+	})})
+	req1, _ := http.NewRequestWithContext(ctx1, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	resp1, err := client1.Do(req1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Sealing while in-flight MUST return SealInFlight.
+	if st := SealReview(root, l1, s1); st != SealInFlight {
+		t.Fatalf("SealReview while in-flight = %v, want SealInFlight", st)
+	}
+
+	// l2 also stays active -> capacity (2) is full of unsealed entries; l3 MUST fail closed instead of evicting l1/l2.
+	_, c2, err := BeginReview(context.Background(), root, l2, s2, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := BeginReview(context.Background(), root, l3, s3, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("active ledger overflow err = %v, want ErrUnavailable", err)
+	}
+	// Tainting l2 persists taint on disk, making l2 evictable while l1 stays pinned.
+	c2.HandlerDone(false)
+	TaintReview(root, l2)
+	_, c3, err := BeginReview(context.Background(), root, l3, s3, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatalf("expected eviction of persisted-tainted l2 to allow l3: %v", err)
+	}
+	c3.HandlerDone(false)
+	TaintReview(root, l3)
+
+	// Concurrent taint on l1 must be observed by the SAME entry held by c1; finishing c1 must NEVER overwrite taint.
+	TaintReview(root, l1)
+	_ = resp1.Body.Close()
+	e1.End()
+	c1.Complete(true)
+	c1.HandlerDone(true)
+	r1 := readReviewReceiptFile(t, root, l1)
+	if !r1.Tainted || r1.Complete || r1.Sealed {
+		t.Fatalf("in-flight collector overwrote tainted receipt: %+v", r1)
+	}
+
+	// TaintReview under full active ledger MUST persist taint on disk WITHOUT overflowing reviewLedger cap.
+	_, ca, err := BeginReview(context.Background(), root, "review-bbbb1111-2222-4333-8444-555555555551", s1, "gpt-6.2-sol")
