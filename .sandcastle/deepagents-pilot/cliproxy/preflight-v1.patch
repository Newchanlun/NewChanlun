+	}
+	bad := provider.PreflightRoundTripperFor(&coreauth.Auth{ProxyURL: "https://127.0.0.1:8443"})
+	if bad == nil {
+		t.Fatal("expected fail-closed RoundTripper for unsupported https:// proxy")
+	}
+	req, err := http.NewRequest(http.MethodGet, "https://chatgpt.com/backend-api/codex/responses", nil)
+	if err != nil {
+		t.Fatalf("new request: %v", err)
+	}
+	if resp, errRT := bad.RoundTrip(req); errRT == nil || resp != nil {
+		t.Fatalf("unsupported https:// proxy transport did not fail closed: resp=%v err=%v", resp, errRT)
+	}
+}
