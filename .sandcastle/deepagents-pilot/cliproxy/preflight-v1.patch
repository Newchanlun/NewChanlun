+
+	// 1. Capitalized keys inside response.metadata and output[].arguments MUST be allowed.
+	validWithMetadata := "data: " + `{"type":"response.completed","response":{"id":"resp_meta_ok","status":"completed","model":"gpt-6.2-sol","metadata":{"ID":"user-1","Model":"custom","Text":"note","a":1,"A":2},"output":[{"type":"function_call","arguments":{"ID":"arg-1","Model":"m","Status":"s"}},{"type":"message","role":"assistant","content":[{"type":"output_text","text":"pass","annotations":[{"Text":"cite","ID":"c1"}]}]}]}}` + "\n\n"
