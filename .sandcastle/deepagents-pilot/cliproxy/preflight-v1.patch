+func TestCodexSSEScannerStandaloneCRAtChunkEndDoesNotStall(t *testing.T) {
+	// Astra P2 #5 (PR #2280 R47): a standalone CR ending a live SSE event at the end of a read
+	// buffer MUST emit immediately without blocking for the next byte, and a subsequent leading LF
+	// from a split CRLF MUST be consumed cleanly without producing a phantom blank line.
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+
+	sc := NewCodexSSEScanner(context.Background(), pr, 64*1024)
+	linesCh := make(chan string, 16)
+	doneCh := make(chan error, 1)
+	go func() {
+		for sc.Scan() {
+			linesCh <- string(sc.Bytes())
+		}
+		doneCh <- sc.Err()
+	}()
+
+	// Write a complete CR-delimited event ending with \r\r and keep the pipe OPEN (no next byte yet).
+	if _, err := pw.Write([]byte("data: {\"type\":\"response.output_text.delta\",\"delta\":\"hi\"}\r\r")); err != nil {
+		t.Fatal(err)
+	}
+	wantFirst := []string{
+		`data: {"type":"response.output_text.delta","delta":"hi"}`,
+		"",
+	}
+	for i, want := range wantFirst {
+		select {
+		case got := <-linesCh:
+			if got != want {
+				t.Fatalf("chunk1 line[%d] = %q, want %q", i, got, want)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatalf("scanner stalled waiting for byte after trailing CR on chunk1 line[%d]", i)
+		}
+	}
+
+	// Next chunk starts with '\n' (completing split CRLF from the prior trailing '\r'),
+	// followed by a second event terminated by CRLF split across two writes.
+	if _, err := pw.Write([]byte("\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"2\"}\r")); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case got := <-linesCh:
+		want := `data: {"type":"response.output_text.delta","delta":"2"}`
+		if got != want {
+			t.Fatalf("chunk2 line = %q, want %q (phantom blank line from split CRLF?)", got, want)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("scanner stalled on chunk2 trailing CR")
+	}
+
+	if _, err := pw.Write([]byte("\n\n")); err != nil {
+		t.Fatal(err)
+	}
+	_ = pw.Close()
+
+	select {
+	case got := <-linesCh:
+		if got != "" {
+			t.Fatalf("chunk3 blank delimiter = %q, want empty string", got)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("scanner stalled on final blank line")
+	}
+	select {
+	case err := <-doneCh:
+		if err != nil {
+			t.Fatalf("scanner ended with err=%v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("scanner did not terminate after EOF")
+	}
+	select {
+	case extra := <-linesCh:
+		t.Fatalf("unexpected extra line after EOF: %q", extra)
+	default:
+	}
+}
