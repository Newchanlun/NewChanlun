+// RequireStrictProducer marks that this strict Codex attempt runs through an upstream SSE producer
+// whose response.completed response ID and final assistant output digest must match the consumer.
+func (c *Collector) RequireStrictProducer() {
+	if c == nil || !c.strictCodex {
