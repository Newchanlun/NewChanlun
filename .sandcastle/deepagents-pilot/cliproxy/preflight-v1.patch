+func TestReviewReceiptCodexExecutorPostTerminalScanErrorTaintsPriorTurn(t *testing.T) {
+	tlsState := preflightCodexVerifiedTLS(t, "chatgpt.com")
+	exec := NewCodexExecutor(&config.Config{})
+	auth := &cliproxyauth.Auth{
+		ID:       "codex-review-test",
