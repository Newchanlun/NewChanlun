+	if _, err := ReserveReview(badRoot, launchBad); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("ReserveReview on unwritable 0755 root = %v, want ErrUnavailable", err)
+	}
+	reviewMu.Lock()
+	_, leaked := reviewLedger[badRoot+"\x00"+launchBad]
+	reviewMu.Unlock()
+	if leaked {
+		t.Fatalf("failed ReserveReview leaked entry into reviewLedger")
+	}
+
+	// 2. Writable ReserveReview writes an initial unsealed receipt.json BEFORE request #1 reads body
+	// or calls upstream. Even if storage refuses writes during Taint() (simulated root-safely with a
+	// temp-file blocker directory + re-planting the surviving initial receipt, as on a read-only mount)
+	// and the proxy later restarts after storage recovery, loadReviewEntryFromDisk MUST treat the
+	// unsealed disk marker as tainted and refuse both new requests and SealReview.
+	root := filepath.Join(t.TempDir(), "receipts")
+	launch := "review-eeee1111-2222-4333-8444-555555555902"
+	session := "019d0000-0000-7000-8000-000000000992"
+	res, err := ReserveReview(root, launch)
+	if err != nil {
+		t.Fatalf("ReserveReview on writable root failed: %v", err)
+	}
+	initial := readReviewReceiptFile(t, root, launch)
+	if initial.Complete || initial.Sealed || initial.Tainted || initial.Requests != 0 {
+		t.Fatalf("unexpected initial reservation receipt: %+v", initial)
+	}
+	dir := filepath.Join(root, launch)
+	savedInitial, err := os.ReadFile(filepath.Join(dir, "receipt.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Simulate taint write failure (works even when running as root in Linux Docker), then restore
+	// the surviving initial reservation receipt as if the volume were read-only during taint.
+	blocker := filepath.Join(dir, fmt.Sprintf("pending-%d-%d", os.Getpid(), tmpSeq.Load()+1))
+	if err := os.Mkdir(blocker, 0700); err != nil {
+		t.Fatal(err)
+	}
+	res.Taint()
+	res.Release()
+	if err := os.WriteFile(filepath.Join(dir, "receipt.json"), savedInitial, 0600); err != nil {
+		t.Fatal(err)
+	}
+	_ = os.Remove(blocker)
+
+	// Simulate proxy restart + storage recovery: clear reviewLedger.
+	reviewMu.Lock()
+	delete(reviewLedger, root+"\x00"+launch)
+	reviewMu.Unlock()
+
+	if _, err := ReserveReview(root, launch); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("post-restart ReserveReview resurrected tainted launch: err=%v", err)
+	}
+	if _, _, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("post-restart BeginReview resurrected tainted launch: err=%v", err)
+	}
+	if st := SealReview(root, launch, session); st != SealRejected {
+		t.Fatalf("post-restart SealReview accepted launch: %v", st)
+	}
+}
