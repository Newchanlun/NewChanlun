+		want     string
+	}{
+		{"sol-exact", "gpt-6.2-sol", "/backend-api/codex/responses", "", `{"model":"gpt-6.2-sol","stream":true}`, "codex:gpt-6.2-sol@chatgpt.com"},
+		{"astra-exact", "gpt-6.2-astra", "/backend-api/codex/responses", "", `{"model":"gpt-6.2-astra","stream":true}`, "codex:gpt-6.2-astra@chatgpt.com"},
+		{"body-mismatch", "gpt-6.2-astra", "/backend-api/codex/responses", "", `{"model":"gpt-6.2-sol","stream":true}`, "other"},
+		{"duplicate-model-key", "gpt-6.2-astra", "/backend-api/codex/responses", "", `{"model":"gpt-6.2-astra","model":"gpt-6.2-sol"}`, "other"},
+		{"compressed-body", "gpt-6.2-sol", "/backend-api/codex/responses", "zstd", `{"model":"gpt-6.2-sol"}`, "other"},
+		{"wrong-path", "gpt-6.2-sol", "/v1/responses", "", `{"model":"gpt-6.2-sol"}`, "other"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, c := beginTest(t)
+			ctx, e, err := c.Start(ctx, "codex", tc.model)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var seenBody string
+			client := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+				b, _ := io.ReadAll(req.Body)
+				seenBody = string(b)
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+			})})
+			req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com"+tc.path, strings.NewReader(tc.body))
+			if tc.encoding != "" {
+				req.Header.Set("Content-Encoding", tc.encoding)
+			}
+			resp, err := client.Do(req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			_ = resp.Body.Close()
+			e.End()
+			c.Complete(true)
+			c.HandlerDone(true)
+			if seenBody != tc.body {
+				t.Fatalf("downstream body = %q, want %q", seenBody, tc.body)
+			}
+			r := readReceipt(t, c)
+			if !r.Complete || len(r.Routes) != 1 || r.Routes[0] != tc.want {
+				t.Fatalf("routes = %+v, want [%s]", r.Routes, tc.want)
+			}
+		})
+	}
+}
+
+func compressZstd(t *testing.T, raw string) []byte {
+	t.Helper()
+	enc, err := zstd.NewWriter(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer enc.Close()
+	return enc.EncodeAll([]byte(raw), nil)
+}
+
+func compressGzip(t *testing.T, raw string) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	zw := gzip.NewWriter(&buf)
+	if _, err := zw.Write([]byte(raw)); err != nil {
+		t.Fatal(err)
+	}
+	if err := zw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
