+	sseMixedInvalid := "data: " + `{"type":"response.completed","response":{"id":"resp_mixed_bad","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"text":"ignored"},{"type":"output_text","text":"real-verdict"},{"type":"   ","text":"blank"}]}]}}` + "\n\n"
