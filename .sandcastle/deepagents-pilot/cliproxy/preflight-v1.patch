+
+	t.Run("seal-blocked-while-inbound-body-parsing", func(t *testing.T) {
+		const launch = "review-12345678-1234-4234-8234-123456789af1"
+		const session = "019d0000-0000-7000-8000-000000000af1"
+		res1 := post("/v1/responses", "gpt-6.2-sol", launch, session)
+		if res1.Code != http.StatusOK {
+			t.Fatalf("turn 1 HTTP %d: %s", res1.Code, res1.Body.String())
+		}
+		<-models
+		waitReceipt(t, launch, func(r preflightreceipt.ReviewReceipt) bool { return r.Requests == 1 && r.Complete && !r.Sealed })
+
+		pr, pw := io.Pipe()
+		readingStarted := make(chan struct{})
+		var notifyOnce sync.Once
+		bodyReader := &notifyOnReadReader{r: pr, onRead: func() { notifyOnce.Do(func() { close(readingStarted) }) }}
+		reqDone := make(chan *httptest.ResponseRecorder, 1)
+		go func() {
+			req := httptest.NewRequest(http.MethodPost, "/v1/responses", bodyReader)
+			req.Header.Set("Authorization", "Bearer test-key")
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set(preflightreceipt.ReviewHeader, launch)
+			req.Header.Set("Session-Id", session)
+			rec := httptest.NewRecorder()
+			server.engine.ServeHTTP(rec, req)
+			reqDone <- rec
+		}()
+
+		// Deterministically wait until ExtractInboundReviewModel has begun reading req.Body
+		// (AFTER ReserveReview registered in-flight).
+		select {
+		case <-readingStarted:
+		case <-time.After(3 * time.Second):
+			_ = pw.Close()
+			t.Fatalf("inbound request did not reach body read in time")
+		}
+		sealDuring := seal(launch, session)
+		if sealDuring.Code != http.StatusConflict || !strings.Contains(sealDuring.Body.String(), "in_flight") {
+			_ = pw.Close()
+			t.Fatalf("SealReview during body read = %d %s, want 409 in_flight", sealDuring.Code, sealDuring.Body.String())
+		}
+		// Now deliver a mismatched model body; request must fail and taint the unsealed receipt.
+		_, _ = pw.Write([]byte(`{"model":"gpt-6.2-astra","stream":true,"input":"swap"}`))
+		_ = pw.Close()
+		res2 := <-reqDone
+		if res2.Code < 400 || len(models) != 0 {
+			t.Fatalf("mismatched slow body escaped guard: status=%d calls=%d", res2.Code, len(models))
+		}
+		waitReceipt(t, launch, func(r preflightreceipt.ReviewReceipt) bool { return r.Tainted && !r.Complete && !r.Sealed })
+		if sealAfter := seal(launch, session); sealAfter.Code != http.StatusConflict || !strings.Contains(sealAfter.Body.String(), "rejected") {
+			t.Fatalf("SealReview after tainted slow body = %d %s, want 409 rejected", sealAfter.Code, sealAfter.Body.String())
+		}
+	})
+
+	t.Run("missing-receipt-dir-blocks-tagged-requests-and-passes-ordinary", func(t *testing.T) {
+		t.Setenv("CLIPROXY_PREFLIGHT_RECEIPTS", "")
+		noDirServer := newTestServer(t)
+		noDirManager := noDirServer.handlers.AuthManager
+		noDirManager.SetRoundTripperProvider(preflightTransportProvider{transport})
+		noDirManager.RegisterExecutor(runtimeexecutor.NewCodexAutoExecutor(noDirServer.cfg))
+		const noDirID = "review-receipt-codex-nodir"
+		cred := &auth.Auth{ID: noDirID, Provider: "codex", Status: auth.StatusActive,
+			Attributes: map[string]string{auth.AttributeAuthKind: auth.AuthKindOAuth},
+			Metadata:   map[string]any{"access_token": "offline-fake", "websockets": true},
+		}
+		if _, err := noDirManager.Register(context.Background(), cred); err != nil {
+			t.Fatal(err)
+		}
+		registry.GetGlobalRegistry().RegisterClient(noDirID, "codex", []*registry.ModelInfo{{ID: "gpt-6.2-sol"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(noDirID) })
+
+		send := func(launch, session string) *httptest.ResponseRecorder {
+			req := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true,"input":"offline"}`))
+			req.Header.Set("Authorization", "Bearer test-key")
+			req.Header.Set("Content-Type", "application/json")
+			if launch != "" {
+				req.Header.Set(preflightreceipt.ReviewHeader, launch)
+			}
+			if session != "" {
+				req.Header.Set("Session-Id", session)
+			}
+			res := httptest.NewRecorder()
+			noDirServer.engine.ServeHTTP(res, req)
+			return res
+		}
+		// Formal review and preflight requests MUST fail closed (503) before reaching upstream.
+		resRev := send("review-12345678-1234-4234-8234-123456789ad1", "019d0000-0000-7000-8000-000000000ad1")
+		if resRev.Code != http.StatusServiceUnavailable || len(models) != 0 {
+			t.Fatalf("review request escaped when receipt dir unset: status=%d calls=%d", resRev.Code, len(models))
+		}
+		resPre := send("", "preflight-12345678-1234-4234-8234-123456789ad2")
+		if resPre.Code != http.StatusServiceUnavailable || len(models) != 0 {
+			t.Fatalf("preflight request escaped when receipt dir unset: status=%d calls=%d", resPre.Code, len(models))
+		}
+		// Ordinary untagged traffic continues working unchanged.
+		resOrd := send("", "ordinary-session")
+		if resOrd.Code != http.StatusOK {
+			t.Fatalf("ordinary traffic broken when receipt dir unset: status=%d body=%s", resOrd.Code, resOrd.Body.String())
+		}
+		if got := <-models; got != "gpt-6.2-sol" {
+			t.Fatalf("ordinary traffic upstream model = %q", got)
+		}
+	})
+}
+
+type notifyOnReadReader struct {
+	r      io.ReadCloser
+	onRead func()
+}
+
+func (n *notifyOnReadReader) Read(p []byte) (int, error) {
+	if n.onRead != nil {
+		n.onRead()
+	}
+	return n.r.Read(p)
+}
+
+func (n *notifyOnReadReader) Close() error {
+	return n.r.Close()
+}
