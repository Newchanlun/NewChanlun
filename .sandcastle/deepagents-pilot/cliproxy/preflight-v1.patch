@@ -0,0 +1,65 @@
+package auth
+
+import (
+	"context"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	execution "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/preflightreceipt"
+)
+
+func TestPreflightReceiptUnsupportedExecutorIsNotCalled(t *testing.T) {
+	ctx, c, err := preflightreceipt.Begin(context.Background(), filepath.Join(t.TempDir(), "receipts"), "preflight-12345678-1234-4234-8234-123456789abc")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Nil and all non-native implementations must be rejected before any method call.
+	if _, _, err = preflightStart(ctx, nil, &Auth{Provider: "claude"}, "test-model"); err == nil {
+		t.Fatal("uncovered executor admitted")
+	}
+	if _, err = preflightCount(nil, ctx, nil, execution.Request{}, execution.Options{}); err == nil {
+		t.Fatal("count admitted")
+	}
+	c.Complete(true)
+	c.HandlerDone(true)
+}
+
+// Complement behavior tests with a coverage tripwire for this pinned dispatcher.
+// Any new direct execution path must pass through the same preflight boundary.
+func TestPreflightReceiptAuthDispatchCoverage(t *testing.T) {
+	entries, err := os.ReadDir(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		if !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") || name == "preflight_execution.go" {
+			continue
+		}
+		file, err := parser.ParseFile(token.NewFileSet(), name, nil, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ast.Inspect(file, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			selector, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok {
+				return true
+			}
+			switch selector.Sel.Name {
+			case "Execute", "ExecuteStream", "CountTokens":
+				t.Errorf("unguarded execution call in %s", name)
+			}
+			return true
+		})
+	}
+}
diff --git a/sdk/preflightreceipt/receipt.go b/sdk/preflightreceipt/receipt.go
new file mode 100644
index 0000000..f7b05a2
--- /dev/null
+++ b/sdk/preflightreceipt/receipt.go
@@ -0,0 +1,738 @@
+// Package preflightreceipt produces bounded, body-independent admission evidence.
+// It is enabled only for explicit preflight sessions and formal review launches, never for ordinary traffic.
+package preflightreceipt
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+)
+
+const Schema = "cliproxy-preflight-v1"
+const ReviewSchema = "cliproxy-review-v1"
+const ReviewHeader = "X-NewChanlun-Review-Launch"
+const MaxAttempts = 64
+const Lifetime = 50 * time.Second
+const ReviewTurnLifetime = 30 * time.Minute
+const maxOutboundModelBody = 32 << 20
+const maxReviewLedgerEntries = 2048
+
+var ErrUnavailable = errors.New("preflight evidence unavailable")
+var sessionPattern = regexp.MustCompile(`^preflight-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+var reviewLaunchPattern = regexp.MustCompile(`^review-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+var reviewSessionPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+
+type contextKey struct{}
+
+type Receipt struct {
+	Schema   string   `json:"schema"`
+	Session  string   `json:"session"`
+	Started  int64    `json:"started_ns"`
+	Finished int64    `json:"finished_ns"`
+	Complete bool     `json:"complete"`
+	Routes   []string `json:"routes"`
+}
+
+type ReviewReceipt struct {
+	Schema   string   `json:"schema"`
+	Launch   string   `json:"launch"`
+	Session  string   `json:"session"`
+	Started  int64    `json:"started_ns"`
+	Finished int64    `json:"finished_ns"`
+	Complete bool     `json:"complete"`
+	Tainted  bool     `json:"tainted"`
+	Requests int      `json:"requests"`
+	Routes   []string `json:"routes"`
+}
+
+type reviewEntry struct {
+	mu        sync.Mutex
+	directory string
+	launch    string
+	session   string
+	route     string
+	started   int64
+	finished  int64
+	requests  int
+	tainted   bool
+	reserved  bool
+	touched   time.Time
+}
+
+var (
+	reviewMu     sync.Mutex
+	reviewLedger = make(map[string]*reviewEntry)
+	tmpSeq       atomic.Uint64
+)
+
+type Collector struct {
+	mu                                          sync.Mutex
+	receipt                                     Receipt
+	directory                                   string
+	deadline                                    time.Time
+	invalid, sealed, handlerDone, lifecycleDone bool
+	reserved                                    bool
+	strictCodex                                 bool
+	review                                      *reviewEntry
+	executions, active, bodies                  int
+}
+
+type Execution struct {
+	c        *Collector
+	provider string
+	model    string
+	ended    bool
+	attempts int
+}
+
+func From(ctx context.Context) *Collector {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(contextKey{}).(*Collector)
+	return c
+}
+
+func Inherit(ctx, source context.Context) context.Context {
+	if c := From(source); c != nil {
+		return context.WithValue(ctx, contextKey{}, c)
+	}
+	return ctx
+}
+
+func (c *Collector) StrictCodex() bool {
+	return c != nil && c.strictCodex
+}
+
+// Begin binds the inbound nonce. Disk reservation waits for authenticated execution.
+// The directory must be private to the proxy, outside the credential/state volume.
+func Begin(ctx context.Context, root, session string) (context.Context, *Collector, error) {
+	if !sessionPattern.MatchString(session) || !filepath.IsAbs(root) {
+		return ctx, nil, ErrUnavailable
+	}
+	directory := filepath.Join(root, session)
+	now := time.Now()
+	c := &Collector{directory: directory, deadline: now.Add(Lifetime), receipt: Receipt{Schema: Schema, Session: session, Started: now.UnixNano()}}
+	return context.WithValue(ctx, contextKey{}, c), c, nil
+}
+
+func loadReviewEntryFromDisk(dir, launch, session string, now time.Time) (*reviewEntry, bool, error) {
+	info, err := os.Lstat(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, false, nil
+		}
+		return nil, true, ErrUnavailable
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 {
+		return nil, true, ErrUnavailable
+	}
+	path := filepath.Join(dir, "receipt.json")
+	finfo, err := os.Lstat(path)
+	if err != nil || !finfo.Mode().IsRegular() || finfo.Mode()&os.ModeSymlink != 0 || finfo.Size() <= 0 || finfo.Size() > 16384 {
+		return &reviewEntry{
+			directory: dir,
+			launch:    launch,
+			session:   session,
+			started:   now.UnixNano(),
+			tainted:   true,
+			reserved:  true,
+			touched:   now,
+		}, true, nil
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, true, ErrUnavailable
+	}
+	var disk ReviewReceipt
+	if err := json.Unmarshal(raw, &disk); err != nil ||
+		disk.Schema != ReviewSchema ||
+		disk.Launch != launch ||
+		disk.Tainted ||
+		!disk.Complete ||
+		disk.Requests < 1 ||
+		!reviewSessionPattern.MatchString(disk.Session) ||
+		len(disk.Routes) != 1 ||
+		(disk.Routes[0] != "codex:gpt-6.2-sol@chatgpt.com" && disk.Routes[0] != "codex:gpt-6.2-astra@chatgpt.com") {
+		return &reviewEntry{
+			directory: dir,
+			launch:    launch,
+			session:   disk.Session,
+			started:   now.UnixNano(),
+			tainted:   true,
+			reserved:  true,
+			touched:   now,
+		}, true, nil
+	}
+	return &reviewEntry{
+		directory: dir,
+		launch:    launch,
+		session:   disk.Session,
+		route:     disk.Routes[0],
+		started:   disk.Started,
+		finished:  disk.Finished,
+		requests:  disk.Requests,
+		tainted:   false,
+		reserved:  true,
+		touched:   now,
+	}, true, nil
+}
+
+func getOrCreateReviewEntry(root, launch, session string, now time.Time) (*reviewEntry, error) {
+	key := root + "\x00" + launch
+	reviewMu.Lock()
+	defer reviewMu.Unlock()
+	if entry := reviewLedger[key]; entry != nil {
+		entry.touched = now
+		return entry, nil
+	}
+	dir := filepath.Join(root, launch)
+	diskEntry, onDisk, err := loadReviewEntryFromDisk(dir, launch, session, now)
+	if err != nil {
+		return nil, err
+	}
+	if len(reviewLedger) >= maxReviewLedgerEntries {
+		var oldestKey string
+		var oldestTime time.Time
+		for k, v := range reviewLedger {
+			if oldestKey == "" || v.touched.Before(oldestTime) {
+				oldestKey, oldestTime = k, v.touched
+			}
+		}
+		if oldestKey != "" {
+			delete(reviewLedger, oldestKey)
+		}
+	}
+	entry := diskEntry
+	if !onDisk {
+		entry = &reviewEntry{
+			directory: dir,
+			launch:    launch,
+			session:   session,
+			started:   now.UnixNano(),
+			touched:   now,
+		}
+	}
+	reviewLedger[key] = entry
+	return entry, nil
+}
+
+// TaintReview permanently marks a valid review launch receipt as tainted on disk.
+func TaintReview(root, launch string) {
+	if !reviewLaunchPattern.MatchString(launch) || !filepath.IsAbs(root) {
+		return
+	}
+	entry, err := getOrCreateReviewEntry(root, launch, "", time.Now())
+	if err != nil || entry == nil {
+		return
+	}
+	entry.mu.Lock()
+	entry.tainted = true
+	entry.persistLocked()
+	entry.mu.Unlock()
+}
+
+// BeginReview binds a formal external-review launch and its Codex session.
+// Every outbound request for this launch is strictly enforced to native Codex OAuth HTTP
+// with an exact outbound JSON model match; any violation aborts the request and taints the launch receipt.
+func BeginReview(ctx context.Context, root, launch, session string) (context.Context, *Collector, error) {
+	if !reviewLaunchPattern.MatchString(launch) || !filepath.IsAbs(root) {
+		return ctx, nil, ErrUnavailable
+	}
+	if !reviewSessionPattern.MatchString(session) {
+		TaintReview(root, launch)
+		return ctx, nil, ErrUnavailable
+	}
+	now := time.Now()
+	entry, err := getOrCreateReviewEntry(root, launch, session, now)
+	if err != nil {
+		return ctx, nil, ErrUnavailable
+	}
+
+	entry.mu.Lock()
+	if entry.tainted {
+		entry.persistLocked()
+		entry.mu.Unlock()
+		return ctx, nil, ErrUnavailable
+	}
+	if entry.session != session {
+		entry.tainted = true
+		entry.persistLocked()
+		entry.mu.Unlock()
+		return ctx, nil, ErrUnavailable
+	}
+	entry.mu.Unlock()
+
+	c := &Collector{
+		directory:   entry.directory,
+		deadline:    now.Add(ReviewTurnLifetime),
+		strictCodex: true,
+		review:      entry,
+		receipt:     Receipt{Schema: ReviewSchema, Session: session, Started: now.UnixNano()},
+	}
+	return context.WithValue(ctx, contextKey{}, c), c, nil
+}
+
+func (c *Collector) Reject() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.invalid = true
+}
+
+// Taint permanently invalidates both this collector and, for formal review launches,
+// the launch-level session receipt on disk so a misrouted or policy-violating turn can never pass.
+func (c *Collector) Taint() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	c.invalid = true
+	entry := c.review
+	c.mu.Unlock()
+	if entry != nil {
+		entry.mu.Lock()
+		entry.tainted = true
+		entry.persistLocked()
+		entry.mu.Unlock()
+	}
+}
+
+func (c *Collector) HandlerDone(success bool) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.handlerDone = true
+	if !success {
+		c.invalid = true
+	}
+	c.publishLocked()
+}
+
+func (c *Collector) Complete(success bool) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	// Multiple lifecycle owners under one inbound request are not covered.
+	if c.lifecycleDone || !success {
+		c.invalid = true
+	}
+	c.lifecycleDone = true
+	c.publishLocked()
+}
+
+func reservePrivateDir(directory string, allowExisting bool) error {
+	root := filepath.Dir(directory)
+	if err := os.MkdirAll(root, 0700); err != nil {
+		return err
+	}
+	info, err := os.Lstat(root)
+	if err != nil || !info.IsDir() || info.Mode().Perm()&0077 != 0 {
+		return ErrUnavailable
+	}
+	err = os.Mkdir(directory, 0700)
+	if err != nil {
+		if !allowExisting || !os.IsExist(err) {
+			return err
+		}
+		dirInfo, statErr := os.Lstat(directory)
+		if statErr != nil || !dirInfo.IsDir() || dirInfo.Mode()&os.ModeSymlink != 0 || dirInfo.Mode().Perm()&0077 != 0 {
+			return ErrUnavailable
+		}
+	}
+	return nil
+}
+
+// Start is called by the auth execution guard, not by an asynchronous usage sink.
+func (c *Collector) Start(ctx context.Context, provider, model string) (context.Context, *Execution, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.invalid || c.sealed || c.handlerDone || c.lifecycleDone || time.Now().After(c.deadline) {
+		c.invalid = true
+		return ctx, nil, ErrUnavailable
+	}
+	if c.review != nil {
+		expected := "codex:" + model + "@chatgpt.com"
+		c.review.mu.Lock()
+		if c.review.tainted {
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if provider != "codex" || (model != "gpt-6.2-sol" && model != "gpt-6.2-astra") {
+			c.review.tainted = true
+			c.review.persistLocked()
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if c.review.route != "" && c.review.route != expected {
+			c.review.tainted = true
+			c.review.persistLocked()
+			c.review.mu.Unlock()
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		if !c.review.reserved {
+			if err := reservePrivateDir(c.directory, true); err != nil {
+				c.review.mu.Unlock()
+				c.invalid = true
+				return ctx, nil, ErrUnavailable
+			}
+			c.review.reserved = true
+		}
+		if c.review.route == "" {
+			c.review.route = expected
+		}
+		c.review.mu.Unlock()
+		c.reserved = true
+	} else if !c.reserved {
+		if err := reservePrivateDir(c.directory, false); err != nil {
+			c.invalid = true
+			return ctx, nil, ErrUnavailable
+		}
+		c.reserved = true
+	}
+	c.active++
+	c.executions++
+	e := &Execution{c: c, provider: provider, model: model}
+	ctx = httptransport.WithDecorator(ctx, func(next http.RoundTripper) http.RoundTripper { return &transport{next: next, execution: e} })
+	return ctx, e, nil
+}
+
+func (e *Execution) End() {
+	c := e.c
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if e.ended {
+		c.invalid = true
+		return
+	}
+	e.ended = true
+	c.active--
+	if e.attempts == 0 {
+		c.invalid = true
+	}
+	c.publishLocked()
+}
+
+type restoredBody struct {
+	io.Reader
+	io.Closer
+}
+
+func parseTopLevelJSONModel(raw []byte) string {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return ""
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok || delim != '{' {
+		return ""
+	}
+	found := ""
+	seenModel := false
+	for dec.More() {
+		keyTok, err := dec.Token()
+		if err != nil {
+			return ""
+		}
+		key, ok := keyTok.(string)
+		if !ok {
+			return ""
+		}
+		if key == "model" {
+			if seenModel {
+				return ""
+			}
+			seenModel = true
+			var value string
+			if err := dec.Decode(&value); err != nil {
+				return ""
+			}
+			found = value
+		} else {
+			var skip json.RawMessage
+			if err := dec.Decode(&skip); err != nil {
+				return ""
+			}
+		}
+	}
+	endTok, err := dec.Token()
+	if err != nil {
+		return ""
+	}
+	if endDelim, ok := endTok.(json.Delim); !ok || endDelim != '}' {
+		return ""
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return ""
+	}
+	return found
+}
+
+func decodeCodexWireBody(raw []byte, encoding string) ([]byte, bool) {
+	switch strings.ToLower(strings.TrimSpace(encoding)) {
+	case "", "identity":
+		return raw, true
+	case "zstd":
+		dec, err := zstd.NewReader(bytes.NewReader(raw), zstd.WithDecoderMaxMemory(64<<20))
+		if err != nil {
+			return nil, false
+		}
+		defer dec.Close()
+		out, err := io.ReadAll(io.LimitReader(dec, maxOutboundModelBody+1))
+		if err != nil || len(out) > maxOutboundModelBody {
+			return nil, false
+		}
+		return out, true
+	case "gzip":
+		dec, err := gzip.NewReader(bytes.NewReader(raw))
+		if err != nil {
+			return nil, false
+		}
+		defer dec.Close()
+		out, err := io.ReadAll(io.LimitReader(dec, maxOutboundModelBody+1))
+		if err != nil || len(out) > maxOutboundModelBody {
+			return nil, false
+		}
+		return out, true
+	default:
+		return nil, false
+	}
+}
+
+func codexOutboundModel(req *http.Request, allowCompact bool) string {
+	if req.Method != http.MethodPost || req.Body == nil {
+		return ""
+	}
+	if req.URL == nil || (req.URL.Path != "/backend-api/codex/responses" && (!allowCompact || req.URL.Path != "/backend-api/codex/responses/compact")) {
+		return ""
+	}
+	orig := req.Body
+	raw, err := io.ReadAll(io.LimitReader(orig, maxOutboundModelBody+1))
+	if err != nil {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return ""
+	}
+	if len(raw) > maxOutboundModelBody {
+		req.Body = restoredBody{Reader: io.MultiReader(bytes.NewReader(raw), orig), Closer: orig}
+		return ""
+	}
+	_ = orig.Close()
+	req.Body = io.NopCloser(bytes.NewReader(raw))
+	decoded, ok := decodeCodexWireBody(raw, req.Header.Get("Content-Encoding"))
+	if !ok {
+		return ""
+	}
+	return parseTopLevelJSONModel(decoded)
+}
+
+// Only enums enter the collector. URL paths, bodies and auth identifiers never do.
+func route(provider, model string, req *http.Request, allowCompact bool) string {
+	if req.URL == nil || req.URL.Scheme != "https" || req.URL.User != nil || (req.URL.Port() != "" && req.URL.Port() != "443") {
+		return "other"
+	}
+	host := strings.ToLower(req.URL.Hostname())
+	if req.Host != "" && !strings.EqualFold(req.Host, req.URL.Host) {
+		return "other"
+	}
+	if provider == "codex" {
+		if host != "chatgpt.com" || (model != "gpt-6.2-sol" && model != "gpt-6.2-astra") {
+			return "other"
+		}
+		if codexOutboundModel(req, allowCompact) != model {
+			return "other"
+		}
+		return "codex:" + model + "@chatgpt.com"
+	}
+	value := provider + "@" + host
+	switch value {
+	case "kimi@api.kimi.com", "kimi-ai@api.kimi.ai", "claude@api.anthropic.com", "antigravity@daily-cloudcode-pa.googleapis.com":
+		return value
+	default:
+		return "other"
+	}
+}
+
+type transport struct {
+	next      http.RoundTripper
+	execution *Execution
+}
+
+func (t *transport) RoundTrip(req *http.Request) (*http.Response, error) {
+	e, c := t.execution, t.execution.c
+	c.mu.Lock()
+	if c.invalid || c.sealed || e.ended || time.Now().After(c.deadline) || len(c.receipt.Routes) >= MaxAttempts {
+		c.invalid = true
+		c.mu.Unlock()
+		return nil, ErrUnavailable
+	}
+	strict := c.strictCodex
+	c.mu.Unlock()
+	observed := route(e.provider, e.model, req, strict)
+	if strict {
+		expected := "codex:" + e.model + "@chatgpt.com"
+		if e.provider != "codex" || (e.model != "gpt-6.2-sol" && e.model != "gpt-6.2-astra") || observed != expected {
+			c.Taint()
+			return nil, ErrUnavailable
+		}
+	}
+	c.mu.Lock()
+	if c.invalid || c.sealed || e.ended || time.Now().After(c.deadline) || len(c.receipt.Routes) >= MaxAttempts {
+		c.invalid = true
+		c.mu.Unlock()
+		return nil, ErrUnavailable
+	}
+	e.attempts++
+	c.bodies++
+	c.receipt.Routes = append(c.receipt.Routes, observed)
+	c.mu.Unlock()
+	resp, err := t.next.RoundTrip(req)
+	finish := func() { c.mu.Lock(); defer c.mu.Unlock(); c.bodies--; c.publishLocked() }
+	if err != nil || resp == nil || resp.Body == nil {
+		finish()
+	} else {
+		resp.Body = &body{ReadCloser: resp.Body, finish: finish, reject: c.Reject}
+	}
+	return resp, err
+}
+
+type body struct {
+	io.ReadCloser
+	once   sync.Once
+	finish func()
+	reject func()
+}
+
+func (b *body) Close() error {
+	err := b.ReadCloser.Close()
+	if err != nil {
+		b.reject()
+	}
+	b.once.Do(b.finish)
+	return err
+}
+
+func (e *reviewEntry) persistLocked() {
+	if !e.reserved {
+		if err := reservePrivateDir(e.directory, true); err != nil {
+			return
+		}
+		e.reserved = true
+	}
+	routes := []string{"other"}
+	complete := false
+	if !e.tainted && e.requests > 0 && e.route != "" {
+		routes = []string{e.route}
+		complete = true
+	}
+	payload := ReviewReceipt{
+		Schema:   ReviewSchema,
+		Launch:   e.launch,
+		Session:  e.session,
+		Started:  e.started,
+		Finished: time.Now().UnixNano(),
+		Complete: complete,
+		Tainted:  e.tainted,
+		Requests: e.requests,
+		Routes:   routes,
+	}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return
+	}
+	tmp := filepath.Join(e.directory, fmt.Sprintf("pending-%d-%d", os.Getpid(), tmpSeq.Add(1)))
+	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return
+	}
+	_, errWrite := f.Write(data)
+	errSync := f.Sync()
+	errClose := f.Close()
+	if errWrite != nil || errSync != nil || errClose != nil {
+		_ = os.Remove(tmp)
+		return
+	}
+	_ = os.Rename(tmp, filepath.Join(e.directory, "receipt.json"))
+}
+
+func (c *Collector) publishLocked() {
+	if c.invalid || c.sealed || !c.handlerDone || !c.lifecycleDone || c.active != 0 || c.bodies != 0 || c.executions == 0 || len(c.receipt.Routes) == 0 {
+		return
+	}
+	if time.Now().After(c.deadline) {
+		c.invalid = true
+		return
+	}
+	c.sealed = true
+	if c.review != nil {
+		routes := append([]string(nil), c.receipt.Routes...)
+		entry := c.review
+		entry.mu.Lock()
+		defer entry.mu.Unlock()
+		if entry.tainted {
+			entry.persistLocked()
+			return
+		}
+		for _, r := range routes {
+			if r != "codex:gpt-6.2-sol@chatgpt.com" && r != "codex:gpt-6.2-astra@chatgpt.com" {
+				entry.tainted = true
+				entry.persistLocked()
+				return
+			}
+			if entry.route == "" {
+				entry.route = r
+			} else if entry.route != r {
+				entry.tainted = true
+				entry.persistLocked()
+				return
+			}
+		}
+		entry.requests++
+		entry.finished = time.Now().UnixNano()
+		entry.persistLocked()
+		return
+	}
+	c.receipt.Complete = true
+	c.receipt.Finished = time.Now().UnixNano()
+	data, err := json.Marshal(c.receipt)
+	if err != nil {
+		return
+	}
+	// Same-directory exclusive temporary file and rename: readers see all or nothing.
+	tmp := filepath.Join(c.directory, "pending")
+	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return
+	}
+	_, errWrite := f.Write(data)
+	errSync := f.Sync()
+	errClose := f.Close()
+	if errWrite != nil || errSync != nil || errClose != nil {
+		return
+	}
+	_ = os.Rename(tmp, filepath.Join(c.directory, "receipt.json"))
+}
