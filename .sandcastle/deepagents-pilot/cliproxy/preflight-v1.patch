+func TestReviewReceiptDirSyncFailureRejectsReservationAndSeal(t *testing.T) {
+	// R31/R35 (Sol P1 + Astra P1):
+	// 1. Parent directory sync failure rejects BOTH initial BeginReview AND retry of the same launch.
+	// 2. SealReview pre-rename failure leaves sealed=false on disk -> permanently SealRejected.
+	// 3. SealReview post-rename dir-sync failure returns SealUnavailable in-process AND post-restart while
+	//    dir-sync fails, blocks new turns/wrong session, returns SealRejected if crash lost the rename,
+	//    and returns SealOK only once intact sealed=true receipt + dir-sync both succeed.
+	origSync := syncDirFn
+	defer func() { syncDirFn = origSync }()
+
+	// 1. Parent directory sync failure on initial AND retry BeginReview for the same launch.
+	root1 := filepath.Join(t.TempDir(), "receipts1")
+	launch1 := "review-eeee1111-2222-4333-8444-555555555960"
+	session1 := "019d0000-0000-7000-8000-000000000960"
+	syncDirFn = func(dir string) error {
+		if dir == root1 {
+			return errors.New("injected parent dir sync error")
+		}
+		return origSync(dir)
+	}
+	if _, _, err := BeginReview(context.Background(), root1, launch1, session1, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("initial BeginReview with parent dir sync failure err = %v, want ErrUnavailable", err)
+	}
+	if _, _, err := BeginReview(context.Background(), root1, launch1, session1, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("retry BeginReview on same launch with parent dir sync still failing err = %v, want ErrUnavailable", err)
+	}
+
+	// 2. SealReview pre-rename write failure leaves sealed=false on disk -> repeat & post-restart SealRejected.
+	syncDirFn = origSync
+	root2 := filepath.Join(t.TempDir(), "receipts2")
+	launch2 := "review-eeee1111-2222-4333-8444-555555555961"
+	session2 := "019d0000-0000-7000-8000-000000000961"
+	ctx2, c2, err := BeginReview(context.Background(), root2, launch2, session2, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx2, e2, err := c2.Start(ctx2, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl2 := httptransport.Decorate(ctx2, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+	})})
+	req2, _ := http.NewRequestWithContext(ctx2, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	resp2, err := cl2.Do(req2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c2.ObserveStreamChunk([]byte(`data: {"type":"response.completed","response":{"id":"resp_dirsync2","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}}` + "\n\n"))
+	_, _ = io.Copy(io.Discard, resp2.Body)
+	_ = resp2.Body.Close()
+	e2.End()
+	c2.Complete(true)
+	c2.HandlerDone(true)
+
+	launchDir2 := filepath.Join(root2, launch2)
+	unsealedBefore2, err := os.ReadFile(filepath.Join(launchDir2, "receipt.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	blocker2 := filepath.Join(launchDir2, fmt.Sprintf("pending-%d-%d", os.Getpid(), tmpSeq.Load()+1))
+	if err := os.Mkdir(blocker2, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if st := SealReview(root2, launch2, session2); st != SealUnavailable {
+		t.Fatalf("SealReview with pre-rename failure = %v, want SealUnavailable", st)
+	}
+	_ = os.Remove(blocker2)
+	if err := os.WriteFile(filepath.Join(launchDir2, "receipt.json"), unsealedBefore2, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if st := SealReview(root2, launch2, session2); st != SealRejected {
+		t.Fatalf("in-process repeat SealReview after pre-rename failure = %v, want SealRejected", st)
+	}
+	reviewMu.Lock()
+	delete(reviewLedger, root2+"\x00"+launch2)
+	reviewMu.Unlock()
+	if st := SealReview(root2, launch2, session2); st != SealRejected {
+		t.Fatalf("post-restart SealReview after pre-rename failure = %v, want SealRejected", st)
+	}
+
+	// 3. Post-rename dir-sync failure: launch stays sealed-but-unsynced; returns SealUnavailable both in-process
+	//    and post-restart while dir-sync fails, blocks new turns and wrong session, rejects if crash rolled back
+	//    receipt.json to sealed=false, and returns SealOK only once intact sealed=true + dir-sync both succeed.
+	syncDirFn = origSync
+	root3 := filepath.Join(t.TempDir(), "receipts3")
+	launch3 := "review-preflight-eeee1111-2222-4333-8444-555555555962"
+	session3 := "019d0000-0000-7000-8000-000000000962"
+	if !ValidReviewLaunch(launch3) {
+		t.Fatalf("ValidReviewLaunch(%q) = false, want true", launch3)
+	}
+	ctx3, c3, err := BeginReview(context.Background(), root3, launch3, session3, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx3, e3, err := c3.Start(ctx3, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl3 := httptransport.Decorate(ctx3, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+	})})
+	req3, _ := http.NewRequestWithContext(ctx3, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	resp3, err := cl3.Do(req3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c3.ObserveStreamChunk([]byte(`data: {"type":"response.completed","response":{"id":"resp_dirsync3","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}}` + "\n\n"))
+	_, _ = io.Copy(io.Discard, resp3.Body)
+	_ = resp3.Body.Close()
+	e3.End()
+	c3.Complete(true)
+	c3.HandlerDone(true)
+
+	launchDir3 := filepath.Join(root3, launch3)
+	unsealedBefore3, err := os.ReadFile(filepath.Join(launchDir3, "receipt.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	syncDirFn = func(dir string) error {
+		if dir == launchDir3 {
+			return errors.New("injected launch dir sync error")
+		}
+		return origSync(dir)
+	}
+	if st := SealReview(root3, launch3, session3); st != SealUnavailable {
+		t.Fatalf("SealReview with post-rename dir-sync failure = %v, want SealUnavailable", st)
+	}
+	// Repeat in-process while dir-sync still fails MUST still return SealUnavailable (not SealOK).
+	if st := SealReview(root3, launch3, session3); st != SealUnavailable {
+		t.Fatalf("repeat in-process SealReview while dir-sync fails = %v, want SealUnavailable", st)
+	}
+	// Wrong session rejects immediately; new BeginReview is blocked.
+	if st := SealReview(root3, launch3, "019d0000-0000-7000-8000-000000000999"); st != SealRejected {
+		t.Fatalf("wrong-session SealReview while unsynced = %v, want SealRejected", st)
+	}
+	if _, _, err := BeginReview(context.Background(), root3, launch3, session3, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("in-process BeginReview after seal rename err = %v, want ErrUnavailable", err)
+	}
+	// Post-restart while dir-sync STILL fails MUST return SealUnavailable (not SealOK!).
+	sealedBytes3, err := os.ReadFile(filepath.Join(launchDir3, "receipt.json"))
+	if err != nil || !strings.Contains(string(sealedBytes3), `"sealed":true`) {
+		t.Fatalf("expected sealed=true receipt on disk: err=%v raw=%s", err, string(sealedBytes3))
+	}
+	reviewMu.Lock()
+	delete(reviewLedger, root3+"\x00"+launch3)
+	reviewMu.Unlock()
+	if st := SealReview(root3, launch3, session3); st != SealUnavailable {
+		t.Fatalf("post-restart SealReview while dir-sync fails = %v, want SealUnavailable", st)
+	}
+	// If crash lost the unsynced rename (receipt.json reverts to sealed=false), post-restart returns SealRejected.
+	syncDirFn = origSync
+	if err := os.WriteFile(filepath.Join(launchDir3, "receipt.json"), unsealedBefore3, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if st := SealReview(root3, launch3, session3); st != SealRejected {
+		t.Fatalf("post-restart SealReview after crash lost rename = %v, want SealRejected", st)
+	}
+	// Once intact sealed=true receipt is on disk AND dir-sync succeeds, idempotent SealReview returns SealOK.
+	if err := os.WriteFile(filepath.Join(launchDir3, "receipt.json"), sealedBytes3, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if st := SealReview(root3, launch3, session3); st != SealOK {
+		t.Fatalf("post-restart SealReview once intact sealed=true + dir-sync succeed = %v, want SealOK", st)
+	}
+}
