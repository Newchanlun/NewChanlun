+		t.Fatal(err)
+	}
+	markerPath := filepath.Join(dir, "producer.json")
+	preexisting := `{"foreign":"do-not-delete"}`
+	if err := os.WriteFile(markerPath, []byte(preexisting), 0600); err != nil {
+		t.Fatal(err)
+	}
+	lease, err := acquirePrivateRootLease(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lease.Close()
+
+	if sub, _, created, _, _, _, _, rerr := reserveStagedSubdirWithMarker(lease.dir, root, launch, false, time.Now().UnixNano()); !os.IsExist(rerr) || created || sub != nil {
+		t.Fatalf("reserveStagedSubdirWithMarker(allowExisting=false) over existing dir = (created=%v, err=%v), want (false, EEXIST)", created, rerr)
+	}
+	sub, _, created, _, _, _, _, rerr := reserveStagedSubdirWithMarker(lease.dir, root, launch, true, time.Now().UnixNano())
+	if rerr != nil || created || sub == nil {
+		t.Fatalf("reserveStagedSubdirWithMarker(allowExisting=true) over existing dir = (created=%v, err=%v), want (false, nil)", created, rerr)
+	}
+	_ = sub.Close()
+	if got, gerr := os.ReadFile(markerPath); gerr != nil || string(got) != preexisting {
+		t.Fatalf("pre-existing producer.json was removed/modified: err=%v raw=%q", gerr, string(got))
+	}
+
+	// Pre-existing empty dir MUST NOT be replaced when allowExisting=false (RENAME_NOREPLACE / RENAME_EXCL).
+	pfSess := "preflight-b0000000-2222-4333-8444-555555555502"
+	emptyDir := filepath.Join(root, pfSess)
+	if err := os.Mkdir(emptyDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	emptyFI, err := os.Lstat(emptyDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	eDev, eIno, _ := statDevIno(emptyFI)
+	if sub2, _, _, _, _, _, _, rerr := reserveStagedSubdirWithMarker(lease.dir, root, pfSess, false, time.Now().UnixNano()); !os.IsExist(rerr) || sub2 != nil {
+		t.Fatalf("reserveStagedSubdirWithMarker replaced pre-existing empty dir: err=%v", rerr)
+	}
+	afterFI, err := os.Lstat(emptyDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	aDev, aIno, _ := statDevIno(afterFI)
+	if aDev != eDev || aIno != eIno {
+		t.Fatalf("pre-existing empty dir inode changed: (%d,%d) -> (%d,%d)", eDev, eIno, aDev, aIno)
+	}
+	if _, err := os.Lstat(filepath.Join(emptyDir, "producer.json")); !os.IsNotExist(err) {
+		t.Fatalf("unexpected producer.json written into pre-existing empty dir: %v", err)
+	}
+}
