+func TestReviewReceiptPostCompletedErrorOrIncompleteTaintsPriorTurn(t *testing.T) {
+	// Astra P1 (R20): if a launch already has a clean Turn 1 and Turn 2 sees response.completed
+	// followed by an error (without nested error object) or response.incomplete, the entire launch
+	// MUST be permanently tainted so SealReview cannot seal the earlier clean turn.
+	root := filepath.Join(t.TempDir(), "receipts")
+	cases := []struct {
+		name  string
+		trail string
+		id    string
+	}{
+		{name: "trailing-bare-error", trail: `data: {"type":"error"}` + "\n\n", id: "1"},
+		{name: "trailing-response-incomplete", trail: `data: {"type":"response.incomplete","response":{"id":"resp_t2","status":"incomplete","model":"gpt-6.2-sol"}}` + "\n\n", id: "2"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			launch := "review-eeee1111-2222-4333-8444-55555555592" + tc.id
+			session := "019d0000-0000-7000-8000-00000000092" + tc.id
+			// Turn 1: clean completed turn persisted unsealed.
+			ctx1, c1, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx1, e1, err := c1.Start(ctx1, "codex", "gpt-6.2-sol")
+			if err != nil {
+				t.Fatal(err)
+			}
+			cl1 := httptransport.Decorate(ctx1, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+			})})
+			req1, _ := http.NewRequestWithContext(ctx1, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+			resp1, err := cl1.Do(req1)
+			if err != nil {
+				t.Fatal(err)
+			}
+			c1.ObserveStreamChunk([]byte(`data: {"type":"response.completed","response":{"id":"resp_t1","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n"))
+			_, _ = io.Copy(io.Discard, resp1.Body)
+			_ = resp1.Body.Close()
+			e1.End()
+			c1.Complete(true)
+			c1.HandlerDone(true)
+			before := readReviewReceiptFile(t, root, launch)
+			if !before.Complete || before.Tainted || before.Requests != 1 {
+				t.Fatalf("expected clean Turn 1 receipt before Turn 2: %+v", before)
+			}
+
+			// Turn 2: response.completed followed by bare error / response.incomplete MUST taint launch.
+			ctx2, c2, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx2, e2, err := c2.Start(ctx2, "codex", "gpt-6.2-sol")
+			if err != nil {
+				t.Fatal(err)
+			}
+			cl2 := httptransport.Decorate(ctx2, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+			})})
+			req2, _ := http.NewRequestWithContext(ctx2, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+			resp2, err := cl2.Do(req2)
+			if err != nil {
+				t.Fatal(err)
+			}
+			c2.ObserveStreamChunk([]byte(`data: {"type":"response.completed","response":{"id":"resp_t2","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n" + tc.trail))
+			_, _ = io.Copy(io.Discard, resp2.Body)
+			_ = resp2.Body.Close()
+			e2.End()
+			c2.Complete(true)
+			c2.HandlerDone(true)
+
+			after := readReviewReceiptFile(t, root, launch)
+			if !after.Tainted || after.Complete || after.Sealed {
+				t.Fatalf("post-completed %s failed to taint launch: %+v", tc.name, after)
+			}
+			if st := SealReview(root, launch, session); st != SealRejected {
+				t.Fatalf("SealReview accepted launch after post-completed %s: %v", tc.name, st)
+			}
+		})
+	}
+}
