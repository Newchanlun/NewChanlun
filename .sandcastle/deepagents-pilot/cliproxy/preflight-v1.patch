+		res := request("gpt-6.1-sol", session)
+		if res.Code != http.StatusOK || !strings.Contains(res.Body.String(), "response.completed") {
+			t.Fatalf("ordinary HTTP %d: %s", res.Code, res.Body.String())
+		}
+		requireUpstreamModel(t, "gpt-6.1-sol")
+		requireNoReceipt(t, session)
