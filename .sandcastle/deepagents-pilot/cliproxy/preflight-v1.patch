+	sawPostCommitLaunchSync := false
+	sawPostCommitRootSync := false
+	rotatedAtSealParentSync := false
+	syncDirFn = func(dir string) error {
+		clean := filepath.Clean(dir)
+		if clean == filepath.Clean(launchDir) {
+			if raw, rerr := os.ReadFile(filepath.Join(launchDir, "receipt.json")); rerr == nil && strings.Contains(string(raw), `"sealed":true`) {
+				sawPostCommitLaunchSync = true
+			}
+		} else if sawPostCommitLaunchSync && clean == filepath.Clean(root) {
+			sawPostCommitRootSync = true
+		} else if sawPostCommitRootSync && !rotatedAtSealParentSync && clean == filepath.Clean(base) {
+			rotatedAtSealParentSync = true
+			if rerr := os.Rename(root, movedAway); rerr != nil {
+				return rerr
+			}
+			if merr := os.Mkdir(root, 0700); merr != nil {
+				return merr
+			}
+		}
+		if origSync != nil {
+			return origSync(dir)
+		}
+		return nil
+	}
+	if st, digest := SealReviewWithDigest(root, launch, session); st != SealUnavailable || digest != "" {
+		t.Fatalf("SealReviewWithDigest after post-commit root rotation = (%v, %q), want (SealUnavailable, \"\")", st, digest)
+	}
+	if !rotatedAtSealParentSync {
+		t.Fatalf("test fault never reached post-commit parent sync inside syncSealAncestorsForSubRoot (launchSync=%v rootSync=%v)", sawPostCommitLaunchSync, sawPostCommitRootSync)
+	}
+	if raw, err := os.ReadFile(filepath.Join(movedAway, launch, "receipt.json")); err != nil || !strings.Contains(string(raw), `"sealed":true`) {
+		t.Fatalf("expected sealed receipt committed in movedAway before final verification rejected SealOK: err=%v raw=%s", err, string(raw))
+	}
+}
