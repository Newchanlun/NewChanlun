+	// Simulate staging failure during taint persistence (works even as root in Linux Docker),
+	// AND re-plant the exact unsealed file as would happen on a read-only filesystem.
+	stagingDir := filepath.Join(root, ".staging")
+	_ = os.RemoveAll(stagingDir)
+	if err := os.WriteFile(stagingDir, []byte("blocked"), 0600); err != nil {
