+		t.Fatal(err)
+	}
+	registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{{ID: "gpt-6.2-sol"}, {ID: "gpt-6.2-astra"}, {ID: "gpt-6.1-sol"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+
+	post := func(path, model, launch, session string) *httptest.ResponseRecorder {
+		body := fmt.Sprintf(`{"model":%q,"stream":true,"input":"offline"}`, model)
