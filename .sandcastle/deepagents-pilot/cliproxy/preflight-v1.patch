+	reviewLedger          = make(map[string]*reviewEntry)
+	sealedBindings        = make(map[string]sealedDirBinding)
+	reservedBindingKeys   = make(map[string]bool)
+	activeSealingKeys     = make(map[string]int)
+	reclaimingKeys        = make(map[string]bool)
+	pendingReviewLaunches = make(map[string]*pendingReviewState)
+	pendingReviewTotal    int
+	reviewTurnSeqGen      uint64
+	taintWriteOverflow    bool
+	tmpSeq                atomic.Uint64
