diff --git a/internal/pluginhost/preflight_receipt_test.go b/internal/pluginhost/preflight_receipt_test.go
index e69de29..6cebb36 100644
--- a/internal/pluginhost/preflight_receipt_test.go
+++ b/internal/pluginhost/preflight_receipt_test.go
@@ -0,0 +1,19 @@
+package pluginhost
+
+import "testing"
+
+func TestPreflightReceiptPluginReloadInvalidatesGuard(t *testing.T) {
+	h := New()
+	guard := h.PreflightEvidenceGuard()
+	if !guard() {
+		t.Fatal("empty host rejected")
+	}
+	h.snapshot.Store(emptySnapshot())
+	if guard() {
+		t.Fatal("reload accepted old evidence guard")
+	}
+	h.snapshot.Store(&Snapshot{records: []capabilityRecord{{}}})
+	if h.PreflightEvidenceGuard()() {
+		t.Fatal("nonempty host accepted")
+	}
+}
diff --git a/internal/pluginhost/snapshot.go b/internal/pluginhost/snapshot.go
index 85ae6d6..69a1d19 100644
--- a/internal/pluginhost/snapshot.go
+++ b/internal/pluginhost/snapshot.go
@@ -192,3 +192,10 @@ func cloneConfigFieldValue(value any) any {
 	visited := make(map[metadataCloneVisit]reflect.Value)
 	return cloneInterceptorMetadataAny(reflect.ValueOf(value), visited)
 }
+
+// PreflightEvidenceGuard accepts only an empty, unchanged plugin snapshot.
+// A reload creates a new snapshot, so load/unload during a request also rejects.
+func (h *Host) PreflightEvidenceGuard() func() bool {
+	snapshot := h.Snapshot()
+	return func() bool { return snapshot != nil && len(snapshot.records) == 0 && h.Snapshot() == snapshot }
+}
