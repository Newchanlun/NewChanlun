+		"data: " + `{"type":"response.output_item.done","output_index":1,"item":{"id":"msg_scsip","type":"message","role":"assistant","status":"completed","content":[{"type":"output_text","text":"VERDICT: PASS"}]}}` + "\n\n" +
+		"data: " + `{"type":"response.completed","response":{"id":"resp_scsip","status":"completed","model":"gpt-6.2-sol","output":[{"id":"ws_2","type":"web_search_call","status":"completed"},{"id":"msg_scsip","type":"message","role":"assistant","status":"completed","content":[{"type":"output_text","text":"VERDICT: PASS"}]}]}}` + "\n\n"
+	if st := runSSE(t, "review-d1111111-2222-4333-8444-5555555555bb", "019d0000-0000-7000-8000-8888888881bb", sseSubCompletedThenSnapInProg); st != SealRejected {
