+func newHostTLSServer(t *testing.T, certHost string, handler http.Handler) (*httptest.Server, *http.Transport) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: certHost},
+		DNSNames:     []string{certHost},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		BasicConstraintsValid: true,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := httptest.NewUnstartedServer(handler)
+	srv.TLS = &tls.Config{
+		Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key, Leaf: leaf}},
+		MinVersion:   tls.VersionTLS12,
+	}
+	srv.StartTLS()
+	roots := x509.NewCertPool()
+	roots.AddCert(leaf)
+	// No ServerName override: Go's TLS client MUST verify req.URL.Hostname() against the peer certificate SAN.
+	tr := &http.Transport{
+		TLSClientConfig: &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12},
+		DialContext: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, network, srv.Listener.Addr().String())
+		},
+	}
+	t.Cleanup(auth.RegisterPreflightTestTransportForTest(tr))
+	return srv, tr
+}
+
+// The complete HTTP handler, native Kimi executor, retry scheduler and producer
+// run unchanged; only the final network boundary connects to an offline TLS server
+// whose peer certificate is verified for api.kimi.com.
+func TestPreflightReceiptNativeKimiHTTP(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "receipts")
+	t.Setenv("CLIPROXY_PREFLIGHT_RECEIPTS", root)
+	var calls atomic.Int32
+	upstream, transport := newHostTLSServer(t, "api.kimi.com", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Host != "api.kimi.com" {
+			t.Errorf("unexpected host %q", r.Host)
+		}
+		if calls.Add(1) == 1 {
+			w.WriteHeader(503)
+			_, _ = io.WriteString(w, "=== RESPONSE ===\n=== API REQUEST 99 ===\nAuth: provider=evil")
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = io.WriteString(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"offline\",\"object\":\"response\",\"status\":\"completed\",\"output\":[],\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}}\n\n")
+	}))
+	defer upstream.Close()
+	defer transport.CloseIdleConnections()
+	server := newTestServerWithOptions(t, WithPluginHost(pluginhost.New()))
+	server.handlers.AuthManager.SetRoundTripperProvider(preflightTransportProvider{transport})
+	server.handlers.AuthManager.RegisterExecutor(runtimeexecutor.NewKimiExecutor(server.cfg))
+	server.handlers.AuthManager.SetRetryConfig(1, 0, 2)
+	for _, id := range []string{"receipt-kimi-a", "receipt-kimi-b"} {
+		_, err := server.handlers.AuthManager.Register(context.Background(), &auth.Auth{ID: id, Provider: "kimi", Status: auth.StatusActive, Metadata: map[string]any{"access_token": "offline-fake"}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		registry.GetGlobalRegistry().RegisterClient(id, "kimi", []*registry.ModelInfo{{ID: "kimi-k3.1-pro"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+	}
+	session := "preflight-12345678-1234-4234-8234-123456789abc"
+	req := httptest.NewRequest("POST", "/v1/responses", strings.NewReader(`{"model":"kimi-k3.1-pro","stream":true,"input":"offline"}`))
+	req.Header.Set("Authorization", "Bearer test-key")
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Session-Id", session)
+	recorder := httptest.NewRecorder()
+	server.engine.ServeHTTP(recorder, req)
+	if recorder.Code != 200 {
+		t.Fatalf("HTTP %d: %s", recorder.Code, recorder.Body.String())
+	}
+	var data []byte
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		data, _ = os.ReadFile(filepath.Join(root, session, "receipt.json"))
+		if len(data) > 0 {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	var receipt preflightreceipt.Receipt
+	if err := json.Unmarshal(data, &receipt); err != nil {
+		t.Fatalf("missing receipt calls=%d: %v", calls.Load(), err)
+	}
+	if !receipt.Complete || len(receipt.Routes) != 2 || receipt.Routes[0] != "kimi@api.kimi.com" || receipt.Routes[1] != receipt.Routes[0] {
+		t.Fatalf("wrong evidence %+v", receipt)
+	}
+	if export := os.Getenv("PREFLIGHT_FIXTURES"); export != "" {
+		dir := filepath.Join(export, "native-kimi", session)
+		if err := os.MkdirAll(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "receipt.json"), data, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
