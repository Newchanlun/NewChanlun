+			}
+			// Wait until the executor goroutine has read the frame from upstream, then cancel without receiving on out.
+			select {
+			case <-readDone:
+			case <-time.After(2 * time.Second):
+				t.Fatal("timed out waiting for executor to read turn 2 SSE body")
+			}
+			time.Sleep(15 * time.Millisecond)
+			cancelTurn2()
+			for range stream2.Chunks {
+			}
+			lease2.End()
+			c2.Complete(false)
+			c2.HandlerDone(false)
+
+			if st := preflightreceipt.SealReview(root, tc.launch, tc.session); st != preflightreceipt.SealRejected {
