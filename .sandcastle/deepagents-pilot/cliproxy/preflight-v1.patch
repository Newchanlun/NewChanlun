+func (t *strictStreamTracker) recordTextDelta(canonKey string, contentIdx int64, delta string) bool {
+	if canonKey == "" {
+		return true
+	}
+	if contentIdx < 0 || contentIdx >= int64(maxTrackedContentParts) {
+		return false
+	}
+	if parts := t.contentPartByItem[canonKey]; parts != nil {
+		if prevTag, finalized := parts[contentIdx]; finalized && prevTag != "text-pending" {
+			return false
+		}
+	}
+	hashes := t.textDeltaHashByItem[canonKey]
+	if hashes == nil {
+		if len(t.textDeltaHashByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.textDeltaHashByItem == nil {
+			t.textDeltaHashByItem = make(map[string]map[int64]*textDeltaState)
+		}
+		hashes = make(map[int64]*textDeltaState)
+		t.textDeltaHashByItem[canonKey] = hashes
+	}
+	st := hashes[contentIdx]
+	if st == nil {
+		if len(hashes) >= maxTrackedContentParts {
+			return false
+		}
+		st = &textDeltaState{h: sha256.New()}
+		hashes[contentIdx] = st
+	}
+	_, _ = st.h.Write([]byte(delta))
+	st.hasDelta = true
+	return true
+}
+
+func (t *strictStreamTracker) recordPendingTextPart(canonKey string, contentIdx int64) bool {
+	if canonKey == "" {
+		return true
+	}
+	if contentIdx < 0 || contentIdx >= int64(maxTrackedContentParts) {
+		return false
+	}
+	parts := t.contentPartByItem[canonKey]
+	if parts != nil {
+		if prevTag, exists := parts[contentIdx]; exists {
+			return prevTag == "text-pending" || strings.HasPrefix(prevTag, "text:")
+		}
+		if len(parts) >= maxTrackedContentParts {
+			return false
+		}
+	} else {
+		if len(t.contentPartByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.contentPartByItem == nil {
+			t.contentPartByItem = make(map[string]map[int64]string)
+		}
+		parts = make(map[int64]string)
+		t.contentPartByItem[canonKey] = parts
+	}
+	parts[contentIdx] = "text-pending"
+	return true
+}
+
+func (t *strictStreamTracker) recordContentPart(canonKey string, contentIdx int64, partType, text string) bool {
+	if canonKey == "" {
+		return true
+	}
+	if contentIdx < 0 || contentIdx >= int64(maxTrackedContentParts) {
+		return false
+	}
+	if hashes := t.textDeltaHashByItem[canonKey]; hashes != nil {
+		if st := hashes[contentIdx]; st != nil {
+			if partType != "output_text" || ((!st.fromSnapshot || st.hasDelta) && hex.EncodeToString(st.h.Sum(nil)) != sha256Hex(text)) {
+				return false
+			}
+		}
+	}
+	if prefixes := t.textPrefixByItem[canonKey]; prefixes != nil {
+		if pref, hasPref := prefixes[contentIdx]; hasPref {
+			if partType != "output_text" || len(text) < pref.byteLen || sha256Hex(text[:pref.byteLen]) != pref.sha256 {
+				return false
+			}
+		}
+	}
+	tag := contentPartTag(partType, text)
+	parts := t.contentPartByItem[canonKey]
+	if parts != nil {
+		if prevTag, exists := parts[contentIdx]; exists {
+			if prevTag == "text-pending" {
+				if partType != "output_text" {
+					return false
+				}
+				parts[contentIdx] = tag
+				return true
+			}
+			return prevTag == tag
+		}
+		if len(parts) >= maxTrackedContentParts {
+			return false
+		}
+	} else {
+		if len(t.contentPartByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.contentPartByItem == nil {
+			t.contentPartByItem = make(map[string]map[int64]string)
+		}
+		parts = make(map[int64]string)
+		t.contentPartByItem[canonKey] = parts
+	}
+	parts[contentIdx] = tag
+	return true
+}
+
+func (t *strictStreamTracker) resolvedKeyIndex(key string) (int64, bool) {
+	if strings.HasPrefix(key, "idx:") {
+		idx, err := strconv.ParseInt(strings.TrimPrefix(key, "idx:"), 10, 64)
+		return idx, err == nil
+	}
+	if strings.HasPrefix(key, "id:") {
+		idx, ok := t.itemIndexByID[strings.TrimPrefix(key, "id:")]
+		return idx, ok
+	}
+	return 0, false
+}
+
+func (t *strictStreamTracker) recomputeLastItemOutput() {
+	if t.responseID == "" {
+		t.lastItemOutputSHA = ""
+		t.lastItemResponseID = ""
+		return
+	}
+	allIndexed := t.pendingUnkeyed == 0 && t.streamedNonFinalUnkeyed == 0 && len(t.unkeyedDoneItems) == 0
+	if allIndexed {
+		for k := range t.doneItems {
+			if _, ok := t.resolvedKeyIndex(k); !ok {
+				allIndexed = false
+				break
+			}
+		}
+	}
+	if allIndexed {
+		for k := range t.pendingItems {
+			if _, ok := t.resolvedKeyIndex(k); !ok {
+				allIndexed = false
+				break
+			}
+		}
+	}
+	if allIndexed {
+		for k := range t.streamedNonFinalKeys {
+			if _, ok := t.resolvedKeyIndex(k); !ok {
+				allIndexed = false
+				break
+			}
+		}
+	}
+	if allIndexed {
+		hasMax := false
+		var maxIdx int64
+		var maxKey string
+		visit := func(k string) {
+			if idx, ok := t.resolvedKeyIndex(k); ok {
+				if !hasMax || idx > maxIdx {
+					hasMax = true
+					maxIdx = idx
+					maxKey = k
+				}
+			}
+		}
+		for k := range t.doneItems {
+			visit(k)
+		}
+		for k := range t.pendingItems {
+			visit(k)
+		}
+		for k := range t.streamedNonFinalKeys {
+			visit(k)
+		}
+		if hasMax {
+			if _, isPending := t.pendingItems[maxKey]; !isPending {
+				if _, isNonFinal := t.streamedNonFinalKeys[maxKey]; !isNonFinal {
+					if rec, isDone := t.doneItems[maxKey]; isDone && rec.isFinal && rec.outputTextSHA != "" {
+						t.lastItemOutputSHA = rec.outputTextSHA
+						t.lastItemResponseID = t.responseID
+						return
+					}
+				}
+			}
+		}
+		t.lastItemOutputSHA = ""
+		t.lastItemResponseID = ""
+		return
+	}
+	if len(t.pendingItems) > 0 || t.pendingUnkeyed > 0 {
+		t.lastItemOutputSHA = ""
+		t.lastItemResponseID = ""
+		return
+	}
+	hasMaxIdx := false
+	var maxIdx int64
+	hasMaxNonFinalIdx := false
+	var maxNonFinalIdx int64
+	for k := range t.doneItems {
+		if idx, ok := t.resolvedKeyIndex(k); ok {
+			if !hasMaxIdx || idx > maxIdx {
+				hasMaxIdx = true
+				maxIdx = idx
+			}
+		}
+	}
+	for k := range t.streamedNonFinalKeys {
+		if idx, ok := t.resolvedKeyIndex(k); ok {
+			if !hasMaxIdx || idx > maxIdx {
+				hasMaxIdx = true
+				maxIdx = idx
+			}
+			if !hasMaxNonFinalIdx || idx > maxNonFinalIdx {
+				hasMaxNonFinalIdx = true
+				maxNonFinalIdx = idx
+			}
+		}
+	}
+	bestSeq := 0
+	var bestRec doneItemSummary
+	foundBest := false
+	for k, rec := range t.doneItems {
+		s := rec.seq
+		if s == 0 {
+			s = t.itemSeqByKey[k]
+		}
+		if s > bestSeq {
+			bestSeq = s
+			bestRec = rec
+			foundBest = true
+		}
+	}
+	for _, rec := range t.unkeyedDoneItems {
+		if rec.seq > bestSeq {
+			bestSeq = rec.seq
+			bestRec = rec
+			foundBest = true
+		}
+	}
+	if !foundBest || bestSeq < t.maxItemSeq || bestSeq <= t.maxNonFinalSeq || !bestRec.isFinal || bestRec.outputTextSHA == "" {
+		t.lastItemOutputSHA = ""
+		t.lastItemResponseID = ""
+		return
+	}
+	if bestRec.hasOutputIndex {
+		if (hasMaxIdx && bestRec.outputIndex < maxIdx) || (hasMaxNonFinalIdx && bestRec.outputIndex <= maxNonFinalIdx) {
+			t.lastItemOutputSHA = ""
+			t.lastItemResponseID = ""
+			return
+		}
+	}
+	t.lastItemOutputSHA = bestRec.outputTextSHA
+	t.lastItemResponseID = t.responseID
+}
+
+func (t *strictStreamTracker) recordNonFinal(seq int, canonKey, itemID string, outputIndex int64, hasOutputIndex, countUnkeyed bool) bool {
+	if seq > t.maxNonFinalSeq {
+		t.maxNonFinalSeq = seq
+	}
+	if hasOutputIndex && (!t.hasMaxNonFinalOutputIndex || outputIndex > t.maxNonFinalOutputIndex) {
+		t.maxNonFinalOutputIndex = outputIndex
+		t.hasMaxNonFinalOutputIndex = true
+	}
+	if itemID != "" {
+		if _, exists := t.streamedNonFinalIDs[itemID]; !exists && len(t.streamedNonFinalIDs) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.streamedNonFinalIDs == nil {
+			t.streamedNonFinalIDs = make(map[string]struct{})
+		}
+		t.streamedNonFinalIDs[itemID] = struct{}{}
+	}
+	if canonKey != "" {
+		if _, exists := t.streamedNonFinalKeys[canonKey]; !exists && len(t.streamedNonFinalKeys) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.streamedNonFinalKeys == nil {
+			t.streamedNonFinalKeys = make(map[string]struct{})
+		}
+		t.streamedNonFinalKeys[canonKey] = struct{}{}
+	} else if countUnkeyed {
+		if t.streamedNonFinalUnkeyed >= maxTrackedOutputItems {
+			return false
+		}
+		t.streamedNonFinalUnkeyed++
+	}
+	return true
+}
