+	agedMarker, _ := json.Marshal(preflightReservationMarker{Schema: Schema, Session: failSess1, Started: ancient.UnixNano()})
+	_ = os.WriteFile(markerPath, agedMarker, 0600)
+	_ = os.Chtimes(markerPath, ancient, ancient)
