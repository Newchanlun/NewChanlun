+func (g *PendingReviewGuard) Release() {
+	if g == nil {
+		return
+	}
+	g.once.Do(func() {
+		reviewMu.Lock()
+		if pendingReviewTotal > 0 {
+			pendingReviewTotal--
+		}
+		if st := pendingReviewLaunches[g.key]; st != nil {
+			st.count--
+			if st.count <= 0 {
+				delete(pendingReviewLaunches, g.key)
+			}
+		}
+		reviewMu.Unlock()
+	})
+}
