+	// If taint disk write ALSO fails while ledger is full, ledger stays bounded AND taintWriteOverflow latches fail-closed.
+	t.Cleanup(func() {
+		reviewMu.Lock()
+		taintWriteOverflow = false
+		reviewMu.Unlock()
+	})
