+func TestPreflightReceiptReviewBodyTimeoutReleasesReservation(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("CLIPROXY_PREFLIGHT_RECEIPTS", root)
+
+	origBodyTimeout := preflightreceipt.ReviewBodyReadTimeout
+	origTurnTimeout := preflightreceipt.ReviewTurnTimeout
+	preflightreceipt.ReviewBodyReadTimeout = 150 * time.Millisecond
+	preflightreceipt.ReviewTurnTimeout = 5 * time.Second
+	defer func() {
+		preflightreceipt.ReviewBodyReadTimeout = origBodyTimeout
+		preflightreceipt.ReviewTurnTimeout = origTurnTimeout
+	}()
+
+	engine := gin.New()
+	engine.Use(PreflightReceipt())
+	engine.POST("/v1/responses", func(c *gin.Context) {
+		c.Status(http.StatusOK)
+	})
+	srv := httptest.NewServer(engine)
+	defer srv.Close()
+
+	launch := "review-12345678-1234-4234-8234-123456789401"
+	session := "019d0000-0000-7000-8000-000000000401"
+
+	// Open a raw TCP connection, send headers promising a 200-byte body, then stall without sending the body.
+	conn, err := net.DialTimeout("tcp", srv.Listener.Addr().String(), 2*time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	rawReq := "POST /v1/responses HTTP/1.1\r\n" +
+		"Host: " + srv.Listener.Addr().String() + "\r\n" +
+		"Content-Type: application/json\r\n" +
+		"Content-Length: 200\r\n" +
+		"Session-Id: " + session + "\r\n" +
+		preflightreceipt.ReviewHeader + ": " + launch + "\r\n\r\n" +
+		`{"model":"gpt-6.2-sol"`
+	if _, err := conn.Write([]byte(rawReq)); err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.SetReadDeadline(time.Now().Add(3 * time.Second))
+	resp, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	if err != nil {
+		t.Fatalf("expected timeout HTTP response from server, got err: %v", err)
+	}
+	_, _ = io.Copy(io.Discard, resp.Body)
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusRequestTimeout {
+		t.Fatalf("status = %d, want %d (408 Request Timeout)", resp.StatusCode, http.StatusRequestTimeout)
+	}
+
+	// Reservation MUST have been released (SealReview must NOT report SealInFlight) and launch tainted.
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		st := preflightreceipt.SealReview(root, launch, session)
+		if st == preflightreceipt.SealRejected {
+			break
+		}
+		if st != preflightreceipt.SealInFlight || time.Now().After(deadline) {
+			t.Fatalf("SealReview after body read timeout = %v, want SealRejected (reservation released)", st)
+		}
+		time.Sleep(15 * time.Millisecond)
+	}
+}
+
+func TestPreflightReceiptReviewTurnTimeoutReleasesReservation(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("CLIPROXY_PREFLIGHT_RECEIPTS", root)
+
+	origBodyTimeout := preflightreceipt.ReviewBodyReadTimeout
+	origTurnTimeout := preflightreceipt.ReviewTurnTimeout
+	preflightreceipt.ReviewBodyReadTimeout = 2 * time.Second
+	preflightreceipt.ReviewTurnTimeout = 150 * time.Millisecond
+	defer func() {
+		preflightreceipt.ReviewBodyReadTimeout = origBodyTimeout
+		preflightreceipt.ReviewTurnTimeout = origTurnTimeout
+	}()
+
+	handlerCanceled := make(chan error, 1)
+	engine := gin.New()
+	engine.Use(PreflightReceipt())
+	engine.POST("/v1/responses", func(c *gin.Context) {
+		col := preflightreceipt.From(c.Request.Context())
+		if col == nil {
+			handlerCanceled <- errors.New("missing collector in review context")
+			c.Status(http.StatusInternalServerError)
+			return
+		}
+		<-c.Request.Context().Done()
+		handlerCanceled <- c.Request.Context().Err()
+		col.Complete(false)
+		c.Status(http.StatusGatewayTimeout)
+	})
+	srv := httptest.NewServer(engine)
+	defer srv.Close()
+
+	launch := "review-12345678-1234-4234-8234-123456789402"
+	session := "019d0000-0000-7000-8000-000000000402"
+	body := `{"model":"gpt-6.2-sol","stream":true}`
+	req, err := http.NewRequest(http.MethodPost, srv.URL+"/v1/responses", bytes.NewBufferString(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Session-Id", session)
+	req.Header.Set(preflightreceipt.ReviewHeader, launch)
+
+	client := &http.Client{Timeout: 3 * time.Second}
+	resp, err := client.Do(req)
+	if err != nil {
+		if !strings.Contains(err.Error(), "EOF") && !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("unexpected client err: %v", err)
+		}
+	} else {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}
+
+	select {
+	case cerr := <-handlerCanceled:
+		if !errors.Is(cerr, context.DeadlineExceeded) {
+			t.Fatalf("handler ctx err = %v, want context.DeadlineExceeded", cerr)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("downstream review handler context was not canceled by ReviewTurnTimeout")
+	}
+
+	// Reservation MUST be released so SealReview does not remain stuck at SealInFlight.
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		st := preflightreceipt.SealReview(root, launch, session)
+		if st == preflightreceipt.SealRejected {
+			break
+		}
+		if st != preflightreceipt.SealInFlight || time.Now().After(deadline) {
+			t.Fatalf("SealReview after turn timeout = %v, want SealRejected (reservation released)", st)
+		}
+		time.Sleep(15 * time.Millisecond)
+	}
+}
+
+type mustNotReadBody struct {
+	readCalled atomic.Bool
+}
+
+func (b *mustNotReadBody) Read(_ []byte) (int, error) {
+	b.readCalled.Store(true)
+	return 0, io.EOF
+}
+
+func (b *mustNotReadBody) Close() error { return nil }
+
+func TestPreflightReceiptMiddlewareRejectsUnsupportedSetReadDeadlineBeforeReadingBody(t *testing.T) {
+	// Sol P2 #4 + Astra P2 #4 (PR #2280 R14): when ResponseWriter does not support SetReadDeadline,
+	// fail closed (503 + taint + release reservation) BEFORE reading Request.Body so no reader goroutine leaks.
+	gin.SetMode(gin.TestMode)
+	root := t.TempDir() + "/receipts"
+	t.Setenv("CLIPROXY_PREFLIGHT_RECEIPTS", root)
+
+	engine := gin.New()
+	engine.Use(PreflightReceipt())
+	engine.POST("/v1/responses", func(c *gin.Context) {
+		c.Status(http.StatusOK)
+	})
+
+	body := &mustNotReadBody{}
+	launch := "review-12345678-1234-4234-8234-123456789403"
+	session := "019d0000-0000-7000-8000-000000000403"
+	req := httptest.NewRequest(http.MethodPost, "/v1/responses", body)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Session-Id", session)
+	req.Header.Set(preflightreceipt.ReviewHeader, launch)
+
+	rec := httptest.NewRecorder()
+	engine.ServeHTTP(rec, req)
+	if rec.Code != http.StatusServiceUnavailable {
+		t.Fatalf("status = %d, want %d (503 Service Unavailable)", rec.Code, http.StatusServiceUnavailable)
+	}
+	if rec.Header().Get("Connection") != "close" {
+		t.Fatalf("Connection header = %q, want close", rec.Header().Get("Connection"))
+	}
+	if body.readCalled.Load() {
+		t.Fatalf("middleware read request body despite SetReadDeadline being unsupported")
+	}
+	if st := preflightreceipt.SealReview(root, launch, session); st != preflightreceipt.SealRejected {
+		t.Fatalf("SealReview after unsupported SetReadDeadline = %v, want SealRejected (reservation released)", st)
+	}
+}
+
+type readOnlyDeadlineRecorder struct {
+	*httptest.ResponseRecorder
+}
+
+func (r *readOnlyDeadlineRecorder) SetReadDeadline(time.Time) error { return nil }
+
+func TestPreflightReceiptMiddlewareRejectsUnsupportedSetWriteDeadlineBeforeReadingBody(t *testing.T) {
+	// Sol P2 #1 + Astra P2 #3 (PR #2280 R16): when ResponseWriter supports SetReadDeadline but NOT
+	// SetWriteDeadline, fail closed (503 + taint + release reservation) BEFORE reading body or streaming.
+	gin.SetMode(gin.TestMode)
+	root := t.TempDir() + "/receipts"
+	t.Setenv("CLIPROXY_PREFLIGHT_RECEIPTS", root)
+
+	handlerCalled := atomic.Bool{}
+	engine := gin.New()
+	engine.Use(PreflightReceipt())
+	engine.POST("/v1/responses", func(c *gin.Context) {
+		handlerCalled.Store(true)
+		c.Status(http.StatusOK)
+	})
+
+	body := &mustNotReadBody{}
+	launch := "review-12345678-1234-4234-8234-123456789404"
+	session := "019d0000-0000-7000-8000-000000000404"
+	req := httptest.NewRequest(http.MethodPost, "/v1/responses", body)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Session-Id", session)
+	req.Header.Set(preflightreceipt.ReviewHeader, launch)
+
+	rec := &readOnlyDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+	engine.ServeHTTP(rec, req)
+	if rec.Code != http.StatusServiceUnavailable {
+		t.Fatalf("status = %d, want %d (503 Service Unavailable)", rec.Code, http.StatusServiceUnavailable)
+	}
+	if rec.Header().Get("Connection") != "close" {
+		t.Fatalf("Connection header = %q, want close", rec.Header().Get("Connection"))
+	}
+	if body.readCalled.Load() || handlerCalled.Load() {
+		t.Fatalf("middleware read body (%v) or ran handler (%v) despite unsupported SetWriteDeadline",
+			body.readCalled.Load(), handlerCalled.Load())
+	}
+	if st := preflightreceipt.SealReview(root, launch, session); st != preflightreceipt.SealRejected {
+		t.Fatalf("SealReview after unsupported SetWriteDeadline = %v, want SealRejected", st)
+	}
+}
+
+type fullDeadlineRecorder struct {
+	*httptest.ResponseRecorder
+}
+
+func (r *fullDeadlineRecorder) SetReadDeadline(time.Time) error  { return nil }
+func (r *fullDeadlineRecorder) SetWriteDeadline(time.Time) error { return nil }
+
+type middlewareFakeRT func(*http.Request) (*http.Response, error)
+
+func (f middlewareFakeRT) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func middlewareVerifiedTLS(t *testing.T, host string) *tls.ConnectionState {
+	t.Helper()
+	priv, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: host},
+		DNSNames:     []string{host},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &priv.PublicKey, priv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &tls.ConnectionState{
+		HandshakeComplete: true,
+		ServerName:        host,
+		VerifiedChains:    [][]*x509.Certificate{{cert}},
+	}
+}
+
+type blockingReviewBody struct {
+	entered chan struct{}
+	release chan struct{}
+	once    sync.Once
+	reader  *strings.Reader
+}
+
+func (b *blockingReviewBody) Read(p []byte) (int, error) {
+	b.once.Do(func() {
+		close(b.entered)
+		<-b.release
+	})
+	return b.reader.Read(p)
+}
+
+func (b *blockingReviewBody) Close() error { return nil }
+
+func TestPreflightReceiptMiddlewareExistingLaunchEnforcesBodyReadCapAndRecordsFailedTurn(t *testing.T) {
+	// Sol P1 #1 + P2 #1 & Astra P1 #1 + P2 #1 (PR #2280 R30):
+	// 1. An existing untainted launch rejected at the global BeginPendingReview cap MUST record a failed
+	//    follow-up turn atomically so SealReview cannot seal stale Turn 1 until a clean retry succeeds.
+	// 2. An existing launch MUST hold its BeginPendingReview slot until ExtractInboundReviewModel finishes
+	//    so concurrent body reads on the same existing launch cannot bypass the 32-reader global cap.
+	gin.SetMode(gin.TestMode)
+	root := t.TempDir() + "/receipts"
+	t.Setenv("CLIPROXY_PREFLIGHT_RECEIPTS", root)
+	tlsState := middlewareVerifiedTLS(t, "chatgpt.com")
+
+	var turnCounter atomic.Int32
+	engine := gin.New()
+	engine.Use(PreflightReceipt())
+	engine.POST("/v1/responses", func(c *gin.Context) {
+		col := preflightreceipt.From(c.Request.Context())
+		if col == nil {
+			c.AbortWithStatus(http.StatusInternalServerError)
+			return
+		}
+		ctx, execLease, err := col.Start(c.Request.Context(), "codex", "gpt-6.2-sol")
+		if err != nil {
+			c.AbortWithStatus(http.StatusInternalServerError)
+			return
+		}
+		cl := httptransport.Decorate(ctx, &http.Client{Transport: middlewareFakeRT(func(r *http.Request) (*http.Response, error) {
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Header:     make(http.Header),
+				Body:       io.NopCloser(strings.NewReader("")),
+				TLS:        tlsState,
+			}, nil
+		})})
+		upReq, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		resp, err := cl.Do(upReq)
+		if err != nil {
+			execLease.End()
+			col.Complete(false)
+			c.AbortWithStatus(http.StatusInternalServerError)
+			return
+		}
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+		n := turnCounter.Add(1)
+		col.ObserveStreamChunk([]byte("data: " + fmt.Sprintf(`{"type":"response.completed","response":{"id":"resp_mw_cap_%d","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","status":"completed","content":[{"type":"output_text","text":"VERDICT: PASS %d"}]}]}}`, n, n) + "\n\n"))
+		execLease.End()
+		col.Complete(true)
+		c.Status(http.StatusOK)
+	})
+
+	runCleanTurn := func(launch, session string) int {
+		req := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Session-Id", session)
+		req.Header.Set(preflightreceipt.ReviewHeader, launch)
+		rec := &fullDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+		engine.ServeHTTP(rec, req)
+		return rec.Code
+	}
+
+	// Part 1: existing launch rejected with 503 at global BeginPendingReview cap cannot seal stale Turn 1.
+	launch1 := "review-12345678-1234-4234-8234-123456789501"
+	session1 := "019d0000-0000-7000-8000-000000000501"
+	if code := runCleanTurn(launch1, session1); code != http.StatusOK {
+		t.Fatalf("launch1 turn 1 HTTP %d, want 200", code)
+	}
+	guards := make([]*preflightreceipt.PendingReviewGuard, 0, 32)
+	for i := 0; i < 32; i++ {
+		other := fmt.Sprintf("review-22345678-1234-4234-8234-1234567895%02d", i)
+		g, err := preflightreceipt.BeginPendingReview(root, other)
+		if err != nil {
+			for _, held := range guards {
+				held.Release()
+			}
+			t.Fatalf("fill pending slot %d: %v", i, err)
+		}
+		guards = append(guards, g)
+	}
+	bodyRejected := &mustNotReadBody{}
+	reqCap := httptest.NewRequest(http.MethodPost, "/v1/responses", bodyRejected)
+	reqCap.Header.Set("Content-Type", "application/json")
+	reqCap.Header.Set("Session-Id", session1)
+	reqCap.Header.Set(preflightreceipt.ReviewHeader, launch1)
+	recCap := &fullDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+	engine.ServeHTTP(recCap, reqCap)
+	for _, held := range guards {
+		held.Release()
+	}
+	if recCap.Code != http.StatusServiceUnavailable || bodyRejected.readCalled.Load() {
+		t.Fatalf("cap-rejected turn = (status=%d, readBody=%v), want (503, false)", recCap.Code, bodyRejected.readCalled.Load())
+	}
+	if st, digest := preflightreceipt.SealReviewWithDigest(root, launch1, session1); st != preflightreceipt.SealRejected || digest != "" {
+		t.Fatalf("SealReviewWithDigest after cap-rejected follow-up = (%v, %q), want (SealRejected, \"\")", st, digest)
+	}
+	if code := runCleanTurn(launch1, session1); code != http.StatusOK {
+		t.Fatalf("launch1 clean retry turn HTTP %d, want 200", code)
+	}
+	if st, digest := preflightreceipt.SealReviewWithDigest(root, launch1, session1); st != preflightreceipt.SealOK || digest == "" {
+		t.Fatalf("SealReviewWithDigest after clean retry = (%v, %q), want (SealOK, non-empty)", st, digest)
+	}
+
+	// Part 2: 32 concurrent body reads on the SAME existing launch saturate the global cap so #33 gets 503 before Read().
+	launch2 := "review-12345678-1234-4234-8234-123456789502"
+	session2 := "019d0000-0000-7000-8000-000000000502"
+	if code := runCleanTurn(launch2, session2); code != http.StatusOK {
+		t.Fatalf("launch2 turn 1 HTTP %d, want 200", code)
+	}
+	release := make(chan struct{})
+	entered := make([]chan struct{}, 32)
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		ch := make(chan struct{})
+		entered[i] = ch
+		wg.Add(1)
+		go func(ent chan struct{}) {
+			defer wg.Done()
+			b := &blockingReviewBody{
+				entered: ent,
+				release: release,
+				reader:  strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`),
+			}
+			req := httptest.NewRequest(http.MethodPost, "/v1/responses", b)
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set("Session-Id", session2)
+			req.Header.Set(preflightreceipt.ReviewHeader, launch2)
+			rec := &fullDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+			engine.ServeHTTP(rec, req)
+		}(ch)
+	}
+	for i, ch := range entered {
+		select {
+		case <-ch:
+		case <-time.After(5 * time.Second):
+			close(release)
+			wg.Wait()
+			t.Fatalf("concurrent body reader %d on existing launch did not enter Read()", i)
+		}
+	}
+	body33 := &mustNotReadBody{}
+	req33 := httptest.NewRequest(http.MethodPost, "/v1/responses", body33)
+	req33.Header.Set("Content-Type", "application/json")
+	req33.Header.Set("Session-Id", session2)
+	req33.Header.Set(preflightreceipt.ReviewHeader, launch2)
+	rec33 := &fullDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+	engine.ServeHTTP(rec33, req33)
+	close(release)
+	wg.Wait()
+	if rec33.Code != http.StatusServiceUnavailable || body33.readCalled.Load() {
+		t.Fatalf("33rd concurrent request on existing launch = (status=%d, readBody=%v), want (503, false)", rec33.Code, body33.readCalled.Load())
+	}
+
+	// Part 3 (Sol P1 #1 + Astra P1 #1): earlier Request A reading body on existing launch MUST NOT clear
+	// later cap-rejected Request B's failure; SealReview stays SealRejected until fresh retry Request C succeeds.
+	launch3 := "review-12345678-1234-4234-8234-123456789503"
+	session3 := "019d0000-0000-7000-8000-000000000503"
+	if code := runCleanTurn(launch3, session3); code != http.StatusOK {
+		t.Fatalf("launch3 turn 1 HTTP %d, want 200", code)
+	}
+	entA := make(chan struct{})
+	relA := make(chan struct{})
+	doneA := make(chan int, 1)
+	go func() {
+		b := &blockingReviewBody{entered: entA, release: relA, reader: strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`)}
+		req := httptest.NewRequest(http.MethodPost, "/v1/responses", b)
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Session-Id", session3)
+		req.Header.Set(preflightreceipt.ReviewHeader, launch3)
+		rec := &fullDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+		engine.ServeHTTP(rec, req)
+		doneA <- rec.Code
+	}()
+	<-entA
+	fill31 := make([]*preflightreceipt.PendingReviewGuard, 0, 31)
+	for i := 0; i < 31; i++ {
+		other := fmt.Sprintf("review-32345678-1234-4234-8234-1234567895%02d", i)
+		g, err := preflightreceipt.BeginPendingReview(root, other)
+		if err != nil {
+			close(relA)
+			for _, h := range fill31 {
+				h.Release()
+			}
+			t.Fatalf("fill 31 slots (%d): %v", i, err)
+		}
+		fill31 = append(fill31, g)
+	}
+	// Request B arrives AFTER A, hits the 32-slot cap -> 503 and records failedTurnSeq > A.turnSeq.
+	bodyB := &mustNotReadBody{}
+	reqB := httptest.NewRequest(http.MethodPost, "/v1/responses", bodyB)
+	reqB.Header.Set("Content-Type", "application/json")
+	reqB.Header.Set("Session-Id", session3)
+	reqB.Header.Set(preflightreceipt.ReviewHeader, launch3)
+	recB := &fullDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+	engine.ServeHTTP(recB, reqB)
+	for _, h := range fill31 {
+		h.Release()
+	}
+	close(relA)
+	codeA := <-doneA
+	if recB.Code != http.StatusServiceUnavailable || bodyB.readCalled.Load() || codeA != http.StatusOK {
+		t.Fatalf("part 3 race = (B=%d readB=%v A=%d), want (503, false, 200)", recB.Code, bodyB.readCalled.Load(), codeA)
+	}
+	if st, digest := preflightreceipt.SealReviewWithDigest(root, launch3, session3); st != preflightreceipt.SealRejected || digest != "" {
+		t.Fatalf("SealReviewWithDigest after earlier A finished post-B failure = (%v, %q), want (SealRejected, \"\")", st, digest)
+	}
+	if code := runCleanTurn(launch3, session3); code != http.StatusOK {
+		t.Fatalf("launch3 fresh retry C HTTP %d, want 200", code)
+	}
+	if st, digest := preflightreceipt.SealReviewWithDigest(root, launch3, session3); st != preflightreceipt.SealOK || digest == "" {
+		t.Fatalf("SealReviewWithDigest after fresh retry C = (%v, %q), want (SealOK, non-empty)", st, digest)
+	}
+
+	// Part 4 (Astra P1 #2): brand-new launch Request A reading body inherits later cap-rejected Request B's
+	// failure without allocating a disk directory when B is rejected.
+	launch4 := "review-12345678-1234-4234-8234-123456789504"
+	session4 := "019d0000-0000-7000-8000-000000000504"
+	ent4A := make(chan struct{})
+	rel4A := make(chan struct{})
+	done4A := make(chan int, 1)
+	go func() {
+		b := &blockingReviewBody{entered: ent4A, release: rel4A, reader: strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`)}
+		req := httptest.NewRequest(http.MethodPost, "/v1/responses", b)
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Session-Id", session4)
+		req.Header.Set(preflightreceipt.ReviewHeader, launch4)
+		rec := &fullDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+		engine.ServeHTTP(rec, req)
+		done4A <- rec.Code
+	}()
+	<-ent4A
+	fill4 := make([]*preflightreceipt.PendingReviewGuard, 0, 31)
+	for i := 0; i < 31; i++ {
+		other := fmt.Sprintf("review-42345678-1234-4234-8234-1234567895%02d", i)
+		g, err := preflightreceipt.BeginPendingReview(root, other)
+		if err != nil {
+			close(rel4A)
+			for _, h := range fill4 {
+				h.Release()
+			}
+			t.Fatalf("part 4 fill (%d): %v", i, err)
+		}
+		fill4 = append(fill4, g)
+	}
+	body4B := &mustNotReadBody{}
+	req4B := httptest.NewRequest(http.MethodPost, "/v1/responses", body4B)
+	req4B.Header.Set("Content-Type", "application/json")
+	req4B.Header.Set("Session-Id", session4)
+	req4B.Header.Set(preflightreceipt.ReviewHeader, launch4)
+	rec4B := &fullDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+	engine.ServeHTTP(rec4B, req4B)
+	if _, statErr := os.Stat(root + "/" + launch4); !os.IsNotExist(statErr) {
+		for _, h := range fill4 {
+			h.Release()
+		}
+		close(rel4A)
+		t.Fatalf("cap-rejected brand-new launch B created disk directory: %v", statErr)
+	}
+	for _, h := range fill4 {
+		h.Release()
+	}
+	close(rel4A)
+	code4A := <-done4A
+	if rec4B.Code != http.StatusServiceUnavailable || body4B.readCalled.Load() || code4A != http.StatusOK {
+		t.Fatalf("part 4 brand-new race = (B=%d readB=%v A=%d), want (503, false, 200)", rec4B.Code, body4B.readCalled.Load(), code4A)
+	}
+	if st, digest := preflightreceipt.SealReviewWithDigest(root, launch4, session4); st != preflightreceipt.SealRejected || digest != "" {
+		t.Fatalf("SealReviewWithDigest brand-new launch4 after A completed post-B rejection = (%v, %q), want (SealRejected, \"\")", st, digest)
+	}
+	if code := runCleanTurn(launch4, session4); code != http.StatusOK {
+		t.Fatalf("launch4 fresh retry C HTTP %d, want 200", code)
+	}
+	if st, digest := preflightreceipt.SealReviewWithDigest(root, launch4, session4); st != preflightreceipt.SealOK || digest == "" {
+		t.Fatalf("SealReviewWithDigest brand-new launch4 after retry C = (%v, %q), want (SealOK, non-empty)", st, digest)
+	}
+
+	// Part 5 (Sol P1 #2 + Astra P2 #3): real HTTP/1.1 server MUST send 503 + Connection: close immediately
+	// and close the TCP connection without draining an unread slow 1 MiB body when the 32-slot cap is saturated.
+	srv := httptest.NewServer(engine)
+	defer srv.Close()
+	fill5 := make([]*preflightreceipt.PendingReviewGuard, 0, 32)
+	for i := 0; i < 32; i++ {
+		other := fmt.Sprintf("review-52345678-1234-4234-8234-1234567895%02d", i)
+		g, err := preflightreceipt.BeginPendingReview(root, other)
+		if err != nil {
+			for _, h := range fill5 {
+				h.Release()
+			}
+			t.Fatalf("part 5 fill (%d): %v", i, err)
+		}
+		fill5 = append(fill5, g)
+	}
+	defer func() {
+		for _, h := range fill5 {
+			h.Release()
+		}
+	}()
+	conn, err := net.DialTimeout("tcp", srv.Listener.Addr().String(), 2*time.Second)
+	if err != nil {
+		t.Fatalf("dial httptest server: %v", err)
+	}
+	defer func() { _ = conn.Close() }()
+	_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+	rawReq := "POST /v1/responses HTTP/1.1\r\n" +
+		"Host: " + srv.Listener.Addr().String() + "\r\n" +
+		"Content-Type: application/json\r\n" +
+		"Content-Length: 1048576\r\n" +
+		"Session-Id: 019d0000-0000-7000-8000-000000000505\r\n" +
+		preflightreceipt.ReviewHeader + ": review-12345678-1234-4234-8234-123456789505\r\n" +
+		"\r\n"
+	if _, err := io.WriteString(conn, rawReq); err != nil {
+		t.Fatalf("write headers: %v", err)
+	}
+	respBytes, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatalf("read 503 + EOF from server (slow body must not stall): %v", err)
+	}
+	respStr := string(respBytes)
+	if !strings.HasPrefix(respStr, "HTTP/1.1 503 ") || !strings.Contains(strings.ToLower(respStr), "connection: close") {
+		t.Fatalf("unexpected HTTP/1.1 cap-rejection response: %q", respStr)
+	}
+}
