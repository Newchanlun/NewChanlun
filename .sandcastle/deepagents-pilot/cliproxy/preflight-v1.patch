+func TestReviewReceiptInvalidateDoesNotTruncateSymlinkTarget(t *testing.T) {
+	// Astra P1 #4 (PR #2280 R1): invalidateDiskReceiptLocked must unlink receipt.json directly
+	// without calling os.Truncate, so a symlinked receipt.json never truncates its target file.
+	base := t.TempDir()
+	root := filepath.Join(base, "receipts")
