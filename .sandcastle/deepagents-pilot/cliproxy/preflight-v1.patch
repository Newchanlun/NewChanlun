+	c2.ObserveStreamChunk(raw2)
+	_ = resp2.Body.Close()
+	e2.End()
+	c2.Complete(true)
+	c2.HandlerDone(true)
+	if st := SealReview(root, launchErr, sessionErr); st != SealRejected {
