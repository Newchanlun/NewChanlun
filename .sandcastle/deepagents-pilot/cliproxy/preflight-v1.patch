+	_ = os.Chtimes(badSealFile, ancient, ancient)
+	_ = os.Chtimes(badSealDir, ancient, ancient)
+	if _, ok := inspectProducerReceiptDir(badSealDir, badSealLaunch, true); ok {
+		t.Fatalf("inspectProducerReceiptDir accepted seal.sha256 with trailing newline (>64 bytes)")
+	}
+
+	// Sol P1 #2 + Astra P2 #4 (PR #2280 R35): failed/disconnected legacy preflight writes producer.json
+	// (no receipt.json), allowing bounded reclamation once past preflightDiskRetention.
+	failRoot := filepath.Join(t.TempDir(), "failed-preflight-reclaim")
+	maxPreflightDiskEntries = 1
+	failSess1 := "preflight-22222222-2222-4333-8444-555555555501"
+	ctxF, cF, err := Begin(context.Background(), failRoot, failSess1)
