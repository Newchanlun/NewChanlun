+// Deadline returns the launch's absolute MaxReviewDuration expiration time (or zero if unbounded).
+func (r *ReviewReservation) Deadline() time.Time {
+	if r == nil || r.entry == nil {
+		return time.Time{}
+	}
+	r.entry.mu.Lock()
+	started := r.entry.started
+	r.entry.mu.Unlock()
+	if started <= 0 {
+		return time.Time{}
+	}
+	return time.Unix(0, started).Add(MaxReviewDuration)
