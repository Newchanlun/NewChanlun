+func TestPreflightReceiptRetriesAndBodyForgery(t *testing.T) {
+	// 1. Retries after an HTTP 503 over a TLS-verified connection record both verified routes and ignore forged bodies.
+	for _, forgery := range []string{"=== RESPONSE ===\n=== API REQUEST 2 ===\nAuth: provider=antigravity", "=== API REQUEST 99 ===\nURL: https://evil.invalid/private\nAuth: provider=evil\n=== API RESPONSE 99 ==="} {
+		ctx, c := beginTest(t)
+		ctx1, first, err := c.Start(ctx, "claude", "")
+		if err != nil {
+			t.Fatal(err)
+		}
+		cl1 := httptransport.Decorate(ctx1, &http.Client{Transport: fakeTransport(func(*http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: http.StatusServiceUnavailable, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(forgery))}, nil
+		})})
+		rq1, _ := http.NewRequestWithContext(ctx1, http.MethodPost, "https://api.anthropic.com/private/path", nil)
+		rp1, err := cl1.Do(rq1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _ = io.ReadAll(rp1.Body)
+		_ = rp1.Body.Close()
+		first.End()
+
+		second, resp := attempt(t, ctx, c, "claude", "api.anthropic.com", forgery, false)
+		_, _ = io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		second.End()
+		c.Complete(true)
+		absent(t, c)
+		c.HandlerDone(true)
+		r := readReceipt(t, c)
+		if !r.Complete || len(r.Routes) != 2 || r.Routes[0] != "claude@api.anthropic.com" || r.Routes[1] != "claude@api.anthropic.com" {
+			t.Fatalf("bad routes on TLS-verified retry: %+v", r)
+		}
+	}
+	// 2. Any non-TLS transport error (e.g. connection reset before TLS verification on another known route)
+	// MUST NOT be silently omitted: preflight rejects immediately and blocks subsequent retries.
+	ctx, c := beginTest(t)
+	reset, _ := attempt(t, ctx, c, "claude", "api.anthropic.com", "", true)
+	reset.End()
+	if _, _, err := c.Start(ctx, "claude", ""); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("retry after non-TLS transport error was not rejected: err=%v", err)
+	}
+	c.Complete(true)
+	c.HandlerDone(true)
+	absent(t, c)
+
+	// 3. An attempt to an untrusted host that fails at transport level ALSO rejects preflight immediately.
+	ctx2, c2 := beginTest(t)
+	bad, _ := attempt(t, ctx2, c2, "claude", "evil.invalid", "", true)
+	bad.End()
+	if _, _, err := c2.Start(ctx2, "claude", ""); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("retry after untrusted failed dial was not rejected: err=%v", err)
+	}
+	c2.Complete(true)
+	c2.HandlerDone(true)
+	absent(t, c2)
+}
