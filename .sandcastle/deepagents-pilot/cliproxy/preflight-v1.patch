+		// 1) sealStageFD/seal.pending.json -> launchDirFD/seal.pending.json
+		// 2) sealStageFD/seal.sha256 -> launchDirFD/seal.sha256
+		// 3) launchDirFD/seal.pending.json -> launchDirFD/receipt.json
+		if err := renameatPinned(sealStageFD, "seal.pending.json", launchDirFD, "seal.pending.json"); err != nil {
