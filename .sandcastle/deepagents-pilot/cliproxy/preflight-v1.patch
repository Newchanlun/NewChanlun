+func TestReviewReceiptStaleOrTaintedPersistPreservesSealedAndForeignDisk(t *testing.T) {
+	// Sol P1 #1 + Astra P1 #2 (PR #2280 R36):
+	// 1. Even when e.tainted == true, persistWithStatusLocked MUST validate on-disk receipt.json under
+	//    the root lock and preserve a sealed or foreign receipt untouched (never overwriting/unlinking).
+	// 2. When pre-seal disk inspection detects foreign/unexpected content, SealReviewWithDigest MUST
+	//    return SealRejected without overwriting or deleting the foreign file.
+	root := filepath.Join(t.TempDir(), "receipts")
+
+	// Case A: Stale in-memory tainted entry vs sealed receipt + seal.sha256 on disk.
+	launchA := "review-f2222222-2222-4333-8444-555555555501"
+	sessionA := "019d0000-0000-7000-8000-999999999601"
+	resA, err := ReserveReview(root, launchA)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resA.Release()
+	keyA := filepath.Clean(root) + "\x00" + launchA
+	reviewMu.Lock()
+	staleEntry := reviewLedger[keyA]
+	reviewMu.Unlock()
+	if staleEntry == nil {
+		t.Fatal("missing ledger entry for launchA")
+	}
+
+	now := time.Now().UnixNano()
+	sealedRec := ReviewReceipt{
+		Schema:           ReviewSchema,
+		Launch:           launchA,
+		Session:          sessionA,
+		Started:          now - int64(time.Second),
+		Finished:         now,
+		SealedAt:         now,
+		Complete:         true,
+		Sealed:           true,
+		Tainted:          false,
+		Requests:         1,
+		Routes:           []string{"codex:gpt-6.2-sol@chatgpt.com"},
+		ResponseIDSHAs:   []string{sha256Hex("resp_sealed_disk")},
+		LastResponseID:   sha256Hex("resp_sealed_disk"),
+		LastOutputSHA256: sha256Hex("VERDICT: PASS"),
+	}
+	sealedRaw, err := json.Marshal(sealedRec)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sealedDigest := sha256Hex(string(sealedRaw))
+	dirA := filepath.Join(root, launchA)
+	recPathA := filepath.Join(dirA, "receipt.json")
+	sealPathA := filepath.Join(dirA, "seal.sha256")
+	if err := os.WriteFile(recPathA, sealedRaw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(sealPathA, []byte(sealedDigest), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	// Attempt to persist taint via the stale unsealed entry -> MUST preserve both files untouched.
+	staleEntry.mu.Lock()
+	staleEntry.taintAndPersistLocked()
+	preservedForeign := staleEntry.foreignDisk && staleEntry.taintedPersisted
+	staleEntry.mu.Unlock()
+	if !preservedForeign {
+		t.Fatalf("stale tainted entry did not latch foreignDisk + taintedPersisted")
+	}
+	gotRecA, err := os.ReadFile(recPathA)
+	if err != nil || string(gotRecA) != string(sealedRaw) {
+		t.Fatalf("sealed receipt.json was clobbered by stale tainted entry: err=%v raw=%q", err, string(gotRecA))
+	}
+	gotSealA, err := os.ReadFile(sealPathA)
+	if err != nil || string(gotSealA) != sealedDigest {
+		t.Fatalf("seal.sha256 was clobbered by stale tainted entry: err=%v raw=%q", err, string(gotSealA))
+	}
+
+	// Case B: Foreign receipt substituted before SealReviewWithDigest -> SealRejected AND foreign bytes preserved.
+	launchB := "review-f2222222-2222-4333-8444-555555555502"
+	sessionB := "019d0000-0000-7000-8000-999999999602"
+	ctxB, cB, err := BeginReview(context.Background(), root, launchB, sessionB, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctxB, eB, err := cB.Start(ctxB, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	clB := httptransport.Decorate(ctxB, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("")), TLS: verifiedTLSState("chatgpt.com")}, nil
+	})})
+	reqB, _ := http.NewRequestWithContext(ctxB, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	respB, err := clB.Do(reqB)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = io.Copy(io.Discard, respB.Body)
+	_ = respB.Body.Close()
+	cB.ObserveStreamChunk([]byte("data: " + `{"type":"response.completed","response":{"id":"resp_foreign_b","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"VERDICT: PASS"}]}]}}` + "\n\n"))
+	eB.End()
+	cB.Complete(true)
+	cB.HandlerDone(true)
+
+	recPathB := filepath.Join(root, launchB, "receipt.json")
+	foreignB := `{"custom_app":"keep-me","owner":"external"}`
+	if err := os.WriteFile(recPathB, []byte(foreignB), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if st, digest := SealReviewWithDigest(root, launchB, sessionB); st != SealRejected || digest != "" {
+		t.Fatalf("SealReviewWithDigest with substituted foreign receipt = (%v, %q), want (SealRejected, \"\")", st, digest)
+	}
+	if gotB, err := os.ReadFile(recPathB); err != nil || string(gotB) != foreignB {
+		t.Fatalf("SealReviewWithDigest overwrote/unlinked substituted foreign receipt: err=%v raw=%q", err, string(gotB))
+	}
+}
