+}
+
+func (r *ReviewReservation) SetTurnSeq(seq uint64) {
+	if r == nil || seq == 0 {
+		return
+	}
+	r.turnSeq = seq
+}
+
+// Deadline returns the launch's absolute MaxReviewDuration expiration time (or zero if unbounded).
+func (r *ReviewReservation) Deadline() time.Time {
+	if r == nil || r.entry == nil {
+		return time.Time{}
+	}
+	r.entry.mu.Lock()
+	started := r.entry.started
+	r.entry.mu.Unlock()
+	if started <= 0 {
+		return time.Time{}
+	}
+	return time.Unix(0, started).Add(MaxReviewDuration)
+}
+
+// Deadline returns the collector's effective turn deadline (already capped by launch MaxReviewDuration).
+func (c *Collector) Deadline() time.Time {
+	if c == nil {
+		return time.Time{}
+	}
+	c.mu.Lock()
+	d := c.deadline
+	c.mu.Unlock()
+	return d
+}
+
+func (r *ReviewReservation) Release() {
+	if r == nil {
+		return
+	}
+	r.once.Do(func() {
+		releaseReview(r.entry)
+	})
+}
+
+func (r *ReviewReservation) Taint() {
+	if r == nil || r.entry == nil {
+		return
+	}
+	r.entry.mu.Lock()
+	r.entry.taintAndPersistLocked()
+	r.entry.mu.Unlock()
+}
+
+func (r *ReviewReservation) transfer() (*reviewEntry, bool) {
+	if r == nil || r.entry == nil {
+		return nil, false
+	}
+	transferred := false
+	r.once.Do(func() {
+		transferred = true
+	})
+	if !transferred {
+		return nil, false
+	}
+	return r.entry, true
+}
+
+type pendingReviewState struct {
+	count         int
+	tainted       bool
+	failedTurnSeq uint64
+	started       int64
+}
+
+type sealedDirBinding struct {
+	rootDev    uint64
+	rootIno    uint64
+	dirDev     uint64
+	dirIno     uint64
+	hasDirID   bool
+	dirFD      *os.File
+	receiptSHA string
+	recordedAt time.Time
+}
+
+var (
+	maxSealedBindings         = 2048
+	pinnedDirFDBudgetOverride = -1
+	pinnedDirFDs              atomic.Int64
+	getNofileRlimitFn         = func() (uint64, error) {
+		var rl syscall.Rlimit
+		err := syscall.Getrlimit(syscall.RLIMIT_NOFILE, &rl)
+		return rl.Cur, err
+	}
+)
+
+func computePinnedDirFDBudget(nofile uint64, maxCap int) int {
+	// Reserve at least 75% of RLIMIT_NOFILE AND at least 256 FDs for ordinary proxy HTTP traffic
+	// and temporary reclamation handles. Never impose a fixed non-zero floor that could override
+	// a low soft limit; if the limit is <= 256, return 0 so new reservations fail closed.
+	if maxCap <= 0 || nofile <= 256 {
+		return 0
+	}
+	budget := nofile / 4
+	if avail := nofile - 256; avail < budget {
+		budget = avail
+	}
+	if budget > uint64(maxCap) {
+		return maxCap
+	}
+	return int(budget)
+}
+
+func effectivePinnedDirFDBudget() int {
+	if pinnedDirFDBudgetOverride >= 0 {
+		return pinnedDirFDBudgetOverride
+	}
+	if cur, err := getNofileRlimitFn(); err == nil {
+		return computePinnedDirFDBudget(cur, maxSealedBindings)
+	}
+	// Fail closed if RLIMIT_NOFILE cannot be queried so pinned launch FDs can never exhaust a low-limit process.
+	return 0
+}
+
+func tryReservePinnedDirFD() bool {
+	budget := int64(effectivePinnedDirFDBudget())
+	for {
+		cur := pinnedDirFDs.Load()
+		if cur >= budget {
+			return false
+		}
+		if pinnedDirFDs.CompareAndSwap(cur, cur+1) {
+			return true
+		}
+	}
+}
+
+func openBudgetedPinnedDirFD(r *os.Root) (*os.File, uint64, uint64, bool, error) {
+	if !tryReservePinnedDirFD() {
+		return nil, 0, 0, false, ErrUnavailable
+	}
+	fd, dev, ino, hasID, err := openPinnedDirFD(r)
+	if err != nil {
+		pinnedDirFDs.Add(-1)
+		return nil, 0, 0, false, err
+	}
+	return fd, dev, ino, hasID, nil
+}
+
+func closeBudgetedPinnedDirFD(fd *os.File) {
+	if fd == nil {
+		return
+	}
+	_ = fd.Close()
+	pinnedDirFDs.Add(-1)
+}
