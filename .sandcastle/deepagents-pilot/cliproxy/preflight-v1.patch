+func isAssistantOnlyPartTag(tag string) bool {
+	return tag == "text-pending" ||
+		strings.HasPrefix(tag, "text:") ||
+		tag == contentPartTag("refusal", "") ||
+		tag == contentPartTag("output_audio", "")
+}
+
+func mergeStrictItemKind(prev, next strictItemKind) (strictItemKind, bool) {
+	if next == itemKindUnknown {
+		return prev, true
+	}
+	if prev == itemKindUnknown || prev == next {
+		return next, true
+	}
+	if prev == itemKindMessageAny && (next == itemKindFinalAssistant || next == itemKindCommentary) {
+		return next, true
+	}
+	if next == itemKindMessageAny && (prev == itemKindFinalAssistant || prev == itemKindCommentary) {
+		return prev, true
+	}
+	return itemKindUnknown, false
+}
+
+func isFinalAssistantOutputItem(item responseOutputItem) bool {
+	if item.Type != "message" || item.Role != "assistant" {
+		return false
+	}
+	if item.Phase != "" && item.Phase != "final_answer" {
+		return false
+	}
+	if item.Status != "" && item.Status != "completed" {
+		return false
+	}
+	return true
+}
