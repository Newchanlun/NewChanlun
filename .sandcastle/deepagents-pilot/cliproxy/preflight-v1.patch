+func TestReviewReceiptInitialReservePostRenameSyncFailReleasesPinnedFDBudget(t *testing.T) {
+	// Sol P1 #1 + Astra P1 #1 (PR #2280 R50): when initial ReserveReview renames receipt.json
+	// successfully but fails post-rename launch-directory fsync and evicts the entry from
+	// reviewLedger, it MUST close boundDirFD and return the pinnedDirFDs budget slot.
