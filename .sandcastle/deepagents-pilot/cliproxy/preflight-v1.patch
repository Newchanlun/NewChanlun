+func classifyOutputItemKind(itemType, itemRole, itemPhase string, isDone bool) strictItemKind {
+	if itemType == "" {
+		return itemKindUnknown
+	}
+	if itemType == "message" && itemRole == "assistant" {
+		if itemPhase == "final_answer" {
+			return itemKindFinalAssistant
+		}
+		if itemPhase != "" {
+			return itemKindCommentary
+		}
+		if isDone {
+			return itemKindFinalAssistant
+		}
+		return itemKindMessageAny
+	}
+	return itemKindNonMessage
+}
