+
+	// 1. response.completed with missing/null/empty type parts ONLY -> last_output_sha256 MUST be empty.
+	sseNoType := "data: " + `{"type":"response.completed","response":{"id":"resp_notype1","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"text":"missing"},{"type":null,"text":"nulltype"},{"type":"","text":"emptytype"}]}]}}` + "\n\n"
+	r1 := runSSE(t, "review-b7777777-2222-4333-8444-555555555501", "019d0000-0000-7000-8000-666666666701", sseNoType)
