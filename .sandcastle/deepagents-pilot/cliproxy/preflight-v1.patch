+type partialBodyReader struct {
+	data    []byte
+	offset  int
+	errTail error
+}
+
+func (r *partialBodyReader) Read(p []byte) (int, error) {
+	if r.offset < len(r.data) {
+		n := copy(p, r.data[r.offset:])
+		r.offset += n
+		return n, nil
+	}
+	if r.errTail != nil {
+		return 0, r.errTail
+	}
+	return 0, io.EOF
+}
+
+func (r *partialBodyReader) Close() error { return nil }
+
+func TestReviewReceiptStrictBodyMustReachEOF(t *testing.T) {
+	// Sol P1 (R19): strict Codex transport body wrapper MUST reject if the executor closes resp.Body
+	// before reading to true io.EOF (unread trailing bytes or mid-stream read error).
+	root := filepath.Join(t.TempDir(), "receipts")
+	sse := `data: {"type":"response.completed","response":{"id":"resp_eof","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}}` + "\n\n"
+
+	// 1. Executor closes early leaving unread trailing bytes on resp.Body -> MUST reject and refuse SealReview.
+	launchEarly := "review-eeee1111-2222-4333-8444-555555555911"
+	sessionEarly := "019d0000-0000-7000-8000-000000000911"
+	ctx1, c1, err := BeginReview(context.Background(), root, launchEarly, sessionEarly, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx1, e1, err := c1.Start(ctx1, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl1 := httptransport.Decorate(ctx1, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: 200, Header: make(http.Header),
+			Body: &partialBodyReader{data: []byte(sse + "data: {\"type\":\"error\"}\n\n")},
+		}, nil
+	})})
+	req1, _ := http.NewRequestWithContext(ctx1, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	resp1, err := cl1.Do(req1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, len(sse))
+	if _, err := io.ReadFull(resp1.Body, buf); err != nil {
+		t.Fatal(err)
+	}
+	c1.ObserveStreamChunk(buf)
+	// Close WITHOUT draining the trailing bytes to io.EOF.
+	_ = resp1.Body.Close()
+	e1.End()
+	c1.Complete(true)
+	c1.HandlerDone(true)
+	if st := SealReview(root, launchEarly, sessionEarly); st != SealRejected {
+		t.Fatalf("SealReview accepted early-closed body with unread tail: %v", st)
+	}
+
+	// 2. Upstream returns io.ErrUnexpectedEOF after response.completed -> MUST reject.
+	launchErr := "review-eeee1111-2222-4333-8444-555555555912"
+	sessionErr := "019d0000-0000-7000-8000-000000000912"
+	ctx2, c2, err := BeginReview(context.Background(), root, launchErr, sessionErr, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx2, e2, err := c2.Start(ctx2, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl2 := httptransport.Decorate(ctx2, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: 200, Header: make(http.Header),
+			Body: &partialBodyReader{data: []byte(sse), errTail: io.ErrUnexpectedEOF},
+		}, nil
+	})})
+	req2, _ := http.NewRequestWithContext(ctx2, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	resp2, err := cl2.Do(req2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw2, readErr2 := io.ReadAll(resp2.Body)
+	if !errors.Is(readErr2, io.ErrUnexpectedEOF) {
+		t.Fatalf("expected ErrUnexpectedEOF, got %v", readErr2)
+	}
+	c2.ObserveStreamChunk(raw2)
+	_ = resp2.Body.Close()
+	e2.End()
+	c2.Complete(true)
+	c2.HandlerDone(true)
+	if st := SealReview(root, launchErr, sessionErr); st != SealRejected {
+		t.Fatalf("SealReview accepted body ending with ErrUnexpectedEOF: %v", st)
+	}
+
+	// 3. Full drain to io.EOF -> SealReview MUST succeed.
+	launchOK := "review-eeee1111-2222-4333-8444-555555555913"
+	sessionOK := "019d0000-0000-7000-8000-000000000913"
+	ctx3, c3, err := BeginReview(context.Background(), root, launchOK, sessionOK, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx3, e3, err := c3.Start(ctx3, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl3 := httptransport.Decorate(ctx3, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: 200, Header: make(http.Header),
+			Body: &partialBodyReader{data: []byte(sse)},
+		}, nil
+	})})
+	req3, _ := http.NewRequestWithContext(ctx3, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	resp3, err := cl3.Do(req3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw3, err := io.ReadAll(resp3.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c3.ObserveStreamChunk(raw3)
+	_ = resp3.Body.Close()
+	e3.End()
+	c3.Complete(true)
+	c3.HandlerDone(true)
+	if st := SealReview(root, launchOK, sessionOK); st != SealOK {
+		t.Fatalf("SealReview rejected cleanly EOF-drained body: %v", st)
+	}
+}
