+func TestReviewReceiptDirSyncFailureRejectsReservationAndSeal(t *testing.T) {
+	// R31/R35 (Sol P1 + Astra P1):
+	// 1. Parent directory sync failure rejects BOTH initial BeginReview AND retry of the same launch.
+	// 2. SealReview pre-rename failure leaves sealed=false on disk -> permanently SealRejected.
+	// 3. SealReview post-rename dir-sync failure returns SealUnavailable in-process AND post-restart while
+	//    dir-sync fails, blocks new turns/wrong session, returns SealRejected if crash lost the rename,
+	//    and returns SealOK only once intact sealed=true receipt + dir-sync both succeed.
+	origSync := syncDirFn
+	defer func() { syncDirFn = origSync }()
+
+	// 1. Parent directory sync failure on initial AND retry BeginReview for the same launch.
+	root1 := filepath.Join(t.TempDir(), "receipts1")
+	launch1 := "review-eeee1111-2222-4333-8444-555555555960"
+	session1 := "019d0000-0000-7000-8000-000000000960"
+	syncDirFn = func(dir string) error {
+		if dir == root1 {
+			return errors.New("injected parent dir sync error")
+		}
+		return origSync(dir)
+	}
+	if _, _, err := BeginReview(context.Background(), root1, launch1, session1, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("initial BeginReview with parent dir sync failure err = %v, want ErrUnavailable", err)
+	}
+	if _, _, err := BeginReview(context.Background(), root1, launch1, session1, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("retry BeginReview on same launch with parent dir sync still failing err = %v, want ErrUnavailable", err)
+	}
+
+	// 2. SealReview pre-rename write failure leaves sealed=false on disk -> repeat & post-restart SealRejected.
+	syncDirFn = origSync
+	root2 := filepath.Join(t.TempDir(), "receipts2")
+	launch2 := "review-eeee1111-2222-4333-8444-555555555961"
+	session2 := "019d0000-0000-7000-8000-000000000961"
