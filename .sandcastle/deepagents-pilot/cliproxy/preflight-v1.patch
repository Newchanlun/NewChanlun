+	reviewMu.Lock()
+	_, hasLedger := reviewLedger[key]
+	_, hasBind := sealedBindings[key]
+	delete(reviewLedger, key) // Evict ledger to confirm sealedBindings alone still protects against dir replacement.
+	reviewMu.Unlock()
