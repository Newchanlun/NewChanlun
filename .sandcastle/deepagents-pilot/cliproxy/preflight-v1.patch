+
+func extractSingleAssistantText(item responseOutputItem) string {
+	var b strings.Builder
+	for _, part := range item.Content {
+		if part.Type == "output_text" {
+			b.WriteString(part.Text)
+		}
+	}
+	return b.String()
+}
+
+func contentPartTag(partType, text string) string {
+	if partType == "output_text" {
+		return "text:" + sha256Hex(text)
+	}
+	return "other:" + sha256Hex(partType)
+}
+
+func extractAssistantOutputText(items []responseOutputItem) string {
+	last := ""
+	for _, item := range items {
+		if item.Type == "message" && item.Role == "assistant" {
+			// Exclude intermediate narration/progress messages (e.g. phase="commentary") and
+			// explicitly non-completed messages; clear last so earlier text never leaks through.
+			if (item.Phase != "" && item.Phase != "final_answer") || (item.Status != "" && item.Status != "completed") {
+				last = ""
+				continue
+			}
+			// Always overwrite last (including clearing to "" when the latest final assistant
+			// message has only a refusal or non-output_text content) so earlier text never leaks through.
+			last = extractSingleAssistantText(item)
+			continue
+		}
+		// Any non-assistant-message item (tool calls, mcp_approval_request, reasoning, etc.)
+		// supersedes earlier unphased assistant preamble text so only a final assistant answer
+		// emitted as the final actionable item may supply last_output_sha256.
+		last = ""
+	}
+	return last
+}
+
+func hasResponseError(raw json.RawMessage) bool {
+	trimmed := bytes.TrimSpace(raw)
+	return len(trimmed) > 0 && !bytes.Equal(trimmed, []byte("null"))
+}
+
+func (t *strictStreamTracker) verifyCompletedOutput(output []responseOutputItem, completedSHA string) bool {
+	if len(t.pendingItems) > 0 || t.pendingUnkeyed > 0 || len(t.failedItemKeys) > 0 {
+		return false
+	}
+	for _, item := range output {
+		if item.Type == "message" && item.Role == "assistant" {
+			if !isTerminalAssistantItemStatus(item.Status) {
+				return false
+			}
+		} else if !isCompletedNonMessageItemStatus(item.Status) {
+			return false
+		}
+	}
+	if len(output) == 0 || !t.sawStreamedOutputItem {
+		return true
+	}
+	if t.hasMaxOutputIndex && int64(len(output)) <= t.maxOutputIndex {
+		return false
+	}
+	hasPendingItems := len(t.pendingItems) > 0 || t.pendingUnkeyed > 0
+	completedNonFinalCount := 0
+	completedNonFinalIDs := make(map[string]struct{}, len(output))
+	matchedDoneKeys := make(map[string]struct{}, len(t.doneItems))
+	matchedOutputIdx := make([]bool, len(output))
+	for idx, item := range output {
+		pos := int64(idx)
+		if item.ID != "" {
+			if boundIdx, seen := t.itemIndexByID[item.ID]; seen && boundIdx != pos {
+				return false
+			}
+		}
+		boundID, hasBoundID := t.itemIDByIndex[pos]
+		if hasBoundID && item.ID != "" && boundID != item.ID {
+			return false
+		}
+		canonKey := ""
+		if item.ID != "" {
+			canonKey = "id:" + item.ID
+		} else if hasBoundID {
+			canonKey = "id:" + boundID
+		} else {
+			canonKey = "idx:" + strconv.FormatInt(pos, 10)
+		}
+		itemKind := classifyOutputItemKind(item.Type, item.Role, item.Phase, true)
+		if prevKind, exists := t.itemKindByKey[canonKey]; exists {
+			if _, okMerge := mergeStrictItemKind(prevKind, itemKind); !okMerge {
+				return false
+			}
+		}
+		if prevType, exists := t.itemTypeByKey[canonKey]; exists && item.Type != prevType {
+			return false
+		}
+		if recordedParts, hasParts := t.contentPartByItem[canonKey]; hasParts {
+			if item.Type != "message" || item.Role != "assistant" {
+				for _, wantTag := range recordedParts {
+					if isAssistantOnlyPartTag(wantTag) {
+						return false
+					}
+				}
+			} else {
+				for cIdx, wantTag := range recordedParts {
+					if cIdx < 0 || int(cIdx) >= len(item.Content) {
+						return false
+					}
+					part := item.Content[cIdx]
+					if wantTag == "text-pending" {
+						if part.Type != "output_text" {
+							return false
+						}
+					} else if contentPartTag(part.Type, part.Text) != wantTag {
+						return false
+					}
+				}
+			}
+		}
+		if deltaHashes, hasDeltas := t.textDeltaHashByItem[canonKey]; hasDeltas {
+			if item.Type != "message" || item.Role != "assistant" {
+				return false
+			}
+			for cIdx, st := range deltaHashes {
+				if cIdx < 0 || int(cIdx) >= len(item.Content) {
+					return false
+				}
+				part := item.Content[cIdx]
+				if part.Type != "output_text" || ((!st.fromSnapshot || st.hasDelta) && sha256Hex(part.Text) != hex.EncodeToString(st.h.Sum(nil))) {
+					return false
+				}
+			}
+		}
+		if prefixes, hasPrefixes := t.textPrefixByItem[canonKey]; hasPrefixes {
+			if item.Type != "message" || item.Role != "assistant" {
+				return false
+			}
+			for cIdx, pref := range prefixes {
+				if cIdx < 0 || int(cIdx) >= len(item.Content) {
+					return false
+				}
+				part := item.Content[cIdx]
+				if part.Type != "output_text" || len(part.Text) < pref.byteLen || sha256Hex(part.Text[:pref.byteLen]) != pref.sha256 {
+					return false
+				}
+			}
+		}
+		itemMeta := toolItemMeta{callID: item.CallID, name: item.Name, serverLabel: item.ServerLabel}
+		itemArgs := toolPayloadField{sha: item.ArgsSHA, str: item.ArgsStr, isStr: item.ArgsIsStr}
+		itemInput := toolPayloadField{sha: item.InputSHA, str: item.InputStr, isStr: item.InputIsStr}
+		itemCode := toolPayloadField{sha: item.CodeSHA, str: item.CodeStr, isStr: item.CodeIsStr}
+		if item.Type == "message" && item.Role == "assistant" {
+			if t.hasTrackedToolPayload(canonKey) {
+				return false
+			}
+		} else {
+			if !t.checkToolMetaComplete(canonKey, itemMeta) ||
+				!t.checkToolPayloadFinal(canonKey, "arguments", itemArgs) ||
+				!t.checkToolPayloadFinal(canonKey, "input", itemInput) ||
+				!t.checkToolPayloadFinal(canonKey, "code", itemCode) {
+				return false
+			}
+		}
+		if doneRec, exists := t.doneItems[canonKey]; exists {
+			matchedDoneKeys[canonKey] = struct{}{}
+			matchedOutputIdx[idx] = true
+			if !doneItemMatchesOutputItem(doneRec, item) {
+				return false
+			}
+		}
+		if _, mustBeIncomplete := t.incompleteItemKeys[canonKey]; mustBeIncomplete && item.Status != "incomplete" {
+			return false
+		}
+		if !isFinalAssistantOutputItem(item) {
+			completedNonFinalCount++
+			if item.ID != "" {
+				completedNonFinalIDs[item.ID] = struct{}{}
+			}
+		}
+	}
+	if len(matchedDoneKeys) < len(t.doneItems) {
+		return false
+	}
+	if len(t.unkeyedDoneItems) > 0 {
+		scan := 0
+		for _, unkeyedRec := range t.unkeyedDoneItems {
+			found := false
+			for scan < len(output) {
+				if matchedOutputIdx[scan] {
+					scan++
+					continue
+				}
+				if doneItemMatchesOutputItem(unkeyedRec, output[scan]) {
+					matchedOutputIdx[scan] = true
+					scan++
+					found = true
+					break
+				}
+				scan++
+			}
+			if !found {
+				return false
+			}
+		}
+	}
+	if completedNonFinalCount < len(t.streamedNonFinalKeys)+t.streamedNonFinalUnkeyed {
+		return false
+	}
+	for nonFinalID := range t.streamedNonFinalIDs {
+		if _, ok := completedNonFinalIDs[nonFinalID]; !ok {
+			return false
+		}
+	}
+	if completedSHA != "" && (t.lastItemOutputSHA != completedSHA || hasPendingItems) {
+		return false
+	}
+	return true
+}
+
+func (c *Collector) taintStreamAnomaly() {
+	c.mu.Lock()
+	c.modelMismatch = true
+	c.invalid = true
+	c.resetOutputTrackingLocked()
+	c.mu.Unlock()
+	c.Taint()
+}
+
+var errStrictJSONFormat = errors.New("invalid strict JSON SSE frame")
+
+var (
+	sseEventSchemaKeys = map[string]struct{}{
+		"type": {}, "response_id": {}, "model": {}, "error": {}, "response": {},
+		"item": {}, "item_id": {}, "output_index": {}, "content_index": {}, "text": {}, "delta": {}, "refusal": {}, "part": {},
+		"arguments": {}, "input": {}, "code": {}, "name": {}, "call_id": {},
+	}
+	sseResponseSchemaKeys = map[string]struct{}{
+		"id": {}, "model": {}, "status": {}, "error": {}, "output": {},
+	}
+	sseItemSchemaKeys = map[string]struct{}{
+		"id": {}, "type": {}, "role": {}, "phase": {}, "status": {}, "content": {}, "response_id": {},
+		"call_id": {}, "name": {}, "server_label": {}, "arguments": {}, "input": {}, "code": {}, "action": {}, "queries": {},
+	}
+	sseContentPartSchemaKeys = map[string]struct{}{
+		"type": {}, "text": {}, "refusal": {},
+	}
+)
+
+func validateStrictJSONValue(dec *json.Decoder, depth int) error {
+	if depth > 128 {
+		return errStrictJSONFormat
+	}
+	tok, err := dec.Token()
+	if err != nil {
+		return err
+	}
+	return validateStrictJSONToken(dec, tok, depth, nil)
+}
+
+func validateStrictJSONToken(dec *json.Decoder, tok json.Token, depth int, schemaKeys map[string]struct{}) error {
+	delim, ok := tok.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delim {
+	case '{':
+		var seenLower map[string]struct{}
+		var seenExact map[string]struct{}
+		if depth == 0 && schemaKeys != nil {
+			seenLower = make(map[string]struct{})
+		} else {
+			seenExact = make(map[string]struct{})
+		}
+		for dec.More() {
+			keyTok, err := dec.Token()
+			if err != nil {
+				return err
+			}
+			key, ok := keyTok.(string)
+			if !ok {
+				return errStrictJSONFormat
+			}
+			if seenLower != nil {
+				lower := strings.ToLower(key)
+				if _, dup := seenLower[lower]; dup {
+					return errStrictJSONFormat
+				}
+				if key != lower {
+					if _, isSchema := schemaKeys[lower]; isSchema {
+						return errStrictJSONFormat
+					}
+				}
+				seenLower[lower] = struct{}{}
+			} else {
+				if _, dup := seenExact[key]; dup {
+					return errStrictJSONFormat
+				}
+				seenExact[key] = struct{}{}
+			}
+			if err := validateStrictJSONValue(dec, depth+1); err != nil {
+				return err
+			}
+		}
+		endTok, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		if endDelim, ok := endTok.(json.Delim); !ok || endDelim != '}' {
+			return errStrictJSONFormat
+		}
+		return nil
+	case '[':
+		for dec.More() {
+			if err := validateStrictJSONValue(dec, depth+1); err != nil {
+				return err
+			}
+		}
+		endTok, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		if endDelim, ok := endTok.(json.Delim); !ok || endDelim != ']' {
+			return errStrictJSONFormat
+		}
+		return nil
+	default:
+		return errStrictJSONFormat
+	}
+}
+
+func validateStrictJSONObject(raw []byte, schemaKeys map[string]struct{}) error {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return err
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok || delim != '{' {
+		return errStrictJSONFormat
+	}
+	if err := validateStrictJSONToken(dec, tok, 0, schemaKeys); err != nil {
+		return err
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return errStrictJSONFormat
+	}
+	return nil
+}
+
+func decodeExactJSONObject(raw []byte, schemaKeys map[string]struct{}) (map[string]json.RawMessage, error) {
+	if err := validateStrictJSONObject(raw, schemaKeys); err != nil {
+		return nil, err
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &fields); err != nil {
+		return nil, err
+	}
+	return fields, nil
+}
+
+func exactOptionalStringPresent(fields map[string]json.RawMessage, key string) (string, bool, bool) {
+	raw, exists := fields[key]
+	if !exists {
+		return "", false, true
+	}
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
+		return "", true, false
+	}
+	var s string
+	if err := json.Unmarshal(trimmed, &s); err != nil {
+		return "", true, false
+	}
+	return s, true, true
+}
+
+func exactOptionalString(fields map[string]json.RawMessage, key string) (string, bool) {
+	raw, exists := fields[key]
+	if !exists {
+		return "", true
+	}
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
+		return "", true
+	}
+	var s string
+	if err := json.Unmarshal(trimmed, &s); err != nil {
+		return "", false
+	}
+	return s, true
+}
+
+func forEachJSONArrayElement(raw []byte, limit int, fn func(elem json.RawMessage) bool) bool {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil {
+		return false
+	}
+	if delim, ok := tok.(json.Delim); !ok || delim != '[' {
+		return false
+	}
+	count := 0
+	for dec.More() {
+		count++
+		if count > limit {
+			return false
+		}
+		var elem json.RawMessage
+		if err := dec.Decode(&elem); err != nil {
+			return false
+		}
+		if !fn(elem) {
+			return false
+		}
+	}
+	endTok, err := dec.Token()
+	if err != nil {
+		return false
+	}
+	if delim, ok := endTok.(json.Delim); !ok || delim != ']' {
+		return false
+	}
+	_, err = dec.Token()
+	return err == io.EOF
+}
+
+func decodeExactAssistantContentParts(raw json.RawMessage) ([]responseOutputContentPart, bool) {
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
+		return nil, true
+	}
+	var parts []responseOutputContentPart
+	ok := forEachJSONArrayElement(trimmed, maxTrackedContentParts, func(rp json.RawMessage) bool {
+		fields, err := decodeExactJSONObject(rp, sseContentPartSchemaKeys)
+		if err != nil {
+			return false
+		}
+		typ, ok1 := exactOptionalString(fields, "type")
+		if !ok1 || len(typ) > maxStrictIdentityBytes {
+			return false
+		}
+		var txt string
+		if typ == "output_text" {
+			var hasTxt, ok2 bool
+			txt, hasTxt, ok2 = exactOptionalStringPresent(fields, "text")
+			if !hasTxt || !ok2 {
+				return false
+			}
+		} else {
+			var ok2 bool
+			txt, ok2 = exactOptionalString(fields, "text")
+			if !ok2 {
+				return false
+			}
+		}
+		parts = append(parts, responseOutputContentPart{Type: typ, Text: txt})
+		return true
+	})
+	if !ok {
+		return nil, false
+	}
+	return parts, true
+}
+
+func extractToolPayloadField(fields map[string]json.RawMessage, key string) (toolPayloadField, bool) {
+	raw, exists := fields[key]
+	if !exists || !hasResponseError(raw) {
+		return toolPayloadField{}, true
+	}
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) > 0 && trimmed[0] == '"' {
+		var s string
+		if err := json.Unmarshal(trimmed, &s); err != nil {
+			return toolPayloadField{}, false
+		}
+		return toolPayloadField{sha: "str:" + sha256Hex(s), str: s, isStr: true}, true
+	}
+	canon, okCanon := canonicalJSONDigest(trimmed)
+	if !okCanon {
+		return toolPayloadField{}, false
+	}
+	return toolPayloadField{sha: "json:" + canon}, true
+}
+
+func extractItemToolFields(fields map[string]json.RawMessage) (meta toolItemMeta, args, input, code toolPayloadField, ok bool) {
+	callID, ok1 := exactOptionalString(fields, "call_id")
+	name, ok2 := exactOptionalString(fields, "name")
+	serverLabel, ok3 := exactOptionalString(fields, "server_label")
+	if !ok1 || !ok2 || !ok3 ||
+		len(callID) > maxStrictIdentityBytes || len(name) > maxStrictIdentityBytes || len(serverLabel) > maxStrictIdentityBytes {
+		return toolItemMeta{}, toolPayloadField{}, toolPayloadField{}, toolPayloadField{}, false
+	}
+	args, okArgs := extractToolPayloadField(fields, "arguments")
+	if !okArgs {
+		return toolItemMeta{}, toolPayloadField{}, toolPayloadField{}, toolPayloadField{}, false
+	}
+	input, okInput := extractToolPayloadField(fields, "input")
+	if !okInput {
+		return toolItemMeta{}, toolPayloadField{}, toolPayloadField{}, toolPayloadField{}, false
+	}
+	code, okCode := extractToolPayloadField(fields, "code")
+	if !okCode {
+		return toolItemMeta{}, toolPayloadField{}, toolPayloadField{}, toolPayloadField{}, false
+	}
+	return toolItemMeta{callID: callID, name: name, serverLabel: serverLabel}, args, input, code, true
+}
+
+func canonicalCompletedItemDigest(fields map[string]json.RawMessage) (string, bool) {
+	if fields == nil {
+		return "", false
+	}
+	itemType, _ := exactOptionalString(fields, "type")
+	norm := make(map[string]any, len(fields))
+	for k, raw := range fields {
+		// id, status, and response_id are verified separately (identity binding,
+		// status compatibility/terminal checks, and response_id consistency).
+		if k == "id" || k == "status" || k == "response_id" {
+			continue
+		}
+		dec := json.NewDecoder(bytes.NewReader(raw))
+		dec.UseNumber()
+		var v any
+		if err := dec.Decode(&v); err != nil {
+			return "", false
+		}
+		var extra any
+		if err := dec.Decode(&extra); !errors.Is(err, io.EOF) {
+			return "", false
+		}
+		if itemType == "reasoning" && k == "summary" {
+			if v == nil {
+				continue
+			}
+			if arr, ok := v.([]any); ok && len(arr) == 0 {
+				continue
+			}
+		}
+		norm[k] = v
+	}
+	canon, err := json.Marshal(norm)
+	if err != nil {
+		return "", false
+	}
+	return sha256Hex(string(canon)), true
+}
+
+func decodeExactResponseOutputItems(raw json.RawMessage, expectedRespID string) ([]responseOutputItem, string, bool) {
+	trimmed := bytes.TrimSpace(raw)
+	if len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null")) {
+		return nil, "", false
+	}
+	boundID := expectedRespID
+	var items []responseOutputItem
+	seenIDs := make(map[string]struct{})
+	ok := forEachJSONArrayElement(trimmed, maxTrackedOutputItems, func(ri json.RawMessage) bool {
+		fields, err := decodeExactJSONObject(ri, sseItemSchemaKeys)
+		if err != nil {
+			return false
+		}
+		itemID, okID := exactOptionalString(fields, "id")
+		typ, ok1 := exactOptionalString(fields, "type")
+		role, ok2 := exactOptionalString(fields, "role")
+		phase, ok3 := exactOptionalString(fields, "phase")
+		status, ok4 := exactOptionalString(fields, "status")
+		itemRespID, hasItemRespID, okRespID := exactOptionalStringPresent(fields, "response_id")
+		if !okID || !ok1 || !ok2 || !ok3 || !ok4 || !okRespID ||
+			strings.TrimSpace(typ) == "" ||
+			len(itemID) > maxStrictIdentityBytes || len(itemRespID) > maxStrictIdentityBytes ||
+			len(typ) > maxStrictIdentityBytes || len(role) > maxStrictIdentityBytes ||
+			len(phase) > maxStrictIdentityBytes || len(status) > maxStrictIdentityBytes {
+			return false
+		}
+		if itemID != "" {
+			if _, dup := seenIDs[itemID]; dup {
+				return false
+			}
+			seenIDs[itemID] = struct{}{}
+		}
+		if hasItemRespID {
+			if itemRespID == "" || strings.TrimSpace(itemRespID) != itemRespID {
+				return false
+			}
+			if boundID != "" && itemRespID != boundID {
+				return false
+			}
+			boundID = itemRespID
+		}
+		meta, argsField, inputField, codeField, okTool := extractItemToolFields(fields)
+		if !okTool {
+			return false
+		}
+		canonItemSHA, okCanonItem := canonicalCompletedItemDigest(fields)
+		if !okCanonItem {
+			return false
+		}
+		item := responseOutputItem{
+			ID:               itemID,
+			Type:             typ,
+			Role:             role,
+			Phase:            phase,
+			Status:           status,
+			CallID:           meta.callID,
+			Name:             meta.name,
+			ServerLabel:      meta.serverLabel,
+			ArgsSHA:          argsField.sha,
+			ArgsStr:          argsField.str,
+			ArgsIsStr:        argsField.isStr,
+			InputSHA:         inputField.sha,
+			InputStr:         inputField.str,
+			InputIsStr:       inputField.isStr,
+			CodeSHA:          codeField.sha,
+			CodeStr:          codeField.str,
+			CodeIsStr:        codeField.isStr,
+			CanonicalItemSHA: canonItemSHA,
+		}
+		if typ == "message" && role == "assistant" {
+			parts, okParts := decodeExactAssistantContentParts(fields["content"])
+			if !okParts {
+				return false
+			}
+			item.Content = parts
+		}
+		items = append(items, item)
+		return true
+	})
+	if !ok {
+		return nil, "", false
+	}
+	return items, boundID, true
+}
+
+type parsedStrictFrame struct {
+	evType          string
+	respID          string
+	respModel       string
+	respStatus      string
+	respErr         json.RawMessage
+	respOutput      json.RawMessage
+	hasRespOutput   bool
+	respItems       []responseOutputItem
+	itemRaw         json.RawMessage
+	itemFields      map[string]json.RawMessage
+	itemKey         string
+	itemID          string
+	outputIndex     int64
+	hasOutputIndex  bool
+	contentIndex    int64
+	hasContentIndex bool
+	evText          string
+	hasEvText       bool
+	evDelta         string
+	hasEvDelta      bool
+	evArgs          string
+	hasEvArgs       bool
+	evInput         string
+	hasEvInput      bool
+	evCode          string
+	hasEvCode       bool
+	evName          string
+	partFields      map[string]json.RawMessage
+}
+
+func extractStrictItemIdentity(evFields, itemFields map[string]json.RawMessage) (itemKey, itemID string, outputIndex int64, hasOutputIndex bool, ok bool) {
+	if itemFields != nil {
+		idVal, okID := exactOptionalString(itemFields, "id")
+		if !okID {
+			return "", "", 0, false, false
+		}
+		itemID = idVal
+	}
+	evItemID, okEvItemID := exactOptionalString(evFields, "item_id")
+	if !okEvItemID {
+		return "", "", 0, false, false
+	}
+	if itemID == "" {
+		itemID = evItemID
+	} else if evItemID != "" && evItemID != itemID {
+		return "", "", 0, false, false
+	}
+	if len(itemID) > maxStrictIdentityBytes {
+		return "", "", 0, false, false
+	}
+	if rawIdx, exists := evFields["output_index"]; exists {
+		trimmed := bytes.TrimSpace(rawIdx)
+		if len(trimmed) > 0 && !bytes.Equal(trimmed, []byte("null")) {
+			var idx int64
+			if err := json.Unmarshal(trimmed, &idx); err != nil || idx < 0 {
+				return "", "", 0, false, false
+			}
+			outputIndex = idx
+			hasOutputIndex = true
+		}
+	}
+	if itemID != "" {
+		itemKey = "id:" + itemID
+	} else if hasOutputIndex {
+		itemKey = "idx:" + strconv.FormatInt(outputIndex, 10)
+	}
+	return itemKey, itemID, outputIndex, hasOutputIndex, true
+}
+
+func validateStrictOutputItemEvent(frame parsedStrictFrame) bool {
+	switch frame.evType {
+	case "response.output_item.added":
+		if frame.itemFields == nil {
+			return false
+		}
+		itemType, ok1 := exactOptionalString(frame.itemFields, "type")
+		itemRole, ok2 := exactOptionalString(frame.itemFields, "role")
+		itemPhase, ok3 := exactOptionalString(frame.itemFields, "phase")
+		itemStatus, ok4 := exactOptionalString(frame.itemFields, "status")
+		if !ok1 || !ok2 || !ok3 || !ok4 ||
+			len(itemType) > maxStrictIdentityBytes || len(itemRole) > maxStrictIdentityBytes ||
+			len(itemPhase) > maxStrictIdentityBytes || len(itemStatus) > maxStrictIdentityBytes {
+			return false
+		}
+		if (itemType == "" || itemType == "message") && (itemRole == "" || itemRole == "assistant") {
+			if rawContent, hasContent := frame.itemFields["content"]; hasContent && hasResponseError(rawContent) {
+				if _, okParts := decodeExactAssistantContentParts(rawContent); !okParts {
+					return false
+				}
+			}
+		}
+		if _, _, _, _, okTool := extractItemToolFields(frame.itemFields); !okTool {
+			return false
+		}
+		return true
+	case "response.output_item.done":
+		if frame.itemFields == nil {
+			return false
+		}
+		itemType, ok1 := exactOptionalString(frame.itemFields, "type")
+		itemRole, ok2 := exactOptionalString(frame.itemFields, "role")
+		itemPhase, ok3 := exactOptionalString(frame.itemFields, "phase")
+		itemStatus, ok4 := exactOptionalString(frame.itemFields, "status")
+		if !ok1 || !ok2 || !ok3 || !ok4 || itemType == "" ||
+			len(itemType) > maxStrictIdentityBytes || len(itemRole) > maxStrictIdentityBytes ||
+			len(itemPhase) > maxStrictIdentityBytes || len(itemStatus) > maxStrictIdentityBytes {
+			return false
+		}
+		if itemType == "message" && itemRole == "assistant" {
+			if _, okParts := decodeExactAssistantContentParts(frame.itemFields["content"]); !okParts {
+				return false
+			}
+		}
+		return true
+	default:
+		return true
+	}
+}
+
+func isExplicitFailureEventType(evType string) bool {
+	switch evType {
+	case "response.failed", "response.incomplete", "response.cancelled", "response.canceled", "error":
+		return true
+	default:
+		return false
+	}
+}
+
+// validateStrictFrameIdentity performs shared strict JSON, model-binding, and response-ID
+// consistency verification used by both ObserveStreamChunk and ValidateStrictEvent.
+// Required fields (such as non-blank type) are ALWAYS enforced; error fields are tolerated
+// only when allowFailureEvents is true AND the event type is an explicit upstream failure event.
+func (c *Collector) validateStrictFrameIdentity(line []byte, allowFailureEvents, producerOnly bool) (parsedStrictFrame, bool) {
+	var out parsedStrictFrame
+	evFields, err := decodeExactJSONObject(line, sseEventSchemaKeys)
+	if err != nil {
+		c.taintStreamAnomaly()
+		return out, false
+	}
+	evType, okType := exactOptionalString(evFields, "type")
+	evRespID, hasEvRespID, okRespID := exactOptionalStringPresent(evFields, "response_id")
+	evModel, hasEvModel, okEvModel := exactOptionalStringPresent(evFields, "model")
+	if !okType || !okRespID || !okEvModel || strings.TrimSpace(evType) == "" ||
+		len(evType) > maxStrictIdentityBytes || len(evRespID) > maxStrictIdentityBytes || len(evModel) > maxStrictIdentityBytes {
+		c.taintStreamAnomaly()
+		return out, false
+	}
+	if hasEvRespID && (evRespID == "" || strings.TrimSpace(evRespID) != evRespID) {
+		c.taintStreamAnomaly()
+		return out, false
+	}
+	if hasEvModel && evModel == "" {
+		c.taintStreamAnomaly()
+		return out, false
+	}
+	rejectErrors := !allowFailureEvents || !isExplicitFailureEventType(evType)
+	if rejectErrors && hasResponseError(evFields["error"]) {
+		c.taintStreamAnomaly()
+		return out, false
+	}
+	var respID, respModel, respStatus string
+	var hasRespID, hasRespModel, hasRespOutput bool
+	var respErr, respOutput json.RawMessage
+	if hasResponseError(evFields["response"]) {
+		respFields, err := decodeExactJSONObject(evFields["response"], sseResponseSchemaKeys)
+		if err != nil {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		var ok1, ok2, ok3 bool
+		respID, hasRespID, ok1 = exactOptionalStringPresent(respFields, "id")
+		respModel, hasRespModel, ok2 = exactOptionalStringPresent(respFields, "model")
+		respStatus, ok3 = exactOptionalString(respFields, "status")
+		if !ok1 || !ok2 || !ok3 || len(respID) > maxStrictIdentityBytes || len(respModel) > maxStrictIdentityBytes {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		if hasRespID && (respID == "" || strings.TrimSpace(respID) != respID) {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		if hasRespModel && respModel == "" {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		respErr = respFields["error"]
+		respOutput, hasRespOutput = respFields["output"]
+		if hasRespOutput && !hasResponseError(respOutput) {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		if rejectErrors && hasResponseError(respErr) {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		if rejectErrors && (respStatus == "failed" || respStatus == "cancelled" || respStatus == "canceled" || respStatus == "incomplete") {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		switch evType {
+		case "response.created":
+			if respStatus != "" && respStatus != "in_progress" && respStatus != "queued" {
+				c.taintStreamAnomaly()
+				return out, false
+			}
+		case "response.queued":
+			if respStatus != "" && respStatus != "queued" {
+				c.taintStreamAnomaly()
+				return out, false
+			}
+		case "response.in_progress":
+			if respStatus != "" && respStatus != "in_progress" {
+				c.taintStreamAnomaly()
+				return out, false
+			}
+		}
+	}
+	if hasEvModel && hasRespModel && evModel != respModel {
+		c.taintStreamAnomaly()
+		return out, false
+	}
+	explicitModel := ""
+	if hasRespModel {
+		explicitModel = respModel
+	} else if hasEvModel {
+		explicitModel = evModel
+	}
+	if explicitModel != "" {
+		c.mu.Lock()
+		mismatch := c.expectedModel == "" || explicitModel != c.expectedModel
+		c.mu.Unlock()
+		if mismatch {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+	}
+	if hasEvRespID && hasRespID && evRespID != respID {
+		c.taintStreamAnomaly()
+		return out, false
+	}
+	var itemFields map[string]json.RawMessage
+	var itemRespID string
+	var hasItemRespID bool
+	if hasResponseError(evFields["item"]) {
+		var itemErr error
+		itemFields, itemErr = decodeExactJSONObject(evFields["item"], sseItemSchemaKeys)
+		if itemErr != nil {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		var okItemRespID bool
+		itemRespID, hasItemRespID, okItemRespID = exactOptionalStringPresent(itemFields, "response_id")
+		if !okItemRespID || len(itemRespID) > maxStrictIdentityBytes || (hasItemRespID && (itemRespID == "" || strings.TrimSpace(itemRespID) != itemRespID)) {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+	}
+	explicitRespID := ""
+	if hasEvRespID {
+		explicitRespID = evRespID
+	} else if hasRespID {
+		explicitRespID = respID
+	}
+	if hasItemRespID {
+		if explicitRespID != "" && explicitRespID != itemRespID {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		explicitRespID = itemRespID
+	}
+	if explicitRespID != "" {
+		conflict := false
+		c.mu.Lock()
+		tr := &c.consumer
+		if producerOnly {
+			tr = &c.producer
+		}
+		if tr.responseID != "" && tr.responseID != explicitRespID {
+			conflict = true
+		} else {
+			tr.responseID = explicitRespID
+		}
+		c.mu.Unlock()
+		if conflict {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+	}
+	var respItems []responseOutputItem
+	if hasResponseError(respOutput) {
+		c.mu.Lock()
+		expectedItemRespID := explicitRespID
+		if expectedItemRespID == "" {
+			if producerOnly {
+				expectedItemRespID = c.producer.responseID
+			} else {
+				expectedItemRespID = c.consumer.responseID
+			}
+		}
+		c.mu.Unlock()
+		var boundItemRespID string
+		var okItems bool
+		respItems, boundItemRespID, okItems = decodeExactResponseOutputItems(respOutput, expectedItemRespID)
+		if !okItems {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		if boundItemRespID != "" {
+			conflict := false
+			c.mu.Lock()
+			tr := &c.consumer
+			if producerOnly {
+				tr = &c.producer
+			}
+			if tr.responseID != "" && tr.responseID != boundItemRespID {
+				conflict = true
+			} else {
+				tr.responseID = boundItemRespID
+			}
+			c.mu.Unlock()
+			if conflict {
+				c.taintStreamAnomaly()
+				return out, false
+			}
+		}
+	}
+	itemKey, itemID, outputIndex, hasOutputIndex, okItemKey := extractStrictItemIdentity(evFields, itemFields)
+	if !okItemKey {
+		c.taintStreamAnomaly()
+		return out, false
+	}
+	var contentIndex int64
+	hasContentIndex := false
+	if rawCIdx, exists := evFields["content_index"]; exists {
+		trimmedCIdx := bytes.TrimSpace(rawCIdx)
+		if len(trimmedCIdx) > 0 && !bytes.Equal(trimmedCIdx, []byte("null")) {
+			var cIdx int64
+			if err := json.Unmarshal(trimmedCIdx, &cIdx); err != nil || cIdx < 0 || cIdx >= int64(maxTrackedContentParts) {
+				c.taintStreamAnomaly()
+				return out, false
+			}
+			contentIndex = cIdx
+			hasContentIndex = true
+		}
+	}
+	var evText string
+	var hasEvText bool
+	if evType == "response.output_text.done" {
+		var okText bool
+		evText, hasEvText, okText = exactOptionalStringPresent(evFields, "text")
+		if !okText || !hasEvText {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+	}
+	var evDelta string
+	var hasEvDelta bool
+	if evType == "response.output_text.delta" ||
+		evType == "response.refusal.delta" ||
+		evType == "response.function_call_arguments.delta" ||
+		evType == "response.mcp_call_arguments.delta" ||
+		evType == "response.custom_tool_call_input.delta" ||
+		evType == "response.code_interpreter_call_code.delta" {
+		var okDelta bool
+		evDelta, hasEvDelta, okDelta = exactOptionalStringPresent(evFields, "delta")
+		if !okDelta || !hasEvDelta {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+	}
+	var evArgs string
+	var hasEvArgs bool
+	var evName string
+	if evType == "response.function_call_arguments.done" || evType == "response.mcp_call_arguments.done" {
+		var okArgs bool
+		evArgs, hasEvArgs, okArgs = exactOptionalStringPresent(evFields, "arguments")
+		var okName bool
+		evName, okName = exactOptionalString(evFields, "name")
+		if !okArgs || !hasEvArgs || !okName || len(evName) > maxStrictIdentityBytes {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+	}
+	var evInput string
+	var hasEvInput bool
+	if evType == "response.custom_tool_call_input.done" {
+		var okInput bool
+		evInput, hasEvInput, okInput = exactOptionalStringPresent(evFields, "input")
+		if !okInput || !hasEvInput {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+	}
+	var evCode string
+	var hasEvCode bool
+	if evType == "response.code_interpreter_call_code.done" {
+		var okCode bool
+		evCode, hasEvCode, okCode = exactOptionalStringPresent(evFields, "code")
+		if !okCode || !hasEvCode {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+	}
+	if evType == "response.refusal.done" {
+		if _, hasRef, okRef := exactOptionalStringPresent(evFields, "refusal"); !okRef || !hasRef {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+	}
+	var partFields map[string]json.RawMessage
+	if evType == "response.content_part.done" {
+		if !hasResponseError(evFields["part"]) {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		var partErr error
+		partFields, partErr = decodeExactJSONObject(evFields["part"], sseContentPartSchemaKeys)
+		if partErr != nil {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		pType, hasPType, ok1 := exactOptionalStringPresent(partFields, "type")
+		_, ok2 := exactOptionalString(partFields, "text")
+		_, ok3 := exactOptionalString(partFields, "refusal")
+		if !ok1 || !ok2 || !ok3 || !hasPType || strings.TrimSpace(pType) == "" || len(pType) > maxStrictIdentityBytes {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		if pType == "output_text" {
+			if _, hasPText, okPText := exactOptionalStringPresent(partFields, "text"); !okPText || !hasPText {
+				c.taintStreamAnomaly()
+				return out, false
+			}
+		}
+	} else if evType == "response.content_part.added" {
+		if !hasResponseError(evFields["part"]) {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		var partErr error
+		partFields, partErr = decodeExactJSONObject(evFields["part"], sseContentPartSchemaKeys)
+		if partErr != nil {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		pType, hasPType, ok1 := exactOptionalStringPresent(partFields, "type")
+		_, ok2 := exactOptionalString(partFields, "text")
+		_, ok3 := exactOptionalString(partFields, "refusal")
+		if !ok1 || !ok2 || !ok3 || !hasPType || strings.TrimSpace(pType) == "" || len(pType) > maxStrictIdentityBytes {
+			c.taintStreamAnomaly()
+			return out, false
+		}
+		if pType == "output_text" {
+			if _, hasPText, okPText := exactOptionalStringPresent(partFields, "text"); !okPText || !hasPText {
+				c.taintStreamAnomaly()
+				return out, false
+			}
+		}
+	}
+	out = parsedStrictFrame{
+		evType:          evType,
+		respID:          respID,
+		respModel:       respModel,
+		respStatus:      respStatus,
+		respErr:         respErr,
+		respOutput:      respOutput,
+		hasRespOutput:   hasRespOutput,
+		respItems:       respItems,
+		itemRaw:         evFields["item"],
+		itemFields:      itemFields,
+		itemKey:         itemKey,
+		itemID:          itemID,
+		outputIndex:     outputIndex,
+		hasOutputIndex:  hasOutputIndex,
+		contentIndex:    contentIndex,
+		hasContentIndex: hasContentIndex,
+		evText:          evText,
+		hasEvText:       hasEvText,
+		evDelta:         evDelta,
+		hasEvDelta:      hasEvDelta,
+		evArgs:          evArgs,
+		hasEvArgs:       hasEvArgs,
+		evInput:         evInput,
+		hasEvInput:      hasEvInput,
+		evCode:          evCode,
+		hasEvCode:       hasEvCode,
+		evName:          evName,
+		partFields:      partFields,
+	}
+	return out, true
+}
+
+// ValidateStrictEvent validates model binding, response-ID consistency, explicit SSE event-name
+// consistency, strict protocol JSON, and cross-frame item/content/completion consistency on ONE
+// complete assembled SSE event JSON payload (including multi-line JSON objects) without touching
+// consumer-order state. Unlike ObserveStreamChunk, it tolerates legitimate pre-completion upstream
+// failure event types (response.failed, response.incomplete, response.cancelled, error) when
+// declared event name, model, and response ID match. Returns false whenever validation fails
+// and taints the collector so callers can abort before forwarding an untrusted frame downstream.
+func (c *Collector) ValidateStrictEvent(evName string, hasEvName bool, rawEventJSON []byte) bool {
+	if c == nil || !c.strictCodex {
+		return true
+	}
+	c.mu.Lock()
+	c.producerObserved = true
+	c.lastAttemptRequiredProducer = true
+	alreadyTainted := c.modelMismatch && c.invalid
+	c.mu.Unlock()
+	if alreadyTainted {
+		return false
+	}
+	if hasEvName && len(evName) > maxStrictIdentityBytes {
+		c.taintStreamAnomaly()
+		return false
+	}
+	trimmed := bytes.TrimSpace(rawEventJSON)
+	if len(trimmed) == 0 {
+		if hasEvName {
+			c.taintStreamAnomaly()
+			return false
+		}
+		return true
+	}
+	if bytes.Equal(trimmed, []byte("[DONE]")) {
+		c.mu.Lock()
+		doneAllowed := c.producer.sawCompleted || c.producer.sawFailure
+		c.mu.Unlock()
+		if hasEvName || !doneAllowed {
+			c.taintStreamAnomaly()
+			return false
+		}
+		return true
+	}
+	frame, ok := c.validateStrictFrameIdentity(trimmed, true, true)
+	if !ok {
+		return false
+	}
+	if frame.evType == "response.done" || !validateStrictOutputItemEvent(frame) {
+		c.taintStreamAnomaly()
+		return false
+	}
+	if hasEvName && evName != frame.evType {
+		c.taintStreamAnomaly()
+		return false
+	}
+	c.applyStrictFrame(frame, false)
+	c.mu.Lock()
+	valid := !(c.modelMismatch && c.invalid)
+	c.mu.Unlock()
+	return valid
+}
+
+func (c *Collector) splitSSEChunkLinesLocked(payload []byte) [][]byte {
+	// An empty chunk from CodexSSEScanner represents a single blank SSE event-delimiter line.
+	if len(payload) == 0 {
+		c.ssePendingCR = false
+		return [][]byte{{}}
+	}
+	if c.ssePendingCR {
+		c.ssePendingCR = false
+		if payload[0] == '\n' {
+			payload = payload[1:]
+			if len(payload) == 0 {
+				return nil
+			}
+		}
+	}
+	var lines [][]byte
+	start := 0
+	for i := 0; i < len(payload); {
+		switch payload[i] {
+		case '\r':
+			lines = append(lines, payload[start:i])
+			if i+1 < len(payload) && payload[i+1] == '\n' {
+				i += 2
+			} else {
+				if i+1 == len(payload) {
+					c.ssePendingCR = true
+				}
+				i++
+			}
+			start = i
+		case '\n':
+			lines = append(lines, payload[start:i])
+			i++
+			start = i
+		default:
+			i++
+		}
+	}
+	if start < len(payload) {
+		lines = append(lines, payload[start:])
+	}
+	return lines
+}
+
+func stripSSEFieldValue(raw []byte) []byte {
+	if len(raw) > 0 && raw[0] == ' ' {
+		return raw[1:]
+	}
+	return raw
+}
+
+func (t *strictStreamTracker) bindIdentity(itemID string, outputIndex int64, hasOutputIndex bool) (canonKey, effItemID string, effIdx int64, effHasIdx bool, ok bool) {
+	if itemID != "" {
+		canonKey = "id:" + itemID
+		if hasOutputIndex {
+			if prevIdx, exists := t.itemIndexByID[itemID]; exists && prevIdx != outputIndex {
+				return "", "", 0, false, false
+			}
+			if prevID, exists := t.itemIDByIndex[outputIndex]; exists && prevID != itemID {
+				return "", "", 0, false, false
+			}
+			if _, exists := t.itemIndexByID[itemID]; !exists && len(t.itemIndexByID) >= maxTrackedOutputItems {
+				return "", "", 0, false, false
+			}
+			if _, exists := t.itemIDByIndex[outputIndex]; !exists {
+				if len(t.itemIDByIndex) >= maxTrackedOutputItems {
+					return "", "", 0, false, false
+				}
+				idxKey := "idx:" + strconv.FormatInt(outputIndex, 10)
+				if _, idxDone := t.doneItemKeys[idxKey]; idxDone {
+					return "", "", 0, false, false
+				}
+				// Migrate any open index-only tracking state onto the unified canonical ID key.
+				if _, wasPending := t.pendingItems[idxKey]; wasPending {
+					delete(t.pendingItems, idxKey)
+					if t.pendingItems == nil {
+						t.pendingItems = make(map[string]struct{})
+					}
+					t.pendingItems[canonKey] = struct{}{}
+				}
+				if _, wasFailed := t.failedItemKeys[idxKey]; wasFailed {
+					delete(t.failedItemKeys, idxKey)
+					if _, alreadyCompletedSub := t.completedSubItemKeys[canonKey]; alreadyCompletedSub {
+						return "", "", 0, false, false
+					}
+					if t.failedItemKeys == nil {
+						t.failedItemKeys = make(map[string]struct{})
+					}
+					t.failedItemKeys[canonKey] = struct{}{}
+				}
+				if _, wasCompSub := t.completedSubItemKeys[idxKey]; wasCompSub {
+					delete(t.completedSubItemKeys, idxKey)
+					if _, alreadyFailed := t.failedItemKeys[canonKey]; alreadyFailed {
+						return "", "", 0, false, false
+					}
+					if t.completedSubItemKeys == nil {
+						t.completedSubItemKeys = make(map[string]struct{})
+					}
+					t.completedSubItemKeys[canonKey] = struct{}{}
+				}
+				if _, wasInc := t.incompleteItemKeys[idxKey]; wasInc {
+					delete(t.incompleteItemKeys, idxKey)
+					if t.incompleteItemKeys == nil {
+						t.incompleteItemKeys = make(map[string]struct{})
+					}
+					t.incompleteItemKeys[canonKey] = struct{}{}
+				}
+				if _, wasNonFinal := t.streamedNonFinalKeys[idxKey]; wasNonFinal {
+					delete(t.streamedNonFinalKeys, idxKey)
+					t.streamedNonFinalKeys[canonKey] = struct{}{}
+					if t.streamedNonFinalIDs == nil {
+						t.streamedNonFinalIDs = make(map[string]struct{})
+					}
+					t.streamedNonFinalIDs[itemID] = struct{}{}
+				}
+				if prevKind, hasKind := t.itemKindByKey[idxKey]; hasKind {
+					delete(t.itemKindByKey, idxKey)
+					if curKind, hasCur := t.itemKindByKey[canonKey]; hasCur {
+						merged, okMerge := mergeStrictItemKind(curKind, prevKind)
+						if !okMerge {
+							return "", "", 0, false, false
+						}
+						t.itemKindByKey[canonKey] = merged
+					} else {
+						t.itemKindByKey[canonKey] = prevKind
+					}
+				}
+				if prevType, hasType := t.itemTypeByKey[idxKey]; hasType {
+					delete(t.itemTypeByKey, idxKey)
+					if curType, hasCur := t.itemTypeByKey[canonKey]; hasCur {
+						if curType != prevType {
+							return "", "", 0, false, false
+						}
+					} else {
+						t.itemTypeByKey[canonKey] = prevType
+					}
+				}
+				if prevMeta, hasMeta := t.toolMetaByKey[idxKey]; hasMeta {
+					delete(t.toolMetaByKey, idxKey)
+					if !t.recordToolMeta(canonKey, prevMeta) {
+						return "", "", 0, false, false
+					}
+				}
+				if prevFinals, hasFinals := t.toolPayloadFinalByItem[idxKey]; hasFinals {
+					delete(t.toolPayloadFinalByItem, idxKey)
+					curFinals := t.toolPayloadFinalByItem[canonKey]
+					if curFinals == nil {
+						t.toolPayloadFinalByItem[canonKey] = prevFinals
+					} else {
+						for field, sha := range prevFinals {
+							if existing, dup := curFinals[field]; dup && existing != sha {
+								return "", "", 0, false, false
+							}
+							curFinals[field] = sha
+						}
+					}
+				}
+				if prevToolDeltas, hasToolDeltas := t.toolPayloadDeltaByItem[idxKey]; hasToolDeltas {
+					delete(t.toolPayloadDeltaByItem, idxKey)
+					curToolDeltas := t.toolPayloadDeltaByItem[canonKey]
+					if curToolDeltas == nil {
+						t.toolPayloadDeltaByItem[canonKey] = prevToolDeltas
+					} else {
+						for field, st := range prevToolDeltas {
+							if _, dup := curToolDeltas[field]; dup {
+								return "", "", 0, false, false
+							}
+							curToolDeltas[field] = st
+						}
+					}
+				}
+				if prevToolPrefixes, hasToolPrefixes := t.toolPayloadPrefixByItem[idxKey]; hasToolPrefixes {
+					delete(t.toolPayloadPrefixByItem, idxKey)
+					curToolPrefixes := t.toolPayloadPrefixByItem[canonKey]
+					if curToolPrefixes == nil {
+						t.toolPayloadPrefixByItem[canonKey] = prevToolPrefixes
+					} else {
+						for field, pref := range prevToolPrefixes {
+							if existing, dup := curToolPrefixes[field]; dup && existing != pref {
+								return "", "", 0, false, false
+							}
+							curToolPrefixes[field] = pref
+						}
+					}
+				}
+				if prevParts, hasParts := t.contentPartByItem[idxKey]; hasParts {
+					delete(t.contentPartByItem, idxKey)
+					curParts := t.contentPartByItem[canonKey]
+					if curParts == nil {
+						t.contentPartByItem[canonKey] = prevParts
+					} else {
+						for cIdx, tag := range prevParts {
+							if existingTag, dup := curParts[cIdx]; dup {
+								if existingTag == "text-pending" && strings.HasPrefix(tag, "text:") {
+									curParts[cIdx] = tag
+									continue
+								}
+								if tag == "text-pending" && strings.HasPrefix(existingTag, "text:") {
+									continue
+								}
+								if existingTag != tag {
+									return "", "", 0, false, false
+								}
+								continue
+							}
+							if len(curParts) >= maxTrackedContentParts {
+								return "", "", 0, false, false
+							}
+							curParts[cIdx] = tag
+						}
+					}
+				}
+				if prevDeltas, hasDeltas := t.textDeltaHashByItem[idxKey]; hasDeltas {
+					delete(t.textDeltaHashByItem, idxKey)
+					curDeltas := t.textDeltaHashByItem[canonKey]
+					if curDeltas == nil {
+						t.textDeltaHashByItem[canonKey] = prevDeltas
+					} else {
+						for cIdx, st := range prevDeltas {
+							if _, dup := curDeltas[cIdx]; dup {
+								return "", "", 0, false, false
+							}
+							if len(curDeltas) >= maxTrackedContentParts {
+								return "", "", 0, false, false
+							}
+							curDeltas[cIdx] = st
+						}
+					}
+				}
+				if prevPrefixes, hasPrefixes := t.textPrefixByItem[idxKey]; hasPrefixes {
+					delete(t.textPrefixByItem, idxKey)
+					curPrefixes := t.textPrefixByItem[canonKey]
+					if curPrefixes == nil {
+						t.textPrefixByItem[canonKey] = prevPrefixes
+					} else {
+						for cIdx, pref := range prevPrefixes {
+							if existing, dup := curPrefixes[cIdx]; dup && existing != pref {
+								return "", "", 0, false, false
+							}
+							if len(curPrefixes) >= maxTrackedContentParts {
+								return "", "", 0, false, false
+							}
+							curPrefixes[cIdx] = pref
+						}
+					}
+				}
+				if seq, hasSeq := t.itemSeqByKey[idxKey]; hasSeq {
+					if idSeq, hasIDSeq := t.itemSeqByKey[canonKey]; !hasIDSeq || seq < idSeq {
+						t.itemSeqByKey[canonKey] = seq
+					}
+					delete(t.itemSeqByKey, idxKey)
+					recomputedMax := t.maxNonFinalSeq
+					for _, s := range t.itemSeqByKey {
+						if s > recomputedMax {
+							recomputedMax = s
+						}
+					}
+					t.maxItemSeq = recomputedMax
+				}
+			}
+			if t.itemIndexByID == nil {
+				t.itemIndexByID = make(map[string]int64)
+			}
+			if t.itemIDByIndex == nil {
+				t.itemIDByIndex = make(map[int64]string)
+			}
+			t.itemIndexByID[itemID] = outputIndex
+			t.itemIDByIndex[outputIndex] = itemID
+			if doneRec, hasDone := t.doneItems[canonKey]; hasDone && !doneRec.hasOutputIndex {
+				doneRec.outputIndex = outputIndex
+				doneRec.hasOutputIndex = true
+				t.doneItems[canonKey] = doneRec
+			}
+			return canonKey, itemID, outputIndex, true, true
+		}
+		if prevIdx, exists := t.itemIndexByID[itemID]; exists {
+			return canonKey, itemID, prevIdx, true, true
+		}
+		return canonKey, itemID, 0, false, true
+	}
+	if hasOutputIndex {
+		if prevID, exists := t.itemIDByIndex[outputIndex]; exists {
+			return "id:" + prevID, prevID, outputIndex, true, true
+		}
+		return "idx:" + strconv.FormatInt(outputIndex, 10), "", outputIndex, true, true
+	}
+	return "", "", 0, false, true
+}
+
+func (t *strictStreamTracker) assignSeq(canonKey string) (int, bool) {
+	if canonKey != "" {
+		if existing, exists := t.itemSeqByKey[canonKey]; exists {
+			return existing, true
+		}
+	}
+	if t.nextItemSeq >= maxTrackedOutputItems {
+		return 0, false
+	}
+	t.nextItemSeq++
+	seq := t.nextItemSeq
+	if canonKey != "" {
+		if len(t.itemSeqByKey) >= maxTrackedOutputItems {
+			return 0, false
+		}
+		if t.itemSeqByKey == nil {
+			t.itemSeqByKey = make(map[string]int)
+		}
+		t.itemSeqByKey[canonKey] = seq
+	}
+	return seq, true
+}
+
+func (t *strictStreamTracker) recordItemType(canonKey, rawType string) bool {
+	if canonKey == "" || rawType == "" {
+		return true
+	}
+	if len(rawType) > maxStrictIdentityBytes {
+		return false
+	}
+	if prev, exists := t.itemTypeByKey[canonKey]; exists {
+		return prev == rawType
+	}
+	if len(t.itemTypeByKey) >= maxTrackedOutputItems {
+		return false
+	}
+	if t.itemTypeByKey == nil {
+		t.itemTypeByKey = make(map[string]string)
+	}
+	t.itemTypeByKey[canonKey] = rawType
+	return true
+}
+
+func (t *strictStreamTracker) recordItemKind(canonKey string, kind strictItemKind) bool {
+	if canonKey == "" || kind == itemKindUnknown {
+		return true
+	}
+	prev := t.itemKindByKey[canonKey]
+	merged, okMerge := mergeStrictItemKind(prev, kind)
+	if !okMerge {
+		return false
+	}
+	if _, exists := t.itemKindByKey[canonKey]; !exists && len(t.itemKindByKey) >= maxTrackedOutputItems {
+		return false
+	}
+	if t.itemKindByKey == nil {
+		t.itemKindByKey = make(map[string]strictItemKind)
+	}
+	t.itemKindByKey[canonKey] = merged
+	return true
+}
+
+func (t *strictStreamTracker) hasTrackedToolPayload(canonKey string) bool {
+	if canonKey == "" {
+		return false
+	}
+	return len(t.toolPayloadFinalByItem[canonKey]) > 0 ||
+		len(t.toolPayloadDeltaByItem[canonKey]) > 0 ||
+		len(t.toolPayloadPrefixByItem[canonKey]) > 0
+}
+
+func (t *strictStreamTracker) recordToolMeta(canonKey string, meta toolItemMeta) bool {
+	if canonKey == "" || (meta.callID == "" && meta.name == "" && meta.serverLabel == "") {
+		return true
+	}
+	prev, exists := t.toolMetaByKey[canonKey]
+	if !exists && len(t.toolMetaByKey) >= maxTrackedOutputItems {
+		return false
+	}
+	if prev.callID != "" && meta.callID != "" && prev.callID != meta.callID {
+		return false
+	}
+	if prev.name != "" && meta.name != "" && prev.name != meta.name {
+		return false
+	}
+	if prev.serverLabel != "" && meta.serverLabel != "" && prev.serverLabel != meta.serverLabel {
+		return false
+	}
+	if meta.callID != "" {
+		prev.callID = meta.callID
+	}
+	if meta.name != "" {
+		prev.name = meta.name
+	}
+	if meta.serverLabel != "" {
+		prev.serverLabel = meta.serverLabel
+	}
+	if t.toolMetaByKey == nil {
+		t.toolMetaByKey = make(map[string]toolItemMeta)
+	}
+	t.toolMetaByKey[canonKey] = prev
+	return true
+}
+
+func (t *strictStreamTracker) checkToolMetaComplete(canonKey string, meta toolItemMeta) bool {
+	if canonKey == "" {
+		return true
+	}
+	prev, exists := t.toolMetaByKey[canonKey]
+	if !exists {
+		return true
+	}
+	if prev.callID != "" && meta.callID != prev.callID {
+		return false
+	}
+	if prev.name != "" && meta.name != prev.name {
+		return false
+	}
+	if prev.serverLabel != "" && meta.serverLabel != prev.serverLabel {
+		return false
+	}
+	return true
+}
+
+func (t *strictStreamTracker) verifyToolMetaComplete(canonKey string, meta toolItemMeta) bool {
+	return t.checkToolMetaComplete(canonKey, meta) && t.recordToolMeta(canonKey, meta)
+}
+
+func (t *strictStreamTracker) recordToolPayloadPrefix(canonKey, field, text string) bool {
+	if canonKey == "" || text == "" {
+		return true
+	}
+	prefixes := t.toolPayloadPrefixByItem[canonKey]
+	if prefixes == nil {
+		if len(t.toolPayloadPrefixByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.toolPayloadPrefixByItem == nil {
+			t.toolPayloadPrefixByItem = make(map[string]map[string]textPrefixCheck)
+		}
+		prefixes = make(map[string]textPrefixCheck)
+		t.toolPayloadPrefixByItem[canonKey] = prefixes
+	}
+	if prev, exists := prefixes[field]; exists {
+		if len(text) < prev.byteLen || sha256Hex(text[:prev.byteLen]) != prev.sha256 {
+			return false
+		}
+		if len(text) == prev.byteLen {
+			return true
+		}
+	}
+	prefixes[field] = textPrefixCheck{byteLen: len(text), sha256: sha256Hex(text)}
+	return true
+}
+
+func (t *strictStreamTracker) recordToolPayloadInitial(canonKey, field string, val toolPayloadField) bool {
+	if canonKey == "" || val.sha == "" {
+		return true
+	}
+	if !val.isStr {
+		if deltas := t.toolPayloadDeltaByItem[canonKey]; deltas != nil && deltas[field] != nil {
+			return false
+		}
+		if prefixes := t.toolPayloadPrefixByItem[canonKey]; prefixes != nil {
+			if _, hasPref := prefixes[field]; hasPref {
+				return false
+			}
+		}
+		return t.recordToolPayloadFinal(canonKey, field, val)
+	}
+	if finals := t.toolPayloadFinalByItem[canonKey]; finals != nil {
+		if prevFinal, exists := finals[field]; exists && prevFinal != val.sha {
+			return false
+		}
+	}
+	if val.str == "" {
+		if prefixes := t.toolPayloadPrefixByItem[canonKey]; prefixes != nil {
+			if pref, exists := prefixes[field]; exists && pref.byteLen > 0 {
+				return false
+			}
+		}
+		if deltas := t.toolPayloadDeltaByItem[canonKey]; deltas != nil {
+			if st := deltas[field]; st != nil && hex.EncodeToString(st.h.Sum(nil)) != sha256Hex("") {
+				return false
+			}
+		}
+		return true
+	}
+	if !t.recordToolPayloadPrefix(canonKey, field, val.str) {
+		return false
+	}
+	deltas := t.toolPayloadDeltaByItem[canonKey]
+	if deltas == nil {
+		if len(t.toolPayloadDeltaByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.toolPayloadDeltaByItem == nil {
+			t.toolPayloadDeltaByItem = make(map[string]map[string]*textDeltaState)
+		}
+		deltas = make(map[string]*textDeltaState)
+		t.toolPayloadDeltaByItem[canonKey] = deltas
+	}
+	initSHA := sha256Hex(val.str)
+	if st := deltas[field]; st != nil {
+		if !st.hasDelta && st.hasSeed {
+			return st.seedSHA == initSHA
+		}
+		return hex.EncodeToString(st.h.Sum(nil)) == initSHA
+	}
+	h := sha256.New()
+	_, _ = h.Write([]byte(val.str))
+	deltas[field] = &textDeltaState{h: h, hasSeed: true, seedSHA: initSHA}
+	return true
+}
+
+func (t *strictStreamTracker) recordToolPayloadDelta(canonKey, field, delta string) bool {
+	if canonKey == "" {
+		return true
+	}
+	if finals := t.toolPayloadFinalByItem[canonKey]; finals != nil {
+		if _, finalized := finals[field]; finalized {
+			return false
+		}
+	}
+	deltas := t.toolPayloadDeltaByItem[canonKey]
+	if deltas == nil {
+		if len(t.toolPayloadDeltaByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.toolPayloadDeltaByItem == nil {
+			t.toolPayloadDeltaByItem = make(map[string]map[string]*textDeltaState)
+		}
+		deltas = make(map[string]*textDeltaState)
+		t.toolPayloadDeltaByItem[canonKey] = deltas
+	}
+	st := deltas[field]
+	if st == nil {
+		st = &textDeltaState{h: sha256.New()}
+		deltas[field] = st
+	}
+	_, _ = st.h.Write([]byte(delta))
+	st.hasDelta = true
+	return true
+}
+
+func (t *strictStreamTracker) recordToolPayloadSnapshot(canonKey, field string, val toolPayloadField) bool {
+	if canonKey == "" {
+		return true
+	}
+	if val.sha == "" {
+		if finals := t.toolPayloadFinalByItem[canonKey]; finals != nil {
+			if _, exists := finals[field]; exists {
+				return false
+			}
+		}
+		if deltas := t.toolPayloadDeltaByItem[canonKey]; deltas != nil && deltas[field] != nil {
+			return false
+		}
+		if prefixes := t.toolPayloadPrefixByItem[canonKey]; prefixes != nil {
+			if _, exists := prefixes[field]; exists {
+				return false
+			}
+		}
+		return true
+	}
+	if !val.isStr {
+		if deltas := t.toolPayloadDeltaByItem[canonKey]; deltas != nil && deltas[field] != nil {
+			return false
+		}
+		if prefixes := t.toolPayloadPrefixByItem[canonKey]; prefixes != nil {
+			if _, exists := prefixes[field]; exists {
+				return false
+			}
+		}
+		return t.recordToolPayloadFinal(canonKey, field, val)
+	}
+	if finals := t.toolPayloadFinalByItem[canonKey]; finals != nil {
+		if prevFinal, exists := finals[field]; exists && prevFinal != val.sha {
+			return false
+		}
+	}
+	if val.str == "" {
+		if prefixes := t.toolPayloadPrefixByItem[canonKey]; prefixes != nil {
+			if pref, exists := prefixes[field]; exists && pref.byteLen > 0 {
+				return false
+			}
+		}
+		if deltas := t.toolPayloadDeltaByItem[canonKey]; deltas != nil {
+			if st := deltas[field]; st != nil && hex.EncodeToString(st.h.Sum(nil)) != sha256Hex("") {
+				return false
+			}
+		}
+		return true
+	}
+	if !t.recordToolPayloadPrefix(canonKey, field, val.str) {
+		return false
+	}
+	deltas := t.toolPayloadDeltaByItem[canonKey]
+	if deltas == nil {
+		if len(t.toolPayloadDeltaByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.toolPayloadDeltaByItem == nil {
+			t.toolPayloadDeltaByItem = make(map[string]map[string]*textDeltaState)
+		}
+		deltas = make(map[string]*textDeltaState)
+		t.toolPayloadDeltaByItem[canonKey] = deltas
+	}
+	snapSHA := sha256Hex(val.str)
+	if st := deltas[field]; st != nil {
+		if st.hasDelta {
+			return hex.EncodeToString(st.h.Sum(nil)) == snapSHA
+		}
+		h := sha256.New()
+		_, _ = h.Write([]byte(val.str))
+		st.h = h
+		st.hasSeed = true
+		st.seedSHA = snapSHA
+		return true
+	}
+	h := sha256.New()
+	_, _ = h.Write([]byte(val.str))
+	deltas[field] = &textDeltaState{h: h, hasSeed: true, fromSnapshot: true, seedSHA: snapSHA}
+	return true
+}
+
+func (t *strictStreamTracker) checkToolPayloadFinal(canonKey, field string, val toolPayloadField) bool {
+	if canonKey == "" {
+		return true
+	}
+	if val.sha == "" {
+		if finals := t.toolPayloadFinalByItem[canonKey]; finals != nil {
+			if _, exists := finals[field]; exists {
+				return false
+			}
+		}
+		if deltas := t.toolPayloadDeltaByItem[canonKey]; deltas != nil && deltas[field] != nil {
+			return false
+		}
+		if prefixes := t.toolPayloadPrefixByItem[canonKey]; prefixes != nil {
+			if _, exists := prefixes[field]; exists {
+				return false
+			}
+		}
+		return true
+	}
+	if val.isStr {
+		if deltas := t.toolPayloadDeltaByItem[canonKey]; deltas != nil {
+			if st := deltas[field]; st != nil && (!st.fromSnapshot || st.hasDelta) {
+				if hex.EncodeToString(st.h.Sum(nil)) != sha256Hex(val.str) {
+					return false
+				}
+			}
+		}
+		if prefixes := t.toolPayloadPrefixByItem[canonKey]; prefixes != nil {
+			if pref, exists := prefixes[field]; exists {
+				if len(val.str) < pref.byteLen || sha256Hex(val.str[:pref.byteLen]) != pref.sha256 {
+					return false
+				}
+			}
+		}
+	} else {
+		if deltas := t.toolPayloadDeltaByItem[canonKey]; deltas != nil && deltas[field] != nil {
+			return false
+		}
+		if prefixes := t.toolPayloadPrefixByItem[canonKey]; prefixes != nil {
+			if _, exists := prefixes[field]; exists {
+				return false
+			}
+		}
+	}
+	if finals := t.toolPayloadFinalByItem[canonKey]; finals != nil {
+		if prevFinal, exists := finals[field]; exists && prevFinal != val.sha {
+			return false
+		}
+	}
+	return true
+}
+
+func (t *strictStreamTracker) recordToolPayloadFinal(canonKey, field string, val toolPayloadField) bool {
+	if !t.checkToolPayloadFinal(canonKey, field, val) {
+		return false
+	}
+	if canonKey == "" || val.sha == "" {
+		return true
+	}
+	finals := t.toolPayloadFinalByItem[canonKey]
+	if finals == nil {
+		if len(t.toolPayloadFinalByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.toolPayloadFinalByItem == nil {
+			t.toolPayloadFinalByItem = make(map[string]map[string]string)
+		}
+		finals = make(map[string]string)
+		t.toolPayloadFinalByItem[canonKey] = finals
+	}
+	finals[field] = val.sha
+	return true
+}
+
+func (t *strictStreamTracker) recordTextPrefix(canonKey string, contentIdx int64, text string) bool {
+	if canonKey == "" || text == "" {
+		return true
+	}
+	if contentIdx < 0 || contentIdx >= int64(maxTrackedContentParts) {
+		return false
+	}
+	if parts := t.contentPartByItem[canonKey]; parts != nil {
+		if prevTag, exists := parts[contentIdx]; exists && prevTag != "text-pending" && !strings.HasPrefix(prevTag, "text:") {
+			return false
+		}
+	}
+	prefixes := t.textPrefixByItem[canonKey]
+	if prefixes == nil {
+		if len(t.textPrefixByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.textPrefixByItem == nil {
+			t.textPrefixByItem = make(map[string]map[int64]textPrefixCheck)
+		}
+		prefixes = make(map[int64]textPrefixCheck)
+		t.textPrefixByItem[canonKey] = prefixes
+	}
+	if prev, exists := prefixes[contentIdx]; exists {
+		if len(text) < prev.byteLen || sha256Hex(text[:prev.byteLen]) != prev.sha256 {
+			return false
+		}
+		if len(text) == prev.byteLen {
+			return true
+		}
+	} else if len(prefixes) >= maxTrackedContentParts {
+		return false
+	}
+	prefixes[contentIdx] = textPrefixCheck{byteLen: len(text), sha256: sha256Hex(text)}
+	return true
+}
+
+func canonicalJSONDigest(raw []byte) (string, bool) {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.UseNumber()
+	var v any
+	if err := dec.Decode(&v); err != nil {
+		return "", false
+	}
+	var extra any
+	if err := dec.Decode(&extra); !errors.Is(err, io.EOF) {
+		return "", false
+	}
+	canon, err := json.Marshal(v)
+	if err != nil {
+		return "", false
+	}
+	return sha256Hex(string(canon)), true
+}
+
+func (t *strictStreamTracker) recordSnapshotText(canonKey string, contentIdx int64, snapText string) bool {
+	if !t.recordPendingTextPart(canonKey, contentIdx) {
+		return false
+	}
+	if canonKey == "" {
+		return true
+	}
+	if parts := t.contentPartByItem[canonKey]; parts != nil {
+		if prevTag, exists := parts[contentIdx]; exists && strings.HasPrefix(prevTag, "text:") {
+			if contentPartTag("output_text", snapText) != prevTag {
+				return false
+			}
+		}
+	}
+	if snapText == "" {
+		if prefixes := t.textPrefixByItem[canonKey]; prefixes != nil {
+			if pref, exists := prefixes[contentIdx]; exists && pref.byteLen > 0 {
+				return false
+			}
+		}
+		if hashes := t.textDeltaHashByItem[canonKey]; hashes != nil {
+			if st := hashes[contentIdx]; st != nil && hex.EncodeToString(st.h.Sum(nil)) != sha256Hex("") {
+				return false
+			}
+		}
+		return true
+	}
+	if !t.recordTextPrefix(canonKey, contentIdx, snapText) {
+		return false
+	}
+	hashes := t.textDeltaHashByItem[canonKey]
+	if hashes == nil {
+		if len(t.textDeltaHashByItem) >= maxTrackedOutputItems {
+			return false
+		}
+		if t.textDeltaHashByItem == nil {
+			t.textDeltaHashByItem = make(map[string]map[int64]*textDeltaState)
+		}
+		hashes = make(map[int64]*textDeltaState)
+		t.textDeltaHashByItem[canonKey] = hashes
+	}
+	snapSHA := sha256Hex(snapText)
+	if st := hashes[contentIdx]; st != nil {
+		if st.hasDelta {
+			return hex.EncodeToString(st.h.Sum(nil)) == snapSHA
+		}
+		// Advance pre-delta snapshot seed (monotonic prefix already proven by recordTextPrefix).
+		h := sha256.New()
+		_, _ = h.Write([]byte(snapText))
+		st.h = h
+		st.hasSeed = true
+		st.seedSHA = snapSHA
+		return true
+	}
+	if len(hashes) >= maxTrackedContentParts {
+		return false
+	}
+	h := sha256.New()
+	_, _ = h.Write([]byte(snapText))
+	hashes[contentIdx] = &textDeltaState{h: h, hasSeed: true, fromSnapshot: true, seedSHA: snapSHA}
+	return true
+}
