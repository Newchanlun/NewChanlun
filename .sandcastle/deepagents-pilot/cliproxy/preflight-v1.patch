+
+func TestPreflightReceiptProductionTransportTrust(t *testing.T) {
+	// Proxy-owned controlled transports constructed via ControlledTransportForProxy MUST be trusted
+	// and MUST NOT expose mutable *http.Transport to external callers.
+	for _, proxyURL := range []string{"", "direct", "http://127.0.0.1:8080", "socks5://127.0.0.1:1080"} {
+		rt, err := ControlledTransportForProxy(proxyURL)
+		if err != nil || rt == nil {
+			t.Fatalf("ControlledTransportForProxy(%q) failed: rt=%v err=%v", proxyURL, rt, err)
+		}
+		if _, exposed := rt.(*http.Transport); exposed {
+			t.Fatalf("ControlledTransportForProxy(%q) exposed mutable *http.Transport", proxyURL)
+		}
+		if !isTrustedPreflightTransport(rt) {
+			t.Fatalf("controlled transport for %q was rejected", proxyURL)
+		}
+	}
+	// Unsupported https:// proxy (requires DialTLSContext) and malformed proxy URLs MUST fail closed.
+	for _, badProxy := range []string{"https://127.0.0.1:8443", "ftp://127.0.0.1:21", "://bad"} {
+		if rt, err := ControlledTransportForProxy(badProxy); err == nil || rt != nil {
+			t.Fatalf("ControlledTransportForProxy(%q) escaped guard: rt=%v err=%v", badProxy, rt, err)
+		}
+	}
+
+	// Go's net/http lazily initializes Transport.TLSClientConfig on the first HTTPS request when
+	// ForceAttemptHTTP2 is enabled. Reusing the exact same cached controlled transport across
+	// multiple consecutive requests MUST remain trusted without tainting subsequent turns.
+	tlsSrv := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer tlsSrv.Close()
+	directRT, err := ControlledTransportForProxy("direct")
+	if err != nil {
+		t.Fatalf("ControlledTransportForProxy(direct) failed: %v", err)
+	}
+	for attempt := 1; attempt <= 2; attempt++ {
+		req, errReq := http.NewRequestWithContext(context.Background(), http.MethodGet, tlsSrv.URL, nil)
+		if errReq != nil {
+			t.Fatalf("new request: %v", errReq)
+		}
+		resp, errRT := directRT.RoundTrip(req)
+		if resp != nil && resp.Body != nil {
+			_ = resp.Body.Close()
+		}
+		if errRT == nil {
+			t.Fatalf("attempt %d: self-signed TLS server unexpectedly passed OS trust roots", attempt)
+		}
+		if !isTrustedPreflightTransport(directRT) {
+			t.Fatalf("attempt %d: controlled transport rejected after Go HTTP/2 TLSClientConfig auto-init", attempt)
+		}
+	}
+	if sealed, ok := directRT.(*controlledPreflightTransport); !ok || sealed.tr.TLSClientConfig == nil {
+		t.Fatal("expected Go net/http to auto-initialize TLSClientConfig on ForceAttemptHTTP2 transport")
+	}
+
+	// Same controlled transport for an explicit HTTP proxy MUST complete two consecutive requests cleanly.
+	var proxyHits atomic.Int32
+	proxySrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		proxyHits.Add(1)
+		w.WriteHeader(http.StatusOK)
+		_, _ = io.WriteString(w, "ok")
+	}))
+	defer proxySrv.Close()
+	proxyRT1, err := ControlledTransportForProxy(proxySrv.URL)
+	if err != nil {
+		t.Fatalf("ControlledTransportForProxy(http proxy) failed: %v", err)
+	}
+	proxyRT2, err := ControlledTransportForProxy(proxySrv.URL)
+	if err != nil || proxyRT1 != proxyRT2 {
+		t.Fatalf("expected cached controlled transport for proxy %s", proxySrv.URL)
+	}
+	for attempt := 1; attempt <= 2; attempt++ {
+		if !isTrustedPreflightTransport(proxyRT1) {
+			t.Fatalf("attempt %d: cached proxy transport not trusted before request", attempt)
+		}
+		req, errReq := http.NewRequestWithContext(context.Background(), http.MethodGet, "http://example.invalid/v1/responses", nil)
+		if errReq != nil {
+			t.Fatalf("new proxy request: %v", errReq)
+		}
+		resp, errRT := proxyRT1.RoundTrip(req)
+		if errRT != nil {
+			t.Fatalf("attempt %d: proxy RoundTrip failed: %v", attempt, errRT)
+		}
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+		if !isTrustedPreflightTransport(proxyRT1) {
+			t.Fatalf("attempt %d: cached proxy transport rejected after completion", attempt)
+		}
+	}
+	if got := proxyHits.Load(); got != 2 {
+		t.Fatalf("proxyHits = %d, want 2", got)
+	}
+
+	// SOCKS5 controlled transport MUST honor request context cancellation even when the proxy
+	// accepts TCP and stalls during the SOCKS5 handshake (no leaked dial goroutine/connection).
+	ln, errListen := net.Listen("tcp", "127.0.0.1:0")
+	if errListen != nil {
+		t.Fatalf("listen stalled socks5: %v", errListen)
+	}
+	defer ln.Close()
+	accepted := make(chan net.Conn, 1)
+	go func() {
+		conn, errAccept := ln.Accept()
+		if errAccept == nil {
+			accepted <- conn
+		}
+	}()
+	socksRT, errSocks := ControlledTransportForProxy("socks5://" + ln.Addr().String())
+	if errSocks != nil || socksRT == nil {
+		t.Fatalf("ControlledTransportForProxy(socks5) failed: rt=%v err=%v", socksRT, errSocks)
+	}
+	reqCtx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	reqSocks, errReqSocks := http.NewRequestWithContext(reqCtx, http.MethodGet, "https://chatgpt.com/backend-api/codex/responses", nil)
+	if errReqSocks != nil {
+		t.Fatalf("new socks request: %v", errReqSocks)
+	}
+	started := time.Now()
+	respSocks, errRoundTrip := socksRT.RoundTrip(reqSocks)
+	elapsed := time.Since(started)
+	if respSocks != nil && respSocks.Body != nil {
+		_ = respSocks.Body.Close()
+	}
+	if errRoundTrip == nil {
+		t.Fatal("stalled SOCKS5 proxy unexpectedly succeeded")
+	}
+	if elapsed > 3*time.Second {
+		t.Fatalf("stalled SOCKS5 dial ignored context deadline: elapsed=%v err=%v", elapsed, errRoundTrip)
+	}
+	select {
+	case conn := <-accepted:
+		_ = conn.Close()
+	case <-time.After(time.Second):
+	}
+
+	// Any externally constructed *http.Transport (even default-looking, or carrying RegisterProtocol("https", ...),
+	// custom RootCAs, callbacks, DialTLS*, typed-nil, or non-standard RoundTripper) MUST be rejected in production.
+	customRoots := x509.NewCertPool()
+	var typedNil *http.Transport
+	altProtoTr := &http.Transport{}
+	altProtoTr.RegisterProtocol("https", nonStandardRoundTripper{})
+
+	for _, bad := range []struct {
+		name string
+		rt   any
+	}{
+		{"nil-roundtripper", nil},
+		{"external-empty-transport", &http.Transport{}},
+		{"register-protocol-https", altProtoTr},
+		{"custom-root-cas", &http.Transport{TLSClientConfig: &tls.Config{RootCAs: customRoots, MinVersion: tls.VersionTLS12}}},
+		{"insecure-skip-verify", &http.Transport{TLSClientConfig: &tls.Config{InsecureSkipVerify: true, MinVersion: tls.VersionTLS12}}},
+		{"servername-override", &http.Transport{TLSClientConfig: &tls.Config{ServerName: "example.com", MinVersion: tls.VersionTLS12}}},
+		{"verify-peer-cert", &http.Transport{TLSClientConfig: &tls.Config{VerifyPeerCertificate: func([][]byte, [][]*x509.Certificate) error { return nil }}}},
+		{"verify-connection", &http.Transport{TLSClientConfig: &tls.Config{VerifyConnection: func(tls.ConnectionState) error { return nil }}}},
+		{"custom-dial-tls", &http.Transport{DialTLS: func(network, addr string) (net.Conn, error) { return nil, errors.New("blocked") }}},
+		{"custom-dial-tls-context", &http.Transport{DialTLSContext: func(context.Context, string, string) (net.Conn, error) { return nil, errors.New("blocked") }}},
+		{"typed-nil-transport", typedNil},
+		{"non-standard-roundtripper", nonStandardRoundTripper{}},
+	} {
+		if isTrustedPreflightTransport(bad.rt) {
+			t.Fatalf("external/unsafe transport %s escaped production trust check", bad.name)
+		}
+	}
+	if IsTestPreflightTransport(altProtoTr) {
+		t.Fatal("production build accepted test transport")
+	}
+}
