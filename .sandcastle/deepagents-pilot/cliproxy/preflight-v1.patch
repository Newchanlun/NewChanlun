+func TestReserveExistingReviewRequiresMarkerPersisted(t *testing.T) {
+	// Astra P1 #3 (PR #2280 R28): ReserveExistingReview MUST verify markerPersisted (and fail closed
+	// when marker persistence fails) rather than admitting a second concurrent request on an unpersisted entry.
+	root := filepath.Join(t.TempDir(), "existing-marker-receipts")
+	launch := "review-e2222222-2222-4333-8444-555555555501"
+	key := filepath.Clean(root) + "\x00" + launch
+
+	// Simulate an in-memory entry whose initial marker write failed/is still unpersisted while sync fails.
+	origSync := syncDirFn
+	syncDirFn = func(string) error { return errors.New("injected sync failure") }
+	defer func() { syncDirFn = origSync }()
+
+	unpersisted := &reviewEntry{
+		directory: filepath.Join(filepath.Clean(root), launch),
+		launch:    launch,
+		started:   time.Now().UnixNano(),
+		touched:   time.Now(),
+		inFlight:  1,
+	}
+	reviewMu.Lock()
+	reviewLedger[key] = unpersisted
+	reviewMu.Unlock()
+	t.Cleanup(func() {
+		reviewMu.Lock()
+		delete(reviewLedger, key)
+		reviewMu.Unlock()
+	})
+
+	if res, existed, err := ReserveExistingReview(root, launch); !existed || res != nil || !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("ReserveExistingReview on unpersisted entry with failing sync = (%v, %v, %v), want (nil, true, ErrUnavailable)", res, existed, err)
+	}
+	// Restore syncDirFn: once persistence can succeed, ReserveExistingReview persists the marker and admits.
+	syncDirFn = origSync
+	res, existed, err := ReserveExistingReview(root, launch)
+	if !existed || err != nil || res == nil {
+		t.Fatalf("ReserveExistingReview after sync restored = (%v, %v, %v), want (non-nil, true, nil)", res, existed, err)
+	}
+	res.Release()
+	if _, statErr := os.Stat(filepath.Join(root, launch, "receipt.json")); statErr != nil {
+		t.Fatalf("ReserveExistingReview admitted without persisting receipt marker: %v", statErr)
+	}
+}
