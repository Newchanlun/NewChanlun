+func (c *Collector) applyStrictFrame(frame parsedStrictFrame, isConsumer bool) {
+	c.mu.Lock()
+	if c.modelMismatch && c.invalid {
+		c.mu.Unlock()
+		return
+	}
+	t := &c.producer
+	if isConsumer {
+		t = &c.consumer
+	}
+	if t.sawCompleted || (isConsumer && c.observedCompleted) {
+		c.mu.Unlock()
+		c.taintStreamAnomaly()
+		return
+	}
+	t.sawAnyFrame = true
+	switch frame.evType {
+	case "response.created", "response.queued", "response.in_progress":
+		var seenSnapKeys map[string]struct{}
+		if frame.hasRespOutput {
+			if t.hasMaxOutputIndex && int64(len(frame.respItems)) <= t.maxOutputIndex {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			if t.pendingUnkeyed > 0 && len(frame.respItems) < t.pendingUnkeyed {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			seenSnapKeys = make(map[string]struct{}, len(frame.respItems))
+		}
+		for idx, item := range frame.respItems {
+			pos := int64(idx)
+			canonKey, effItemID, effIdx, effHasIdx, okBind := t.bindIdentity(item.ID, pos, true)
+			if !okBind {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			if seenSnapKeys != nil && canonKey != "" {
+				seenSnapKeys[canonKey] = struct{}{}
+			}
+			isAssistantMsg := item.Type == "message" && item.Role == "assistant"
+			if isIrreversibleFailureItemStatus(item.Status) || (!isAssistantMsg && item.Status == "incomplete") {
+				if canonKey == "" {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if _, alreadyDone := t.doneItemKeys[canonKey]; alreadyDone {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if _, alreadyCompSub := t.completedSubItemKeys[canonKey]; alreadyCompSub {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if _, exists := t.failedItemKeys[canonKey]; !exists && len(t.failedItemKeys) >= maxTrackedOutputItems {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if t.failedItemKeys == nil {
+					t.failedItemKeys = make(map[string]struct{})
+				}
+				t.failedItemKeys[canonKey] = struct{}{}
+			} else if item.Status == "incomplete" {
+				if canonKey == "" {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if _, exists := t.incompleteItemKeys[canonKey]; !exists && len(t.incompleteItemKeys) >= maxTrackedOutputItems {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if t.incompleteItemKeys == nil {
+					t.incompleteItemKeys = make(map[string]struct{})
+				}
+				t.incompleteItemKeys[canonKey] = struct{}{}
+			}
+			_, alreadyDoneSnap := t.doneItems[canonKey]
+			isDone := item.Status == "completed" || (isAssistantMsg && item.Status == "incomplete") || (alreadyDoneSnap && item.Status == "")
+			if _, mustBeIncomplete := t.incompleteItemKeys[canonKey]; mustBeIncomplete && item.Status != "incomplete" {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			if isDone && canonKey != "" {
+				if _, failed := t.failedItemKeys[canonKey]; failed {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+			} else if !isDone && canonKey != "" && item.Status != "" {
+				if _, alreadyCompSub := t.completedSubItemKeys[canonKey]; alreadyCompSub {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+			}
+			snapKind := classifyOutputItemKind(item.Type, item.Role, item.Phase, isDone)
+			if !t.recordItemKind(canonKey, snapKind) || !t.recordItemType(canonKey, item.Type) {
+				c.mu.Unlock()
+				c.taintStreamAnomaly()
+				return
+			}
+			if isAssistantMsg {
+				if t.hasTrackedToolPayload(canonKey) {
+					c.mu.Unlock()
+					c.taintStreamAnomaly()
+					return
+				}
+				if existingParts, hasExisting := t.contentPartByItem[canonKey]; hasExisting {
+					for cIdx := range existingParts {
+						if cIdx < 0 || int(cIdx) >= len(item.Content) {
+							c.mu.Unlock()
+							c.taintStreamAnomaly()
+							return
+						}
+					}
+				}
+				if deltaHashes, hasDeltas := t.textDeltaHashByItem[canonKey]; hasDeltas {
+					for cIdx := range deltaHashes {
+						if cIdx < 0 || int(cIdx) >= len(item.Content) {
+							c.mu.Unlock()
+							c.taintStreamAnomaly()
+							return
+						}
+					}
+				}
+				if prefixes, hasPrefixes := t.textPrefixByItem[canonKey]; hasPrefixes {
+					for cIdx := range prefixes {
+						if cIdx < 0 || int(cIdx) >= len(item.Content) {
+							c.mu.Unlock()
+							c.taintStreamAnomaly()
+							return
+						}
+					}
+				}
+				if isDone {
+					for cIdx, part := range item.Content {
+						if !t.recordContentPart(canonKey, int64(cIdx), part.Type, part.Text) {
+							c.mu.Unlock()
+							c.taintStreamAnomaly()
+							return
+						}
+					}
+				} else {
+					for cIdx, part := range item.Content {
+						var okPart bool
+						if part.Type == "output_text" {
+							okPart = t.recordSnapshotText(canonKey, int64(cIdx), part.Text)
+						} else {
+							okPart = t.recordContentPart(canonKey, int64(cIdx), part.Type, "")
+						}
+						if !okPart {
+							c.mu.Unlock()
+							c.taintStreamAnomaly()
+							return
+						}
+					}
+				}
+			} else {
+				if existingParts, hasParts := t.contentPartByItem[canonKey]; hasParts {
+					for _, tag := range existingParts {
+						if isAssistantOnlyPartTag(tag) {
+							c.mu.Unlock()
+							c.taintStreamAnomaly()
+							return
+						}
+					}
+				}
