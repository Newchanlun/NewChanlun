+func TestReviewReceiptUnpersistedTaintNeverEvictedAfterLifetime(t *testing.T) {
+	reviewMu.Lock()
+	oldCap := maxReviewLedgerEntries
+	oldLedger := reviewLedger
+	oldOverflow := taintWriteOverflow
+	maxReviewLedgerEntries = 1
+	reviewLedger = make(map[string]*reviewEntry)
+	taintWriteOverflow = false
+	reviewMu.Unlock()
+	t.Cleanup(func() {
+		reviewMu.Lock()
+		maxReviewLedgerEntries = oldCap
+		reviewLedger = oldLedger
+		taintWriteOverflow = oldOverflow
+		reviewMu.Unlock()
+	})
+
+	// Fail syncDirFn during TaintReview on a valid 0700 private root so entry enters reviewLedger,
+	// taint persistence fails (taintedPersisted=false), and removing the unflushed empty dir leaves
+	// zero disk footprint (even as root on Linux).
+	base := t.TempDir()
+	root := filepath.Join(base, "receipts")
+	if err := os.Mkdir(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	origSync := syncDirFn
+	syncDirFn = func(string) error { return errors.New("simulated dir sync failure") }
+	t.Cleanup(func() { syncDirFn = origSync })
+
+	lTainted := "review-9999aaaa-2222-4333-8444-555555555501"
+	sTainted := "019d0000-0000-7000-8000-000000000901"
+	TaintReview(root, lTainted)
+
+	// Storage recovers and the unflushed empty launch dir is absent on disk; entry ages past 2 * ReviewTurnLifetime.
+	syncDirFn = origSync
+	_ = os.Remove(filepath.Join(root, lTainted))
+	if _, statErr := os.Stat(filepath.Join(root, lTainted)); !os.IsNotExist(statErr) {
+		t.Fatalf("expected zero disk footprint for failed taint persist, got %v", statErr)
+	}
+	reviewMu.Lock()
+	ent := reviewLedger[root+"\x00"+lTainted]
+	if ent == nil || !ent.tainted || ent.taintedPersisted {
+		reviewMu.Unlock()
+		t.Fatalf("expected unpersisted tainted entry in ledger, got %+v", ent)
+	}
+	ent.touched = time.Now().Add(-2 * ReviewTurnLifetime)
+	reviewMu.Unlock()
+
+	// Another launch MUST NOT evict the unpersisted tainted entry even after ReviewTurnLifetime.
+	lOther := "review-9999aaaa-2222-4333-8444-555555555502"
+	sOther := "019d0000-0000-7000-8000-000000000902"
+	if _, _, err := BeginReview(context.Background(), root, lOther, sOther, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("expired unpersisted taint was evicted for new launch: err=%v", err)
+	}
+	// Re-presenting the tainted launch itself MUST still fail closed and never become sealable.
+	if _, _, err := BeginReview(context.Background(), root, lTainted, sTainted, "gpt-6.2-sol"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("tainted launch resurrected after storage recovery: err=%v", err)
+	}
+	if st := SealReview(root, lTainted, sTainted); st != SealRejected {
+		t.Fatalf("SealReview accepted unpersisted tainted launch: %v", st)
+	}
+}
