+func readReviewReceiptFile(t *testing.T, root, launch string) ReviewReceipt {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(root, launch, "receipt.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var r ReviewReceipt
+	if err := json.Unmarshal(data, &r); err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
