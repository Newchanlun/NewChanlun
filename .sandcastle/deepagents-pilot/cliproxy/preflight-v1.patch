+				if !r.Complete || len(r.Routes) != 1 || r.Routes[0] != "codex:gpt-6.2-sol@chatgpt.com" {
+					t.Fatalf("unexpected legacy Codex preflight receipt: %+v", r)
+				}
+				break
+			}
+			if time.Now().After(deadline) {
+				t.Fatalf("legacy Codex preflight with delayed upstream EOF did not publish receipt: %v", readErr)
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	})
+}
