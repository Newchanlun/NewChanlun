+func TestPreflightReceiptCodexCompressedWireBody(t *testing.T) {
+	cases := []struct {
+		name     string
+		model    string
+		encoding string
+		raw      []byte
+		want     string
+	}{
+		{"valid-zstd-sol", "gpt-6.2-sol", "zstd", compressZstd(t, `{"model":"gpt-6.2-sol","stream":true}`), "codex:gpt-6.2-sol@chatgpt.com"},
+		{"valid-gzip-astra", "gpt-6.2-astra", "gzip", compressGzip(t, `{"model":"gpt-6.2-astra","stream":true}`), "codex:gpt-6.2-astra@chatgpt.com"},
+		{"zstd-model-mismatch", "gpt-6.2-astra", "zstd", compressZstd(t, `{"model":"gpt-6.2-sol","stream":true}`), "other"},
+		{"corrupt-zstd", "gpt-6.2-sol", "zstd", []byte("not-a-zstd-frame"), "other"},
+		{"unknown-encoding", "gpt-6.2-sol", "br", []byte(`{"model":"gpt-6.2-sol"}`), "other"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, c := beginTest(t)
+			ctx, e, err := c.Start(ctx, "codex", tc.model)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var seenBody []byte
+			client := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+				seenBody, _ = io.ReadAll(req.Body)
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+			})})
+			req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", bytes.NewReader(tc.raw))
+			req.Header.Set("Content-Encoding", tc.encoding)
+			resp, err := client.Do(req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			_ = resp.Body.Close()
+			e.End()
+			c.Complete(true)
+			c.HandlerDone(true)
+			if !bytes.Equal(seenBody, tc.raw) {
+				t.Fatalf("downstream compressed body mutated")
+			}
+			r := readReceipt(t, c)
+			if !r.Complete || len(r.Routes) != 1 || r.Routes[0] != tc.want {
+				t.Fatalf("routes = %+v, want [%s]", r.Routes, tc.want)
+			}
+		})
+	}
+}
