+func recordExistingReviewTurnFailure(entry *reviewEntry, turnSeq uint64, taint bool) {
+	defer releaseReview(entry)
+	entry.mu.Lock()
+	if !entry.sealed && !entry.tainted {
+		if taint {
+			entry.taintAndPersistLocked()
+		} else {
+			if turnSeq > entry.failedTurnSeq {
+				entry.failedTurnSeq = turnSeq
+			}
+			latestPubSeq := uint64(0)
+			if len(entry.publishedTurns) > 0 {
+				latestPubSeq = entry.publishedTurns[len(entry.publishedTurns)-1].seq
+			}
+			entry.lastTurnFailed = entry.failedTurnSeq > latestPubSeq
+			if entry.lastTurnFailed {
+				if err := entry.persistLocked(); err != nil {
+					entry.taintAndPersistLocked()
+				}
+			}
+		}
+	}
+	entry.mu.Unlock()
+}
+
+// BeginPendingReview registers a bounded in-memory pre-admission guard BEFORE reading the
+// HTTP body and assigns the turn's monotonic sequence number up front so earlier concurrent
+// requests cannot clear a later rejected request's failure. If an existing unsealed launch
+// or an active brand-new pending launch is rejected due to the global pre-admission cap,
+// the rejection sequence is recorded atomically before releasing reviewMu.
+func BeginPendingReview(root, launch string) (*PendingReviewGuard, error) {
+	cleanRoot, ok := cleanPrivateRoot(root)
+	if !ok || !reviewLaunchPattern.MatchString(launch) {
+		return nil, ErrUnavailable
+	}
+	key := cleanRoot + "\x00" + launch
+	reviewMu.Lock()
+	entry := reviewLedger[key]
+	if entry != nil && (entry.sealedFlag || entry.sealing) {
+		reviewMu.Unlock()
+		return nil, errReviewSealed
+	}
+	reviewTurnSeqGen++
+	turnSeq := reviewTurnSeqGen
+	st := pendingReviewLaunches[key]
+	if pendingReviewTotal >= maxPendingReviewInFlight {
+		if st != nil && turnSeq > st.failedTurnSeq {
+			st.failedTurnSeq = turnSeq
+		}
+		if entry != nil {
+			entry.inFlight++
+			reviewMu.Unlock()
+			recordExistingReviewTurnFailure(entry, turnSeq, false)
+			return nil, ErrUnavailable
+		}
+		reviewMu.Unlock()
+		return nil, ErrUnavailable
+	}
+	if st != nil {
+		if st.tainted {
+			if entry != nil {
+				entry.inFlight++
+				reviewMu.Unlock()
+				recordExistingReviewTurnFailure(entry, turnSeq, true)
+				return nil, ErrUnavailable
+			}
+			reviewMu.Unlock()
+			return nil, ErrUnavailable
+		}
+		st.count++
+		pendingReviewTotal++
+		reviewMu.Unlock()
+		return &PendingReviewGuard{key: key, turnSeq: turnSeq}, nil
+	}
+	if len(pendingReviewLaunches) >= maxPendingReviewLaunches {
+		if entry != nil {
+			entry.inFlight++
+			reviewMu.Unlock()
+			recordExistingReviewTurnFailure(entry, turnSeq, false)
+			return nil, ErrUnavailable
+		}
+		reviewMu.Unlock()
+		return nil, ErrUnavailable
+	}
+	pendingReviewLaunches[key] = &pendingReviewState{count: 1, started: time.Now().UnixNano()}
+	pendingReviewTotal++
+	reviewMu.Unlock()
+	return &PendingReviewGuard{key: key, turnSeq: turnSeq}, nil
+}
