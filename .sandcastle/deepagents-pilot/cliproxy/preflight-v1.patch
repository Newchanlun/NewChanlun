+func TestReviewReceiptStagingCollisionRetriesWithoutDeletingPreexisting(t *testing.T) {
+	// Astra P2 #4 (PR #2280 R41): colliding staging names MUST retry with a fresh name without
+	// deleting pre-existing colliding files and without failing valid publish/seal.
+	root := filepath.Join(t.TempDir(), "staging-retry")
+	if err := ensurePrivateRoot(root); err != nil {
+		t.Fatal(err)
+	}
+	lease, err := acquirePrivateRootLease(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lease.Close()
+	stagingRoot, err := ensureStagingDir(lease.dir, root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stagingRoot.Close()
+
+	c1 := filepath.Join(root, ".staging", "pending-1-1-0000000000000001")
+	c2 := filepath.Join(root, ".staging", "pending-1-2-0000000000000002")
+	if err := os.WriteFile(c1, []byte("keep-1"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(c2, []byte("keep-2"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	candidates := []string{
+		"pending-1-1-0000000000000001",
+		"pending-1-2-0000000000000002",
+		"pending-1-3-0000000000000003",
+	}
+	idx := 0
+	name, f, release, err := createStagingFileWithGen(stagingRoot, root, func() (string, error) {
+		n := candidates[idx]
+		idx++
+		return n, nil
+	})
+	if err != nil || name != candidates[2] {
+		t.Fatalf("createStagingFileWithGen = (%q, %v), want (%q, nil)", name, err, candidates[2])
+	}
+	_ = f.Close()
+	_ = stagingRoot.Remove(name)
+	release()
+	if got1, err := os.ReadFile(c1); err != nil || string(got1) != "keep-1" {
+		t.Fatalf("colliding file c1 was removed/modified: err=%v raw=%q", err, string(got1))
+	}
+	if got2, err := os.ReadFile(c2); err != nil || string(got2) != "keep-2" {
+		t.Fatalf("colliding file c2 was removed/modified: err=%v raw=%q", err, string(got2))
+	}
+}
