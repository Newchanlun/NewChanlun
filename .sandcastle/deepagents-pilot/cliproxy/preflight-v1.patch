+	}
+	badSealFile := filepath.Join(badSealDir, "seal.sha256")
+	if err := os.WriteFile(badSealFile, []byte(sha256Hex(string(badSealRecData))+"\n"), 0600); err != nil {
+		t.Fatal(err)
