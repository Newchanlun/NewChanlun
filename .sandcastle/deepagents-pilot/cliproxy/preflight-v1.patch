+func TestPreflightReceiptPluginReloadInvalidatesGuard(t *testing.T) {
+	h := New()
+	guard := h.PreflightEvidenceGuard()
+	if !guard() {
+		t.Fatal("empty host rejected")
+	}
+	h.snapshot.Store(emptySnapshot())
+	if guard() {
+		t.Fatal("reload accepted old evidence guard")
+	}
+	h.snapshot.Store(&Snapshot{records: []capabilityRecord{{}}})
+	if h.PreflightEvidenceGuard()() {
+		t.Fatal("nonempty host accepted")
+	}
+}
