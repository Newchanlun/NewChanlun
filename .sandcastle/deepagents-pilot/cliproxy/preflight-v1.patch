+func TestReviewReceiptStrictCompletionAndCrossExecutionOutputIsolation(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "receipts")
+	runSingle := func(t *testing.T, launch, session string, chunks []string) *ReviewReceipt {
+		t.Helper()
+		ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, e, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+		if err != nil {
+			t.Fatal(err)
+		}
+		client := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+		})})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+		resp, err := client.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, ch := range chunks {
+			c.ObserveStreamChunk([]byte(ch))
+		}
+		_ = resp.Body.Close()
+		e.End()
+		c.Complete(true)
+		c.HandlerDone(true)
+		raw, err := os.ReadFile(filepath.Join(root, launch, "receipt.json"))
+		if err != nil {
+			return nil
+		}
+		var r ReviewReceipt
+		if err := json.Unmarshal(raw, &r); err != nil {
+			t.Fatal(err)
+		}
+		return &r
+	}
+
+	// 1. response.done is NOT accepted as terminal completion.
+	if r := runSingle(t, "review-eeee1111-2222-4333-8444-555555555501", "019d0000-0000-7000-8000-000000000501", []string{
+		`data: {"type":"response.done","response":{"id":"resp_done","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+	}); r != nil && r.Complete {
+		t.Fatalf("response.done accepted as complete: %+v", r)
+	}
+	// 2. Empty response.status -> tainted.
+	if r := runSingle(t, "review-eeee1111-2222-4333-8444-555555555502", "019d0000-0000-7000-8000-000000000502", []string{
+		`data: {"type":"response.completed","response":{"id":"resp_nostatus","status":"","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+	}); r == nil || !r.Tainted || r.Complete {
+		t.Fatalf("empty status did not taint: %+v", r)
+	}
+	// 3. Non-null response.error -> tainted.
+	if r := runSingle(t, "review-eeee1111-2222-4333-8444-555555555503", "019d0000-0000-7000-8000-000000000503", []string{
+		`data: {"type":"response.completed","response":{"id":"resp_err","status":"completed","model":"gpt-6.2-sol","error":{"message":"failed"},"output":[]}}` + "\n\n",
+	}); r == nil || !r.Tainted || r.Complete {
+		t.Fatalf("non-null error did not taint: %+v", r)
+	}
+	// 3b. Top-level event error paired with response.completed -> tainted.
+	if r := runSingle(t, "review-eeee1111-2222-4333-8444-555555555508", "019d0000-0000-7000-8000-000000000508", []string{
+		`data: {"type":"response.completed","error":{"code":"rate_limit_exceeded"},"response":{"id":"resp_outer_err","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+	}); r == nil || !r.Tainted || r.Complete {
+		t.Fatalf("top-level error on response.completed did not taint: %+v", r)
+	}
+	// 4. Duplicate response.completed -> tainted.
+	if r := runSingle(t, "review-eeee1111-2222-4333-8444-555555555504", "019d0000-0000-7000-8000-000000000504", []string{
+		`data: {"type":"response.completed","response":{"id":"resp_dup1","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+		`data: {"type":"response.completed","response":{"id":"resp_dup2","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+	}); r == nil || !r.Tainted || r.Complete {
+		t.Fatalf("duplicate response.completed did not taint: %+v", r)
+	}
+	// 5. Unattributed output_item.done without response.created is NOT adopted.
+	if r := runSingle(t, "review-eeee1111-2222-4333-8444-555555555505", "019d0000-0000-7000-8000-000000000505", []string{
+		`data: {"type":"response.output_item.done","item":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"unattributed"}]}}` + "\n\n",
+		`data: {"type":"response.completed","response":{"id":"resp_no_created","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+	}); r == nil || !r.Complete || r.LastOutputSHA256 != "" {
+		t.Fatalf("unattributed output_item.done leaked into receipt: %+v", r)
+	}
+	// 6. Matching response.created + output_item.done + response.completed IS adopted.
+	if r := runSingle(t, "review-eeee1111-2222-4333-8444-555555555506", "019d0000-0000-7000-8000-000000000506", []string{
+		`data: {"type":"response.created","response":{"id":"resp_bound"}}` + "\n\n",
+		`data: {"type":"response.output_item.done","item":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"bound-text"}]}}` + "\n\n",
+		`data: {"type":"response.completed","response":{"id":"resp_bound","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n",
+	}); r == nil || !r.Complete || r.LastOutputSHA256 != sha256Hex("bound-text") {
+		t.Fatalf("bound output_item.done not adopted: %+v", r)
+	}
+	// 7. Execution 1 aborted after output_item.done MUST NOT leak into retry Execution 2's response.completed.
+	launchIso := "review-eeee1111-2222-4333-8444-555555555507"
+	sessionIso := "019d0000-0000-7000-8000-000000000507"
+	ctx, c, err := BeginReview(context.Background(), root, launchIso, sessionIso, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx1, e1, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl1 := httptransport.Decorate(ctx1, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+	})})
+	rq1, _ := http.NewRequestWithContext(ctx1, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	rp1, err := cl1.Do(rq1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.ObserveStreamChunk([]byte(`data: {"type":"response.created","response":{"id":"resp_aborted"}}` + "\n\n"))
+	c.ObserveStreamChunk([]byte(`data: {"type":"response.output_item.done","item":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"leaked-from-exec1"}]}}` + "\n\n"))
+	_ = rp1.Body.Close()
+	e1.End()
+
+	ctx2, e2, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl2 := httptransport.Decorate(ctx2, &http.Client{Transport: fakeTransport(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}, nil
+	})})
+	rq2, _ := http.NewRequestWithContext(ctx2, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol"}`))
+	rp2, err := cl2.Do(rq2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.ObserveStreamChunk([]byte(`data: {"type":"response.created","response":{"id":"resp_retry"}}` + "\n\n"))
+	c.ObserveStreamChunk([]byte(`data: {"type":"response.completed","response":{"id":"resp_retry","status":"completed","model":"gpt-6.2-sol","output":[]}}` + "\n\n"))
+	_ = rp2.Body.Close()
+	e2.End()
+	c.Complete(true)
+	c.HandlerDone(true)
+	if r := readReviewReceiptFile(t, root, launchIso); !r.Complete || r.Tainted || r.LastOutputSHA256 != "" || r.LastResponseID != sha256Hex("resp_retry") {
+		t.Fatalf("cross-execution output hash leaked: %+v", r)
+	}
+}
