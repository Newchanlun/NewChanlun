+		mgr.RegisterExecutor(runtimeexecutor.NewCodexAutoExecutor(srv.cfg))
+		const did = "review-receipt-codex-delayed-eof"
+		cred := &auth.Auth{ID: did, Provider: "codex", Status: auth.StatusActive,
+			Attributes: map[string]string{auth.AttributeAuthKind: auth.AuthKindOAuth},
+			Metadata:   map[string]any{"access_token": "offline-fake", "websockets": true},
+		}
+		if _, err := mgr.Register(context.Background(), cred); err != nil {
+			t.Fatal(err)
+		}
+		registry.GetGlobalRegistry().RegisterClient(did, "codex", []*registry.ModelInfo{{ID: "gpt-6.2-sol"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(did) })
+
+		proxy := httptest.NewServer(srv.engine)
+		defer proxy.Close()
+		clientReq, err := http.NewRequest(http.MethodPost, proxy.URL+"/v1/responses",
+			strings.NewReader(`{"model":"gpt-6.2-sol","stream":true,"input":"delayed-eof"}`))
+		if err != nil {
+			t.Fatal(err)
+		}
+		clientReq.Header.Set("Authorization", "Bearer test-key")
+		clientReq.Header.Set("Content-Type", "application/json")
+		clientReq.Header.Set(preflightreceipt.ReviewHeader, launch)
+		clientReq.Header.Set("Session-Id", session)
+		resp, err := proxy.Client().Do(clientReq)
+		if err != nil {
+			t.Fatal(err)
+		}
+		scanner := bufio.NewScanner(resp.Body)
+		sawCompleted := false
+		for scanner.Scan() {
+			if strings.Contains(scanner.Text(), `"type":"response.completed"`) {
+				sawCompleted = true
+				break // Simulate Codex closing immediately upon observing response.completed.
+			}
+		}
+		_ = resp.Body.Close()
+		if !sawCompleted {
+			t.Fatalf("client never received response.completed (status=%d)", resp.StatusCode)
+		}
+		waitReceipt(t, launch, func(r preflightreceipt.ReviewReceipt) bool { return r.Complete && !r.Tainted && r.Requests == 1 })
+		var sealRes *httptest.ResponseRecorder
+		deadline := time.Now().Add(2 * time.Second)
+		for {
+			sealRes = seal(launch, session)
+			if sealRes.Code != http.StatusConflict || time.Now().After(deadline) {
+				break
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		if sealRes.Code != http.StatusOK {
+			t.Fatalf("SealReview after immediate post-completed client close = %d %s, want 200", sealRes.Code, sealRes.Body.String())
+		}
+	})
+}
+
+type notifyOnReadReader struct {
+	r      io.ReadCloser
+	onRead func()
+}
+
+func (n *notifyOnReadReader) Read(p []byte) (int, error) {
+	if n.onRead != nil {
+		n.onRead()
+	}
+	return n.r.Read(p)
+}
+
+func (n *notifyOnReadReader) Close() error {
+	return n.r.Close()
+}
