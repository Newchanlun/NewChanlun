+type notifyEOFReader struct {
+	data   string
+	offset int
+	onEOF  func()
+	fired  bool
+}
+
+func (r *notifyEOFReader) Read(p []byte) (int, error) {
+	if r.offset < len(r.data) {
+		n := copy(p, r.data[r.offset:])
+		r.offset += n
+		if r.offset >= len(r.data) && !r.fired {
+			r.fired = true
+			if r.onEOF != nil {
+				r.onEOF()
+			}
+		}
+		return n, nil
+	}
+	if !r.fired {
+		r.fired = true
+		if r.onEOF != nil {
+			r.onEOF()
+		}
+	}
+	return 0, io.EOF
+}
+
+func (r *notifyEOFReader) Close() error { return nil }
