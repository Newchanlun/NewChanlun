+func TestRoundTrip_ConcurrentPreflightPreservesRequestInitiationOrder(t *testing.T) {
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	token := "preflight-12345678-1234-4234-8234-123456789390"
+	ctx, c, err := Begin(context.Background(), root, token)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx1, e1, err := c.Start(ctx, "kimi", "kimi-k3.1-pro")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx2, e2, err := c.Start(ctx, "claude", "claude-opus-4-6")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	req1Entered := make(chan struct{})
+	req2Finished := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(2)
+
+	go func() {
+		defer wg.Done()
+		cl1 := httptransport.Decorate(ctx1, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+			close(req1Entered)
+			<-req2Finished // Force request 1 to respond AFTER request 2.
+			return &http.Response{
+				StatusCode: 200,
+				Header:     make(http.Header),
+				Body:       io.NopCloser(strings.NewReader("ok1")),
+				TLS:        verifiedTLSState("api.kimi.com"),
+			}, nil
+		})})
+		req1, _ := http.NewRequestWithContext(ctx1, http.MethodPost, "https://api.kimi.com/v1/messages", strings.NewReader("{}"))
+		resp1, err := cl1.Do(req1)
+		if err != nil {
+			t.Errorf("req1 err: %v", err)
+			return
+		}
+		_, _ = io.Copy(io.Discard, resp1.Body)
+		_ = resp1.Body.Close()
+		e1.End()
+	}()
+
+	go func() {
+		defer wg.Done()
+		<-req1Entered // Guarantee request 2 is initiated AFTER request 1.
+		cl2 := httptransport.Decorate(ctx2, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+			return &http.Response{
+				StatusCode: 200,
+				Header:     make(http.Header),
+				Body:       io.NopCloser(strings.NewReader("ok2")),
+				TLS:        verifiedTLSState("api.anthropic.com"),
+			}, nil
+		})})
+		req2, _ := http.NewRequestWithContext(ctx2, http.MethodPost, "https://api.anthropic.com/v1/messages", strings.NewReader("{}"))
+		resp2, err := cl2.Do(req2)
+		if err != nil {
+			t.Errorf("req2 err: %v", err)
+			return
+		}
+		_, _ = io.Copy(io.Discard, resp2.Body)
+		_ = resp2.Body.Close()
+		e2.End()
+		close(req2Finished)
+	}()
+
+	wg.Wait()
+	c.Complete(true)
+	c.HandlerDone(true)
+
+	raw, err := os.ReadFile(filepath.Join(root, token, "receipt.json"))
+	if err != nil {
+		t.Fatalf("read receipt.json: %v", err)
+	}
+	var got Receipt
+	if err := json.Unmarshal(raw, &got); err != nil {
+		t.Fatalf("unmarshal receipt.json: %v", err)
+	}
+	want := []string{"kimi@api.kimi.com", "claude@api.anthropic.com"}
+	if len(got.Routes) != len(want) || got.Routes[0] != want[0] || got.Routes[1] != want[1] {
+		t.Fatalf("receipt.Routes = %v, want request-initiation order %v", got.Routes, want)
+	}
+}
