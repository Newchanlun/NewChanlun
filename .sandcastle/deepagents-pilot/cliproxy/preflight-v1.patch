+}
+
+func (c *Collector) maybeReleaseReviewLocked() {
+	if c.review != nil && !c.reviewReleased && c.handlerDone && c.active == 0 && c.bodies == 0 && (c.sealed || c.lifecycleDone || c.invalid || c.attemptFailed) {
+		if !c.reviewPublished {
+			entry := c.review
+			entry.mu.Lock()
+			if !entry.sealed && !entry.tainted {
+				if c.reviewTurnSeq > entry.failedTurnSeq {
+					entry.failedTurnSeq = c.reviewTurnSeq
+				}
+				latestPubSeq := uint64(0)
+				if len(entry.publishedTurns) > 0 {
+					latestPubSeq = entry.publishedTurns[len(entry.publishedTurns)-1].seq
+				}
+				entry.lastTurnFailed = entry.failedTurnSeq > latestPubSeq
+				if entry.lastTurnFailed {
+					if err := entry.persistLocked(); err != nil {
+						entry.taintAndPersistLocked()
+					}
+				}
+			}
+			entry.mu.Unlock()
+		}
+		c.reviewReleased = true
+		releaseReview(c.review)
+	}
+}
+
+func (c *Collector) publishLocked() {
+	defer c.maybeReleaseReviewLocked()
+	if c.invalid || c.attemptFailed || c.sealed || !c.handlerDone || !c.lifecycleDone || c.active != 0 || c.bodies != 0 || c.executions == 0 || len(c.receipt.Routes) == 0 {
+		return
+	}
+	now := time.Now()
+	if now.After(c.deadline) {
+		c.invalid = true
+		return
+	}
+	c.sealed = true
+	if c.review != nil {
+		routes := append([]string(nil), c.receipt.Routes...)
+		observedCompleted := c.observedCompleted
+		modelMismatch := c.modelMismatch
+		if c.strictCodex && c.lastAttemptRequiredProducer && !c.lastAttemptProducerVerified {
+			modelMismatch = true
+		}
+		lastResp := c.lastResponseIDSHA
+		lastOut := c.lastOutputSHA
+		entry := c.review
+		entry.mu.Lock()
+		defer entry.mu.Unlock()
+		if entry.sealed {
+			return
+		}
+		if entry.tainted || modelMismatch {
+			entry.taintAndPersistLocked()
+			return
+		}
+		for _, r := range routes {
+			if r != "codex:gpt-6.2-sol@chatgpt.com" && r != "codex:gpt-6.2-astra@chatgpt.com" {
+				entry.taintAndPersistLocked()
+				return
+			}
+			if entry.route == "" {
+				entry.route = r
+			} else if entry.route != r {
+				entry.taintAndPersistLocked()
+				return
+			}
+		}
+		if !observedCompleted || !isSHA256Hex(lastResp) {
+			return
+		}
+		if len(entry.responseIDSHAs) >= maxReviewResponseIDs {
+			entry.taintAndPersistLocked()
+			return
+		}
+		finished := time.Now().UnixNano()
+		if entry.started <= 0 || finished < entry.started || finished-entry.started > int64(MaxReviewDuration) {
+			entry.taintAndPersistLocked()
+			return
+		}
+		turnRec := reviewPublishedTurn{
+			seq:        c.reviewTurnSeq,
+			responseID: lastResp,
+			outputSHA:  lastOut,
+		}
+		pos := len(entry.publishedTurns)
+		for pos > 0 && entry.publishedTurns[pos-1].seq > turnRec.seq {
+			pos--
+		}
+		entry.publishedTurns = append(entry.publishedTurns, reviewPublishedTurn{})
+		copy(entry.publishedTurns[pos+1:], entry.publishedTurns[pos:])
+		entry.publishedTurns[pos] = turnRec
+		entry.responseIDSHAs = make([]string, len(entry.publishedTurns))
+		for i, pt := range entry.publishedTurns {
+			entry.responseIDSHAs[i] = pt.responseID
+		}
+		latest := entry.publishedTurns[len(entry.publishedTurns)-1]
+		entry.requests = len(entry.publishedTurns)
+		entry.lastResponseIDSHA = latest.responseID
+		entry.lastOutputSHA = latest.outputSHA
+		entry.lastTurnFailed = entry.failedTurnSeq > latest.seq
+		if finished > entry.finished {
+			entry.finished = finished
+		}
+		if err := entry.persistLocked(); err != nil {
+			entry.taintAndPersistLocked()
+			return
+		}
+		c.reviewPublished = true
+		return
+	}
+	c.receipt.Complete = true
+	c.receipt.Finished = now.UnixNano()
+	if c.receipt.Finished < c.receipt.Started || c.receipt.Finished-c.receipt.Started > int64(Lifetime) {
+		return
+	}
+	data, err := json.Marshal(c.receipt)
+	if err != nil {
+		return
+	}
+	rootDir := filepath.Dir(c.directory)
+	rootLease, err := acquirePrivateRootLease(rootDir)
+	if err != nil {
+		return
+	}
+	defer rootLease.Close()
+	subRoot, subFI, err := openVerifiedSubdir(rootLease.dir, c.receipt.Session)
+	if err != nil {
+		return
+	}
+	defer subRoot.Close()
+	if c.hasDirID {
+		if sDev, sIno, okID := statDevIno(subFI); okID && (sDev != c.dirDev || sIno != c.dirIno) {
+			return
+		}
+	}
+	// Refuse to publish into a polluted session directory containing unexpected files (such as
+	// crash-left temp files or a pre-existing receipt.json); only our reservation marker may exist.
+	subDirFile, err := subRoot.Open(".")
+	if err != nil {
+		return
+	}
+	subEntries, readDirErr := subDirFile.ReadDir(4)
+	_ = subDirFile.Close()
+	if readDirErr != nil && !errors.Is(readDirErr, io.EOF) {
+		return
+	}
+	for _, ent := range subEntries {
+		if ent.Name() != "producer.json" {
+			return
+		}
+	}
+	stagingRoot, err := ensureStagingDir(rootLease.dir, rootDir)
+	if err != nil {
+		return
+	}
+	defer stagingRoot.Close()
+	stagingDirFD, _, _, _, err := openPinnedDirFD(stagingRoot)
+	if err != nil {
+		return
+	}
+	defer stagingDirFD.Close()
+	subDirFD, subFDDev, subFDIno, hasSubFDID, err := openPinnedDirFD(subRoot)
+	if err != nil {
+		return
+	}
+	defer subDirFD.Close()
+	if c.hasDirID && hasSubFDID && (subFDDev != c.dirDev || subFDIno != c.dirIno) {
+		return
+	}
+	// Stage temporary file inside <root>/.staging and publish via descriptor-pinned non-overwriting linkat:
+	// neither .staging nor <session> is re-resolved by path, readers see all or nothing, and an existing
+	// receipt.json is never clobbered.
+	tmp, f, releaseTmp, err := createStagingFile(stagingRoot, rootDir, "pending")
+	if err != nil {
+		return
+	}
+	defer releaseTmp()
+	_, errWrite := f.Write(data)
+	errSync := f.Sync()
+	errClose := f.Close()
+	if errWrite != nil || errSync != nil || errClose != nil {
+		_ = stagingRoot.Remove(tmp)
+		return
+	}
+	if c.hasDirID {
+		if curFI, lerr := rootLease.dir.Lstat(c.receipt.Session); lerr != nil || !curFI.IsDir() || curFI.Mode()&os.ModeSymlink != 0 || curFI.Mode().Perm()&0077 != 0 || !ownedByCurrentUser(curFI) {
+			_ = stagingRoot.Remove(tmp)
+			return
+		} else if curDev, curIno, okCur := statDevIno(curFI); okCur && (curDev != c.dirDev || curIno != c.dirIno) {
+			_ = stagingRoot.Remove(tmp)
+			return
+		}
+	}
+	linkErr := linkatPinned(stagingDirFD, tmp, subDirFD, "receipt.json")
+	_ = stagingRoot.Remove(tmp)
+	if linkErr != nil {
+		return
+	}
+	removeVerifiedMarkerInSubdir(subRoot, c.markerDev, c.markerIno, c.hasMarkerID, c.markerSHA256)
+	_ = syncPinnedDir(subRoot, c.directory)
+}
