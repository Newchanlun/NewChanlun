+	// subsequent replacement of <root>/<launch> still fails closed with SealUnavailable.
+	root := filepath.Join(t.TempDir(), "failed-reclaim-keeps-binding")
+	launch := "review-d3333333-2222-4333-8444-555555555501"
+	session := "019d0000-0000-7000-8000-dddddddddd03"
+
+	ctx, c, err := BeginReview(context.Background(), root, launch, session, "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, e, err := c.Start(ctx, "codex", "gpt-6.2-sol")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cl := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("")), TLS: verifiedTLSState("chatgpt.com")}, nil
+	})})
+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://chatgpt.com/backend-api/codex/responses", strings.NewReader(`{"model":"gpt-6.2-sol","stream":true}`))
+	resp, err := cl.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = io.Copy(io.Discard, resp.Body)
+	_ = resp.Body.Close()
+	c.ObserveStreamChunk([]byte("data: " + `{"type":"response.completed","response":{"id":"resp_fail_reclaim","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","phase":"final_answer","content":[{"type":"output_text","text":"VERDICT: PASS"}]}]}}` + "\n\n"))
+	e.End()
+	c.Complete(true)
+	c.HandlerDone(true)
+
+	st1, d1 := SealReviewWithDigest(root, launch, session)
+	if st1 != SealOK || !isSHA256Hex(d1) {
+		t.Fatalf("initial SealReviewWithDigest = (%v, %q), want SealOK", st1, d1)
+	}
+
+	// Age launch dir + receipt/seal/marker + in-memory timestamps past retention so reclaim attempts it.
+	ancient := time.Now().Add(-48 * time.Hour)
+	dir := filepath.Join(root, launch)
+	recRaw, err := os.ReadFile(filepath.Join(dir, "receipt.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var rr ReviewReceipt
+	if err := json.Unmarshal(recRaw, &rr); err != nil {
+		t.Fatal(err)
+	}
+	rr.Started = ancient.UnixNano()
+	rr.Finished = ancient.UnixNano()
+	rr.SealedAt = ancient.UnixNano()
+	agedRecRaw, _ := json.Marshal(rr)
+	agedSHA := sha256Hex(string(agedRecRaw))
+	agedMarker, _ := json.Marshal(reviewReservationMarker{Schema: ReviewSchema, Launch: launch, Started: ancient.UnixNano()})
+	if err := os.WriteFile(filepath.Join(dir, "receipt.json"), agedRecRaw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "seal.sha256"), []byte(agedSHA), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "producer.json"), agedMarker, 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, p := range []string{filepath.Join(dir, "receipt.json"), filepath.Join(dir, "seal.sha256"), filepath.Join(dir, "producer.json"), dir} {
+		_ = os.Chtimes(p, ancient, ancient)
+	}
+	key := filepath.Clean(root) + "\x00" + launch
+	reviewMu.Lock()
+	if ent := reviewLedger[key]; ent != nil {
+		ent.touched = ancient
+		ent.mu.Lock()
+		ent.sealedReceiptSHA = agedSHA
+		ent.mu.Unlock()
+	}
+	if b, ok := sealedBindings[key]; ok {
+		b.receiptSHA = agedSHA
+		b.recordedAt = ancient
+		sealedBindings[key] = b
+	}
+	reviewMu.Unlock()
+
+	// Block quarantine by replacing <root>/.staging with a regular file -> removeVerifiedLeafSubdir MUST fail.
+	stagingPath := filepath.Join(root, ".staging")
+	_ = os.RemoveAll(stagingPath)
+	if err := os.WriteFile(stagingPath, []byte("block-quarantine"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	lease, err := acquirePrivateRootLease(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	state := &bucketReclaimState{cache: make(map[reclaimCacheKey]reclaimCacheEntry)}
+	if got, _ := reclaimExpiredBucketEntries(lease.dir, root, []string{launch}, true, 1, 0, state); got != 0 {
