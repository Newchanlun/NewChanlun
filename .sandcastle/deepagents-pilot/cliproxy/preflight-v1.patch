+package auth
+
+import (
+	"context"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	execution "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/preflightreceipt"
+)
+
+func TestPreflightReceiptUnsupportedExecutorIsNotCalled(t *testing.T) {
+	ctx, c, err := preflightreceipt.Begin(context.Background(), filepath.Join(t.TempDir(), "receipts"), "preflight-12345678-1234-4234-8234-123456789abc")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Nil and all non-native implementations must be rejected before any method call.
+	if _, _, err = preflightStart(ctx, nil, &Auth{Provider: "claude"}); err == nil {
+		t.Fatal("uncovered executor admitted")
+	}
+	if _, err = preflightCount(nil, ctx, nil, execution.Request{}, execution.Options{}); err == nil {
+		t.Fatal("count admitted")
+	}
+	c.Complete(true)
+	c.HandlerDone(true)
+}
+
+// Complement behavior tests with a coverage tripwire for this pinned dispatcher.
+// Any new direct execution path must pass through the same preflight boundary.
+func TestPreflightReceiptAuthDispatchCoverage(t *testing.T) {
+	entries, err := os.ReadDir(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		if !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") || name == "preflight_execution.go" {
+			continue
+		}
+		file, err := parser.ParseFile(token.NewFileSet(), name, nil, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ast.Inspect(file, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			selector, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok {
+				return true
+			}
+			switch selector.Sel.Name {
+			case "Execute", "ExecuteStream", "CountTokens":
+				t.Errorf("unguarded execution call in %s", name)
+			}
+			return true
+		})
+	}
+}
--- a/sdk/preflightreceipt/receipt.go
