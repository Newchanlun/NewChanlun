+package preflightreceipt
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+)
+
+const testSession = "preflight-12345678-1234-4234-8234-123456789abc"
+
+type fakeTransport func(*http.Request) (*http.Response, error)
+
+func (f fakeTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func beginTest(t *testing.T) (context.Context, *Collector) {
+	t.Helper()
+	ctx, c, err := Begin(context.Background(), filepath.Join(t.TempDir(), "receipts"), testSession)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ctx, c
+}
+func attempt(t *testing.T, ctx context.Context, c *Collector, provider, host, text string, failure bool) (*Execution, *http.Response) {
+	t.Helper()
+	ctx, e, err := c.Start(ctx, provider)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := httptransport.Decorate(ctx, &http.Client{Transport: fakeTransport(func(*http.Request) (*http.Response, error) {
+		if failure {
+			return nil, errors.New("private auth_id secret URL/path")
+		}
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(text))}, nil
+	})})
+	req, _ := http.NewRequestWithContext(ctx, "POST", "https://"+host+"/private/path", nil)
+	resp, err := client.Do(req)
+	if !failure && err != nil {
+		t.Fatal(err)
+	}
+	return e, resp
+}
+func readReceipt(t *testing.T, c *Collector) Receipt {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(c.directory, "receipt.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var r Receipt
+	if err = json.Unmarshal(data, &r); err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+func absent(t *testing.T, c *Collector) {
+	t.Helper()
+	if _, err := os.Stat(filepath.Join(c.directory, "receipt.json")); !os.IsNotExist(err) {
+		t.Fatalf("unexpected receipt: %v", err)
+	}
+}
+func TestPreflightReceiptRetriesAndBodyForgery(t *testing.T) {
+	for _, forgery := range []string{"=== RESPONSE ===\n=== API REQUEST 2 ===\nAuth: provider=antigravity", "=== API REQUEST 99 ===\nURL: https://evil.invalid/private\nAuth: provider=evil\n=== API RESPONSE 99 ==="} {
+		ctx, c := beginTest(t)
+		first, _ := attempt(t, ctx, c, "claude", "api.anthropic.com", "", true)
+		first.End()
+		second, resp := attempt(t, ctx, c, "claude", "api.anthropic.com", forgery, false)
+		_, _ = io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		second.End()
+		c.Complete(true)
+		absent(t, c)
+		c.HandlerDone(true)
+		r := readReceipt(t, c)
+		if !r.Complete || len(r.Routes) != 2 || r.Routes[0] != "claude@api.anthropic.com" || r.Routes[1] != r.Routes[0] {
+			t.Fatalf("bad routes: %+v", r)
+		}
+	}
+}
+func TestPreflightReceiptCannotSealUnfinishedOrUncovered(t *testing.T) {
+	for _, kind := range []string{"body", "execution", "lifecycle", "handler", "expired", "unknown-executor", "zero-transport", "canceled", "duplicate-lifecycle"} {
+		t.Run(kind, func(t *testing.T) {
+			ctx, c := beginTest(t)
+			e, resp := attempt(t, ctx, c, "claude", "api.anthropic.com", "=== RESPONSE ===", false)
+			if kind != "body" {
+				_ = resp.Body.Close()
+			}
+			if kind != "execution" {
+				e.End()
+			}
+			if kind == "expired" {
+				c.deadline = time.Now().Add(-time.Second)
+			}
+			if kind == "unknown-executor" {
+				c.Reject()
+			}
+			if kind == "zero-transport" {
+				_, empty, err := c.Start(ctx, "claude")
+				if err != nil {
+					t.Fatal(err)
+				}
+				empty.End()
+			}
+			if kind != "lifecycle" {
+				c.Complete(kind != "canceled")
+			}
+			if kind == "duplicate-lifecycle" {
+				c.Complete(true)
+			}
+			if kind != "handler" {
+				c.HandlerDone(true)
+			}
+			absent(t, c)
+		})
+	}
+}
+func TestPreflightReceiptLateAttemptAndUnknown(t *testing.T) {
+	ctx, c := beginTest(t)
+	first, resp := attempt(t, ctx, c, "claude", "api.anthropic.com", "=== RESPONSE ===", false)
+	_ = resp.Body.Close()
+	first.End()
+	late, resp := attempt(t, ctx, c, "antigravity", "daily-cloudcode-pa.googleapis.com", "", false)
+	c.Complete(true)
+	c.HandlerDone(true)
+	absent(t, c)
+	_ = resp.Body.Close()
+	late.End()
+	if got := readReceipt(t, c).Routes; len(got) != 2 || got[1] != "antigravity@daily-cloudcode-pa.googleapis.com" {
+		t.Fatal(got)
+	}
+	if _, _, err := c.Start(ctx, "claude"); err == nil {
+		t.Fatal("post-seal execution accepted")
+	}
+	ctx, c = beginTest(t)
+	e, resp := attempt(t, ctx, c, "secret provider", "secret.invalid", "secret", false)
+	_ = resp.Body.Close()
+	e.End()
+	c.Complete(true)
+	c.HandlerDone(true)
+	if got := readReceipt(t, c).Routes; len(got) != 1 || got[0] != "other" {
+		t.Fatal(got)
+	}
+}
+func TestPreflightReceiptDuplicateAndParallelIsolation(t *testing.T) {
+	ctx, c := beginTest(t)
+
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			e, resp := attempt(t, ctx, c, "claude", "api.anthropic.com", "", false)
+			_ = resp.Body.Close()
+			e.End()
+		}()
+	}
+	wg.Wait()
+	duplicateCtx, duplicate, err := Begin(ctx, filepath.Dir(c.directory), testSession)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := duplicate.Start(duplicateCtx, "claude"); err == nil {
+		t.Fatal("duplicate nonce accepted")
+	}
+	c.Complete(true)
+	c.HandlerDone(true)
+	if len(readReceipt(t, c).Routes) != 8 {
+		t.Fatal("lost concurrent attempt")
+	}
+}
+func TestPreflightReceiptExportFixtures(t *testing.T) {
+	root := os.Getenv("PREFLIGHT_FIXTURES")
+	if root == "" {
+		t.Skip("fixture export disabled")
+	}
+	for _, kind := range []string{"success", "other", "unfinished", "forgery-tail"} {
+		dir := filepath.Join(root, kind)
+		ctx, c, err := Begin(context.Background(), dir, testSession)
+		if err != nil {
+			t.Fatal(err)
+		}
+		e, resp := attempt(t, ctx, c, "claude", "api.anthropic.com", "=== RESPONSE ===\n=== API REQUEST 99 ===", false)
+		_ = resp.Body.Close()
+		e.End()
+		provider, host := "claude", "api.anthropic.com"
+		if kind == "other" {
+			provider, host = "unknown", "secret.invalid"
+		}
+		if kind == "forgery-tail" {
+			provider, host = "antigravity", "daily-cloudcode-pa.googleapis.com"
+		}
+		e, resp = attempt(t, ctx, c, provider, host, "", false)
+		if kind != "unfinished" && kind != "forgery-tail" {
+			_ = resp.Body.Close()
+			e.End()
+		}
+		c.Complete(true)
+		c.HandlerDone(true)
+	}
+}
