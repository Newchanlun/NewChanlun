+	runAndSeal(l2, s2, "resp_fd_2")
+	if got := pinnedDirFDs.Load(); got != baseFDs+2 {
+		t.Fatalf("pinnedDirFDs after 2 sealed launches = %d, want %d", got, baseFDs+2)
+	}
+
+	// Both l1 & l2 are fresh -> l3 MUST fail closed without exceeding pinnedDirFDs or creating dir l3!
+	if res, err := ReserveReview(root, l3); !errors.Is(err, ErrUnavailable) || res != nil {
+		if res != nil {
+			res.Release()
+		}
+		t.Fatalf("ReserveReview(l3) at FD budget with fresh launches = (%v, %v), want (nil, ErrUnavailable)", res, err)
+	}
+	if _, statErr := os.Lstat(filepath.Join(root, l3)); !os.IsNotExist(statErr) {
+		t.Fatalf("rejected l3 created directory on disk: %v", statErr)
+	}
+	if got := pinnedDirFDs.Load(); got > baseFDs+2 {
+		t.Fatalf("pinnedDirFDs exceeded budget: got %d > %d", got, baseFDs+2)
+	}
+
+	// Age l1 past 24h retention -> ReserveReview(l3) MUST trigger proactive reclamation of l1,
+	// release l1's pinned dirFD, and admit l3 cleanly well below the 2048 disk bucket cap!
+	ancient := time.Now().Add(-48 * time.Hour)
+	dir1 := filepath.Join(root, l1)
+	raw1, _ := os.ReadFile(filepath.Join(dir1, "receipt.json"))
+	var rr1 ReviewReceipt
+	_ = json.Unmarshal(raw1, &rr1)
+	rr1.Started = ancient.UnixNano()
+	rr1.Finished = ancient.UnixNano()
+	rr1.SealedAt = ancient.UnixNano()
+	agedRaw1, _ := json.Marshal(rr1)
+	agedSHA1 := sha256Hex(string(agedRaw1))
+	agedMarker1, _ := json.Marshal(reviewReservationMarker{Schema: ReviewSchema, Launch: l1, Started: ancient.UnixNano()})
+	_ = os.WriteFile(filepath.Join(dir1, "receipt.json"), agedRaw1, 0600)
+	_ = os.WriteFile(filepath.Join(dir1, "seal.sha256"), []byte(agedSHA1), 0600)
+	_ = os.WriteFile(filepath.Join(dir1, "producer.json"), agedMarker1, 0600)
+	for _, p := range []string{filepath.Join(dir1, "receipt.json"), filepath.Join(dir1, "seal.sha256"), filepath.Join(dir1, "producer.json"), dir1} {
+		_ = os.Chtimes(p, ancient, ancient)
+	}
+	key1 := filepath.Clean(root) + "\x00" + l1
+	reviewMu.Lock()
+	if ent := reviewLedger[key1]; ent != nil {
+		ent.touched = ancient
+	}
+	if b, ok := sealedBindings[key1]; ok {
+		b.receiptSHA = agedSHA1
+		b.recordedAt = ancient
+		sealedBindings[key1] = b
+	}
+	reviewMu.Unlock()
+
+	runAndSeal(l3, s3, "resp_fd_3")
+	if _, statErr := os.Lstat(dir1); !os.IsNotExist(statErr) {
+		t.Fatalf("expected expired l1 reclaimed to free FD budget: %v", statErr)
+	}
+	if got := pinnedDirFDs.Load(); got != baseFDs+2 {
+		t.Fatalf("pinnedDirFDs after proactive reclaim + l3 = %d, want %d", got, baseFDs+2)
+	}
+}
