+
+const Schema = "cliproxy-preflight-v1"
+const ReviewSchema = "cliproxy-review-v1"
+const ReviewHeader = "X-NewChanlun-Review-Launch"
+const MaxAttempts = 64
+const Lifetime = 50 * time.Second
+const ReviewTurnLifetime = 30 * time.Minute
+const MaxReviewDuration = 2 * time.Hour
+
+// ReviewTurnTimeout and ReviewBodyReadTimeout bound formal review turns and inbound body reads.
+// Exposed as package vars so middleware tests can exercise real timeout release without waiting 30 minutes.
+var (
+	ReviewTurnTimeout     = ReviewTurnLifetime
+	ReviewBodyReadTimeout = 30 * time.Second
+)
+const maxOutboundModelBody = 32 << 20
+const maxReviewResponseIDs = 512
+const maxReviewReceiptBytes = 65536
+const maxSSEEventBytes = 8 << 20
+const maxSSEEventLines = 4096
+const maxStrictIdentityBytes = 512
+
+var maxReviewLedgerEntries = 2048
+var maxReviewDiskEntries = 2048
+var maxPreflightDiskEntries = 2048
+var preflightDiskRetention = 30 * time.Minute
+var reviewDiskRetention = 24 * time.Hour
+var maxPendingReviewLaunches = 2048
