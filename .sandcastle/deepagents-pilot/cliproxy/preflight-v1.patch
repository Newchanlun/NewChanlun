new file mode 100644
index 0000000..3a5aa78
--- /dev/null
+++ b/sdk/cliproxy/auth/preflight_execution.go
@@ -0,0 +1,124 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"reflect"
+
+	execution "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/preflightreceipt"
+)
+
+// This fixed-revision allowlist is deliberately by concrete implementation, not
+// Identifier(): a plugin can advertise the same provider without this coverage.
+func preflightStart(ctx context.Context, executor ProviderExecutor, auth *Auth, model string) (context.Context, *preflightreceipt.Execution, error) {
+	c := preflightreceipt.From(ctx)
+	if c == nil {
+		return ctx, nil, nil
+	}
+	typ := reflect.TypeOf(executor)
+	supported := false
+	if typ != nil && typ.Kind() == reflect.Pointer {
+		typ = typ.Elem()
+		if typ.PkgPath() == "github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor" {
+			switch typ.Name() {
+			case "KimiExecutor", "ClaudeExecutor", "AntigravityExecutor":
+				supported = !c.StrictCodex()
+			case "CodexAutoExecutor":
+				// Only the native OAuth HTTP route is covered by the transport receipt.
+				supported = (model == "gpt-6.2-sol" || model == "gpt-6.2-astra") && auth != nil && auth.Provider == "codex" &&
+					auth.AuthKind() == AuthKindOAuth && authAttribute(auth, AttributeAPIKey) == "" &&
+					!execution.DownstreamWebsocket(ctx) && !execution.RequiredUpstreamWebsocket(ctx)
+			}
+		}
+	}
+	// An injected transport may forward elsewhere; it has no coverage contract.
+	rt := ctx.Value("cliproxy.roundtripper")
+	stdTransport, standardTransport := rt.(*http.Transport)
+	badTLSConfig := standardTransport && stdTransport.TLSClientConfig != nil &&
+		(stdTransport.TLSClientConfig.InsecureSkipVerify || stdTransport.TLSClientConfig.ServerName != "")
+	if !supported || auth == nil || (rt != nil && (!standardTransport || badTLSConfig)) {
+		c.Taint()
+		return ctx, nil, preflightreceipt.ErrUnavailable
+	}
+	return c.Start(ctx, auth.Provider, model)
+}
+
+func preflightExecute(executor ProviderExecutor, ctx context.Context, auth *Auth, req execution.Request, opts execution.Options) (execution.Response, error) {
+	ctx, lease, err := preflightStart(ctx, executor, auth, req.Model)
+	if err != nil {
+		return execution.Response{}, err
+	}
+	if lease != nil {
+		defer lease.End()
+	}
+	resp, err := executor.Execute(ctx, auth, req, opts)
+	if err == nil {
+		if c := preflightreceipt.From(ctx); c != nil {
+			c.ObserveStreamChunk(resp.Payload)
+		}
+	}
+	return resp, err
+}
+
+func preflightCount(executor ProviderExecutor, ctx context.Context, auth *Auth, req execution.Request, opts execution.Options) (execution.Response, error) {
+	if c := preflightreceipt.From(ctx); c != nil {
+		c.Taint()
+		return execution.Response{}, preflightreceipt.ErrUnavailable
+	}
+	return executor.CountTokens(ctx, auth, req, opts)
+}
+
+func preflightStream(executor ProviderExecutor, ctx context.Context, auth *Auth, req execution.Request, opts execution.Options) (*execution.StreamResult, error) {
+	ctx, lease, err := preflightStart(ctx, executor, auth, req.Model)
+	if err != nil {
+		return nil, err
+	}
+	result, err := executor.ExecuteStream(ctx, auth, req, opts)
+	if lease == nil {
+		return result, err
+	}
+	if err != nil || result == nil || result.Chunks == nil {
+		lease.End()
+		return result, err
+	}
+	out := make(chan execution.StreamChunk)
+	original := result.Chunks
+	copyResult := *result
+	copyResult.Chunks = out
+	go func() {
+		canceled := false
+		defer func() {
+			close(out)
+			if canceled {
+				deliveryErr, tracked := coreusage.WaitStreamDelivery(ctx)
+				if !tracked || deliveryErr != nil {
+					preflightreceipt.From(ctx).Reject()
+				}
+			}
+			lease.End()
+		}()
+		for {
+			select {
+			case <-ctx.Done():
+				canceled = true
+				return
+			case chunk, ok := <-original:
+				if !ok {
+					return
+				}
+				if c := preflightreceipt.From(ctx); c != nil {
+					c.ObserveStreamChunk(chunk.Payload)
+				}
+				select {
+				case out <- chunk:
+				case <-ctx.Done():
+					canceled = true
+					return
+				}
+			}
+		}
+	}()
+	return &copyResult, nil
+}
