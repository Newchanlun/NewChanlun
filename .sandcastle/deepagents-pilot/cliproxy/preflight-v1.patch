diff --git a/sdk/cliproxy/auth/preflight_execution.go b/sdk/cliproxy/auth/preflight_execution.go
index e69de29..e172af8 100644
--- a/sdk/cliproxy/auth/preflight_execution.go
+++ b/sdk/cliproxy/auth/preflight_execution.go
@@ -0,0 +1,269 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"reflect"
+
+	execution "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/preflightreceipt"
+)
+
+// isTrustedPreflightTransport reports whether rt is a proxy-controlled transport
+// (or, solely in `-tags preflight_test_roots` builds, an explicitly registered offline test transport).
+// Arbitrary externally constructed *http.Transport instances are rejected because they can carry
+// custom RootCAs, verification callbacks, DialTLS hooks, or RegisterProtocol("https", ...) handlers.
+func isTrustedPreflightTransport(rt any) bool {
+	if rt == nil {
+		return false
+	}
+	return isControlledPreflightTransport(rt) || isAllowedTestTransport(rt)
+}
+
+// This fixed-revision allowlist is deliberately by concrete implementation, not
+// Identifier(): a plugin can advertise the same provider without this coverage.
+func preflightStart(ctx context.Context, executor ProviderExecutor, auth *Auth, model string) (context.Context, *preflightreceipt.Execution, error) {
+	c := preflightreceipt.From(ctx)
+	if c == nil {
+		return ctx, nil, nil
+	}
+	typ := reflect.TypeOf(executor)
+	supported := false
+	if typ != nil && typ.Kind() == reflect.Pointer {
+		typ = typ.Elem()
+		if typ.PkgPath() == "github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor" {
+			switch typ.Name() {
+			case "KimiExecutor", "ClaudeExecutor", "AntigravityExecutor":
+				supported = !c.StrictCodex()
+			case "CodexAutoExecutor":
+				// Only the native OAuth HTTP route is covered by the transport receipt.
+				supported = (model == "gpt-6.2-sol" || model == "gpt-6.2-astra") && auth != nil && auth.Provider == "codex" &&
+					auth.AuthKind() == AuthKindOAuth && authAttribute(auth, AttributeAPIKey) == "" &&
+					!execution.DownstreamWebsocket(ctx) && !execution.RequiredUpstreamWebsocket(ctx)
+			}
+		}
+	}
+	if !supported || auth == nil {
+		c.Taint()
+		return ctx, nil, preflightreceipt.ErrUnavailable
+	}
+	rt := ctx.Value("cliproxy.roundtripper")
+	if rt != nil {
+		if !isTrustedPreflightTransport(rt) {
+			c.Taint()
+			return ctx, nil, preflightreceipt.ErrUnavailable
+		}
+	} else {
+		controlled, err := ControlledTransportForProxy(auth.ProxyURL)
+		if err != nil {
+			c.Taint()
+			return ctx, nil, preflightreceipt.ErrUnavailable
+		}
+		ctx = context.WithValue(ctx, "cliproxy.roundtripper", http.RoundTripper(controlled))
+	}
+	return c.Start(ctx, auth.Provider, model)
+}
+
+func preflightExecute(executor ProviderExecutor, ctx context.Context, auth *Auth, req execution.Request, opts execution.Options) (execution.Response, error) {
+	if c := preflightreceipt.From(ctx); c != nil && c.StrictCodex() {
+		// Formal review launches require streaming SSE response.completed evidence; reject non-streaming Execute.
+		c.Taint()
+		return execution.Response{}, preflightreceipt.ErrUnavailable
+	}
+	ctx, lease, err := preflightStart(ctx, executor, auth, req.Model)
+	if err != nil {
+		return execution.Response{}, err
+	}
+	if lease != nil {
+		defer lease.End()
+	}
+	resp, err := executor.Execute(ctx, auth, req, opts)
+	if err == nil {
+		if c := preflightreceipt.From(ctx); c != nil {
+			c.ObserveStreamChunk(resp.Payload)
+		}
+	}
+	return resp, err
+}
+
+func preflightCount(executor ProviderExecutor, ctx context.Context, auth *Auth, req execution.Request, opts execution.Options) (execution.Response, error) {
+	if c := preflightreceipt.From(ctx); c != nil {
+		c.Taint()
+		return execution.Response{}, preflightreceipt.ErrUnavailable
+	}
+	return executor.CountTokens(ctx, auth, req, opts)
+}
+
+func wrapPreflightStream(ctx context.Context, lease *preflightreceipt.Execution, original <-chan execution.StreamChunk) <-chan execution.StreamChunk {
+	out := make(chan execution.StreamChunk)
+	deliverySupported := coreusage.StreamDeliverySupported(ctx)
+	go func() {
+		canceled := false
+		postEOFCancel := false
+		sawPayload := false
+		leaseEnded := false
+		defer func() {
+			if leaseEnded {
+				close(out)
+				return
+			}
+			if !canceled && !postEOFCancel {
+				// Release the execution lease BEFORE exposing EOF on out so an immediate
+				// serial retry on the same Collector never observes stale active > 0.
+				lease.End()
+				close(out)
+				return
+			}
+			// Capture producer delivery opt-in BEFORE closing out so an executor that does
+			// not support early terminal delivery (e.g. ClaudeExecutor) cannot accidentally
+			// slip through on a racy post-disconnect cancel(nil).
+			if !deliverySupported {
+				deliverySupported = coreusage.StreamDeliverySupported(ctx)
+			}
+			// On cancellation, close out first so WaitStreamDelivery cannot deadlock
+			// waiting for a consumer blocked on reading out.
+			close(out)
+			c := preflightreceipt.From(ctx)
+			if postEOFCancel && c != nil && c.StrictCodex() {
+				// Upstream HTTP body already reached true io.EOF and response.completed was delivered
+				// downstream (e.g. OpenAIResponsesAPIHandler ChunkDone() -> cancel(nil)). Drain any
+				// remaining already-queued chunks on original to observe trailing errors/duplicates,
+				// and accept only when downstream delivery acknowledged nil error.
+				for chunk := range original {
+					if chunk.Err != nil {
+						c.Taint()
+						continue
+					}
+					if chunk.Payload != nil {
+						c.ObserveStreamChunk(chunk.Payload)
+					}
+				}
+				deliveryErr, tracked := coreusage.WaitStreamDelivery(ctx)
+				if !tracked || deliveryErr != nil {
+					c.Reject()
+				}
+			} else if c != nil && c.StrictCodex() {
+				// Formal review launches must observe upstream EOF; stopping early on client
+				// cancellation could hide trailing duplicate terminal events or errors.
+				c.Reject()
+				// Hold the execution lease until the producer goroutine finishes closing original
+				// (and completes any pending ObserveStreamChunk / defer Taint()) so SealReview can
+				// never observe inFlight == 0 and seal a prior turn ahead of producer taint.
+				for chunk := range original {
+					if chunk.Err != nil {
+						if c.ObservedCompleted() {
+							c.Taint()
+						}
+						continue
+					}
+					if chunk.Payload != nil {
+						c.ObserveStreamChunk(chunk.Payload)
+					}
+				}
+			} else {
+				deliveryErr, tracked := coreusage.WaitStreamDelivery(ctx)
+				if !tracked || !deliverySupported || deliveryErr != nil {
+					c.Reject()
+				}
+			}
+			lease.End()
+		}()
+		for {
+			select {
+			case <-ctx.Done():
+				if c := preflightreceipt.From(ctx); c != nil && c.StrictCodex() && c.UpstreamEOF() && c.ObservedCompleted() {
+					postEOFCancel = true
+				} else {
+					canceled = true
+				}
+				return
+			case chunk, ok := <-original:
+				if !ok {
+					if ctx.Err() != nil {
+						if c := preflightreceipt.From(ctx); c != nil && c.StrictCodex() && c.UpstreamEOF() && c.ObservedCompleted() {
+							postEOFCancel = true
+						} else {
+							canceled = true
+						}
+					}
+					return
+				}
+				if !deliverySupported && coreusage.StreamDeliverySupported(ctx) {
+					deliverySupported = true
+				}
+				if c := preflightreceipt.From(ctx); c != nil {
+					if chunk.Err != nil {
+						if c.StrictCodex() && c.ObservedCompleted() {
+							c.Taint()
+						} else if sawPayload {
+							c.Reject()
+						} else {
+							c.MarkAttemptFailed()
+							// Drain original to EOF and release the execution lease BEFORE delivering a
+							// pre-payload bootstrap error so Manager.ExecuteStream's immediate serial
+							// retry never races with async discardStreamChunks and hits active > 0.
+							for {
+								select {
+								case <-ctx.Done():
+									canceled = true
+									return
+								case extra, more := <-original:
+									if !more {
+										goto bootstrapDrained
+									}
+									if extra.Err != nil {
+										if c.StrictCodex() && c.ObservedCompleted() {
+											c.Taint()
+										}
+									} else if len(extra.Payload) > 0 {
+										c.Reject()
+										c.ObserveStreamChunk(extra.Payload)
+									}
+								}
+							}
+						bootstrapDrained:
+							lease.End()
+							leaseEnded = true
+							select {
+							case out <- chunk:
+							case <-ctx.Done():
+							}
+							return
+						}
+					} else if chunk.Payload != nil {
+						if len(chunk.Payload) > 0 {
+							sawPayload = true
+						}
+						c.ObserveStreamChunk(chunk.Payload)
+					}
+				}
+				select {
+				case out <- chunk:
+				case <-ctx.Done():
+					canceled = true
+					return
+				}
+			}
+		}
+	}()
+	return out
+}
+
+func preflightStream(executor ProviderExecutor, ctx context.Context, auth *Auth, req execution.Request, opts execution.Options) (*execution.StreamResult, error) {
+	ctx, lease, err := preflightStart(ctx, executor, auth, req.Model)
+	if err != nil {
+		return nil, err
+	}
+	result, err := executor.ExecuteStream(ctx, auth, req, opts)
+	if lease == nil {
+		return result, err
+	}
+	if err != nil || result == nil || result.Chunks == nil {
+		lease.End()
+		return result, err
+	}
+	copyResult := *result
+	copyResult.Chunks = wrapPreflightStream(ctx, lease, result.Chunks)
+	return &copyResult, nil
+}
