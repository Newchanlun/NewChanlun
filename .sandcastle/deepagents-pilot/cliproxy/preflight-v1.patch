+			}
+		default:
+			t.Fatal("no upstream request")
+		}
+	}
+	requireNoReceipt := func(t *testing.T, session string) {
+		t.Helper()
+		if _, err := os.Stat(filepath.Join(root, session, "receipt.json")); !os.IsNotExist(err) {
+			t.Fatalf("unexpected receipt or stat error: %v", err)
+		}
+	}
