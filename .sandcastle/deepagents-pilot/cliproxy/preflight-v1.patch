+		}
+		_, _ = io.Copy(io.Discard, resp1.Body)
+		_ = resp1.Body.Close()
+		e1.End()
+	}()
+
+	go func() {
+		defer wg.Done()
+		<-req1Entered // Guarantee request 2 is initiated AFTER request 1.
+		cl2 := httptransport.Decorate(ctx2, &http.Client{Transport: fakeTransport(func(r *http.Request) (*http.Response, error) {
+			return &http.Response{
+				StatusCode: 200,
+				Header:     make(http.Header),
+				Body:       io.NopCloser(strings.NewReader("ok2")),
+				TLS:        verifiedTLSState("api.anthropic.com"),
