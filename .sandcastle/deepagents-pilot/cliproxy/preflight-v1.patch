+	sse1 := "data: " + `{"type":"response.completed","response":{"id":"resp_fm_t1","status":"completed","model":"gpt-6.2-sol","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"turn1"}]}]}}` + "\n\n"
+
+	for _, tc := range []struct {
+		name           string
+		launch         string
+		session        string
