#!/usr/bin/env python3
from pathlib import Path
import argparse
import sys

from common import Invalid, git
from registry import load


def main():
    parser = argparse.ArgumentParser(description="AT-18 登记册静态核验")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[2])
    refs = parser.add_mutually_exclusive_group()
    refs.add_argument("--base", help="对比已确定的 PR merge-base SHA")
    refs.add_argument("--pr-merge-ref", action="store_true", help="从 GitHub 的 PR 合并检出计算 merge base")
    args = parser.parse_args()
    try:
        base = args.base
        if args.pr_merge_ref:
            parents = git(args.root, "rev-list", "--parents", "-n", "1", "HEAD").decode().split()
            if len(parents) != 3:
                raise Invalid("GIT_READ: expected two parents on PR merge ref")
            base = git(args.root, "merge-base", "--all", *parents[1:]).decode().split()
            if len(base) != 1:
                raise Invalid("GIT_READ: expected one merge base")
            base = base[0]
        reg, _, sha, _, _ = load(args.root, base=base)
        print(f"at18-registry-lint OK {sha}: {len(reg['bindings'])} bindings, {len(reg['checks'])} checks")
        return 0
    except (ValueError, OSError, KeyError, TypeError, SyntaxError) as err:
        print(f"at18-registry-lint: {err}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
